# Rust
target/
# NOT Cargo.lock. This ships binaries and container images, so the
# lockfile is committed and a checkout builds the same dependency graph
# the release was cut from. spdk-csi-driver/Cargo.lock has in fact been
# tracked all along — this line never applied to it (gitignore does not
# affect already-tracked files) and only sat here waiting to drop it the
# first time something untracked it.

# Generated files
spdk-csi-driver/src/csi.v1.rs

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Logs
*.log
# ...except drill evidence. lean/e2e/results/ exists so that a number
# quoted in a plan or a score is re-readable without re-running
# anything -- and the commit that added it (fd5b94c7, "the drill
# evidence made durable") committed only the README describing the
# logs, because this *.log rule silently swallowed the logs
# themselves. They lived on one laptop for a month.
!lean/e2e/results/*.log
!forge/e2e/results/*.log
!forge/e2e/scale/results/*.log
# Same for the Kerberos rig: run-gssneg.sh's red run is the only durable
# proof that the sequence-window bug was real, and a fix without its red
# run is an assertion.
!tests/krb5/results/*.log

# Temporary files
*.tmp
*~
.kube/

# Kubeconfigs. NEVER commit one: they carry bearer tokens and client
# certs, and this repo is public. Eight were tracked until 2026-08-21 —
# see the commit that added this block. The .example placeholder is the
# one file that is meant to be here.
kubeconfig
kubeconfig-*.yaml
*.kubeconfig
!tests/system/config/kubeconfig.example

# Test artifacts
tests/system/kuttl-test-*
tests/system/*.log
.claude/
spdk-csi-driver/docker/prebuilt/

# Formal-model gate: scripts/check-tla.sh fetches this on first use and
# caches it here (override with TLA_TOOLS_JAR). It is a 2 MB upstream
# release artifact, not source.
.tla2tools.jar

# Perf-gate measurements are per-run and rig-specific; only the
# baseline (tests/lima/perf-baseline.json) is committed.
tests/lima/perf-*.json
!tests/lima/perf-baseline.json
