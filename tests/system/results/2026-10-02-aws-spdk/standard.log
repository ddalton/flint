        === COMMAND
        /bin/bash -c set -u
        for i in $(seq 1 30); do
          out=$(kubectl -n "$NAMESPACE" logs rox-forgetful-writer 2>/dev/null)
          [ -n "$out" ] && break; sleep 2
        done
        echo "rox-forgetful-writer: $out"
        case "$out" in
          *WRITE_LANDED*) echo "FAIL (F70): a pod without readOnly WROTE to a ReadOnlyMany volume"; exit 1 ;;
          *WRITE_REFUSED*) ;;
          *) echo "FAIL: no verdict from the writer"; exit 1 ;;
        esac
        # Independent of the writer's own view: another node's reader must
        # not see the probe (informative only when the write was refused).
        if kubectl -n "$NAMESPACE" exec reader-pod-1 -- test -e /data/f71-rw-probe; then
          echo "FAIL (F70): the probe file is visible to reader-pod-1"; exit 1
        fi
        echo "PASS: ROX is enforced whatever the pod asks for"
