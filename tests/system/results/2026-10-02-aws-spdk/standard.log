    sink.go:61: | 12:22:21 | snapshot-restore | 04-verify   | CMD       | RUN   |
        === COMMAND
        /bin/bash -c # kuttl retried a TestAssert command until the step timeout;
        # a Chainsaw script runs once, so the retry is explicit.
        attempt() {
          set -e  # Exit on any error
        
          # Get the current namespace
          NAMESPACE=${NAMESPACE:-default}
          echo "Using namespace: $NAMESPACE"
        
          PHASE=$(kubectl get pod snapshot-verifier -n $NAMESPACE -o jsonpath='{.status.phase}')
          if [ "$PHASE" = "Failed" ] || [ "$PHASE" = "Error" ]; then
            echo "❌ Pod in $PHASE state - failing test"
            exit 1
          fi
          echo "✅ Pod status check passed (Phase: $PHASE)"
        }
        until ( attempt ); do sleep 2; done
