# Multi-stage build for pNFS (both MDS and DS)
#
# The runtime base, used by the SECOND stage; declared before the first
# FROM so it is in scope there. The builder stage is not shipped.
ARG BASE_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d
# 
# This builds both flint-pnfs-mds and flint-pnfs-ds in a single image.
# The binaries share ~99% of their dependencies, so building together
# is MUCH faster than building separately.
#
# Runtime: Select MDS or DS via entrypoint

FROM rust:1.90-slim-bookworm AS builder

# --- System-level setup ---
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    perl protobuf-compiler libprotobuf-dev pkg-config && rm -rf /var/lib/apt/lists/*

USER 65532

# --- Application build ---
WORKDIR /app

# Copy source files
COPY --chown=65532:65532 Cargo.toml Cargo.lock ./
COPY --chown=65532:65532 src/ ./src/
COPY --chown=65532:65532 build.rs ./
COPY --chown=65532:65532 proto/ ./proto/

# Build BOTH pNFS binaries together
# They share dependencies, so this is much faster than building separately
# Total time: ~6-8 minutes (vs 10-15 minutes if built separately)
RUN cargo build --release --bin flint-pnfs-mds --bin flint-pnfs-ds

# --- Runtime image ---
# BASE: Chainguard `wolfi-base` (glibc, busybox, apk) instead of
# ubuntu:24.04. The builder above links glibc 2.36 (bookworm) dynamically;
# Wolfi's glibc is newer, so the binaries load (Dockerfile.pnfs.prebuilt,
# the file publish-images.sh builds, ships musl-static ones instead). Pinned by the multi-arch index digest; override with
# --build-arg BASE_IMAGE. Default user root, as ubuntu's was.
FROM ${BASE_IMAGE}

# Runtime dependencies: NFS client/server tools (nfs-utils + rpcbind for
# ubuntu's nfs-common), Kerberos clients (Wolfi `krb5` carries kinit/klist/
# ktutil, as krb5-user did), filesystem tools, and the bash/GNU coreutils
# ubuntu:24.04 carried — the pnfs-bench rigs `kubectl exec ... bash -lc`
# into these pods. The build fails if any named tool is missing.
#
# tcpdump is not a debugging luxury here. Every failure mode this
# server has that matters is on the wire, and the F65 audit showed
# why reading the server's own logs is not a substitute: a
# CB_LAYOUTRECALL the client REFUSED was scored and logged as an ack
# for as long as the bug existed. tests/k8s/pnfs-drills/truncate-recall.sh
# reads the CB_COMPOUND status directly and hard-fails without this.
#
# libcap-utils: setcap, for the file capabilities below.
#
# THE ON-DISK FORMAT IS PINNED to what ubuntu:24.04's e2fsprogs 1.47.0 and
# xfsprogs 6.6.0 made, because a filesystem made here is mounted by the
# NODE's kernel, not this image's. Wolfi's newer tools default to features
# older kernels refuse: ext4 `orphan_file` (>= 5.15) and
# `metadata_csum_seed`; XFS `nrext64` (>= 5.19), `exchange` (>= 6.10) and
# `parent` (>= 6.12). ext4 reads its defaults from /etc/mke2fs.conf, so
# that line is rewritten; mkfs.xfs has no default config file, only `-c
# options=`, so /usr/local/bin/mkfs.xfs (first on PATH) passes a profile
# with ubuntu 6.6.0's feature set to /usr/bin/mkfs.xfs. The build formats
# a scratch image with each and fails on any drift. (xfsprogs >= 7 no
# longer sets the legacy ATTR2 superblock bit; V5 implies attr2 and no
# option restores the bit.) A caller that passes its own `-c` to
# mkfs.xfs, or `mkfs -t xfs` (which searches /sbin first), bypasses the
# profile.
RUN apk add --no-cache \
        bash \
        coreutils \
        util-linux \
        util-linux-misc \
        mount \
        umount \
        blkid \
        blockdev \
        findmnt \
        lsblk \
        losetup \
        wipefs \
        nfs-utils \
        rpcbind \
        e2fsprogs \
        e2fsprogs-extra \
        xfsprogs \
        xfsprogs-core \
        xfsprogs-extra \
        ca-certificates-bundle \
        curl \
        krb5 \
        tcpdump \
        libcap-utils \
    && sed -i 's/^\([[:space:]]*features = \)has_journal,extent,huge_file,flex_bg,metadata_csum,metadata_csum_seed,64bit,dir_nlink,extra_isize,orphan_file$/\1has_journal,extent,huge_file,flex_bg,metadata_csum,64bit,dir_nlink,extra_isize/' /etc/mke2fs.conf \
    && grep -q '^[[:space:]]*features = has_journal,extent,huge_file,flex_bg,metadata_csum,64bit,dir_nlink,extra_isize$' /etc/mke2fs.conf \
    && mkdir -p /etc/flint /usr/local/bin \
    && printf '%s\n' '[metadata]' 'bigtime=1' 'crc=1' 'finobt=1' 'inobtcount=1' 'metadir=0' 'reflink=1' 'rmapbt=1' 'autofsck=0' '[inode]' 'sparse=1' 'nrext64=0' 'exchange=0' '[naming]' 'parent=0' > /etc/flint/mkfs.xfs.conf \
    && printf '%s\n' '#!/bin/sh' '# flint: pin the XFS feature set to what nodes can mount (see Dockerfile).' 'exec /usr/bin/mkfs.xfs -c options=/etc/flint/mkfs.xfs.conf "$@"' > /usr/local/bin/mkfs.xfs \
    && chmod 0755 /usr/local/bin/mkfs.xfs \
    && truncate -s 512M /tmp/fmt.img \
    && mkfs.ext4 -F -q /tmp/fmt.img \
    && dumpe2fs -h /tmp/fmt.img 2>/dev/null | grep '^Filesystem features:' | tee /dev/stderr | grep -q metadata_csum \
    && ! dumpe2fs -h /tmp/fmt.img 2>/dev/null | grep '^Filesystem features:' | grep -qE 'orphan_file|metadata_csum_seed' \
    && mkfs.xfs -q -f /tmp/fmt.img \
    && xfs_db -r -c version /tmp/fmt.img | tee /dev/stderr | grep -q ',RMAPBT,REFLINK,INOBTCNT,BIGTIME$' \
    && rm -f /tmp/fmt.img \
    && timeout --version | grep -q 'GNU coreutils' \
    && for t in timeout mount umount mountpoint findmnt blkid mkfs.ext4 e2fsck resize2fs dumpe2fs mkfs.xfs xfs_growfs xfs_db mount.nfs mount.nfs4 showmount nfsstat rpc.gssd rpcinfo curl kinit klist ktutil tcpdump setcap getcap bash sh; do command -v "$t" >/dev/null || { echo "missing $t" >&2; exit 1; }; done \
    && test -s /etc/ssl/certs/ca-certificates.crt

# Copy BOTH binaries to the runtime image
COPY --from=builder /app/target/release/flint-pnfs-mds /usr/local/bin/
COPY --from=builder /app/target/release/flint-pnfs-ds /usr/local/bin/

# ── Audit finding 7: make running as a non-root uid POSSIBLE ─────────────
#
# The hub was believed to require root. It does not. Measured on Linux
# (2026-08-24), server as uid 65532 with exactly these four capabilities
# as FILE capabilities, pynfs 4.1 scored 171 passed / 0 failed / 91
# skipped — identical to the root run — and every one of the 45 objects
# the suite created came out owned by the CALLER (503:1000), not by the
# server. The control arm, same uid with the capabilities stripped, put
# all of them at 65532:988 and logged nothing at all.
#
# What the server genuinely needs, and why each:
#   CHOWN        stamp the caller's AUTH_SYS identity on created objects
#                (ioops.rs OPEN(create), fileops.rs CREATE). Without it
#                postgres refuses to start on its own data directory and
#                a mode-0700 directory locks out its creator.
#   DAC_OVERRIDE read and write files it does not own, after that chown
#   FOWNER       chmod/utimes on files it does not own (SETATTR)
#   FSETID       preserve setuid/setgid across a chown
#
# FILE capabilities specifically, because Kubernetes has no ambient
# capabilities: a container running as a non-root uid does NOT get an
# effective capability from `securityContext.capabilities.add` alone.
# Without this setcap, `runAsNonRoot: true` silently produces a server
# that cannot chown — which is why `nfs::privilege` probes it at startup
# and says so in the log.
#
# These are inert while the container runs as uid 0, so adding them
# changes nothing for the current default; it removes the reason the
# default cannot move.
RUN setcap cap_chown,cap_dac_override,cap_fowner,cap_fsetid=ep \
      /usr/local/bin/flint-pnfs-mds \
 && setcap cap_chown,cap_dac_override,cap_fowner,cap_fsetid=ep \
      /usr/local/bin/flint-pnfs-ds \
 && getcap /usr/local/bin/flint-pnfs-mds | grep -q cap_chown \
 || (echo "setcap did not take — the image cannot run non-root" && exit 1)

# Expose ports for both MDS and DS
# (only the relevant ports will be used depending on which binary runs)
EXPOSE 2049/tcp
EXPOSE 50051/tcp

# Default to MDS (can be overridden)
# For DS, use: docker run flint/pnfs:latest /usr/local/bin/flint-pnfs-ds
ENTRYPOINT ["/usr/local/bin/flint-pnfs-mds"]
CMD ["--config", "/etc/flint/pnfs.yaml"]

