# syntax=docker/dockerfile:1
# flint-forge-syncer — the one writer of a repository's S3 state, and
# the main container of a forge server pod: its exit restarts the pod,
# which is what makes a fence recoverable.
#
#   for T in x86_64 aarch64; do
#     (cd ../forge/syncer && cargo zigbuild --release --features s3 \
#       --target $T-unknown-linux-musl --bin flint-forge-syncer); done
#   # stage: docker/prebuilt/{amd64,arm64}/flint-forge-syncer
#
# It needs `git` — every object-database operation is a subprocess, by
# design, so that flint writes no git internals — and CA certificates,
# because flint-store builds the AWS SDK against the SYSTEM trust store
# and without a bundle every HTTPS endpoint fails at the handshake. A
# scratch base fails both, and the second failure appears only on a real
# bucket: a MinIO rig is plain HTTP and never sees it.
#
# BASE: Chainguard `wolfi-base` (glibc, busybox, apk) — `static` fails
# the first requirement. It is the same git as Dockerfile.forge-git's
# (both from Wolfi at the same pin), which the hook protocol between the
# two containers already assumes. Pinned by the multi-arch index digest;
# override with --build-arg BASE_IMAGE.
ARG BASE_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d
FROM ${BASE_IMAGE}

ARG BIN_DIR=docker/prebuilt
ARG TARGETARCH

RUN apk add --no-cache ca-certificates-bundle git \
    && test -s /etc/ssl/certs/ca-certificates.crt

COPY ${BIN_DIR}/${TARGETARCH}/flint-forge-syncer /usr/local/bin/flint-forge-syncer

# The legible export (design §9) runs `flint-sync barrier` over a tree
# forge materialises. It is the SHIPPED lean binary, unmodified: forge
# writes no manifest, so the ordering that a crash makes load-bearing —
# upload, CAS, deletes LAST — is lean's, machine-checked by lean's own
# model rather than re-derived here. Build it from lean/syncer with
# --features s3 alongside the syncer.
COPY ${BIN_DIR}/${TARGETARCH}/flint-sync /usr/local/bin/flint-sync

ENTRYPOINT ["/usr/local/bin/flint-forge-syncer"]
