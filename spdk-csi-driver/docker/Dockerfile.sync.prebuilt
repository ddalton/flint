# syntax=docker/dockerfile:1
# flint-sync — the flint-lean workspace syncer, runtime-only image for a
# HOST-CROSS-COMPILED binary, same recipe shape as
# Dockerfile.operator.prebuilt.
#
#   for T in x86_64 aarch64; do
#     (cd ../lean/syncer && cargo zigbuild --release --features s3 \
#       --target $T-unknown-linux-musl --bin flint-sync); done
#   # stage: docker/prebuilt/{amd64,arm64}/flint-sync
#   for A in amd64 arm64; do
#     docker build --platform linux/$A -f docker/Dockerfile.sync.prebuilt \
#       --build-arg BIN_DIR=docker/prebuilt \
#       -t dilipdalton/flint-sync:<tag>-$A . && \
#     docker push dilipdalton/flint-sync:<tag>-$A; done
#   docker manifest create dilipdalton/flint-sync:<tag> \
#     --amend ...-amd64 --amend ...-arm64 && docker manifest push ...
#
# This image runs as the workspace's SYNCER. It was injected into every
# workspace pod by the lean webhook (from a chart value `sidecarImage`)
# until v1.45.0; delivery moved to the s3.csi.chert.us node plugin,
# which launches it in a worker pod from `FLINT_S3CSI_LEAN_IMAGE`. The
# chart value is gone and the webhook with it.
#
# It is still sized and hardened as a guest rather than as a service,
# and that is deliberate rather than left over: the worker shares the
# tenant's tree and uid, so the two requirements below are unchanged.
#
# TWO REQUIREMENTS, and a scratch/distroless base (including
# Chainguard `static`) fails the first:
#
#  1. A SHELL AND BUSYBOX. This image is the BASE of flint-s3-worker-lean
#     (Dockerfile.s3worker-lean), and the worker is where the syncer is
#     inspected and fault-injected: s3csi/e2e/run-s3csi.sh,
#     aws-hardening.sh, aws-identity.sh and aws-access.sh `kubectl exec`
#     `/bin/sh -c`, `ps | grep`, `cat`, `sed`, `tr` and `test -f` inside
#     the lean worker to find, SIGSTOP and kill flint-sync and to read
#     /comm. (The injected-sidecar startupProbe that first made the shell
#     load-bearing went with the webhook in v1.45.0; the rigs did not.)
#     Without the shell those legs read as failures of the syncer.
#
#  2. CA CERTIFICATES. flint-store builds the AWS SDK with its `rustls`
#     feature, which resolves to `rustls-native-certs` — the SYSTEM trust
#     store, not compiled-in roots. Without a CA bundle every HTTPS S3
#     endpoint fails at handshake. Every kind drill missed this because
#     MinIO is plain HTTP; it appears on the first real bucket.
#
# BASE: Chainguard `wolfi-base` (glibc, busybox, apk) gives both; the
# binary is musl-static so the base is only providing the shell, the
# certs and a filesystem. Pinned by the multi-arch index digest; override
# with --build-arg BASE_IMAGE. Its default user is root, as alpine's was.
ARG BASE_IMAGE=cgr.dev/chainguard/wolfi-base:latest@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d
FROM ${BASE_IMAGE}

ARG BIN_DIR=docker/prebuilt
ARG TARGETARCH

# ca-certificates-bundle is already in wolfi-base; installing it by name
# keeps requirement 2 true if the base's package set ever changes.
RUN apk add --no-cache ca-certificates-bundle \
    && test -s /etc/ssl/certs/ca-certificates.crt

COPY ${BIN_DIR}/${TARGETARCH}/flint-sync /usr/local/bin/flint-sync

# No USER: the syncer shares the agent's workspace volume and must be
# able to read and write files the agent owns. The chart sets the
# security context, because only the chart knows the agent's uid.
ENTRYPOINT ["/usr/local/bin/flint-sync"]
