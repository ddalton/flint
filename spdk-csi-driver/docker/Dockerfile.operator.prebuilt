# syntax=docker/dockerfile:1
# flint-lite-operator — runtime-only image for a HOST-CROSS-COMPILED
# binary, same recipe as Dockerfile.csi.prebuilt / Dockerfile.pnfs.prebuilt.
#
#   # TWO crates stage into one tree: the lite/hub/lean operators build
#   # from spdk-csi-driver, flint-lean-gateway from lean/sidecar.
#   for T in x86_64 aarch64; do
#     cargo zigbuild --release --target $T-unknown-linux-musl \
#       --bin flint-lite-operator --bin flint-hub-gateway \
#       --bin flint-lean-operator
#     (cd ../lean/sidecar && cargo zigbuild --release --features s3 \
#       --target $T-unknown-linux-musl --bin flint-lean-gateway); done
#   # stage: docker/prebuilt/amd64/{flint-lite-operator,flint-hub-gateway}
#   #        docker/prebuilt/arm64/{flint-lite-operator,flint-hub-gateway}
#   for A in amd64 arm64; do
#     docker build --platform linux/$A -f docker/Dockerfile.operator.prebuilt \
#       --build-arg BIN_DIR=docker/prebuilt \
#       -t dilipdalton/flint-lite-operator:<tag>-$A . && \
#     docker push dilipdalton/flint-lite-operator:<tag>-$A; done
#   docker manifest create dilipdalton/flint-lite-operator:<tag> \
#     --amend ...-amd64 --amend ...-arm64 && docker manifest push ...
#
# The operator talks to exactly one thing (the API server) and writes
# nothing to disk, so this image carries no tools: the chart runs it
# as non-root with a read-only root filesystem and every capability
# dropped.
FROM ubuntu:24.04

ARG BIN_DIR=docker/prebuilt
ARG TARGETARCH

# ca-certificates only. In-cluster the API server is verified with the
# service account's mounted CA, but an out-of-cluster kubeconfig
# (dev, `kubectl proxy`-less debugging) needs the system store.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY ${BIN_DIR}/${TARGETARCH}/flint-lite-operator /usr/local/bin/flint-lite-operator

# flint-hub-gateway rides in the SAME image. Same crate, same build —
# and one fewer image to publish, sign, scan and keep in step at
# release, which is where a second image actually costs something. The
# chart picks the binary with `command:`; the two processes share
# nothing at runtime (different ServiceAccount, different RBAC,
# different pods), so this is packaging and not coupling.
COPY ${BIN_DIR}/${TARGETARCH}/flint-hub-gateway /usr/local/bin/flint-hub-gateway

# flint-lean's operator and gateway ride here too, and the chart already
# says so: flint-lean-chart/values.yaml names THIS image and its
# templates exec /usr/local/bin/flint-lean-operator and
# /usr/local/bin/flint-lean-gateway. Until this commit they were not in
# it, so `helm install flint-lean` was a CrashLoopBackOff on "no such
# file or directory" — the 1.2.0 unpublished-image bug one layer deeper,
# where the image exists and the binary inside it does not.
#
# There is no webhook in this image any more: pods get their lean
# workspace from the s3.csi.chert.us CSI node driver (Dockerfile.s3csi.
# prebuilt); flint-lean-operator is the claim/posture/sweep controller
# and nothing else.
#
# NOTE flint-lean-gateway is the one binary here that does NOT build
# from this crate — it comes from lean/sidecar. Same staging tree, two
# cargo invocations; see the header.
COPY ${BIN_DIR}/${TARGETARCH}/flint-lean-operator /usr/local/bin/flint-lean-operator
COPY ${BIN_DIR}/${TARGETARCH}/flint-lean-gateway /usr/local/bin/flint-lean-gateway

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/flint-lite-operator"]
