+static void
+blob_persist_zero_new_clusters_cpl(spdk_bs_sequence_t *seq, void *cb_arg, int bserrno)
+{
+	struct spdk_blob_persist_ctx *ctx = cb_arg;
+
+	if (bserrno != 0) {
+		blob_persist_complete(seq, ctx, bserrno);
+		return;
+	}
+	blob_persist_start_md(seq, ctx);
+}
+
+/* A thick blob maps its clusters as soon as it is created or grown: zero the
+ * new ones (from clean.num_clusters up to active.num_clusters, contiguous runs
+ * in one request) before the metadata that maps them is written. Returns false
+ * when there is nothing to zero. A thin blob is left alone: its clusters are
+ * zeroed one by one as writes allocate them. */
+static bool
+blob_persist_zero_new_clusters(spdk_bs_sequence_t *seq, struct spdk_blob_persist_ctx *ctx)
+{
+	struct spdk_blob *blob = ctx->blob;
+	struct spdk_blob_store *bs = blob->bs;
+	uint64_t cluster_lba_count = bs_cluster_to_lba(bs, 1);
+	uint64_t i, lba = 0, lba_count = 0;
+	spdk_bs_batch_t *batch;
+
+	if (spdk_blob_is_thin_provisioned(blob) ||
+	    blob->clean.num_clusters >= blob->active.num_clusters ||
+	    !bs_zero_new_clusters()) {
+		return false;
+	}
+
+	batch = bs_sequence_to_batch(seq, blob_persist_zero_new_clusters_cpl, ctx);
+	for (i = blob->clean.num_clusters; i < blob->active.num_clusters; i++) {
+		uint64_t next_lba = blob->active.clusters[i];
+
+		if (next_lba == 0) {
+			continue;
+		}
+		if (lba_count > 0 && lba + lba_count == next_lba) {
+			lba_count += cluster_lba_count;
+			continue;
+		}
+		if (lba_count > 0) {
+			bs_batch_write_zeroes_dev(batch, lba, lba_count);
+		}
+		lba = next_lba;
+		lba_count = cluster_lba_count;
+	}
+	if (lba_count > 0) {
+		bs_batch_write_zeroes_dev(batch, lba, lba_count);
+	}
+	bs_batch_close(batch);
+	return true;
+}
