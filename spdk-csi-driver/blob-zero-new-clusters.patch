+/* Zero-on-allocate (2026-10-22). A blob must read zeroes where it never wrote.
+ * A thin blob reads them from its zeroes back device until a write allocates
+ * the cluster, and from then on reads the cluster itself; a thick blob reads
+ * its clusters from the moment it is created. Both rely on a free cluster
+ * already holding zeroes, because the clear method zeroed it when it was freed
+ * or when the blobstore was created. That does not hold when the clear is an
+ * unmap and the bdev cannot unmap (uring completes it as a no-op) or does not
+ * read zeroes after one, nor for a disk with data from before the blobstore: a
+ * new blob then reads a deleted blob's data, and raid1 replicas disagree
+ * wherever nothing was written. So zero a cluster before it is mapped
+ * unwritten: a thin blob's new cluster over zeroes (bs_allocate_and_copy_cluster)
+ * and a thick blob's new clusters before the metadata that maps them is
+ * persisted (blob_persist_zero_new_clusters). SPDK_BS_ZERO_NEW_CLUSTERS=0
+ * restores the old behaviour (A/B, and the unit test's control). */
+static bool
+bs_zero_new_clusters(void)
+{
+	static bool warned;
+	const char *env = getenv("SPDK_BS_ZERO_NEW_CLUSTERS");
+
+	if (env != NULL && strcmp(env, "0") == 0) {
+		if (!warned) {
+			SPDK_WARNLOG("SPDK_BS_ZERO_NEW_CLUSTERS=0: new clusters are not zeroed; a blob "
+				     "may read a deleted blob's data where it never wrote\n");
+			warned = true;
+		}
+		return false;
+	}
+	return true;
+}
