+/* Leave n free clusters holding a deleted blob's data: a thick blob filled
+ * with 0xA5 and deleted with BLOB_CLEAR_WITH_NONE (a stand-in for a bdev that
+ * cannot unmap). The lowest free cluster is allocated first, so the next blob
+ * gets them back; their LBAs are returned in lbas[]. */
+static void
+ut_dirty_free_clusters(struct spdk_blob_store *bs, struct spdk_io_channel *channel,
+		       uint64_t n, uint64_t *lbas)
+{
+	uint64_t i, iou = spdk_bs_get_io_unit_size(bs);
+	uint64_t units = n * spdk_bs_get_cluster_size(bs) / iou;
+	struct spdk_blob_opts opts;
+	struct spdk_blob *blob;
+	uint8_t *buf = malloc(units * iou);
+
+	SPDK_CU_ASSERT_FATAL(buf != NULL);
+	memset(buf, 0xA5, units * iou);
+	ut_spdk_blob_opts_init(&opts);
+	opts.num_clusters = n;
+	opts.clear_method = BLOB_CLEAR_WITH_NONE;
+	blob = ut_blob_create_and_open(bs, &opts);
+	spdk_blob_io_write(blob, channel, buf, 0, units, blob_op_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	for (i = 0; i < n; i++) {
+		lbas[i] = blob->active.clusters[i];
+	}
+	ut_blob_close_and_delete(bs, blob);
+	free(buf);
+}
+
+static bool
+ut_buf_is(const uint8_t *buf, uint64_t len, uint8_t v)
+{
+	uint64_t i;
+
+	for (i = 0; i < len; i++) {
+		if (buf[i] != v) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+ut_read_cluster(struct spdk_blob *blob, struct spdk_io_channel *channel, uint64_t cluster,
+		uint8_t *buf)
+{
+	uint64_t upc = spdk_bs_get_cluster_size(blob->bs) / spdk_bs_get_io_unit_size(blob->bs);
+
+	spdk_blob_io_read(blob, channel, buf, cluster * upc, upc, blob_op_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+}
+
+/* Zero-on-allocate: a blob reads zeroes where it never wrote, although the
+ * free clusters it is given hold a deleted blob's data -- a thin blob (zeroes
+ * back device), a clone writing over a cluster its snapshot never allocated,
+ * and a thick blob, also after it grows; the thick blob's data survives the
+ * grow. SPDK_BS_ZERO_NEW_CLUSTERS=0 is the control: the deleted blob's 0xA5
+ * shows through (the leak seen on EC2 with uring bdevs). */
+static void
+blob_new_clusters_read_zeroes(void)
+{
+	struct spdk_blob_store *bs = g_bs;
+	struct spdk_io_channel *channel = spdk_bs_alloc_io_channel(bs);
+	uint64_t cluster_sz = spdk_bs_get_cluster_size(bs);
+	uint64_t iou = spdk_bs_get_io_unit_size(bs);
+	uint64_t upc = cluster_sz / iou, lbas[4], c;
+	uint8_t *one = malloc(iou), *buf = malloc(cluster_sz);
+	uint8_t stale;
+	struct spdk_blob_opts opts;
+	struct spdk_blob *blob, *snapshot;
+	int zero, kind;
+
+	SPDK_CU_ASSERT_FATAL(channel != NULL && one != NULL && buf != NULL);
+	memset(one, 0xC3, iou);
+	for (zero = 1; zero >= 0; zero--) {
+		setenv("SPDK_BS_ZERO_NEW_CLUSTERS", zero ? "1" : "0", 1);
+		stale = zero ? 0x00 : 0xA5;
+		/* kind 0: thin; 1: clone over an unallocated snapshot cluster; 2: thick */
+		for (kind = 0; kind < 3; kind++) {
+			ut_dirty_free_clusters(bs, channel, 4, lbas);
+			snapshot = NULL;
+			ut_spdk_blob_opts_init(&opts);
+			opts.thin_provision = kind != 2;
+			opts.num_clusters = kind == 2 ? 2 : 4;
+			blob = ut_blob_create_and_open(bs, &opts);
+			c = 0;
+			if (kind == 1) {
+				spdk_blob_io_write(blob, channel, one, 0, 1, blob_op_complete, NULL);
+				poll_threads();
+				CU_ASSERT(g_bserrno == 0);
+				spdk_bs_create_snapshot(bs, spdk_blob_get_id(blob), NULL,
+							blob_op_with_id_complete, NULL);
+				poll_threads();
+				CU_ASSERT(g_bserrno == 0);
+				spdk_bs_open_blob(bs, g_blobid, blob_op_with_handle_complete, NULL);
+				poll_threads();
+				CU_ASSERT(g_bserrno == 0);
+				SPDK_CU_ASSERT_FATAL(g_blob != NULL);
+				snapshot = g_blob;
+				g_blob = NULL;
+				c = 1;
+			}
+			if (kind != 2) {
+				spdk_blob_io_write(blob, channel, one, c * upc, 1, blob_op_complete, NULL);
+				poll_threads();
+				CU_ASSERT(g_bserrno == 0);
+			}
+			/* the setup's own check: the cluster read was the deleted blob's */
+			CU_ASSERT(blob->active.clusters[c] == lbas[c]);
+			ut_read_cluster(blob, channel, c, buf);
+			if (kind != 2) {
+				CU_ASSERT(ut_buf_is(buf, iou, 0xC3));
+				CU_ASSERT(ut_buf_is(buf + iou, cluster_sz - iou, stale));
+			} else {
+				CU_ASSERT(ut_buf_is(buf, cluster_sz, stale));
+				/* grow: the written unit survives, the new clusters read zeroes */
+				spdk_blob_io_write(blob, channel, one, 0, 1, blob_op_complete, NULL);
+				poll_threads();
+				CU_ASSERT(g_bserrno == 0);
+				spdk_blob_resize(blob, 4, blob_op_complete, NULL);
+				poll_threads();
+				CU_ASSERT(g_bserrno == 0);
+				spdk_blob_sync_md(blob, blob_op_complete, NULL);
+				poll_threads();
+				CU_ASSERT(g_bserrno == 0);
+				CU_ASSERT(blob->active.clusters[3] == lbas[3]);
+				ut_read_cluster(blob, channel, 0, buf);
+				CU_ASSERT(ut_buf_is(buf, iou, 0xC3));
+				ut_read_cluster(blob, channel, 3, buf);
+				CU_ASSERT(ut_buf_is(buf, cluster_sz, stale));
+			}
+			ut_blob_close_and_delete(bs, blob);
+			if (snapshot != NULL) {
+				ut_blob_close_and_delete(bs, snapshot);
+			}
+		}
+	}
+	unsetenv("SPDK_BS_ZERO_NEW_CLUSTERS");
+	free(one);
+	free(buf);
+	spdk_bs_free_io_channel(channel);
+	poll_threads();
+}
