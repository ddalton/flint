+/* The insert window (Flint, blob-alloc-window-order.patch): an allocation's
+ * insert maps the new cluster (blob_insert_cluster) BEFORE it persists the
+ * extent page, and only after that persist does the slot re-execute its
+ * waiters -- the write that started the allocation first. A write to the
+ * same cluster that arrives inside that window sees the cluster allocated and
+ * would go straight to the device, AHEAD of the earlier writes still parked
+ * on the slot; an earlier one to the same units then lands on top of it. One
+ * replica of a raid1 that hits the window ends with the older data, the
+ * others with the newer. Queue such a write on the slot instead, so writes to
+ * a cluster being allocated apply in arrival order.
+ * SPDK_BS_ORDER_ALLOC_WINDOW=0 restores the old behaviour (A/B, and the unit
+ * test's control). A write overlapping a parked write is logged every time
+ * ("overlaps a parked write": the divergence case); other window hits are
+ * counted and logged sparsely. */
+static uint64_t g_bs_alloc_window_hits;
+static uint64_t g_bs_alloc_window_overlaps;
+
+static bool
+bs_write_in_alloc_window(struct spdk_io_channel *_ch, struct spdk_blob *blob, uint64_t offset,
+			 uint64_t length, struct spdk_bs_cpl *cpl, enum spdk_blob_op_type op_type,
+			 void *payload, int iovcnt, struct spdk_blob_ext_io_opts *ext_io_opts)
+{
+	struct spdk_bs_channel *ch = spdk_io_channel_get_ctx(_ch);
+	struct spdk_bs_cluster_alloc_slot *slot;
+	spdk_bs_user_op_t *op, *parked = NULL;
+	const char *env;
+	bool order;
+
+	if (ch->alloc_slots_used == 0) {
+		return false;
+	}
+	slot = bs_find_alloc_slot(ch, blob, bs_io_unit_to_cluster_number(blob, offset));
+	if (slot == NULL) {
+		return false;
+	}
+	env = getenv("SPDK_BS_ORDER_ALLOC_WINDOW");
+	order = env == NULL || strcmp(env, "0") != 0;
+	g_bs_alloc_window_hits++;
+	TAILQ_FOREACH(op, &slot->waiters, link) {
+		if (op->u.user_op.offset < offset + length &&
+		    offset < op->u.user_op.offset + op->u.user_op.length) {
+			parked = op;
+			break;
+		}
+	}
+	if (parked != NULL) {
+		g_bs_alloc_window_overlaps++;
+		SPDK_NOTICELOG("alloc-window write overlaps a parked write: blob 0x%" PRIx64
+			       " io_unit %" PRIu64 "+%" PRIu64 " parked %" PRIu64 "+%" PRIu64
+			       " cluster %u: %s (overlap %" PRIu64 ", window hits %" PRIu64 ")\n",
+			       blob->id, offset, length, parked->u.user_op.offset,
+			       parked->u.user_op.length, slot->cluster_number,
+			       order ? "queued behind it" : "BYPASS, overtakes it",
+			       g_bs_alloc_window_overlaps, g_bs_alloc_window_hits);
+	} else if (g_bs_alloc_window_hits <= 20 || (g_bs_alloc_window_hits & 65535) == 0) {
+		SPDK_NOTICELOG("alloc-window write: blob 0x%" PRIx64 " io_unit %" PRIu64 "+%" PRIu64
+			       " cluster %u: %s (window hits %" PRIu64 ", overlaps %" PRIu64 ")\n",
+			       blob->id, offset, length, slot->cluster_number,
+			       order ? "queued" : "bypass", g_bs_alloc_window_hits,
+			       g_bs_alloc_window_overlaps);
+	}
+	if (!order) {
+		return false;
+	}
+	op = bs_user_op_alloc(_ch, cpl, op_type, blob, payload, iovcnt, offset, length);
+	if (!op) {
+		cpl->u.blob_basic.cb_fn(cpl->u.blob_basic.cb_arg, -ENOMEM);
+		return true;
+	}
+	op->ext_io_opts = ext_io_opts;
+	TAILQ_INSERT_TAIL(&slot->waiters, op, link);
+	return true;
+}
