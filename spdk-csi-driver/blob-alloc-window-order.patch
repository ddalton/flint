diff -ruN a/test/unit/lib/blob/blob.c/blob_ut.c b/test/unit/lib/blob/blob.c/blob_ut.c
--- a/test/unit/lib/blob/blob.c/blob_ut.c	2026-10-21 19:51:52.167218351 +0000
+++ b/test/unit/lib/blob/blob.c/blob_ut.c	2026-10-21 19:51:52.170218400 +0000
