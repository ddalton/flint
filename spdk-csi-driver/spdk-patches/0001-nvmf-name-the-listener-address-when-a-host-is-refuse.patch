From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dilip Dalton <dilipdalton@hotmail.com>
Date: Thu, 22 Oct 2026 21:59:50 +0000
Subject: [PATCH] nvmf: name the listener address when a host is refused

"Subsystem does not allow host to connect at this address" did not say
which address. Name the listener (trtype/traddr/trsvcid) so an
unexpected refusal can be traced to the listener that refused it.

test/unit/lib/nvmf/ctrlr.c/ctrlr_ut links no nvme transport code, so it
gets a spdk_nvme_transport_id_trtype_str stub (before 2026-11-02 the
patch had none and ctrlr_ut did not link; the image builds no unit
tests, so nothing noticed).

Flint-only (diagnostics).

Formerly spdk-csi-driver/nvmf-hostlog.patch.
---
 lib/nvmf/ctrlr.c                      | 5 +++--
 test/unit/lib/nvmf/ctrlr.c/ctrlr_ut.c | 4 ++++
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/lib/nvmf/ctrlr.c b/lib/nvmf/ctrlr.c
index 5d4ca6501..a8419d140 100644
--- a/lib/nvmf/ctrlr.c
+++ b/lib/nvmf/ctrlr.c
@@ -970,8 +970,9 @@ nvmf_qpair_access_allowed(struct spdk_nvmf_qpair *qpair, struct spdk_nvmf_subsys
 	}
 
 	if (!spdk_nvmf_subsystem_listener_allowed(subsystem, &listen_trid)) {
-		SPDK_ERRLOG("Subsystem '%s' does not allow host '%s' to connect at this address.\n",
-			    subsystem->subnqn, hostnqn);
+		SPDK_ERRLOG("Subsystem '%s' does not allow host '%s' to connect at this address. Listener address is %s/%s/%s\n",
+			    subsystem->subnqn, hostnqn, spdk_nvme_transport_id_trtype_str(listen_trid.trtype),
+			    listen_trid.traddr, listen_trid.trsvcid);
 		return false;
 	}
 
diff --git a/test/unit/lib/nvmf/ctrlr.c/ctrlr_ut.c b/test/unit/lib/nvmf/ctrlr.c/ctrlr_ut.c
index e50711a1f..b4cd91c36 100644
--- a/test/unit/lib/nvmf/ctrlr.c/ctrlr_ut.c
+++ b/test/unit/lib/nvmf/ctrlr.c/ctrlr_ut.c
@@ -88,6 +88,10 @@ DEFINE_STUB(spdk_nvmf_qpair_get_listen_trid,
 	    (struct spdk_nvmf_qpair *qpair, struct spdk_nvme_transport_id *trid),
 	    0);
 
+/* flint nvmf-hostlog.patch: the access-denied ERRLOG in nvmf_qpair_access_allowed()
+ * names the listener's transport; ctrlr_ut links no nvme transport code. */
+DEFINE_STUB(spdk_nvme_transport_id_trtype_str, const char *,
+	    (enum spdk_nvme_transport_type trtype), "TCP");
 DEFINE_STUB(spdk_nvmf_subsystem_listener_allowed,
 	    bool,
 	    (struct spdk_nvmf_subsystem *subsystem, const struct spdk_nvme_transport_id *trid),
