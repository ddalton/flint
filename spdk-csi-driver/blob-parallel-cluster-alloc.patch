diff --git a/test/unit/lib/blob/blob.c/blob_ut.c b/test/unit/lib/blob/blob.c/blob_ut.c
index 9c55cec5d..2b11f442b 100644
--- a/test/unit/lib/blob/blob.c/blob_ut.c
+++ b/test/unit/lib/blob/blob.c/blob_ut.c
@@ -5602,6 +5602,345 @@ bs_load_iter_test(void)
 	g_bs = NULL;
 }
 
+/*
+ * Parallel cluster allocation (F74 change 2). One channel may now have up to
+ * SPDK_BS_MAX_INFLIGHT_CLUSTER_ALLOCS cluster allocations in flight, one per
+ * cluster; ops for a cluster already being allocated wait on it. The test
+ * dev completes I/O by thread message, so between submission and
+ * poll_threads() the allocations are observably in flight.
+ */
+static int g_cow_done;
+static int g_cow_err;
+
+static void
+cow_op_complete(void *cb_arg, int bserrno)
+{
+	g_cow_done++;
+	if (bserrno != 0) {
+		g_cow_err = bserrno;
+	}
+}
+
+static uint32_t
+cow_queue_len(struct spdk_bs_channel *ch, struct spdk_bs_cluster_alloc_slot *slot)
+{
+	struct spdk_bs_request_set *set;
+	uint32_t n = 0;
+
+	if (slot != NULL) {
+		TAILQ_FOREACH(set, &slot->waiters, link) {
+			n++;
+		}
+	} else {
+		TAILQ_FOREACH(set, &ch->need_cluster_alloc, link) {
+			n++;
+		}
+	}
+	return n;
+}
+
+/* A thin blob of n clusters, every byte written 0xE5, then snapshotted: its
+ * clusters now belong to the snapshot and the next write to each one must
+ * allocate and copy. */
+static void
+ut_cow_blob_with_snapshot(struct spdk_blob_store *bs, struct spdk_io_channel *channel, uint32_t n,
+			  struct spdk_blob **blob, struct spdk_blob **snapshot)
+{
+	struct spdk_blob_opts opts;
+	uint64_t len = n * spdk_bs_get_cluster_size(bs);
+	uint8_t *buf = malloc(len);
+
+	SPDK_CU_ASSERT_FATAL(buf != NULL);
+	memset(buf, 0xE5, len);
+	ut_spdk_blob_opts_init(&opts);
+	opts.thin_provision = true;
+	opts.num_clusters = n;
+	*blob = ut_blob_create_and_open(bs, &opts);
+	spdk_blob_io_write(*blob, channel, buf, 0, len / spdk_bs_get_io_unit_size(bs),
+			   blob_op_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	free(buf);
+
+	spdk_bs_create_snapshot(bs, spdk_blob_get_id(*blob), NULL, blob_op_with_id_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	SPDK_CU_ASSERT_FATAL(g_blobid != SPDK_BLOBID_INVALID);
+	spdk_bs_open_blob(bs, g_blobid, blob_op_with_handle_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	SPDK_CU_ASSERT_FATAL(g_blob != NULL);
+	*snapshot = g_blob;
+}
+
+/* Read all n clusters of blob; caller frees. */
+static uint8_t *
+ut_cow_read_all(struct spdk_blob *blob, struct spdk_io_channel *channel, uint32_t n)
+{
+	struct spdk_blob_store *bs = blob->bs;
+	uint64_t len = n * spdk_bs_get_cluster_size(bs);
+	uint8_t *buf = malloc(len);
+
+	SPDK_CU_ASSERT_FATAL(buf != NULL);
+	memset(buf, 0, len);
+	spdk_blob_io_read(blob, channel, buf, 0, len / spdk_bs_get_io_unit_size(bs),
+			  blob_op_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	return buf;
+}
+
+/* Expected image: every byte 0xE5 except io unit `unit` of each cluster i
+ * with marks[i] set, which is 0xAA. */
+static uint8_t *
+ut_cow_expected(struct spdk_blob_store *bs, uint32_t n, const bool *marks, uint64_t unit)
+{
+	uint64_t csz = spdk_bs_get_cluster_size(bs);
+	uint64_t iou = spdk_bs_get_io_unit_size(bs);
+	uint8_t *buf = malloc(n * csz);
+	uint32_t i;
+
+	SPDK_CU_ASSERT_FATAL(buf != NULL);
+	memset(buf, 0xE5, n * csz);
+	for (i = 0; i < n; i++) {
+		if (marks[i]) {
+			memset(buf + i * csz + unit * iou, 0xAA, iou);
+		}
+	}
+	return buf;
+}
+
+static void
+blob_cow_parallel_clusters(void)
+{
+	struct spdk_blob_store *bs = g_bs;
+	struct spdk_io_channel *channel = spdk_bs_alloc_io_channel(bs);
+	struct spdk_bs_channel *ch = spdk_io_channel_get_ctx(channel);
+	struct spdk_blob *blob, *snapshot;
+	uint64_t iou = spdk_bs_get_io_unit_size(bs);
+	uint64_t cluster_io = spdk_bs_get_cluster_size(bs) / iou;
+	const uint32_t n = 4;
+	bool marks[4] = { true, true, true, true };
+	bool none[4] = { false, false, false, false };
+	uint64_t free_before;
+	uint8_t *w, *got, *want;
+	uint32_t i;
+
+	SPDK_CU_ASSERT_FATAL(cluster_io >= 2);
+	ut_cow_blob_with_snapshot(bs, channel, n, &blob, &snapshot);
+	free_before = spdk_bs_free_cluster_count(bs);
+
+	w = malloc(iou);
+	SPDK_CU_ASSERT_FATAL(w != NULL);
+	memset(w, 0xAA, iou);
+	g_cow_done = 0;
+	g_cow_err = 0;
+	for (i = 0; i < n; i++) {
+		spdk_blob_io_write(blob, channel, w, i * cluster_io + 1, 1, cow_op_complete, NULL);
+	}
+	/* All four allocations in flight together; none waits for another. */
+	CU_ASSERT(ch->alloc_slots_used == n);
+	CU_ASSERT(cow_queue_len(ch, NULL) == 0);
+	CU_ASSERT(g_cow_done == 0);
+
+	poll_threads();
+	CU_ASSERT(g_cow_done == (int)n);
+	CU_ASSERT(g_cow_err == 0);
+	CU_ASSERT(ch->alloc_slots_used == 0);
+	CU_ASSERT(free_before - spdk_bs_free_cluster_count(bs) == n);
+
+	/* The written unit is new; the rest of each cluster was copied. */
+	got = ut_cow_read_all(blob, channel, n);
+	want = ut_cow_expected(bs, n, marks, 1);
+	CU_ASSERT(memcmp(got, want, n * spdk_bs_get_cluster_size(bs)) == 0);
+	free(got);
+	free(want);
+	/* The snapshot did not change. */
+	got = ut_cow_read_all(snapshot, channel, n);
+	want = ut_cow_expected(bs, n, none, 1);
+	CU_ASSERT(memcmp(got, want, n * spdk_bs_get_cluster_size(bs)) == 0);
+	free(got);
+	free(want);
+
+	free(w);
+	ut_blob_close_and_delete(bs, blob);
+	ut_blob_close_and_delete(bs, snapshot);
+	spdk_bs_free_io_channel(channel);
+	poll_threads();
+}
+
+static void
+blob_cow_same_cluster_waits(void)
+{
+	struct spdk_blob_store *bs = g_bs;
+	struct spdk_io_channel *channel = spdk_bs_alloc_io_channel(bs);
+	struct spdk_bs_channel *ch = spdk_io_channel_get_ctx(channel);
+	struct spdk_bs_cluster_alloc_slot *slot;
+	struct spdk_blob *blob, *snapshot;
+	uint64_t iou = spdk_bs_get_io_unit_size(bs);
+	uint64_t csz = spdk_bs_get_cluster_size(bs);
+	const uint32_t n = 2;
+	bool marks[2] = { true, false };
+	uint64_t free_before;
+	uint8_t *w, *got, *want;
+
+	SPDK_CU_ASSERT_FATAL(csz / iou >= 3);
+	ut_cow_blob_with_snapshot(bs, channel, n, &blob, &snapshot);
+	free_before = spdk_bs_free_cluster_count(bs);
+
+	w = malloc(iou);
+	SPDK_CU_ASSERT_FATAL(w != NULL);
+	memset(w, 0xAA, iou);
+	g_cow_done = 0;
+	g_cow_err = 0;
+	spdk_blob_io_write(blob, channel, w, 1, 1, cow_op_complete, NULL);
+	spdk_blob_io_write(blob, channel, w, 2, 1, cow_op_complete, NULL);
+	/* One allocation of cluster 0; the second write waits on it rather than
+	 * allocating cluster 0 again. */
+	CU_ASSERT(ch->alloc_slots_used == 1);
+	slot = bs_find_alloc_slot(ch, blob, 0);
+	SPDK_CU_ASSERT_FATAL(slot != NULL);
+	CU_ASSERT(cow_queue_len(ch, slot) == 2);
+
+	poll_threads();
+	CU_ASSERT(g_cow_done == 2);
+	CU_ASSERT(g_cow_err == 0);
+	CU_ASSERT(ch->alloc_slots_used == 0);
+	CU_ASSERT(free_before - spdk_bs_free_cluster_count(bs) == 1);
+
+	got = ut_cow_read_all(blob, channel, n);
+	want = ut_cow_expected(bs, n, marks, 1);
+	memset(want + 2 * iou, 0xAA, iou);
+	CU_ASSERT(memcmp(got, want, n * csz) == 0);
+	free(got);
+	free(want);
+
+	free(w);
+	ut_blob_close_and_delete(bs, blob);
+	ut_blob_close_and_delete(bs, snapshot);
+	spdk_bs_free_io_channel(channel);
+	poll_threads();
+}
+
+static void
+blob_cow_slot_cap(void)
+{
+	struct spdk_blob_store *bs = g_bs;
+	struct spdk_io_channel *channel = spdk_bs_alloc_io_channel(bs);
+	struct spdk_bs_channel *ch = spdk_io_channel_get_ctx(channel);
+	struct spdk_blob *blob, *snapshot;
+	uint64_t iou = spdk_bs_get_io_unit_size(bs);
+	uint64_t cluster_io = spdk_bs_get_cluster_size(bs) / iou;
+	const uint32_t n = SPDK_BS_MAX_INFLIGHT_CLUSTER_ALLOCS + 2;
+	bool marks[SPDK_BS_MAX_INFLIGHT_CLUSTER_ALLOCS + 2];
+	uint8_t *w, *got, *want;
+	uint32_t i;
+
+	ut_cow_blob_with_snapshot(bs, channel, n, &blob, &snapshot);
+	w = malloc(iou);
+	SPDK_CU_ASSERT_FATAL(w != NULL);
+	memset(w, 0xAA, iou);
+	g_cow_done = 0;
+	g_cow_err = 0;
+	for (i = 0; i < n; i++) {
+		marks[i] = true;
+		spdk_blob_io_write(blob, channel, w, i * cluster_io + 1, 1, cow_op_complete, NULL);
+	}
+	/* Every slot taken; the last two wait, in order, for a slot. */
+	CU_ASSERT(ch->alloc_slots_used == SPDK_BS_MAX_INFLIGHT_CLUSTER_ALLOCS);
+	CU_ASSERT(cow_queue_len(ch, NULL) == 2);
+
+	poll_threads();
+	CU_ASSERT(g_cow_done == (int)n);
+	CU_ASSERT(g_cow_err == 0);
+	CU_ASSERT(ch->alloc_slots_used == 0);
+	CU_ASSERT(cow_queue_len(ch, NULL) == 0);
+
+	got = ut_cow_read_all(blob, channel, n);
+	want = ut_cow_expected(bs, n, marks, 1);
+	CU_ASSERT(memcmp(got, want, n * spdk_bs_get_cluster_size(bs)) == 0);
+	free(got);
+	free(want);
+
+	free(w);
+	ut_blob_close_and_delete(bs, blob);
+	ut_blob_close_and_delete(bs, snapshot);
+	spdk_bs_free_io_channel(channel);
+	poll_threads();
+}
+
+/* Allocations in flight when a snapshot of the blob starts. Freeze does not
+ * wait for in-flight I/O, so this was reachable before (one per channel,
+ * across channels); parallel allocation makes it several per channel. The
+ * head must read its writes, the new snapshot must hold each written unit
+ * either old or new (never anything else), and no cluster may leak. */
+static void
+blob_cow_inflight_across_snapshot(void)
+{
+	struct spdk_blob_store *bs = g_bs;
+	struct spdk_io_channel *channel = spdk_bs_alloc_io_channel(bs);
+	struct spdk_blob *blob, *snapshot, *snapshot2;
+	uint64_t iou = spdk_bs_get_io_unit_size(bs);
+	uint64_t csz = spdk_bs_get_cluster_size(bs);
+	uint64_t cluster_io = csz / iou;
+	const uint32_t n = 3;
+	bool marks[3] = { true, true, true };
+	uint64_t free_start = spdk_bs_free_cluster_count(bs);
+	uint8_t *w, *got, *want;
+	uint32_t i;
+	uint64_t b;
+
+	ut_cow_blob_with_snapshot(bs, channel, n, &blob, &snapshot);
+	w = malloc(iou);
+	SPDK_CU_ASSERT_FATAL(w != NULL);
+	memset(w, 0xAA, iou);
+	g_cow_done = 0;
+	g_cow_err = 0;
+	for (i = 0; i < n; i++) {
+		spdk_blob_io_write(blob, channel, w, i * cluster_io + 1, 1, cow_op_complete, NULL);
+	}
+	spdk_bs_create_snapshot(bs, spdk_blob_get_id(blob), NULL, blob_op_with_id_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_cow_done == (int)n);
+	CU_ASSERT(g_cow_err == 0);
+	CU_ASSERT(g_bserrno == 0);
+	SPDK_CU_ASSERT_FATAL(g_blobid != SPDK_BLOBID_INVALID);
+	spdk_bs_open_blob(bs, g_blobid, blob_op_with_handle_complete, NULL);
+	poll_threads();
+	SPDK_CU_ASSERT_FATAL(g_blob != NULL);
+	snapshot2 = g_blob;
+
+	got = ut_cow_read_all(blob, channel, n);
+	want = ut_cow_expected(bs, n, marks, 1);
+	CU_ASSERT(memcmp(got, want, n * csz) == 0);
+	free(got);
+	free(want);
+
+	got = ut_cow_read_all(snapshot2, channel, n);
+	for (i = 0; i < n; i++) {
+		uint8_t first = got[i * csz + iou];
+
+		CU_ASSERT(first == 0xAA || first == 0xE5);
+		for (b = 0; b < csz; b++) {
+			uint8_t expect = (b >= iou && b < 2 * iou) ? first : 0xE5;
+
+			if (got[i * csz + b] != expect) {
+				CU_FAIL("snapshot taken across in-flight allocations holds a torn cluster");
+				break;
+			}
+		}
+	}
+	free(got);
+
+	free(w);
+	ut_blob_close_and_delete(bs, blob);
+	ut_blob_close_and_delete(bs, snapshot2);
+	ut_blob_close_and_delete(bs, snapshot);
+	spdk_bs_free_io_channel(channel);
+	poll_threads();
+	CU_ASSERT(spdk_bs_free_cluster_count(bs) == free_start);
+}
