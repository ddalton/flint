+/* Cluster allocations (copy-on-write or first write to a thin cluster) one
+ * channel may have in flight at once. Each in-flight allocation holds one
+ * cluster-sized DMA buffer when it copies. */
+#define SPDK_BS_MAX_INFLIGHT_CLUSTER_ALLOCS 32
+
+/* One in-flight cluster allocation on a channel. Ops that need the SAME
+ * cluster wait on it; ops for other clusters start their own. */
+struct spdk_bs_cluster_alloc_slot {
+	struct spdk_blob		*blob;	/* NULL: slot free */
+	uint32_t			cluster_number;
+	/* Used only during insert of this slot's new cluster. */
+	struct spdk_blob_md_page	*new_cluster_page;
+	/* The op that started the allocation, then every op for the same
+	 * cluster; all re-execute when the allocation completes. */
+	TAILQ_HEAD(, spdk_bs_request_set) waiters;
+};
