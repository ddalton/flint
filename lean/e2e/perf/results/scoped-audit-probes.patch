+/// PROBE 2: out-of-scope paths that ARE on disk but absent from a scoped
+/// `baseline.entries` — does whole-tree sync delete them, clobber them,
+/// or protect them?
+#[tokio::test]
+async fn probe_scoped_baseline_out_of_scope_local_files() {
+    let store = Arc::new(MemoryStore::new());
+    let dir_a = tempfile::tempdir().unwrap();
+    let mut a = sidecar(&store, dir_a.path()).await;
+    assert!(claim_until_held(&mut a, 3).await);
+    a.checkout().await.unwrap();
+    write(dir_a.path(), "inputs/a.txt", "v1");
+    write(dir_a.path(), "outputs/killme.txt", "v1");
+    write(dir_a.path(), "outputs/clobber.txt", "v1");
+    a.run_barrier().await.unwrap();
+
+    // scoped checkout of `inputs/`: entries+prev_scan scoped, inst_base FULL.
+    {
+        let mut b = a.state.load_baseline().unwrap();
+        b.entries.retain(|p, _| p.starts_with("inputs/"));
+        b.prev_scan.retain(|p| p.starts_with("inputs/"));
+        a.state.save_baseline(&b).unwrap();
+    }
+    // ...but the two out-of-scope files are STILL ON DISK, untracked
+    // (agent-authored work, or residue of an earlier full checkout in
+    // the same emptyDir). Distinct local content.
+    write(dir_a.path(), "outputs/killme.txt", "AGENT WORK killme");
+    write(dir_a.path(), "outputs/clobber.txt", "AGENT WORK clobber");
+
+    // sibling: DELETE one, CHANGE the other.
+    let loaded = manifest::load(store.as_ref(), &a.cfg).await.unwrap().unwrap();
+    let mut theirs = loaded.manifest.clone();
+    theirs.seq += 1;
+    theirs.entries.remove("outputs/killme.txt");
+    {
+        let path = "outputs/clobber.txt";
+        let key = a.cfg.file_key(path);
+        let body = Bytes::from_static(b"foreign clobber v2");
+        let crc = crc64_nvme(&body);
+        let cur = store.head(&key).await.unwrap();
+        let meta = store
+            .put_whole(
+                &key,
+                body,
+                &PutCondition::IfMatch(cur.etag),
+                &GenerationStamps {
+                    generation: 2,
+                    epoch: 0,
+                    flush_uuid: "sibling".into(),
+                    boundary_source: None,
+                    posix: None,
+                },
+                crc,
+            )
+            .await
+            .unwrap();
+        let e = theirs.entries.get_mut(path).unwrap();
+        e.etag = meta.etag.clone();
+        e.crc64_b64 = meta.crc64_b64.clone();
+        e.size = meta.size;
+        e.generation = 2;
+    }
+    manifest::cas_write(store.as_ref(), &a.cfg, &theirs, Some(&loaded.handle()), 0, "sibling")
+        .await
+        .unwrap();
+
+    let r = a.sync().await.unwrap();
+    eprintln!("PROBE2 report: {}", serde_json::to_string(&r).unwrap());
+    eprintln!("PROBE2 killme:  {:?}", read(dir_a.path(), "outputs/killme.txt"));
+    eprintln!("PROBE2 clobber: {:?}", read(dir_a.path(), "outputs/clobber.txt"));
+    let cf = a.state.load_conflicts().unwrap();
+    eprintln!("PROBE2 conflicts: {:?}", cf.iter().map(|c| (&c.path, &c.kind)).collect::<Vec<_>>());
+    let b = a.state.load_baseline().unwrap();
+    eprintln!("PROBE2 after entries={:?}", b.entries.keys().collect::<Vec<_>>());
+    eprintln!("PROBE2 after inst_base={:?}", b.inst_base.keys().collect::<Vec<_>>());
+}
