+// ── FALSIFICATION PROBES (scoped-checkout proposal, inbox area) ───────
+// Temporary. Delete with the rest of this block.
+
+/// The barrier's own merge queues every out-of-scope foreign change into
+/// the inbox (`clear_window(..., &queue)`), and `consume_inbox` has no
+/// scope test of any kind: it MATERIALISES the path, adopts it CLEAN
+/// into `baseline.entries` AND `baseline.prev_scan`, and from that
+/// moment the workspace owns it. One `rm` of a file the agent never
+/// asked for publishes the delete and GC removes the object.
+#[tokio::test]
+async fn probe_inbox_widens_scope_then_deletes_the_object() {
+    let store = Arc::new(MemoryStore::new());
+    let dir = tempfile::tempdir().unwrap();
+    let mut a = sidecar(&store, dir.path()).await;
+    assert!(claim_until_held(&mut a, 3).await);
+    a.checkout().await.unwrap();
+
+    // A path that lives in the manifest, in a region a scoped checkout
+    // would NOT hold.
+    write(dir.path(), "other/big.bin", "somebody elses data");
+    a.run_barrier().await.unwrap();
+    let key = a.cfg.file_key("other/big.bin");
+    assert!(store.head(&key).await.is_ok(), "fixture: the object exists");
+
+    // Put the workspace in exactly the state a SCOPED checkout leaves:
+    // the path is cited by the manifest and present in `inst_base`
+    // (proposal point 3), but absent from `baseline.entries`, from
+    // `prev_scan`, and from the tree.
+    std::fs::remove_file(dir.path().join("other/big.bin")).unwrap();
+    let mut b = a.state.load_baseline().unwrap();
+    b.entries.remove("other/big.bin");
+    b.prev_scan.remove("other/big.bin");
+    assert!(b.inst_base.contains_key("other/big.bin"), "fixture: still the merge base");
+    a.state.save_baseline(&b).unwrap();
+
+    // A foreign write to the out-of-scope path lands an inbox entry —
+    // the same shape `clear_window` queues for a merge-preserved entry.
+    hitl_write(&store, &a.cfg, "other/big.bin", "v2 from elsewhere", "ui").await.unwrap();
+
+    let r = a.run_barrier().await.unwrap();
+    assert_eq!(r.consumed, 1);
+    assert_eq!(
+        read(dir.path(), "other/big.bin").as_deref(),
+        Some("v2 from elsewhere"),
+        "PROBE 1: consume materialised an out-of-scope path — the scope did not hold"
+    );
+    let b = a.state.load_baseline().unwrap();
+    assert!(b.entries.contains_key("other/big.bin"), "PROBE 2: baseline widened");
+    assert!(b.prev_scan.contains("other/big.bin"), "PROBE 3: prev_scan widened");
+
+    // The agent removes the file it never asked for.
+    std::fs::remove_file(dir.path().join("other/big.bin")).unwrap();
+    let r1 = a.run_barrier().await.unwrap();
+    let r2 = a.run_barrier().await.unwrap();
+    eprintln!("PROBE first_absence={:?} then deleted={:?}", r1.first_absence, r2.deleted);
+    assert!(
+        r2.deleted.contains(&"other/big.bin".to_string()),
+        "PROBE 4: the delete published"
+    );
+    assert!(
+        matches!(store.head(&key).await, Err(flint_store::StoreError::NotFound(_))),
+        "PROBE 5: the object another writer put there is GONE from the bucket"
+    );
+    let cs = a.state.load_conflicts().unwrap();
+    assert!(
+        !cs.iter().any(|c| c.path == "other/big.bin" && c.preserved_key.is_some()),
+        "PROBE 6: and nothing preserved a copy"
+    );
+}
