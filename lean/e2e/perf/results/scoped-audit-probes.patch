+/// PROBE: a SCOPED baseline (entries scoped, inst_base FULL — exactly
+/// what the proposed scoped checkout produces per checkout.rs:554/560)
+/// meeting a WHOLE-TREE `sync()`.
+#[tokio::test]
+async fn probe_scoped_baseline_vs_whole_tree_sync() {
+    let store = Arc::new(MemoryStore::new());
+    let dir_a = tempfile::tempdir().unwrap();
+    let mut a = sidecar(&store, dir_a.path()).await;
+    assert!(claim_until_held(&mut a, 3).await);
+    a.checkout().await.unwrap();
+    write(dir_a.path(), "inputs/a.txt", "v1");
+    write(dir_a.path(), "outputs/b.txt", "v1");
+    write(dir_a.path(), "outputs/c.txt", "v1");
+    write(dir_a.path(), "outputs/d.txt", "v1");
+    a.run_barrier().await.unwrap();
+
+    // --- simulate a SCOPED checkout of `inputs/` -------------------
+    // entries + prev_scan scoped; inst_base left FULL (checkout.rs:560).
+    {
+        let mut b = a.state.load_baseline().unwrap();
+        b.entries.retain(|p, _| p.starts_with("inputs/"));
+        b.prev_scan.retain(|p| p.starts_with("inputs/"));
+        a.state.save_baseline(&b).unwrap();
+        for p in ["outputs/b.txt", "outputs/c.txt", "outputs/d.txt"] {
+            std::fs::remove_file(dir_a.path().join(p)).unwrap();
+        }
+        let b = a.state.load_baseline().unwrap();
+        eprintln!("PROBE scoped baseline: entries={:?}", b.entries.keys().collect::<Vec<_>>());
+        eprintln!("PROBE scoped baseline: inst_base={:?}", b.inst_base.keys().collect::<Vec<_>>());
+    }
+
+    // --- a sibling changes ONE out-of-scope path and DELETES another -
+    let loaded = manifest::load(store.as_ref(), &a.cfg).await.unwrap().unwrap();
+    let mut theirs = loaded.manifest.clone();
+    theirs.seq += 1;
+    {
+        let path = "outputs/b.txt";
+        let key = a.cfg.file_key(path);
+        let body = Bytes::from_static(b"foreign b v2");
+        let crc = crc64_nvme(&body);
+        let cur = store.head(&key).await.unwrap();
+        let meta = store
+            .put_whole(
+                &key,
+                body,
+                &PutCondition::IfMatch(cur.etag),
+                &GenerationStamps {
+                    generation: 2,
+                    epoch: 0,
+                    flush_uuid: "sibling".into(),
+                    boundary_source: None,
+                    posix: None,
+                },
+                crc,
+            )
+            .await
+            .unwrap();
+        let e = theirs.entries.get_mut(path).unwrap();
+        e.etag = meta.etag.clone();
+        e.crc64_b64 = meta.crc64_b64.clone();
+        e.size = meta.size;
+        e.generation = 2;
+    }
+    theirs.entries.remove("outputs/d.txt");
+    manifest::cas_write(store.as_ref(), &a.cfg, &theirs, Some(&loaded.handle()), 0, "sibling")
+        .await
+        .unwrap();
+
+    // --- the whole-tree sync verb (CLI `sync`, UDS Sync, scope-less
+    //     sentinel) ------------------------------------------------
+    let r = a.sync().await.unwrap();
+    eprintln!("PROBE report: {}", serde_json::to_string(&r).unwrap());
+    for p in ["inputs/a.txt", "outputs/b.txt", "outputs/c.txt", "outputs/d.txt"] {
+        eprintln!("PROBE on-disk {p}: {:?}", read(dir_a.path(), p));
+    }
+    let b = a.state.load_baseline().unwrap();
+    eprintln!("PROBE after entries={:?}", b.entries.keys().collect::<Vec<_>>());
+    eprintln!("PROBE after prev_scan={:?}", b.prev_scan.iter().collect::<Vec<_>>());
+    eprintln!("PROBE after inst_base={:?}", b.inst_base.keys().collect::<Vec<_>>());
+    eprintln!("PROBE after seq={} metag={:?}", b.seq, b.manifest_etag);
+
+    // PREDICTION (the hazard): the out-of-scope CHANGED path is
+    // re-materialised; the out-of-scope UNCHANGED path is not.
+    assert_eq!(
+        read(dir_a.path(), "outputs/b.txt").as_deref(),
+        Some("foreign b v2"),
+        "PREDICTION FALSIFIED: sync did NOT re-materialise the out-of-scope changed path"
+    );
+    assert_eq!(
+        read(dir_a.path(), "outputs/c.txt"),
+        None,
+        "PREDICTION FALSIFIED: sync re-materialised an UNCHANGED out-of-scope path too"
+    );
+}
