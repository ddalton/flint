@!!BEGIN
@!!type:obligation
@!!id:5147
@!!loc:3382:3:3382:5
@!!status:failed
@!!prover:smt
@!!meth:time-limit: 60; time-used: 60.2 (100%)
@!!reason:timeout
@!!already:false
@!!obl:
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndM2 ,
       NEW CONSTANT s \in Writers,
       NEW CONSTANT h \in Handles,
       Sweep(s, h) ,
       Frame ,
       /\ h \in live /\ ~Cited(h)
       /\ SweepUnderLease => holder = s /\ w[s].pc \in {"claimed", "cased"}
       /\ GatewaySweepGrace => ~(\E p \in Paths : gw[p] = h)
       /\ ~(\E q \in w[s].upDone : (w[s].snap)[q] = h)
       /\ live' = live \ {h}
       /\ UNCHANGED <<minted, doc, gw, nextGen, copies, upped, w>> ,
       ~(\E p \in Paths : gw[p] = h) ,
       /\ gw \in [Paths -> Opt(Handles)] /\ doc \in [Paths -> Opt(Handles)]
          /\ nextGen \in Nat
       /\ holder \in Writers \cup {"none"} /\ live \subseteq Handles
          /\ minted \subseteq Handles ,
       w' = w => Wr("none", w) ,
       "none" \notin Writers 
PROVE  /\ (\A k \in Paths :
              (doc')[k] = doc[k] \/ (doc')[k] = Nil \/ (doc')[k] \in CitedSet
              \/ (doc')[k] \in {})
          /\ (\A k \in Paths :
                 (gw')[k] = gw[k] \/ (gw')[k] = Nil \/ (gw')[k] \notin minted)
          /\ ("none" \in Writers
              => (/\ \A q \in Paths :
                        (w.local)[q] = (w["none"].local)[q]
                        \/ (w.local)[q] = Nil \/ (w.local)[q] \notin minted
                        \/ (w.local)[q] \in CitedSet
                  /\ \A q \in Paths :
                        (w.snap)[q] = (w["none"].snap)[q]
                        \/ (w.snap)[q] = (w["none"].local)[q]
                        \/ (w.snap)[q] = Nil \/ (w.snap)[q] \notin minted))
          /\ Wr("none", w)
          /\ (\A h_1 \in live :
                 h_1 \notin live'
                 => (/\ ~Cited(h_1) /\ (\A k \in Paths : gw[k] # h_1)
                     /\ h_1 \in aged
                        \/ (\A u \in Writers :
                               holder = u
                               => (\A k \in w[u].upDone :
                                      (w[u].snap)[k] # h_1))))
       /\ minted \subseteq minted' /\ upped \subseteq upped'

@!!END

