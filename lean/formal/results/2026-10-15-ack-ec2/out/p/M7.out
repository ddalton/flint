       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
