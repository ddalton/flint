                    /\ W.pc \in IdleSet => ~W.instd
                    /\ W.instd => <<W.iseq, W.clk>> \in W.stamps
                    /\ W.bound.inst
                       => <<W.bound.seq, W.bound.clk>> \in W.stamps,
                  IndAK ,
                  NEW CONSTANT s \in Writers,
                  Install(s) ,
                  <1>w 
