@!!obl:
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW CONSTANT MaxTouches,
       NEW CONSTANT MaxNonces,
       NEW CONSTANT MaxDeposals,
       NEW CONSTANT InstallFenced,
       NEW CONSTANT DeletesUnderLease,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndAK ,
       NEW CONSTANT s \in Writers,
       /\ On(s) /\ s \in Readers /\ w[s].pc = "pulling"
       /\ \E fail \in SUBSET SyncAll(s) :
             /\ fails + Cardinality(fail) =< MaxFetchFails
             /\ w'
                = [w EXCEPT
                     ![s] = [st |-> w[s].st, pc |-> "idle",
                             local |-> [p \in Paths |->
                                          IF p \in SyncOwed(s, fail)
                                            THEN doc[p]
                                            ELSE (w[s].local)[p]],
                             baseline |-> SyncBl(s, fail),
                             integrated |-> w[s].integrated
                                            \cup {Gen(doc[p]) :
                                                    p
                                                    \in {q \in
                                                           SyncOwed(s, fail) :
                                                           doc[q] # Nil}},
                             uploads |-> w[s].uploads,
                             deletes |-> w[s].deletes, snap |-> w[s].snap,
                             upDone |-> w[s].upDone, gone |-> w[s].gone,
                             verified |-> w[s].verified, inst |-> w[s].inst,
                             retire |-> w[s].retire,
                             collected |-> w[s].collected, adv |-> w[s].adv,
                             synced |-> w[s].synced,
                             derived |-> IF fail # {} /\ SyncKeepsLeft
                                           THEN 0
                                           ELSE seq,
                             skipped |-> IF fail # {} /\ SyncKeepsLeft
                                           THEN {}
                                           ELSE {p \in Paths :
                                                   doc[p]
                                                   # SyncBl(s, fail)[p]
                                                   /\ (w[s].local)[p]
                                                      # SyncBl(s, fail)[p]
                                                   /\ Held(s, p)},
                             scope |-> w[s].scope, sStage |-> w[s].sStage,
                             sTgt |-> w[s].sTgt, sDrop |-> w[s].sDrop,
                             sKeep |-> w[s].sKeep, sHeld |-> w[s].sHeld,
                             unlinked |-> w[s].unlinked, memo |-> w[s].rnow,
                             rnow |-> w[s].rnow, nt |-> w[s].nt,
                             pend |-> w[s].pend, ack |-> w[s].ack,
                             car |-> w[s].car, cId |-> w[s].cId,
                             cFold |-> w[s].cFold, clk |-> w[s].clk,
                             iseq |-> w[s].iseq, instd |-> w[s].instd,
                             bound |-> w[s].bound, cN |-> w[s].cN,
                             aN |-> w[s].aN, capped |-> w[s].capped,
                             dset |-> w[s].dset, decl |-> w[s].decl,
                             dMint |-> w[s].dMint, moved |-> w[s].moved,
                             stamps |-> w[s].stamps, lost |-> w[s].lost,
                             deposed |-> w[s].deposed, nd |-> w[s].nd]]
             /\ fails' = fails + Cardinality(fail)
             /\ regressed'
                = (regressed \/ (\E p \in SyncOwed(s, fail) : Back(s, p)))
       /\ UNCHANGED <<bucket, nextGen, ui, reqs, barriers, restarts, syncs,
                      rescopes, upped, copies, orig>> ,
       NEW CONSTANT fail \in SUBSET SyncAll(s),
       /\ w[s].cN \ w[s].capped \subseteq w[s].pend.nonces \cup w[s].aN
       /\ w[s].pend.id = 0 => w[s].pend.nonces = {}
       /\ w[s].ack.nonces \subseteq w[s].aN
       /\ w[s].ack.st \in {"ok", "partial"} /\ w[s].ack.inst
          => <<w[s].ack.seq, w[s].ack.src>> \in w[s].stamps
       /\ w[s].pc \in IdleSet => ~w[s].instd
       /\ w[s].instd => <<w[s].iseq, w[s].clk>> \in w[s].stamps
       /\ w[s].bound.inst
          => <<w[s].bound.seq, w[s].bound.clk>> \in w[s].stamps 
PROVE  /\ [st |-> w[s].st, pc |-> "idle",
           local |-> [p \in Paths |->
                        IF p \in SyncOwed(s, fail)
                          THEN doc[p]
                          ELSE (w[s].local)[p]],
           baseline |-> SyncBl(s, fail),
           integrated |-> w[s].integrated
                          \cup {Gen(doc[p]) :
                                  p
                                  \in {q \in SyncOwed(s, fail) :
                                         doc[q] # Nil}},
           uploads |-> w[s].uploads, deletes |-> w[s].deletes,
           snap |-> w[s].snap, upDone |-> w[s].upDone, gone |-> w[s].gone,
           verified |-> w[s].verified, inst |-> w[s].inst,
           retire |-> w[s].retire, collected |-> w[s].collected,
           adv |-> w[s].adv, synced |-> w[s].synced,
           derived |-> IF fail # {} /\ SyncKeepsLeft THEN 0 ELSE seq,
           skipped |-> IF fail # {} /\ SyncKeepsLeft
                         THEN {}
                         ELSE {p \in Paths :
                                 doc[p] # SyncBl(s, fail)[p]
                                 /\ (w[s].local)[p] # SyncBl(s, fail)[p]
                                 /\ Held(s, p)},
           scope |-> w[s].scope, sStage |-> w[s].sStage, sTgt |-> w[s].sTgt,
           sDrop |-> w[s].sDrop, sKeep |-> w[s].sKeep, sHeld |-> w[s].sHeld,
           unlinked |-> w[s].unlinked, memo |-> w[s].rnow,
           rnow |-> w[s].rnow, nt |-> w[s].nt, pend |-> w[s].pend,
           ack |-> w[s].ack, car |-> w[s].car, cId |-> w[s].cId,
           cFold |-> w[s].cFold, clk |-> w[s].clk, iseq |-> w[s].iseq,
           instd |-> w[s].instd, bound |-> w[s].bound, cN |-> w[s].cN,
           aN |-> w[s].aN, capped |-> w[s].capped, dset |-> w[s].dset,
           decl |-> w[s].decl, dMint |-> w[s].dMint, moved |-> w[s].moved,
           stamps |-> w[s].stamps, lost |-> w[s].lost,
           deposed |-> w[s].deposed, nd |-> w[s].nd].cN
          \ [st |-> w[s].st, pc |-> "idle",
             local |-> [p \in Paths |->
                          IF p \in SyncOwed(s, fail)
                            THEN doc[p]
                            ELSE (w[s].local)[p]],
             baseline |-> SyncBl(s, fail),
             integrated |-> w[s].integrated
                            \cup {Gen(doc[p]) :
                                    p
                                    \in {q \in SyncOwed(s, fail) :
                                           doc[q] # Nil}},
             uploads |-> w[s].uploads, deletes |-> w[s].deletes,
             snap |-> w[s].snap, upDone |-> w[s].upDone, gone |-> w[s].gone,
             verified |-> w[s].verified, inst |-> w[s].inst,
             retire |-> w[s].retire, collected |-> w[s].collected,
             adv |-> w[s].adv, synced |-> w[s].synced,
             derived |-> IF fail # {} /\ SyncKeepsLeft THEN 0 ELSE seq,
             skipped |-> IF fail # {} /\ SyncKeepsLeft
                           THEN {}
                           ELSE {p \in Paths :
                                   doc[p] # SyncBl(s, fail)[p]
                                   /\ (w[s].local)[p] # SyncBl(s, fail)[p]
                                   /\ Held(s, p)},
             scope |-> w[s].scope, sStage |-> w[s].sStage,
             sTgt |-> w[s].sTgt, sDrop |-> w[s].sDrop, sKeep |-> w[s].sKeep,
             sHeld |-> w[s].sHeld, unlinked |-> w[s].unlinked,
             memo |-> w[s].rnow, rnow |-> w[s].rnow, nt |-> w[s].nt,
             pend |-> w[s].pend, ack |-> w[s].ack, car |-> w[s].car,
             cId |-> w[s].cId, cFold |-> w[s].cFold, clk |-> w[s].clk,
             iseq |-> w[s].iseq, instd |-> w[s].instd, bound |-> w[s].bound,
             cN |-> w[s].cN, aN |-> w[s].aN, capped |-> w[s].capped,
             dset |-> w[s].dset, decl |-> w[s].decl, dMint |-> w[s].dMint,
             moved |-> w[s].moved, stamps |-> w[s].stamps,
             lost |-> w[s].lost, deposed |-> w[s].deposed, nd |-> w[s].nd].capped
          \subseteq [st |-> w[s].st, pc |-> "idle",
                     local |-> [p \in Paths |->
                                  IF p \in SyncOwed(s, fail)
                                    THEN doc[p]
                                    ELSE (w[s].local)[p]],
                     baseline |-> SyncBl(s, fail),
                     integrated |-> w[s].integrated
                                    \cup {Gen(doc[p]) :
                                            p
                                            \in {q \in SyncOwed(s, fail) :
                                                   doc[q] # Nil}},
                     uploads |-> w[s].uploads, deletes |-> w[s].deletes,
                     snap |-> w[s].snap, upDone |-> w[s].upDone,
                     gone |-> w[s].gone, verified |-> w[s].verified,
                     inst |-> w[s].inst, retire |-> w[s].retire,
                     collected |-> w[s].collected, adv |-> w[s].adv,
                     synced |-> w[s].synced,
                     derived |-> IF fail # {} /\ SyncKeepsLeft
                                   THEN 0
                                   ELSE seq,
                     skipped |-> IF fail # {} /\ SyncKeepsLeft
                                   THEN {}
                                   ELSE {p \in Paths :
                                           doc[p] # SyncBl(s, fail)[p]
                                           /\ (w[s].local)[p]
                                              # SyncBl(s, fail)[p]
                                           /\ Held(s, p)},
                     scope |-> w[s].scope, sStage |-> w[s].sStage,
                     sTgt |-> w[s].sTgt, sDrop |-> w[s].sDrop,
                     sKeep |-> w[s].sKeep, sHeld |-> w[s].sHeld,
                     unlinked |-> w[s].unlinked, memo |-> w[s].rnow,
                     rnow |-> w[s].rnow, nt |-> w[s].nt, pend |-> w[s].pend,
                     ack |-> w[s].ack, car |-> w[s].car, cId |-> w[s].cId,
                     cFold |-> w[s].cFold, clk |-> w[s].clk,
                     iseq |-> w[s].iseq, instd |-> w[s].instd,
                     bound |-> w[s].bound, cN |-> w[s].cN, aN |-> w[s].aN,
                     capped |-> w[s].capped, dset |-> w[s].dset,
                     decl |-> w[s].decl, dMint |-> w[s].dMint,
                     moved |-> w[s].moved, stamps |-> w[s].stamps,
                     lost |-> w[s].lost, deposed |-> w[s].deposed,
                     nd |-> w[s].nd].pend.nonces
                    \cup [st |-> w[s].st, pc |-> "idle",
                          local |-> [p \in Paths |->
                                       IF p \in SyncOwed(s, fail)
                                         THEN doc[p]
                                         ELSE (w[s].local)[p]],
                          baseline |-> SyncBl(s, fail),
                          integrated |-> w[s].integrated
                                         \cup {Gen(doc[p]) :
                                                 p
