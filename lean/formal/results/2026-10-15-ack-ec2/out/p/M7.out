@!!BEGIN
@!!type:obligation
@!!id:176
@!!loc:195:3:195:5
@!!status:being proved
@!!prover:smt
@!!meth:time-limit: 60
@!!obl:
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW CONSTANT MaxTouches,
       NEW CONSTANT MaxNonces,
       NEW CONSTANT MaxDeposals,
       NEW CONSTANT InstallFenced,
       NEW CONSTANT DeletesUnderLease,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndAK ,
       NEW CONSTANT s \in Writers,
       /\ On(s) /\ w[s].pc = "claimed" /\ (InstallFenced => holder = s)
          /\ w[s].verified
       /\ /\ doc' = InstallInst(s)
          /\ seq' = (IF InstallInst(s) = doc THEN seq ELSE seq + 1)
          /\ tomb'
             = [p \in Paths |->
                  IF InstallInst(s)[p] # Nil
                    THEN Nil
                    ELSE IF doc[p] # Nil THEN doc[p] ELSE tomb[p]]
          /\ conflicts'
             = conflicts \cup {<<p, (w[s].snap)[p]>> : p \in w[s].gone}
               \cup {<<p, doc[p]>> : p \in InstallContested(s)}
               \cup {<<p, DeletedAt(s, p)>> : p \in InstallDelOverridden(s)}
               \cup {<<p, doc[p]>> : p \in InstallDelOver(s)}
          /\ w'
             = [w EXCEPT
                  ![s] = [st |-> w[s].st, pc |-> "cased",
                          local |-> w[s].local, baseline |-> w[s].baseline,
                          integrated |-> w[s].integrated,
                          uploads |-> w[s].uploads, deletes |-> w[s].deletes,
                          snap |-> w[s].snap,
                          upDone |-> w[s].upDone \ w[s].gone,
                          gone |-> w[s].gone, verified |-> w[s].verified,
                          inst |-> InstallInst(s),
                          retire |-> InstallRetired(s),
                          collected |-> InstallRetired(s) = {},
                          adv |-> IF CommitAdvanceGuarded
                                    THEN seq = w[s].derived
                                    ELSE TRUE,
                          synced |-> w[s].synced, derived |-> w[s].derived,
                          skipped |-> w[s].skipped, scope |-> w[s].scope,
                          sStage |-> w[s].sStage, sTgt |-> w[s].sTgt,
                          sDrop |-> w[s].sDrop, sKeep |-> w[s].sKeep,
                          sHeld |-> w[s].sHeld, unlinked |-> w[s].unlinked,
                          memo |-> w[s].memo, rnow |-> w[s].rnow,
                          nt |-> w[s].nt, pend |-> w[s].pend,
                          ack |-> w[s].ack,
                          car |-> IF w[s].cId # 0 /\ ~InstallNothing(s)
                                    THEN InstallCar(s)
                                    ELSE w[s].car,
                          cId |-> w[s].cId, cFold |-> w[s].cFold,
                          clk |-> w[s].clk,
                          iseq |-> IF w[s].cId # 0
                                     THEN IF InstallNothing(s)
                                            THEN seq
                                            ELSE seq + 1
                                     ELSE w[s].iseq,
                          instd |-> IF w[s].cId # 0
                                      THEN ~InstallNothing(s)
                                      ELSE w[s].instd,
                          bound |-> w[s].bound, cN |-> w[s].cN,
                          aN |-> w[s].aN, capped |-> w[s].capped,
                          dset |-> w[s].dset, decl |-> w[s].decl,
                          dMint |-> w[s].dMint, moved |-> w[s].moved,
                          stamps |-> IF w[s].cId # 0 /\ ~InstallNothing(s)
                                       THEN w[s].stamps
                                            \cup {<<seq + 1, w[s].clk>>}
                                       ELSE w[s].stamps,
                          lost |-> IF MaxTouches > 0
                                     THEN w[s].lost
                                          \cup {(w[s].snap)[p] :
                                                  p \in w[s].gone}
                                     ELSE w[s].lost,
                          deposed |-> w[s].deposed, nd |-> w[s].nd]]
          /\ udel'
             = udel
               \cup {<<p, doc[p]>> :
                       p
                       \in {q \in Paths :
                              doc[q] # Nil /\ InstallInst(s)[q] = Nil}}
       /\ UNCHANGED <<live, minted, base, acked, holder, gw, mv, nextGen, ui,
                      reqs, barriers, aux>> ,
       /\ w[s].cN \ w[s].capped \subseteq w[s].pend.nonces \cup w[s].aN
       /\ w[s].pend.id = 0 => w[s].pend.nonces = {}
       /\ w[s].ack.nonces \subseteq w[s].aN
       /\ w[s].ack.st \in {"ok", "partial"} /\ w[s].ack.inst
          => <<w[s].ack.seq, w[s].ack.src>> \in w[s].stamps
       /\ w[s].pc \in IdleSet => ~w[s].instd
       /\ w[s].instd => <<w[s].iseq, w[s].clk>> \in w[s].stamps
       /\ w[s].bound.inst
          => <<w[s].bound.seq, w[s].bound.clk>> \in w[s].stamps 
PROVE  /\ [st |-> w[s].st, pc |-> "cased", local |-> w[s].local,
           baseline |-> w[s].baseline, integrated |-> w[s].integrated,
           uploads |-> w[s].uploads, deletes |-> w[s].deletes,
           snap |-> w[s].snap, upDone |-> w[s].upDone \ w[s].gone,
           gone |-> w[s].gone, verified |-> w[s].verified,
           inst |-> InstallInst(s), retire |-> InstallRetired(s),
           collected |-> InstallRetired(s) = {},
           adv |-> IF CommitAdvanceGuarded THEN seq = w[s].derived ELSE TRUE,
           synced |-> w[s].synced, derived |-> w[s].derived,
           skipped |-> w[s].skipped, scope |-> w[s].scope,
           sStage |-> w[s].sStage, sTgt |-> w[s].sTgt, sDrop |-> w[s].sDrop,
           sKeep |-> w[s].sKeep, sHeld |-> w[s].sHeld,
           unlinked |-> w[s].unlinked, memo |-> w[s].memo,
           rnow |-> w[s].rnow, nt |-> w[s].nt, pend |-> w[s].pend,
           ack |-> w[s].ack,
           car |-> IF w[s].cId # 0 /\ ~InstallNothing(s)
                     THEN InstallCar(s)
                     ELSE w[s].car,
           cId |-> w[s].cId, cFold |-> w[s].cFold, clk |-> w[s].clk,
           iseq |-> IF w[s].cId # 0
                      THEN IF InstallNothing(s) THEN seq ELSE seq + 1
                      ELSE w[s].iseq,
           instd |-> IF w[s].cId # 0 THEN ~InstallNothing(s) ELSE w[s].instd,
           bound |-> w[s].bound, cN |-> w[s].cN, aN |-> w[s].aN,
           capped |-> w[s].capped, dset |-> w[s].dset, decl |-> w[s].decl,
           dMint |-> w[s].dMint, moved |-> w[s].moved,
           stamps |-> IF w[s].cId # 0 /\ ~InstallNothing(s)
                        THEN w[s].stamps \cup {<<seq + 1, w[s].clk>>}
                        ELSE w[s].stamps,
           lost |-> IF MaxTouches > 0
                      THEN w[s].lost \cup {(w[s].snap)[p] : p \in w[s].gone}
                      ELSE w[s].lost,
           deposed |-> w[s].deposed, nd |-> w[s].nd].cN
          \ [st |-> w[s].st, pc |-> "cased", local |-> w[s].local,
             baseline |-> w[s].baseline, integrated |-> w[s].integrated,
             uploads |-> w[s].uploads, deletes |-> w[s].deletes,
             snap |-> w[s].snap, upDone |-> w[s].upDone \ w[s].gone,
             gone |-> w[s].gone, verified |-> w[s].verified,
             inst |-> InstallInst(s), retire |-> InstallRetired(s),
             collected |-> InstallRetired(s) = {},
             adv |-> IF CommitAdvanceGuarded
                       THEN seq = w[s].derived
                       ELSE TRUE,
             synced |-> w[s].synced, derived |-> w[s].derived,
             skipped |-> w[s].skipped, scope |-> w[s].scope,
             sStage |-> w[s].sStage, sTgt |-> w[s].sTgt,
             sDrop |-> w[s].sDrop, sKeep |-> w[s].sKeep,
             sHeld |-> w[s].sHeld, unlinked |-> w[s].unlinked,
             memo |-> w[s].memo, rnow |-> w[s].rnow, nt |-> w[s].nt,
             pend |-> w[s].pend, ack |-> w[s].ack,
             car |-> IF w[s].cId # 0 /\ ~InstallNothing(s)
                       THEN InstallCar(s)
                       ELSE w[s].car,
             cId |-> w[s].cId, cFold |-> w[s].cFold, clk |-> w[s].clk,
             iseq |-> IF w[s].cId # 0
                        THEN IF InstallNothing(s) THEN seq ELSE seq + 1
                        ELSE w[s].iseq,
             instd |-> IF w[s].cId # 0
                         THEN ~InstallNothing(s)
                         ELSE w[s].instd,
             bound |-> w[s].bound, cN |-> w[s].cN, aN |-> w[s].aN,
             capped |-> w[s].capped, dset |-> w[s].dset, decl |-> w[s].decl,
             dMint |-> w[s].dMint, moved |-> w[s].moved,
             stamps |-> IF w[s].cId # 0 /\ ~InstallNothing(s)
                          THEN w[s].stamps \cup {<<seq + 1, w[s].clk>>}
                          ELSE w[s].stamps,
             lost |-> IF MaxTouches > 0
                        THEN w[s].lost
                             \cup {(w[s].snap)[p] : p \in w[s].gone}
                        ELSE w[s].lost,
             deposed |-> w[s].deposed, nd |-> w[s].nd].capped
          \subseteq [st |-> w[s].st, pc |-> "cased", local |-> w[s].local,
                     baseline |-> w[s].baseline,
                     integrated |-> w[s].integrated,
                     uploads |-> w[s].uploads, deletes |-> w[s].deletes,
                     snap |-> w[s].snap, upDone |-> w[s].upDone \ w[s].gone,
                     gone |-> w[s].gone, verified |-> w[s].verified,
                     inst |-> InstallInst(s), retire |-> InstallRetired(s),
                     collected |-> InstallRetired(s) = {},
                     adv |-> IF CommitAdvanceGuarded
                               THEN seq = w[s].derived
