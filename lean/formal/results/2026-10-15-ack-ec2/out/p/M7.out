       NEW CONSTANT DeletesUnderLease,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
