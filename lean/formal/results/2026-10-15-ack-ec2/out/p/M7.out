       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndAK ,
       NEW CONSTANT s \in Writers,
       /\ On(s) /\ w[s].pc = "scanned"
       /\ w[s].uploads \subseteq w[s].upDone
       /\ w[s].uploads \cup w[s].deletes # {}
       /\ holder = "none"
       /\ holder' = s
       /\ w'
          = [w EXCEPT
               ![s] = [st |-> w[s].st, pc |-> "claimed",
                       local |-> w[s].local, baseline |-> w[s].baseline,
                       integrated |-> w[s].integrated,
                       uploads |-> w[s].uploads, deletes |-> w[s].deletes,
                       snap |-> w[s].snap, upDone |-> w[s].upDone,
                       gone |-> w[s].gone, verified |-> w[s].verified,
