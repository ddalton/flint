       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndC ,
       \/ (GatewayStep \/ WriterStep) /\ TookUpdate /\ RetUpdate /\ AncUpdate
          /\ UNCHANGED <<aged, ages, rdoc, rlag>>
       \/ (Age \/ RLoad \/ (\E s \in Writers, h \in Handles : Reap(s, h)))
          /\ UNCHANGED anc ,
       ASSUME GatewayStep 
       PROVE  NRPre ,
       ASSUME Age \/ RLoad
              \/ (\E s \in Writers, h \in Handles : Reap(s, h) \/ Sweep(s, h)) 
       PROVE  NRPre ,
       ASSUME WriterStep /\ ~(\E s \in Writers, h \in Handles : Sweep(s, h)) 
       PROVE  NRPre 
PROVE  NRPre

@!!END

