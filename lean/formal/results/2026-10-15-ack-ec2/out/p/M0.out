@!!BEGIN
@!!type:obligation
@!!id:2019
@!!loc:1579:28:1579:30
@!!status:failed
@!!prover:smt
@!!meth:time-limit: 60; time-used: 60.0 (100%)
@!!reason:internal timeout
@!!already:false
@!!obl:
\* internal timeout while processing obligation
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW CONSTANT MaxTouches,
       NEW CONSTANT MaxNonces,
       NEW CONSTANT MaxDeposals,
       NEW CONSTANT InstallFenced,
       NEW CONSTANT DeletesUnderLease,
       Opt(S) == S \cup {Nil},
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       Writer ==
         [st : {"off", "on"},
          pc : {"idle", "consumed", "scanned", "claimed", "cased", "pulling"},
          local : [Paths -> Opt(Handles)],
          baseline : [Paths -> Opt(Handles)], integrated : SUBSET Gens,
          uploads : SUBSET Paths, deletes : SUBSET Paths,
          snap : [Paths -> Opt(Handles)], upDone : SUBSET Paths,
          gone : SUBSET Paths, verified : BOOLEAN,
          inst : [Paths -> Opt(Handles)], retire : SUBSET Handles,
          collected : BOOLEAN, adv : BOOLEAN, synced : Nat, derived : Nat,
          skipped : SUBSET Paths, scope : SUBSET Paths,
          sStage : {"none", "saved", "mid"}, sTgt : SUBSET Paths,
          sDrop : SUBSET Paths, sKeep : SUBSET Paths,
          sHeld : [Paths -> Opt(Handles)], unlinked : SUBSET Paths,
          memo : Nat, rnow : Nat, nt : Nat,
          pend : [id : Nat, fold : Nat, nonces : SUBSET Nat],
          ack : [st : {"none", "ok", "partial", "refused-read-only"},
                 nonces : SUBSET Nat, seq : Nat, src : Clocks \cup {"none"},
                 dropped : SUBSET Paths, inst : BOOLEAN],
          car : [id : Nat, paths : SUBSET Paths, deletes : SUBSET Paths,
                 dropped : SUBSET Paths, uncited : SUBSET Paths,
                 pub : [Paths -> Opt(Handles)]],
          cId : Nat, cFold : Nat, clk : Clocks \cup {"none"}, iseq : Nat,
          instd : BOOLEAN,
          bound : [id : Nat, fold : Nat, doc : [Paths -> Opt(Handles)],
                   seq : Nat, wd : SUBSET Paths, inst : BOOLEAN,
                   clk : Clocks \cup {"none"}],
          cN : SUBSET Nat, aN : SUBSET Nat, capped : SUBSET Nat,
          dset : SUBSET Paths, decl : [Paths -> Opt(Handles)],
          dMint : [Paths -> Nat], moved : SUBSET Paths,
          stamps : SUBSET Nat \X (Clocks \cup {"none"}),
          lost : SUBSET Opt(Handles), deposed : BOOLEAN, nd : Nat],
       TouchW(s) ==
         [st |-> w[s].st, pc |-> w[s].pc, local |-> w[s].local,
          baseline |-> w[s].baseline, integrated |-> w[s].integrated,
          uploads |-> w[s].uploads, deletes |-> w[s].deletes,
          snap |-> w[s].snap, upDone |-> w[s].upDone, gone |-> w[s].gone,
          verified |-> w[s].verified, inst |-> w[s].inst,
          retire |-> w[s].retire, collected |-> w[s].collected,
          adv |-> w[s].adv, synced |-> w[s].synced, derived |-> w[s].derived,
          skipped |-> w[s].skipped, scope |-> w[s].scope,
          sStage |-> w[s].sStage, sTgt |-> w[s].sTgt, sDrop |-> w[s].sDrop,
          sKeep |-> w[s].sKeep, sHeld |-> w[s].sHeld,
          unlinked |-> w[s].unlinked, memo |-> w[s].memo, rnow |-> w[s].rnow,
          nt |-> TouchN(s),
          pend |-> [id |-> IF TouchFresh(s) THEN TouchN(s) ELSE w[s].pend.id,
                    fold |-> TouchN(s), nonces |-> TouchKept(s)],
          ack |-> w[s].ack, car |-> w[s].car, cId |-> w[s].cId,
          cFold |-> w[s].cFold, clk |-> w[s].clk, iseq |-> w[s].iseq,
          instd |-> w[s].instd, bound |-> w[s].bound,
          cN |-> w[s].cN \cup {TouchN(s)}, aN |-> w[s].aN,
          capped |-> w[s].capped \cup (TouchNs(s) \ TouchKept(s)),
          dset |-> (IF TouchFresh(s) THEN {} ELSE w[s].dset)
                   \cup TouchDirty(s),
          decl |-> [p \in Paths |->
                      IF p \in TouchDirty(s)
                        THEN (w[s].local)[p]
                        ELSE IF TouchFresh(s) THEN Nil ELSE (w[s].decl)[p]],
          dMint |-> [p \in Paths |->
                       IF p \in TouchDirty(s)
                         THEN nextGen
                         ELSE IF TouchFresh(s) THEN 0 ELSE (w[s].dMint)[p]],
          moved |-> (IF TouchFresh(s) THEN {} ELSE w[s].moved)
                    \ TouchDirty(s),
          stamps |-> w[s].stamps, lost |-> w[s].lost,
          deposed |-> w[s].deposed, nd |-> w[s].nd],
       ShippedShape == Shipped,
       FreePaths == Free \subseteq Paths,
       MaxMintNat == MaxMint \in Nat /\ MaxMint >= 1,
       ScopesPaths == Scopes \subseteq SUBSET Paths /\ Scopes # {},
       ReadersWriters == Readers \subseteq Writers,
       NilHandle == Nil \notin Handles,
       NoneWriter == "none" \notin Writers,
       MaxCopiesNat == MaxCopies \in Nat,
       PathsFinite == IsFiniteSet(Paths),
       TouchNat ==
         MaxTouches \in Nat /\ MaxNonces \in Nat /\ MaxNonces >= 1
         /\ MaxDeposals \in Nat,
       PendT == [id : Nat, fold : Nat, nonces : SUBSET Nat],
       AckT ==
         [st : {"none", "ok", "partial", "refused-read-only"},
          nonces : SUBSET Nat, seq : Nat, src : Clocks \cup {"none"},
          dropped : SUBSET Paths, inst : BOOLEAN],
       CarT ==
         [id : Nat, paths : SUBSET Paths, deletes : SUBSET Paths,
          dropped : SUBSET Paths, uncited : SUBSET Paths,
          pub : [Paths -> Opt(Handles)]],
       BoundT ==
         [id : Nat, fold : Nat, doc : [Paths -> Opt(Handles)], seq : Nat,
          wd : SUBSET Paths, inst : BOOLEAN, clk : Clocks \cup {"none"}],
       IndTypeOK ,
       NEW CONSTANT s \in Writers,
       Touch(s) ,
       Frame ,
       <1>0 ,
       <1>d ,
       <1>3 ,
       <1>4 ,
       WriterFields 
PROVE  TouchW(s) \in Writer

@!!END

