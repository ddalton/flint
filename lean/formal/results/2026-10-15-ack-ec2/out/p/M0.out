@!!loc:1111:3:1111:5
@!!status:being proved
@!!prover:smt
@!!meth:time-limit: 60
@!!obl:
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW CONSTANT MaxTouches,
       NEW CONSTANT MaxNonces,
       NEW CONSTANT MaxDeposals,
       NEW CONSTANT InstallFenced,
       NEW CONSTANT DeletesUnderLease,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndTypeOK ,
       NEW CONSTANT s \in Writers,
       Install(s) ,
       Frame ,
       w[s] \in Writer ,
       InstallInst(s) \in [Paths -> Opt(Handles)]
       /\ (\A p \in Paths : InstallInst(s)[p] \in Opt(minted)) ,
       ASSUME NEW CONSTANT W \in Writer
       PROVE  /\ W.st \in {"off", "on"}
              /\ W.pc
                 \in {"idle", "consumed", "scanned", "claimed", "cased",
                      "pulling"}
              /\ W.local \in [Paths -> Opt(Handles)]
              /\ W.baseline \in [Paths -> Opt(Handles)]
              /\ W.integrated \subseteq Gens
              /\ W.uploads \subseteq Paths /\ W.deletes \subseteq Paths
              /\ W.snap \in [Paths -> Opt(Handles)]
              /\ W.upDone \subseteq Paths /\ W.gone \subseteq Paths
                 /\ W.verified \in BOOLEAN
              /\ W.inst \in [Paths -> Opt(Handles)]
              /\ W.retire \subseteq Handles
              /\ W.collected \in BOOLEAN /\ W.adv \in BOOLEAN
              /\ W.synced \in Nat /\ W.derived \in Nat
              /\ W.skipped \subseteq Paths /\ W.scope \subseteq Paths
              /\ W.sStage \in {"none", "saved", "mid"}
              /\ W.sTgt \subseteq Paths /\ W.sDrop \subseteq Paths
                 /\ W.sKeep \subseteq Paths
              /\ W.sHeld \in [Paths -> Opt(Handles)]
              /\ W.unlinked \subseteq Paths
              /\ W.memo \in Nat /\ W.rnow \in Nat
              /\ W.nt \in Nat /\ W.pend \in PendT /\ W.ack \in AckT
                 /\ W.car
                    \in [id : Nat, paths : SUBSET Paths,
                         deletes : SUBSET Paths, dropped : SUBSET Paths,
                         uncited : SUBSET Paths,
                         pub : [Paths -> Opt(Handles)]]
              /\ W.cId \in Nat /\ W.cFold \in Nat
                 /\ W.clk \in Clocks \cup {"none"}
              /\ W.iseq \in Nat /\ W.instd \in BOOLEAN /\ W.bound \in BoundT
              /\ W.cN \subseteq Nat /\ W.aN \subseteq Nat
                 /\ W.capped \subseteq Nat
              /\ W.dset \subseteq Paths /\ W.decl \in [Paths -> Opt(Handles)]
                 /\ W.dMint \in [Paths -> Nat]
              /\ W.moved \subseteq Paths
                 /\ W.stamps \subseteq Nat \X (Clocks \cup {"none"})
              /\ W.lost \subseteq Opt(Handles) /\ W.deposed \in BOOLEAN
                 /\ W.nd \in Nat 
PROVE  [id |-> (IF w[s].car.id = w[s].cId
                  THEN w[s].car
                  ELSE [id |-> w[s].cId, paths |-> {}, deletes |-> {},
                        dropped |-> {}, uncited |-> {},
                        pub |-> [p \in Paths |-> Nil]]).id,
        paths |-> (IF w[s].car.id = w[s].cId
                     THEN w[s].car
                     ELSE [id |-> w[s].cId, paths |-> {}, deletes |-> {},
                           dropped |-> {}, uncited |-> {},
                           pub |-> [p \in Paths |-> Nil]]).paths
                  \cup w[s].uploads \cup w[s].deletes,
        deletes |-> ((IF w[s].car.id = w[s].cId
                        THEN w[s].car
                        ELSE [id |-> w[s].cId, paths |-> {}, deletes |-> {},
                              dropped |-> {}, uncited |-> {},
                              pub |-> [p \in Paths |-> Nil]]).deletes
                     \ w[s].uploads)
                    \cup w[s].deletes,
        dropped |-> (IF w[s].car.id = w[s].cId
                       THEN w[s].car
                       ELSE [id |-> w[s].cId, paths |-> {}, deletes |-> {},
                             dropped |-> {}, uncited |-> {},
                             pub |-> [p \in Paths |-> Nil]]).dropped
                    \cup w[s].gone
                    \cup {p \in w[s].deletes : InstallInst(s)[p] # Nil},
        uncited |-> (IF w[s].car.id = w[s].cId
                       THEN w[s].car
                       ELSE [id |-> w[s].cId, paths |-> {}, deletes |-> {},
                             dropped |-> {}, uncited |-> {},
                             pub |-> [p \in Paths |-> Nil]]).uncited,
        pub |-> [p \in Paths |->
                   IF p \in w[s].uploads \ w[s].gone
                     THEN (w[s].snap)[p]
                     ELSE IF p \in w[s].uploads \cup w[s].deletes
                            THEN Nil
                            ELSE ((IF w[s].car.id = w[s].cId
                                     THEN w[s].car
                                     ELSE [id |-> w[s].cId, paths |-> {},
                                           deletes |-> {}, dropped |-> {},
                                           uncited |-> {},
                                           pub |-> [p_1 \in Paths |-> Nil]]).pub)[p]]]
       \in [id : Nat, paths : SUBSET Paths, deletes : SUBSET Paths,
            dropped : SUBSET Paths, uncited : SUBSET Paths,
            pub : [Paths -> Opt(Handles)]]

@!!END

