@!!BEGIN
@!!type:obligation
@!!id:1166
@!!loc:1109:3:1109:5
@!!status:being proved
@!!prover:smt
@!!meth:time-limit: 60
@!!obl:
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW CONSTANT MaxTouches,
       NEW CONSTANT MaxNonces,
       NEW CONSTANT MaxDeposals,
       NEW CONSTANT InstallFenced,
       NEW CONSTANT DeletesUnderLease,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndTypeOK ,
       NEW CONSTANT s \in Writers,
       Install(s) ,
       Frame ,
       /\ live \subseteq Handles /\ minted \subseteq Handles
          /\ live \subseteq minted
       /\ doc \in [Paths -> Handles \cup {Nil}]
       /\ seq \in Nat
       /\ tomb \in [Paths -> Handles \cup {Nil}]
       /\ base \in [Handles -> Handles \cup {Nil}]
       /\ acked \subseteq Paths \X Handles
       /\ conflicts \subseteq Paths \X (Handles \cup {Nil})
       /\ holder \in Writers \cup {"none"}
       /\ nextGen \in Nat /\ ui \in Nat /\ reqs \in Nat /\ barriers \in Nat
       /\ w \in [Writers -> Writer]
       /\ took \in [Writers -> [Paths -> SUBSET Gens]]
       /\ gw \in [Paths -> Handles \cup {Nil}]
       /\ mv \in Paths \X Handles \cup {Nil}
       /\ udel \subseteq Paths \X Handles
       /\ restarts \in Nat /\ syncs \in Nat /\ regressed \in BOOLEAN
          /\ rescopes \in Nat /\ fails \in Nat
       /\ retiring \subseteq Handles /\ aged \subseteq Handles
          /\ ages \in Nat
       /\ rdoc \in [Paths -> Handles \cup {Nil}] /\ rlag \in BOOLEAN
       /\ anc \in [Handles -> SUBSET Handles] ,
       w[s] \in Writer ,
       /\ doc' = InstallInst(s)
       /\ seq' = (IF InstallInst(s) = doc THEN seq ELSE seq + 1)
       /\ tomb'
          = [p \in Paths |->
               IF InstallInst(s)[p] # Nil
                 THEN Nil
                 ELSE IF doc[p] # Nil THEN doc[p] ELSE tomb[p]]
       /\ conflicts'
          = conflicts \cup {<<p, (w[s].snap)[p]>> : p \in w[s].gone}
            \cup {<<p, doc[p]>> :
                    p
                    \in IF CommitSurfacesForeign
                          THEN {p \in
                                  (w[s].uploads \cap w[s].upDone) \ w[s].gone :
                                  Foreign(s, p) /\ doc[p] # Nil}
                          ELSE {}}
            \cup {<<p,
                    IF tomb[p] # Nil THEN tomb[p] ELSE (w[s].baseline)[p]>> :
                    p
                    \in IF CommitRecordsDeleteOverride
                          THEN {p \in
                                  (w[s].uploads \cap w[s].upDone) \ w[s].gone :
                                  Foreign(s, p) /\ doc[p] = Nil
                                  /\ (w[s].baseline)[p] # Nil}
                          ELSE {}}
            \cup {<<p, doc[p]>> :
                    p
                    \in IF DeleteWinsPreserved
                          THEN {p \in w[s].deletes :
                                  Foreign(s, p) /\ doc[p] # Nil}
                          ELSE {}}
       /\ w' = [w EXCEPT ![s] = InstallW(s)]
       /\ udel'
          = udel
            \cup {<<p, doc[p]>> :
                    p
                    \in {q \in Paths :
                           doc[q] # Nil /\ InstallInst(s)[q] = Nil}}
       /\ UNCHANGED <<live, minted, base, acked, holder, gw, mv, nextGen, ui,
                      reqs, barriers, restarts, syncs, regressed, rescopes,
                      fails, upped, copies, orig>> ,
       ASSUME NEW CONSTANT W \in Writer
       PROVE  /\ W.st \in {"off", "on"}
              /\ W.pc
                 \in {"idle", "consumed", "scanned", "claimed", "cased",
                      "pulling"}
              /\ W.local \in [Paths -> Handles \cup {Nil}]
              /\ W.baseline \in [Paths -> Handles \cup {Nil}]
              /\ W.integrated \subseteq Gens
              /\ W.uploads \subseteq Paths /\ W.deletes \subseteq Paths
              /\ W.snap \in [Paths -> Handles \cup {Nil}]
              /\ W.upDone \subseteq Paths /\ W.gone \subseteq Paths
                 /\ W.verified \in BOOLEAN
              /\ W.inst \in [Paths -> Handles \cup {Nil}]
              /\ W.retire \subseteq Handles
              /\ W.collected \in BOOLEAN /\ W.adv \in BOOLEAN
              /\ W.synced \in Nat /\ W.derived \in Nat
              /\ W.skipped \subseteq Paths /\ W.scope \subseteq Paths
              /\ W.sStage \in {"none", "saved", "mid"}
              /\ W.sTgt \subseteq Paths /\ W.sDrop \subseteq Paths
                 /\ W.sKeep \subseteq Paths
              /\ W.sHeld \in [Paths -> Handles \cup {Nil}]
              /\ W.unlinked \subseteq Paths
              /\ W.memo \in Nat /\ W.rnow \in Nat
              /\ W.nt \in Nat /\ W.pend \in PendT /\ W.ack \in AckT
                 /\ W.car \in CarT
              /\ W.cId \in Nat /\ W.cFold \in Nat
                 /\ W.clk \in Clocks \cup {"none"}
              /\ W.iseq \in Nat /\ W.instd \in BOOLEAN /\ W.bound \in BoundT
              /\ W.cN \subseteq Nat /\ W.aN \subseteq Nat
                 /\ W.capped \subseteq Nat
              /\ W.dset \subseteq Paths
                 /\ W.decl \in [Paths -> Handles \cup {Nil}]
                 /\ W.dMint \in [Paths -> Nat]
              /\ W.moved \subseteq Paths
                 /\ W.stamps \subseteq Nat \X (Clocks \cup {"none"})
              /\ W.lost \subseteq Handles \cup {Nil} /\ W.deposed \in BOOLEAN
                 /\ W.nd \in Nat 
PROVE  conflicts' \subseteq Paths \X (Handles \cup {Nil})

@!!END

