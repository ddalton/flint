       NEW CONSTANT InstallFenced,
       NEW CONSTANT DeletesUnderLease,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
