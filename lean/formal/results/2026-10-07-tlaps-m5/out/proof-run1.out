       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndM5 ,
       NEW CONSTANT s \in Writers,
       NEW CONSTANT p \in Paths,
       Upload(s, p) ,
       Frame ,
       (/\ w'
           = [w EXCEPT ![s] = UploadCopyW(s, p, <<p, MaxMint + copies + 1>>)]
           /\ doc' = doc)
       /\ minted' = minted \cup {<<p, MaxMint + copies + 1>>}
       /\ base'
          = [base EXCEPT
               ![<<p, MaxMint + copies + 1>>] = base[(w[s].snap)[p]]]
       /\ orig'
          = [orig EXCEPT
               ![<<p, MaxMint + copies + 1>>] = Content((w[s].snap)[p])]
       /\ copies < MaxCopies ,
       <<p, MaxMint + copies + 1>> \in Handles ,
       <<p, MaxMint + copies + 1>> \notin minted ,
       base[(w[s].snap)[p]] \in Opt(minted)
       /\ orig[(w[s].snap)[p]] \in Opt(minted)
       /\ (orig[(w[s].snap)[p]] # Nil => orig[orig[(w[s].snap)[p]]] = Nil) ,
       Content((w[s].snap)[p]) \in minted
       /\ orig[Content((w[s].snap)[p])] = Nil ,
       orig[<<p, MaxMint + copies + 1>>] = Nil
       /\ base[<<p, MaxMint + copies + 1>>] = Nil ,
       (\A h \in Handles \ minted :
           base[h] = Nil /\ anc[h] = {} /\ orig[h] = Nil)
       /\ HistAnc /\ HistMinted /\ BaselineMinted ,
       /\ minted \subseteq Handles /\ minted' \subseteq Handles
       /\ base \in [Handles -> Opt(Handles)]
          /\ base' \in [Handles -> Opt(Handles)]
       /\ orig \in [Handles -> Opt(Handles)]
          /\ orig' \in [Handles -> Opt(Handles)]
       /\ anc \in [Handles -> SUBSET Handles] 
PROVE  /\ minted \subseteq minted'
       /\ \A m \in minted : (base')[m] = base[m] /\ (orig')[m] = orig[m]
       /\ \A h \in minted' \ minted :
             /\ (base')[h] \in Opt(minted) /\ (orig')[h] \in Opt(minted)
             /\ (orig')[h] # Nil => orig[(orig')[h]] = Nil
       /\ \A h \in Handles \ minted' : (base')[h] = Nil /\ (orig')[h] = Nil

@!!END

