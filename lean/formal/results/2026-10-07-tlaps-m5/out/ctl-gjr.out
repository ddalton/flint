@!!BEGIN
@!!type:obligation
@!!id:7
@!!loc:8074:3:8074:5
@!!status:being proved
@!!prover:smt
@!!meth:time-limit: 60
@!!obl:
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndM5 ,
       NEW CONSTANT p0 \in Paths,
       /\ gw[p0] # Nil /\ LeaseGuard
       /\ /\ doc'
             = (IF doc[p0] = base[gw[p0]] \/ ~GatewayJudgesRead
                  THEN [doc EXCEPT ![p0] = gw[p0]]
                  ELSE doc)
          /\ seq'
             = (IF doc[p0] = base[gw[p0]] \/ ~GatewayJudgesRead
                  THEN seq + 1
                  ELSE seq)
          /\ tomb'
             = (IF doc[p0] = base[gw[p0]] \/ ~GatewayJudgesRead
                  THEN [tomb EXCEPT ![p0] = Nil]
                  ELSE tomb)
          /\ acked'
             = (IF doc[p0] = base[gw[p0]] \/ ~GatewayJudgesRead
                  THEN acked \cup {<<p0, gw[p0]>>}
                  ELSE acked)
       /\ gw' = [gw EXCEPT ![p0] = Nil]
       /\ UNCHANGED <<live, minted, base, conflicts, holder, nextGen, ui,
                      reqs, barriers, w, mv, udel, aux>> ,
       /\ CommitSurfacesForeign /\ CommitVerifiesUploads /\ SweepUnderLease
       /\ CollectorSparesCited /\ CommitRecordsDeleteOverride
          /\ DeleteWinsPreserved
       /\ ContentConverges /\ RecheckSkipped /\ CommitAdvanceGuarded
          /\ RetireAge
       /\ GatewayIgnoresLease /\ GatewaySweepGrace /\ RenameAtomic
       /\ ConsumeHonorsScope /\ RescopeUnciteFirst /\ RescopeKeepsDirty
          /\ WidenKeepsLocal
       /\ UnlinkChecksBytes /\ ConsumeKeepsLeft /\ SyncKeepsLeft
          /\ ReaderRechecksOwed 
PROVE  /\ gw[p0] # Nil
       /\ doc'
          = (IF doc[p0] = base[gw[p0]]
               THEN [doc EXCEPT ![p0] = gw[p0]]
               ELSE doc)

@!!END

