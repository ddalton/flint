@!!BEGIN
@!!type:obligation
@!!id:472
@!!loc:456:5:456:7
@!!status:failed
@!!prover:smt
@!!meth:time-limit: 30; time-used: 30.0 (100%)
@!!reason:internal timeout
@!!already:false
@!!obl:
\* internal timeout while processing obligation
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       Opt(S) == S \cup {Nil},
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       TypeOK ==
         /\ live \subseteq Handles /\ minted \subseteq Handles
            /\ live \subseteq minted
         /\ doc \in [Paths -> Opt(Handles)]
         /\ seq \in Nat
         /\ tomb \in [Paths -> Opt(Handles)]
         /\ base \in [Handles -> Opt(Handles)]
         /\ acked \subseteq Paths \X Handles
         /\ conflicts \subseteq Paths \X Opt(Handles)
         /\ holder \in Writers \cup {"none"}
         /\ nextGen \in Nat /\ ui \in Nat /\ reqs \in Nat /\ barriers \in Nat
         /\ w \in [Writers -> Writer]
         /\ took \in [Writers -> [Paths -> SUBSET Gens]]
         /\ gw \in [Paths -> Opt(Handles)]
         /\ mv \in Opt(Paths \X Handles)
         /\ udel \subseteq Paths \X Handles
         /\ restarts \in Nat /\ syncs \in Nat /\ regressed \in BOOLEAN
            /\ rescopes \in Nat /\ fails \in Nat
         /\ retiring \subseteq Handles /\ aged \subseteq Handles
            /\ ages \in Nat
         /\ rdoc \in [Paths -> Opt(Handles)] /\ rlag \in BOOLEAN
         /\ anc \in [Handles -> SUBSET Handles],
       UploadCopyW(s, p, c) ==
         [st |-> w[s].st, pc |-> w[s].pc,
          local |-> [w[s].local EXCEPT
                       ![p] = IF (w[s].local)[p] = (w[s].snap)[p]
                                THEN c
                                ELSE (w[s].local)[p]],
          baseline |-> w[s].baseline, integrated |-> w[s].integrated,
          uploads |-> w[s].uploads, deletes |-> w[s].deletes,
          snap |-> [w[s].snap EXCEPT ![p] = c],
          upDone |-> w[s].upDone \cup {p}, gone |-> w[s].gone,
          verified |-> w[s].verified, inst |-> w[s].inst,
          retire |-> w[s].retire, collected |-> w[s].collected,
          adv |-> w[s].adv, synced |-> w[s].synced, derived |-> w[s].derived,
          skipped |-> w[s].skipped, scope |-> w[s].scope,
          sStage |-> w[s].sStage, sTgt |-> w[s].sTgt, sDrop |-> w[s].sDrop,
          sKeep |-> w[s].sKeep, sHeld |-> w[s].sHeld,
          unlinked |-> w[s].unlinked, memo |-> w[s].memo, rnow |-> w[s].rnow],
       ShippedShape == Shipped,
       FreePaths == Free \subseteq Paths,
       MaxMintNat == MaxMint \in Nat /\ MaxMint >= 1,
       ScopesPaths == Scopes \subseteq SUBSET Paths /\ Scopes # {},
       ReadersWriters == Readers \subseteq Writers,
       NilHandle == Nil \notin Handles,
       NoneWriter == "none" \notin Writers,
       MaxCopiesNat == MaxCopies \in Nat,
       PathsFinite == IsFiniteSet(Paths),
       Ghosts ==
         upped \subseteq Handles /\ copies \in Nat
         /\ orig \in [Handles -> Opt(Handles)],
       Minted ==
         /\ \A p \in Paths : doc[p] \in Opt(minted)
         /\ \A p \in Paths : gw[p] \in Opt(minted)
         /\ \A s \in Writers, p \in Paths : (w[s].local)[p] \in Opt(minted)
         /\ \A s \in Writers :
               \A p \in w[s].uploads : (w[s].snap)[p] \in minted,
       IndTypeOK == TypeOK /\ Ghosts /\ mv = Nil /\ nextGen > Seed /\ Minted,
       IndTypeOK ,
       NEW CONSTANT s \in Writers,
       NEW CONSTANT p \in Paths,
       Upload(s, p) ,
       Frame ,
       h == (w[s].snap)[p],
       c == <<p, MaxMint + copies + 1>>,
       <1>0 ,
       <1>2 ,
       <2>1 ,
       <2>2 ,
       WriterFields 
PROVE  /\ \A q \in Paths : (UploadCopyW(s, p, c).local)[q] \in Opt(minted')
       /\ UploadCopyW(s, p, c).uploads = w[s].uploads
       /\ \A q \in w[s].uploads : (UploadCopyW(s, p, c).snap)[q] \in minted'

@!!END

