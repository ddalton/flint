          baseline |-> [p \in Paths |->
                          IF p \in w[s].uploads \cap w[s].upDone
                            THEN (w[s].snap)[p]
                            ELSE IF
                                   p \in w[s].deletes /\ (w[s].inst)[p] = Nil
                                   THEN Nil
                                   ELSE (w[s].baseline)[p]],
