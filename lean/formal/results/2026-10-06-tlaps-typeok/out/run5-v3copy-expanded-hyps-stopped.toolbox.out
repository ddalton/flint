          snap |-> [p \in Paths |-> Nil], upDone |-> {}, gone |-> {},
          verified |-> FALSE, inst |-> w[s].inst, retire |-> w[s].retire,
          collected |-> FALSE, adv |-> FALSE,
          synced |-> IF w[s].inst = doc THEN seq ELSE w[s].synced,
          derived |-> IF w[s].adv /\ w[s].inst = doc
                        THEN seq
                        ELSE w[s].derived,
          skipped |-> IF w[s].adv /\ w[s].inst = doc
                        THEN w[s].skipped
                             \ ((w[s].uploads \cap w[s].upDone)
                                \cup {p \in w[s].deletes :
