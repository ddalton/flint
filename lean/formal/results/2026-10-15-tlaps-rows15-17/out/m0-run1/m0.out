              pend |-> w[s].pend, ack |-> w[s].ack,
              car |-> IF w[s].car.id # 0
                        THEN CarUncited(w[s].car, doc)
                        ELSE w[s].car,
              cId |-> 0, cFold |-> 0, clk |-> "none", iseq |-> 0,
              instd |-> FALSE,
              bound |-> IF w[s].cId # 0
                          THEN [id |-> w[s].cId, fold |-> w[s].cFold,
                                doc |-> doc, seq |-> seq, wd |-> {},
                                inst |-> FALSE, clk |-> w[s].clk]
                          ELSE w[s].bound,
              cN |-> w[s].cN, aN |-> w[s].aN, capped |-> w[s].capped,
              dset |-> w[s].dset, decl |-> w[s].decl, dMint |-> w[s].dMint,
              moved |-> w[s].moved, stamps |-> w[s].stamps,
              lost |-> w[s].lost, deposed |-> w[s].deposed, nd |-> w[s].nd].bound
             \in [id : Nat, fold : Nat, doc : [Paths -> Handles \cup {Nil}],
                  seq : Nat, wd : SUBSET Paths, inst : BOOLEAN,
                  clk : Clocks \cup {"none"}] ,
       ASSUME NEW CONSTANT W \in [st : {"off", "on"},
                                  pc : {"idle", "consumed", "scanned",
                                        "claimed", "cased", "pulling"},
                                  local : [Paths -> Handles \cup {Nil}],
                                  baseline : [Paths -> Handles \cup {Nil}],
                                  integrated : SUBSET Gens,
                                  uploads : SUBSET Paths,
                                  deletes : SUBSET Paths,
                                  snap : [Paths -> Handles \cup {Nil}],
                                  upDone : SUBSET Paths, gone : SUBSET Paths,
                                  verified : BOOLEAN,
                                  inst : [Paths -> Handles \cup {Nil}],
                                  retire : SUBSET Handles,
                                  collected : BOOLEAN, adv : BOOLEAN,
                                  synced : Nat, derived : Nat,
                                  skipped : SUBSET Paths,
                                  scope : SUBSET Paths,
                                  sStage : {"none", "saved", "mid"},
                                  sTgt : SUBSET Paths, sDrop : SUBSET Paths,
                                  sKeep : SUBSET Paths,
                                  sHeld : [Paths -> Handles \cup {Nil}],
                                  unlinked : SUBSET Paths, memo : Nat,
                                  rnow : Nat, nt : Nat,
                                  pend : [id : Nat, fold : Nat,
                                          nonces : SUBSET Nat],
                                  ack : [st : {"none", "ok", "partial",
                                               "refused-read-only"},
                                         nonces : SUBSET Nat, seq : Nat,
                                         src : Clocks \cup {"none"},
                                         dropped : SUBSET Paths,
                                         inst : BOOLEAN],
                                  car : [id : Nat, paths : SUBSET Paths,
                                         deletes : SUBSET Paths,
                                         dropped : SUBSET Paths,
                                         uncited : SUBSET Paths],
                                  cId : Nat, cFold : Nat,
                                  clk : Clocks \cup {"none"}, iseq : Nat,
                                  instd : BOOLEAN,
                                  bound : [id : Nat, fold : Nat,
                                           doc : [Paths ->
                                                    Handles \cup {Nil}],
                                           seq : Nat, wd : SUBSET Paths,
                                           inst : BOOLEAN,
                                           clk : Clocks \cup {"none"}],
                                  cN : SUBSET Nat, aN : SUBSET Nat,
                                  capped : SUBSET Nat, dset : SUBSET Paths,
                                  decl : [Paths -> Handles \cup {Nil}],
                                  dMint : [Paths -> Nat],
                                  moved : SUBSET Paths,
                                  stamps : SUBSET Nat
                                                  \X (Clocks \cup {"none"}),
                                  lost : SUBSET (Handles \cup {Nil}),
                                  deposed : BOOLEAN, nd : Nat]
       PROVE  /\ W.st \in {"off", "on"}
              /\ W.pc
                 \in {"idle", "consumed", "scanned", "claimed", "cased",
                      "pulling"}
              /\ W.local \in [Paths -> Handles \cup {Nil}]
              /\ W.baseline \in [Paths -> Handles \cup {Nil}]
              /\ W.integrated \subseteq Gens
              /\ W.uploads \subseteq Paths /\ W.deletes \subseteq Paths
              /\ W.snap \in [Paths -> Handles \cup {Nil}]
              /\ W.upDone \subseteq Paths /\ W.gone \subseteq Paths
                 /\ W.verified \in BOOLEAN
              /\ W.inst \in [Paths -> Handles \cup {Nil}]
              /\ W.retire \subseteq Handles
              /\ W.collected \in BOOLEAN /\ W.adv \in BOOLEAN
              /\ W.synced \in Nat /\ W.derived \in Nat
              /\ W.skipped \subseteq Paths /\ W.scope \subseteq Paths
              /\ W.sStage \in {"none", "saved", "mid"}
              /\ W.sTgt \subseteq Paths /\ W.sDrop \subseteq Paths
                 /\ W.sKeep \subseteq Paths
              /\ W.sHeld \in [Paths -> Handles \cup {Nil}]
              /\ W.unlinked \subseteq Paths
              /\ W.memo \in Nat /\ W.rnow \in Nat
              /\ W.nt \in Nat
                 /\ W.pend \in [id : Nat, fold : Nat, nonces : SUBSET Nat]
                 /\ W.ack
                    \in [st : {"none", "ok", "partial", "refused-read-only"},
                         nonces : SUBSET Nat, seq : Nat,
                         src : Clocks \cup {"none"}, dropped : SUBSET Paths,
                         inst : BOOLEAN]
                 /\ W.car
                    \in [id : Nat, paths : SUBSET Paths,
                         deletes : SUBSET Paths, dropped : SUBSET Paths,
                         uncited : SUBSET Paths]
              /\ W.cId \in Nat /\ W.cFold \in Nat
                 /\ W.clk \in Clocks \cup {"none"}
              /\ W.iseq \in Nat /\ W.instd \in BOOLEAN
                 /\ W.bound
                    \in [id : Nat, fold : Nat,
                         doc : [Paths -> Handles \cup {Nil}], seq : Nat,
                         wd : SUBSET Paths, inst : BOOLEAN,
                         clk : Clocks \cup {"none"}]
              /\ W.cN \subseteq Nat /\ W.aN \subseteq Nat
                 /\ W.capped \subseteq Nat
              /\ W.dset \subseteq Paths
                 /\ W.decl \in [Paths -> Handles \cup {Nil}]
                 /\ W.dMint \in [Paths -> Nat]
