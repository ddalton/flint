        sDrop |-> w[s].sDrop, sKeep |-> w[s].sKeep, sHeld |-> w[s].sHeld,
        unlinked |-> w[s].unlinked, memo |-> w[s].memo, rnow |-> w[s].rnow,
        nt |-> w[s].nt, pend |-> w[s].pend, ack |-> w[s].ack,
        car |-> IF w[s].car.id # 0
                  THEN CarUncited(w[s].car, doc)
                  ELSE w[s].car,
        cId |-> 0, cFold |-> 0, clk |-> "none", iseq |-> 0, instd |-> FALSE,
