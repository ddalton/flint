                 /\ W.stamps \subseteq Nat \X (Clocks \cup {"none"})
              /\ W.lost \subseteq Handles \cup {Nil} /\ W.deposed \in BOOLEAN
                 /\ W.nd \in Nat 
PROVE  [st |-> w[s].st, pc |-> "idle", local |-> w[s].local,
