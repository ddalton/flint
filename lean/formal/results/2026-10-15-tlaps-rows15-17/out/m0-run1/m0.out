       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndTypeOK ,
       NEW CONSTANT s \in Writers,
       PullOnly(s) ,
       Frame ,
       w[s]
       \in [st : {"off", "on"},
            pc : {"idle", "consumed", "scanned", "claimed", "cased",
                  "pulling"},
            local : [Paths -> Handles \cup {Nil}],
            baseline : [Paths -> Handles \cup {Nil}],
            integrated : SUBSET Gens, uploads : SUBSET Paths,
            deletes : SUBSET Paths, snap : [Paths -> Handles \cup {Nil}],
