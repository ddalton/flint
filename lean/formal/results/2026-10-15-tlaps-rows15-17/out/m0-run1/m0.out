ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW CONSTANT MaxTouches,
       NEW CONSTANT MaxNonces,
       NEW CONSTANT MaxDeposals,
       NEW CONSTANT InstallFenced,
       NEW CONSTANT DeletesUnderLease,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       NEW CONSTANT W \in [st : {"off", "on"},
                           pc : {"idle", "consumed", "scanned", "claimed",
                                 "cased", "pulling"},
                           local : [Paths -> Opt(Handles)],
                           baseline : [Paths -> Opt(Handles)],
                           integrated : SUBSET Gens, uploads : SUBSET Paths,
                           deletes : SUBSET Paths,
                           snap : [Paths -> Opt(Handles)],
                           upDone : SUBSET Paths, gone : SUBSET Paths,
                           verified : BOOLEAN,
                           inst : [Paths -> Opt(Handles)],
                           retire : SUBSET Handles, collected : BOOLEAN,
                           adv : BOOLEAN, synced : Nat, derived : Nat,
                           skipped : SUBSET Paths, scope : SUBSET Paths,
                           sStage : {"none", "saved", "mid"},
                           sTgt : SUBSET Paths, sDrop : SUBSET Paths,
                           sKeep : SUBSET Paths,
                           sHeld : [Paths -> Opt(Handles)],
                           unlinked : SUBSET Paths, memo : Nat, rnow : Nat,
                           nt : Nat,
                           pend : [id : Nat, fold : Nat, nonces : SUBSET Nat],
                           ack : [st : {"none", "ok", "partial",
                                        "refused-read-only"},
                                  nonces : SUBSET Nat, seq : Nat,
                                  src : Clocks \cup {"none"},
                                  dropped : SUBSET Paths, inst : BOOLEAN],
                           car : [id : Nat, paths : SUBSET Paths,
                                  deletes : SUBSET Paths,
                                  dropped : SUBSET Paths,
                                  uncited : SUBSET Paths],
                           cId : Nat, cFold : Nat,
                           clk : Clocks \cup {"none"}, iseq : Nat,
                           instd : BOOLEAN,
                           bound : [id : Nat, fold : Nat,
                                    doc : [Paths -> Opt(Handles)], seq : Nat,
                                    wd : SUBSET Paths, inst : BOOLEAN,
                                    clk : Clocks \cup {"none"}],
                           cN : SUBSET Nat, aN : SUBSET Nat,
                           capped : SUBSET Nat, dset : SUBSET Paths,
                           decl : [Paths -> Opt(Handles)],
                           dMint : [Paths -> Nat], moved : SUBSET Paths,
                           stamps : SUBSET Nat \X (Clocks \cup {"none"}),
                           lost : SUBSET Opt(Handles), deposed : BOOLEAN,
                           nd : Nat]
PROVE  /\ W.nt \in Nat
          /\ W.pend \in [id : Nat, fold : Nat, nonces : SUBSET Nat]
          /\ W.ack
             \in [st : {"none", "ok", "partial", "refused-read-only"},
                  nonces : SUBSET Nat, seq : Nat, src : Clocks \cup {"none"},
                  dropped : SUBSET Paths, inst : BOOLEAN]
          /\ W.car
             \in [id : Nat, paths : SUBSET Paths, deletes : SUBSET Paths,
                  dropped : SUBSET Paths, uncited : SUBSET Paths]
       /\ W.cId \in Nat /\ W.cFold \in Nat /\ W.clk \in Clocks \cup {"none"}
       /\ W.iseq \in Nat /\ W.instd \in BOOLEAN
          /\ W.bound
             \in [id : Nat, fold : Nat, doc : [Paths -> Opt(Handles)],
                  seq : Nat, wd : SUBSET Paths, inst : BOOLEAN,
                  clk : Clocks \cup {"none"}]

@!!END

