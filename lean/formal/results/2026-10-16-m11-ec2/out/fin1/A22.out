       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndC ,
       IndC' ,
       DInv ,
       A1IAK1 ,
       A1LostDead ,
       NEW CONSTANT s \in Writers,
       RPullSync(s) ,
       Frame ,
       NEW CONSTANT fail \in SUBSET SyncAll(s),
       RPullSyncW(s, fail).pc = "idle" ,
       RPullSyncW(s, fail).pend = w[s].pend
       /\ RPullSyncW(s, fail).dset = w[s].dset
       /\ RPullSyncW(s, fail).decl = w[s].decl ,
       RPullSyncW(s, fail).moved = w[s].moved
       /\ RPullSyncW(s, fail).dMint = w[s].dMint
       /\ RPullSyncW(s, fail).car = w[s].car ,
       RPullSyncW(s, fail).bound = w[s].bound
       /\ RPullSyncW(s, fail).nt = w[s].nt
       /\ RPullSyncW(s, fail).lost = w[s].lost ,
       RPullSyncW(s, fail).inst = w[s].inst
       /\ RPullSyncW(s, fail).cId = w[s].cId
       /\ RPullSyncW(s, fail).cFold = w[s].cFold ,
       A1LeftSet(RPullSyncW(s, fail)) = A1LeftSet(w[s]) ,
       \A q \in Paths :
          \/ (RPullSyncW(s, fail).local)[q] = (w[s].local)[q]
             /\ (RPullSyncW(s, fail).baseline)[q] = (w[s].baseline)[q]
          \/ (RPullSyncW(s, fail).local)[q] = doc[q]
             /\ (RPullSyncW(s, fail).baseline)[q] = doc[q] /\ Owed(s, q) ,
       RPullSyncW(s, fail).sStage = w[s].sStage 
PROVE  /\ RPullSyncW(s, fail).pc = "idle"
          /\ RPullSyncW(s, fail).pend = w[s].pend
          /\ RPullSyncW(s, fail).dset = w[s].dset
          /\ RPullSyncW(s, fail).decl = w[s].decl
          /\ RPullSyncW(s, fail).moved = w[s].moved
          /\ RPullSyncW(s, fail).dMint = w[s].dMint
          /\ RPullSyncW(s, fail).car = w[s].car
          /\ RPullSyncW(s, fail).bound = w[s].bound
          /\ RPullSyncW(s, fail).nt = w[s].nt
          /\ RPullSyncW(s, fail).lost = w[s].lost
          /\ RPullSyncW(s, fail).inst = w[s].inst
          /\ RPullSyncW(s, fail).cId = w[s].cId
          /\ RPullSyncW(s, fail).cFold = w[s].cFold
          /\ A1LeftSet(RPullSyncW(s, fail)) = A1LeftSet(w[s])
          /\ RPullSyncW(s, fail).sStage = w[s].sStage
          /\ (\A q \in Paths :
                 \/ (((RPullSyncW(s, fail).local)[q] = (w[s].local)[q]
                      /\ (RPullSyncW(s, fail).baseline)[q]
                         = (w[s].baseline)[q])
                     \/ (RPullSyncW(s, fail).local)[q] = doc[q])
                    /\ (RPullSyncW(s, fail).baseline)[q] = doc[q]
                    /\ Owed(s, q))

