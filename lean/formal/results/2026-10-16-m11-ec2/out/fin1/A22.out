@!!loc:2963:14:2963:16
@!!status:being proved
@!!prover:smt
@!!meth:time-limit: 60
@!!obl:
ASSUME NEW CONSTANT Nil,
       NEW CONSTANT Paths,
       NEW CONSTANT Free,
       NEW CONSTANT Writers,
       NEW CONSTANT MaxMint,
       NEW CONSTANT MaxUI,
       NEW CONSTANT MaxRemovals,
       NEW CONSTANT MaxBarriers,
       NEW CONSTANT MaxRestarts,
       NEW CONSTANT MaxSyncs,
       NEW CONSTANT MaxAges,
       NEW CONSTANT MaxCopies,
       NEW CONSTANT CommitSurfacesForeign,
       NEW CONSTANT CommitVerifiesUploads,
       NEW CONSTANT SweepUnderLease,
       NEW CONSTANT CollectorSparesCited,
       NEW CONSTANT CommitRecordsDeleteOverride,
       NEW CONSTANT DeleteWinsPreserved,
       NEW CONSTANT ContentConverges,
       NEW CONSTANT RecheckSkipped,
       NEW CONSTANT CommitAdvanceGuarded,
       NEW CONSTANT RetireAge,
       NEW CONSTANT GatewayIgnoresLease,
       NEW CONSTANT GatewayJudgesRead,
       NEW CONSTANT GatewaySweepGrace,
       NEW CONSTANT RenameAtomic,
       NEW CONSTANT Scopes,
       NEW CONSTANT MaxRescopes,
       NEW CONSTANT ConsumeHonorsScope,
       NEW CONSTANT RescopeUnciteFirst,
       NEW CONSTANT RescopeKeepsDirty,
       NEW CONSTANT WidenKeepsLocal,
       NEW CONSTANT UnlinkChecksBytes,
       NEW CONSTANT MaxFetchFails,
       NEW CONSTANT ConsumeKeepsLeft,
       NEW CONSTANT SyncKeepsLeft,
       NEW CONSTANT Readers,
       NEW CONSTANT ReaderRechecksOwed,
       NEW CONSTANT MaxTouches,
       NEW CONSTANT MaxNonces,
       NEW CONSTANT MaxDeposals,
       NEW CONSTANT InstallFenced,
       NEW CONSTANT DeletesUnderLease,
       NEW VARIABLE live,
       NEW VARIABLE minted,
       NEW VARIABLE doc,
       NEW VARIABLE seq,
       NEW VARIABLE tomb,
       NEW VARIABLE base,
       NEW VARIABLE acked,
       NEW VARIABLE conflicts,
       NEW VARIABLE holder,
       NEW VARIABLE nextGen,
       NEW VARIABLE ui,
       NEW VARIABLE reqs,
       NEW VARIABLE barriers,
       NEW VARIABLE w,
       NEW VARIABLE took,
       NEW VARIABLE gw,
       NEW VARIABLE mv,
       NEW VARIABLE udel,
       NEW VARIABLE restarts,
       NEW VARIABLE syncs,
       NEW VARIABLE regressed,
       NEW VARIABLE rescopes,
       NEW VARIABLE fails,
       NEW VARIABLE upped,
       NEW VARIABLE copies,
       NEW VARIABLE orig,
       NEW VARIABLE retiring,
       NEW VARIABLE aged,
       NEW VARIABLE ages,
       NEW VARIABLE rdoc,
       NEW VARIABLE rlag,
       NEW VARIABLE anc,
       IndC ,
       IndC' ,
       DInv ,
       A1IAK1 ,
       A1LostDead ,
       NEW CONSTANT s \in Writers,
       RPullSync(s) ,
       Frame ,
       NEW CONSTANT fail \in SUBSET SyncAll(s),
       w[s].sDrop \subseteq Paths ,
       /\ RPullSyncW(s, fail).sDrop = w[s].sDrop
          /\ RPullSyncW(s, fail).sHeld = w[s].sHeld
       /\ RPullSyncW(s, fail).sStage = w[s].sStage
          /\ RPullSyncW(s, fail).sKeep = w[s].sKeep ,
       \A q \in Paths :
          q \in SyncOwed(s, fail)
          => (w[s].local)[q] = (w[s].baseline)[q] \/ (w[s].local)[q] = Nil ,
       RPullSyncW(s, fail).local
       = [p \in Paths |->
            IF p \in SyncOwed(s, fail) THEN doc[p] ELSE (w[s].local)[p]] ,
       RPullSyncW(s, fail).baseline
       = [p \in Paths |->
            IF p \in SyncOwed(s, fail) THEN doc[p] ELSE (w[s].baseline)[p]] 
PROVE  {p \in RPullSyncW(s, fail).sDrop :
          /\ (RPullSyncW(s, fail).local)[p] # Nil
             /\ (RPullSyncW(s, fail).sHeld)[p] # Nil
             /\ (RPullSyncW(s, fail).local)[p]
                = (RPullSyncW(s, fail).sHeld)[p]
          /\ \/ RPullSyncW(s, fail).sStage = "mid"
                /\ p \notin RPullSyncW(s, fail).sKeep
             \/ RPullSyncW(s, fail).sStage = "saved"
                /\ (RPullSyncW(s, fail).baseline)[p] = Nil}
       = {p \in w[s].sDrop :
            /\ (w[s].local)[p] # Nil /\ (w[s].sHeld)[p] # Nil
               /\ (w[s].local)[p] = (w[s].sHeld)[p]
            /\ \/ w[s].sStage = "mid" /\ p \notin w[s].sKeep
               \/ w[s].sStage = "saved" /\ (w[s].baseline)[p] = Nil}

@!!END

