         MaxTouches \in Nat /\ MaxNonces \in Nat /\ MaxNonces >= 1
         /\ MaxDeposals \in Nat,
       IndC ,
       IndC' ,
       A3Side ,
       NEW CONSTANT s \in Writers,
       NEW CONSTANT p \in Paths,
       Edit(s, p) ,
       Frame ,
       NEW CONSTANT hh \in Handles,
       A3Ty ,
       WriterFields 
PROVE  w[s].local \in [Paths -> Opt(Handles)]

@!!END

