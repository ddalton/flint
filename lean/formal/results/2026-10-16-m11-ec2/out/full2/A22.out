       /\ RPullSyncW(s, fail).sStage = w[s].sStage
          /\ RPullSyncW(s, fail).sKeep = w[s].sKeep 
PROVE  q
       \in {p \in SyncW(s, fail).sDrop :
              /\ (SyncW(s, fail).local)[p] # Nil
                 /\ (SyncW(s, fail).sHeld)[p] # Nil
                 /\ (SyncW(s, fail).local)[p] = (SyncW(s, fail).sHeld)[p]
              /\ \/ SyncW(s, fail).sStage = "mid"
                    /\ p \notin SyncW(s, fail).sKeep
                 \/ SyncW(s, fail).sStage = "saved"
                    /\ (SyncW(s, fail).baseline)[p] = Nil}
       <=> q
           \in {p \in w[s].sDrop :
