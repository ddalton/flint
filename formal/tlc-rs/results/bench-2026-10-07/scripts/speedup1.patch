+/// The state variables `e` is a tuple of, in order, through zero-argument
+/// operators and nested tuples (`vars == <<x, y, aux>>`, `aux == <<z>>`);
+/// false if it is anything else.
+fn tuple_vars(p: &Program, e: &Expr, out: &mut Vec<u32>, depth: usize) -> bool {
+    if depth > 64 {
+        return false;
+    }
+    match e {
+        Expr::Var(i) => {
+            out.push(*i);
+            true
+        }
+        Expr::Tuple(v) => v.iter().all(|x| tuple_vars(p, x, out, depth + 1)),
+        Expr::Memo(_, false, x) => tuple_vars(p, x, out, depth + 1),
+        Expr::Call(op, args) if args.is_empty() => {
+            let o = &p.ops[*op as usize];
+            o.nparams == 0 && o.cached.is_none() && tuple_vars(p, &o.body, out, depth + 1)
+        }
+        _ => false,
+    }
+}
