(* (S) The step relation (one case per Next disjunct of rev 16; each       *)
(* disjunct's lemma I_<X> is in parts 51-59), and the theorem.            *)

LEMMA I_Next == IndAll /\ [Next]_vars => IndAll'
<1>. SUFFICES ASSUME IndAll, [Next]_vars PROVE IndAll' OBVIOUS
<1>h. IndInv /\ IndNew BY DEF IndAll
<1>0. CASE UNCHANGED vars BY <1>0, I_StutterAll, <1>h DEF IndAll
<1>1. CASE \E x \in Blocks : Submit(x) /\ NoStamp BY <1>1, I_SubmitAll, <1>h DEF IndAll
<1>2. CASE \E w \in pend : \/ Complete(w) /\ badAck' = (badAck \/ (Stamp /\ \E q \in members : Core(stamp[q]) # Core(CurStamp)))
                                  /\ UNCHANGED <<stampVars, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
                     \/ \E r \in R : \/ Land(w, r) /\ NoStamp
                                     \/ Drop(w, r) /\ LossS(r)
  <2>1. PICK w \in pend : \/ Complete(w) /\ badAck' = (badAck \/ (Stamp /\ \E q \in members : Core(stamp[q]) # Core(CurStamp)))
                                  /\ UNCHANGED <<stampVars, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
                          \/ \E r \in R : \/ Land(w, r) /\ NoStamp
                                          \/ Drop(w, r) /\ LossS(r)
    BY <1>2
  <2>2. CASE Complete(w) /\ badAck' = (badAck \/ (Stamp /\ \E q \in members : Core(stamp[q]) # Core(CurStamp)))
                         /\ UNCHANGED <<stampVars, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
    BY <2>2, I_CompleteAll, <1>h DEF IndAll
  <2>3. CASE \E r \in R : \/ Land(w, r) /\ NoStamp
                          \/ Drop(w, r) /\ LossS(r)
    <3>1. PICK r \in R : \/ Land(w, r) /\ NoStamp
                         \/ Drop(w, r) /\ LossS(r)
      BY <2>3
    <3>. QED BY <3>1, I_LandAll, I_DropAll, <1>h DEF IndAll
  <2>. QED BY <2>1, <2>2, <2>3
<1>3. CASE \E r \in R : \E x \in Blocks : Zombie(r, x) /\ ~ZombieReleases /\ zjv' = zjv \cup {ver + 1}
                                  /\ zpost' = (IF Stamp /\ zst THEN zpost \cup {ver + 1} ELSE zpost)
                                  /\ UNCHANGED <<stampVars, badAck, zAcked, zfreed, zLeg, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare>>
  BY <1>3, I_ZombieAll, <1>h DEF IndAll
<1>4. CASE \E x \in Blocks : ZombieAck(x) BY <1>4, I_ZombieAckAll, <1>h DEF IndAll
<1>5. CASE \E r \in R : \/ FailBegin(r) /\ NoStamp
                        \/ FaultOut(r) /\ LossS(r)
                        \/ MarkStale(r) /\ ~(Stamp /\ MonitorSkipsHold /\ hold) /\ NoStamp
                        \/ Drain(r) /\ (IF DrainStamps THEN LossS(r) ELSE NoStamp)
                        \/ Return(r) /\ NoStamp
  <2>1. PICK r \in R : \/ FailBegin(r) /\ NoStamp
                       \/ FaultOut(r) /\ LossS(r)
                       \/ MarkStale(r) /\ ~(Stamp /\ MonitorSkipsHold /\ hold) /\ NoStamp
                       \/ Drain(r) /\ (IF DrainStamps THEN LossS(r) ELSE NoStamp)
                       \/ Return(r) /\ NoStamp
    BY <1>5
  <2>. QED BY <2>1, I_FailBeginAll, I_FaultOutAll, I_MarkStaleAll, I_DrainAll, I_ReturnAll, <1>h DEF IndAll
<1>6. CASE \E e \in Epochs : Observe(e) /\ NoStamp BY <1>6, I_ObserveAll, <1>h DEF IndAll
<1>7. CASE (CutBegin \/ CutRecord \/ CutAbort \/ CutAbortRead \/ Retire) /\ NoStamp BY <1>7, I_CutSmallAll, <1>h DEF IndAll
<1>8. CASE \E r \in R : (CutOne(r) \/ \E e \in Epochs : GC(r, e)) /\ NoStamp BY <1>8, I_CutGCAll, <1>h DEF IndAll
<1>9. CASE \E r \in R : (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp
  <2>1. PICK r \in R : (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp BY <1>9
  <2>. QED BY <2>1, I_SelectBaseAll, I_RevertDAll, I_BulkCopyAll, I_SessionFailAll, I_ChaseAll, <1>h DEF IndAll
<1>10. CASE (Unstage \/ CrashUnstage) /\ EndRaidS BY <1>10, I_EndRaidAll, <1>h DEF IndAll
<1>11. CASE Stage BY <1>11, I_StageAll, <1>h DEF IndAll
<1>12. CASE ZombieMove /\ MoveS BY <1>12, I_ZombieMoveAll, <1>h DEF IndAll
<1>13. CASE ZombieMark /\ NoStamp BY <1>13, I_ZombieMarkAll, <1>h DEF IndAll
<1>14. CASE ZombieHygiene /\ zfreed' = zx /\ UNCHANGED <<stampVars, badAck, zAcked, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  BY <1>14, I_ZombieHygieneAll, <1>h DEF IndAll
<1>15. CASE \E r \in R : StageAdmit(r) /\ NewAsm(members')
                     /\ (IF Stamp THEN StageGhosts ELSE TRUE)
  BY <1>15, I_StageAdmitAll, <1>h DEF IndAll
<1>16. CASE \E r \in R : AdmitRefuse(r) /\ NoStamp BY <1>16, I_AdmitRefuseAll, <1>h DEF IndAll
<1>17. CASE StampLand \/ Release \/ RecordConfirm \/ HeldFail \/ ZombieStamp \/ StageDecree
  BY <1>17, I_StampLandAll, I_ReleaseAll, I_RecordConfirmAll, I_HeldFailAll, I_ZombieStampAll, I_StageDecreeAll, <1>h DEF IndAll
<1>18. CASE StageRisk BY <1>18, I_StageRiskAll, <1>h DEF IndAll
<1>. QED BY <1>0, <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>7, <1>8, <1>9, <1>10, <1>11, <1>12, <1>13, <1>14,
            <1>15, <1>16, <1>17, <1>18 DEF Next

LEMMA I_InitAll == Init => IndAll
BY I_Init, I_InitNew DEF IndAll

LEMMA I_GoalAll == IndAll => Goal
BY I_Goal DEF IndAll

THEOREM Safety == Spec => []Goal
<1>1. Init => IndAll BY I_InitAll
<1>2. IndAll /\ [Next]_vars => IndAll' BY I_Next
<1>3. IndAll => Goal BY I_GoalAll
<1>. QED BY <1>1, <1>2, <1>3, PTL DEF Spec
