(* (S) Stuttering keeps the invariant (generated by sproof/gen-stutter.py). *)

LEMMA I_Stutter == ASSUME IndInv, UNCHANGED vars PROVE IndInv'
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, members, attached, path, dState, mark>>
      /\ UNCHANGED <<reverted, sb, pin, riskRec, pend, acked, fails, badAdmit, badLoss, ackedEver>>
      /\ UNCHANGED <<used, tainted, floor, mustRev, restamp, cfgAt, conf, tr, htr, zx, cutAck>>
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zseq, zgen, zsize, zm0>>
      /\ UNCHANGED <<zrgen, zrmem, zst, badAck, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ>>
      /\ UNCHANGED <<riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  BY DEF vars
<1>1. TypeOKT' BY <1>0, <1>u, TypeOKParts, Groups, GroupsP, C_Scalar, C_Sets, C_Leg, C_Head, C_Snap, C_Pend, C_Tie, C_Trust
             DEF tieVars, trustVars
<1>2. TyStampS' BY <1>0, <1>u, TypeOKParts, TyStampSplit, TyStampSplitP, C_StA, C_Gh DEF stampVars, sGhost
<1>3. TypeOK' BY <1>1, <1>2, TypeOKPartsP
<1>4. IndJ'
  <2>1. J_DueHold' BY <1>0, <1>u, F_DueHold DEF IndJ
  <2>2. J_HoldAtt' BY <1>0, <1>u, F_JHoldAtt DEF IndJ
  <2>3. J_Rel' BY <1>0, <1>u, F_Rel DEF IndJ
  <2>4. J_Cur' BY <1>0, <1>u, F_Cur DEF IndJ
  <2>5. J_ZxOut' BY <1>0, <1>u, F_ZxOut DEF IndJ
  <2>6. J_Aseq' BY <1>0, <1>u, F_Aseq DEF IndJ
  <2>7. J_SeqSync' BY <1>0, <1>u, F_SeqSync DEF IndJ
  <2>8. J_MemRel' BY <1>0, <1>u, F_MemRel DEF IndJ
  <2>9. J_RelHold' BY <1>0, <1>u, F_RelHold DEF IndJ
  <2>10. J_NoAckBad' BY <1>0, <1>u, F_NoAckBad DEF IndJ
  <2>11. J_M0' BY <1>0, <1>u, F_M0 DEF IndJ
  <2>12. J_RelValid' BY <1>0, <1>u, F_RelValid DEF IndJ
  <2>13. J_MinorRel' BY <1>0, <1>u, F_MinorRel DEF IndJ
  <2>14. J_RelInSync' BY <1>0, <1>u, F_RelInSync DEF IndJ
  <2>15. J_ViewIn' BY <1>0, <1>u, F_ViewIn DEF IndJ
  <2>16. J_ViewOut' BY <1>0, <1>u, F_ViewOut DEF IndJ
  <2>17. J_SoleSeq' BY <1>0, <1>u, F_SoleSeq DEF IndJ
  <2>18. J_GenBound' BY <1>0, <1>u, F_GenBound DEF IndJ
  <2>19. J_ZGen' BY <1>0, <1>u, F_ZGen DEF IndJ
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>8, <2>9, <2>10, <2>11, <2>12, <2>13, <2>14, <2>15, <2>16, <2>17, <2>18, <2>19 DEF IndJ
<1>5. IndT'
  <2>1. I_RangesS' BY <1>0, <1>u, F_RangesS DEF IndT
  <2>2. I_Lineage' BY <1>0, <1>u, F_Lineage DEF IndT
  <2>3. I_Chain' BY <1>0, <1>u, F_Chain DEF IndT
  <2>4. I_Pend' BY <1>0, <1>u, F_Pend DEF IndT
  <2>5. I_MembersS' BY <1>0, <1>u, F_MembersS DEF IndT
  <2>6. I_HoldAtt' BY <1>0, <1>u, F_HoldAtt DEF IndT
  <2>7. I_PendSeen' BY <1>0, <1>u, F_PendSeen DEF IndT
  <2>8. I_Vers' BY <1>0, <1>u, F_Vers DEF IndT
  <2>9. I_Reverted' BY <1>0, <1>u, F_Reverted DEF IndT
  <2>10. I_HeadPend' BY <1>0, <1>u, F_HeadPend DEF IndT
  <2>11. I_Session' BY <1>0, <1>u, F_Session DEF IndT
  <2>12. Inv_TrustComplete' BY <1>0, <1>u, F_TC DEF IndT
  <2>13. I_NoBadLoss' BY <1>0, <1>u, F_NoBadLoss DEF IndT
  <2>14. Inv_AckedHeld' BY <1>0, <1>u, F_AckedHeld DEF IndT
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>8, <2>9, <2>10, <2>11, <2>12, <2>13, <2>14 DEF IndT
<1>6. IndS'
  <2>1. I_AckedEverS' BY <1>0, <1>u, F_AckedEverS DEF IndS
  <2>2. I_LegalS' BY <1>0, <1>u, F_LegalS DEF IndS
  <2>3. I_WHiS' BY <1>0, <1>u, F_WHiS DEF IndS
  <2>4. I_AckMono' BY <1>0, <1>u, F_AckMono DEF IndS
  <2>5. I_HeadLoS' BY <1>0, <1>u, F_HeadLoS DEF IndS
  <2>6. I_FreshS' BY <1>0, <1>u, F_FreshS DEF IndS
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6 DEF IndS
<1>. QED BY <1>3, <1>4, <1>5, <1>6, IndSplitP

LEMMA I_StutterAll == ASSUME IndAll, UNCHANGED vars PROVE IndAll'
<1>0. IndInv /\ IndNew BY DEF IndAll
<1>1. IndInv' BY <1>0, I_Stutter
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, members, attached, path, dState, mark>>
      /\ UNCHANGED <<reverted, sb, pin, riskRec, pend, acked, fails, badAdmit, badLoss, ackedEver>>
      /\ UNCHANGED <<used, tainted, floor, mustRev, restamp, cfgAt, conf, tr, htr, zx, cutAck>>
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zseq, zgen, zsize, zm0>>
      /\ UNCHANGED <<zrgen, zrmem, zst, badAck, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ>>
      /\ UNCHANGED <<riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  BY DEF vars
<1>n. IndNew'
  <2>1. J_RelHoldS' BY <1>0, <1>u, IndNewSplit, F_RelHoldSN
  <2>2. I_FreshS2' BY <1>0, <1>u, IndNewSplit, F_FreshS2N
  <2>3. I_LegalS2' BY <1>0, <1>u, IndNewSplit, F_LegalS2N
  <2>4. I_SnapPend' BY <1>0, <1>u, IndNewSplit, F_SnapPend
  <2>5. J_ZxIdle' BY <1>0, <1>u, IndNewSplit, F_ZxIdle
  <2>6. J_SeqLe' BY <1>0, <1>u, IndNewSplit, F_SeqLe
  <2>7. J_SoleRel' BY <1>0, <1>u, IndNewSplit, F_SoleRel
  <2>8. J_GenTop' BY <1>0, <1>u, IndNewSplit, F_GenTop
  <2>9. J_ZLive' BY <1>0, <1>u, IndNewSplit, F_ZLive
  <2>10. J_RelLe' BY <1>0, <1>u, IndNewSplit, F_RelLe
  <2>11. I_WHiC' BY <1>0, <1>u, IndNewSplit, F_WHiC
  <2>12. I_HeadLoC' BY <1>0, <1>u, IndNewSplit, F_HeadLoC
  <2>13. I_HeadLoA' BY <1>0, <1>u, IndNewSplit, F_HeadLoA
  <2>14. I_StandbyLegal' BY <1>0, <1>u, IndNewSplit, F_StandbyLegal
  <2>15. I_HeadHiC' BY <1>0, <1>u, IndNewSplit, F_HeadHiC
  <2>16. I_SnapLegal' BY <1>0, <1>u, IndNewSplit, F_SnapLegal
  <2>17. I_PendTop' BY <1>0, <1>u, IndNewSplit, F_PendTop
  <2>18. I_PendNext' BY <1>0, <1>u, IndNewSplit, F_PendNext
  <2>19. J_ZRel' BY <1>0, <1>u, IndNewSplit, F_ZRel
  <2>20. I_CutLegal' BY <1>0, <1>u, IndNewSplit, F_CutLegal
  <2>21. I_InSyncLegal' BY <1>0, <1>u, IndNewSplit, F_InSyncLegal
  <2>22. J_ZNoValid' BY <1>0, <1>u, IndNewSplit, F_ZNoValid
  <2>23. J_ZM0' BY <1>0, <1>u, IndNewSplit, F_ZM0
  <2>24. J_SoleGen' BY <1>0, <1>u, IndNewSplit, F_SoleGen
  <2>25. J_ZCut' BY <1>0, <1>u, IndNewSplit, F_ZCut
  <2>26. I_ValidLegal' BY <1>0, <1>u, IndNewSplit, F_ValidLegal
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>8, <2>9, <2>10, <2>11, <2>12, <2>13, <2>14, <2>15, <2>16, <2>17, <2>18, <2>19, <2>20, <2>21, <2>22, <2>23, <2>24, <2>25, <2>26, IndNewSplitP
<1>. QED BY <1>1, <1>n DEF IndAll
