(* (S) The invariant layer, the data plane: Submit, Complete, Land, Drop.   *)
(* FlintCatchupTProof's I_Submit / I_Land / I_Drop / I_Complete ported:    *)
(* the stamp is left alone (NoStamp) except Drop's LossS (the barrier and  *)
(* a stamp due when the dropped leg is a member) and Complete's badAck.    *)
(* A completion runs with the barrier down: the release is the members     *)
(* (J_Rel), every member carries the raid's stamp core (J_Cur, so badAck   *)
(* stays FALSE), and the release keeps an in_sync member (J_RelInSync), so *)
(* the completed write landed and an in_sync member holds it.              *)

\* every J conjunct but J_RelHold and J_NoAckBad reads only the stamp, the raid and the record
LEMMA ZD_FJ ==
  ASSUME IndJ, UNCHANGED stampVars, UNCHANGED <<attached, members, zx, dState>>, J_RelHold', J_NoAckBad'
  PROVE  IndJ'
BY F_DueHold, F_JHoldAtt, F_Rel, F_Cur, F_ZxOut, F_Aseq, F_SeqSync, F_MemRel, F_M0, F_RelValid, F_MinorRel,
   F_RelInSync, F_ViewIn, F_ViewOut, F_SoleSeq, F_GenBound, F_ZGen DEF IndJ, stampVars

\* the J conjuncts that read neither the barrier nor the members (Drop's LossS moves those)
LEMMA ZD_FJcore ==
  ASSUME IndJ, UNCHANGED <<stamp, nseq, aseq, asize, rgenA, rmemA, sole, zgen, dState, badAck>>
  PROVE  /\ J_Aseq' /\ J_SeqSync' /\ J_M0' /\ J_RelValid' /\ J_MinorRel' /\ J_RelInSync' /\ J_ViewIn'
         /\ J_ViewOut' /\ J_SoleSeq' /\ J_ZGen' /\ J_NoAckBad'
BY F_Aseq, F_SeqSync, F_M0, F_RelValid, F_MinorRel, F_RelInSync, F_ViewIn, F_ViewOut, F_SoleSeq, F_ZGen,
   F_NoAckBad DEF IndJ

\* --- v7 (FlintCatchupSInd's v7 candidates, NEEDS-INV until 40-ind-base takes them) ----------------
ZD_V7 ==
  /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
  /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
  /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
  /\ J_SoleGen

\* the v7 conjuncts that read only the stamp registers and the record (no data-plane step moves them)
LEMMA ZD_FV7 ==
  ASSUME I_FreshS2, J_ZxIdle, J_SeqLe, J_SoleRel, J_ZLive, J_RelLe, J_ZRel, J_ZNoValid, J_ZM0, J_SoleGen,
         UNCHANGED <<stamp, nseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zrgen, zrmem, zm0, zst>>,
         UNCHANGED <<dState, sb, reverted, zx, attached, sPres, nextSeq, conf, sCon, cutAck>>
  PROVE  /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_ZLive' /\ J_RelLe' /\ J_ZRel'
         /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen'
<1>1. I_FreshS2' BY DEF I_FreshS2, InSyncR
<1>2. J_ZxIdle' BY DEF J_ZxIdle
<1>3. J_SeqLe' BY DEF J_SeqLe
<1>4. J_SoleRel' BY DEF J_SoleRel
<1>5. J_ZLive' BY DEF J_ZLive
<1>6. J_RelLe' BY DEF J_RelLe
<1>7. ZombieReleases' <=> ZombieReleases BY DEF ZombieReleases, Majority, Valid, SolePairs
<1>8. J_ZRel' BY <1>7 DEF J_ZRel, InSyncR
<1>9. J_ZNoValid' BY DEF J_ZNoValid, Valid, Majority, SolePairs
<1>10. J_ZM0' BY DEF J_ZM0
<1>11. J_SoleGen' BY DEF J_SoleGen
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>8, <1>9, <1>10, <1>11

\* a leg's stamp keeps its validity while the stamps and the record's confirmations stay
LEMMA ZD_ValidSame ==
  ASSUME UNCHANGED <<stamp, sole>> PROVE \A q \in R : Valid(stamp[q])' <=> Valid(stamp[q])
BY DEF Valid, Majority, SolePairs

LEMMA ZD_FGenTop ==
  ASSUME J_GenTop, UNCHANGED <<attached, dState, stamp, agen, due, members, sole>> PROVE J_GenTop'
BY DEF J_GenTop, InSyncR, View, Valid, Majority, SolePairs

\* the acked-value orderings, when the acked maps, the snapshots and every catching-up head stay
LEMMA ZD_FHL ==
  ASSUME I_WHiC, I_HeadLoC, I_HeadLoA, I_HeadHiC,
         UNCHANGED <<acked, cutAck, sPres, sCon, dState, reverted, mark>>,
         \A q \in R : CatchingUp(q) => head'[q] = head[q]
  PROVE  I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC'
<1>1. \A x \in Blocks : AckW(x)' = AckW(x) BY DEF AckW
<1>2. \A q \in R : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q) BY DEF CatchingUp, HiOf
<1>3. I_WHiC' BY <1>1 DEF I_WHiC
<1>4. I_HeadLoC' BY <1>1, <1>2 DEF I_HeadLoC
<1>5. I_HeadLoA' BY <1>2 DEF I_HeadLoA
<1>6. I_HeadHiC' BY <1>1, <1>2 DEF I_HeadHiC
<1>. QED BY <1>3, <1>4, <1>5, <1>6

\* a leg catching up has its epoch below nextSeq (a standby's mark, a stale leg's revert = its base)
LEMMA ZD_HiLt ==
  ASSUME TypeOKT, I_Session, I_Reverted, NEW r \in R, CatchingUp(r)
  PROVE  HiOf(r) \in Int /\ HiOf(r) < nextSeq
<1>0. nextSeq \in Nat /\ mark[r] \in Nat /\ reverted[r] \in Int /\ sb[r] \in Int BY Basics
<1>1. SessionOK(r) /\ RevOK(r) BY DEF I_Session, I_Reverted
<1>2. CASE dState[r] = "standby" BY <1>0, <1>1, <1>2 DEF SessionOK, HiOf
<1>3. CASE dState[r] # "standby"
  <2>1. dState[r] = "stale" /\ reverted[r] # -1 BY <1>3 DEF CatchingUp
  <2>2. sb[r] = reverted[r] BY <1>1, <2>1 DEF RevOK
  <2>3. sb[r] < nextSeq BY <1>1, <2>1, <2>2 DEF SessionOK
  <2>. QED BY <1>0, <1>3, <2>2, <2>3 DEF HiOf
<1>. QED BY <1>2, <1>3

\* a snapshot holding a write in flight's version (or more) is at that write's epoch or later, so at nextSeq - 1 or later
LEMMA ZD_SnapHi ==
  ASSUME TypeOKT, I_PendTop, I_SnapPend, I_Pend, NEW w \in pend, NEW q \in R, NEW p \in sPres[q],
         w.v <= sCon[q][p][w.b]
  PROVE  w.cutAt <= p /\ w.cutAt >= nextSeq - 1 /\ w.cutAt \in Nat /\ p \in Nat
<1>0. p \in Epochs /\ Epochs \subseteq Nat BY Basics
<1>1. w.b \in Blocks /\ w.v \in Nat /\ w.cutAt \in Nat /\ sCon[q][p][w.b] \in Nat /\ nextSeq \in Nat BY <1>0, Nats
<1>2. sCon[q][p][w.b] <= w.v BY DEF I_PendTop
<1>3. sCon[q][p][w.b] = w.v BY <1>1, <1>2
<1>4. w.cutAt <= p BY <1>3 DEF I_SnapPend
<1>5. w.cutAt >= nextSeq - 1 BY DEF I_Pend
<1>. QED BY <1>0, <1>1, <1>4, <1>5

-----------------------------------------------------------------------------
LEMMA I_Submit ==
  ASSUME IndInv, ZD_V7, NEW x \in Blocks, Submit(x) /\ NoStamp PROVE IndInv' /\ ZD_V7'
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>K. TypeOKT BY <1>0, TypeOKParts
<1>V. /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
      /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
      /\ J_SoleGen
  BY DEF ZD_V7
<1>a. /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY <1>0 DEF IndT, IndS
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R /\ Healthy \subseteq R /\ Bases \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>K, Basics
<1>u. /\ UNCHANGED <<head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, members, attached, path, dState, mark, reverted, sb, pin>>
      /\ UNCHANGED <<acked, fails, badAdmit, badLoss, ackedEver, restamp, zx>>
      /\ UNCHANGED <<cfgAt, conf, tr, htr, cutAck>>
  BY DEF Submit, trustVars
<1>s. UNCHANGED stampVars /\ UNCHANGED sGhost BY DEF NoStamp
<1>s2. UNCHANGED <<rmemA, badAck, zjv, zpost>> BY <1>s DEF stampVars, sGhost
<1>. DEFINE nw == [b |-> x, v |-> ver + 1, to |-> members, landed |-> {},
                   dropped |-> {}, recAt |-> Latest, cutAt |-> nextSeq]
<1>p. /\ attached /\ ~Pending(x) /\ ver < MaxVer
      /\ ver' = ver + 1 /\ pend' = pend \cup {nw}
  BY DEF Submit
<1>v. ver \in Nat /\ nextSeq \in Nat BY <1>K, Groups DEF TyScalar, Vers
<1>n. \A q \in R : head[q][x] # ver + 1 /\ \A e \in sPres[q] : sCon[q][e][x] # ver + 1
  BY <1>a, <1>K, <1>T, <1>v, Groups DEF I_Vers, TyHead, TySnap, Vers
<1>1. TypeOK' BY <1>0, S_TySubmit
<1>j. IndJ'
  <2>0. \A y \in Blocks : ~Pending(y)' => ~Pending(y) BY <1>p DEF Pending
  <2>1. J_RelHold' BY <1>0, <1>u, <1>s2, <2>0 DEF IndJ, J_RelHold, InSyncR
  <2>2. J_NoAckBad' BY <1>0, <1>s2 DEF IndJ, J_NoAckBad
  <2>. QED BY <1>0, <1>s, <1>u, <2>1, <2>2, ZD_FJ
<1>t. IndT'
  <2>1. I_RangesS' BY <1>a, <1>u, <1>p DEF I_RangesS
  <2>2. /\ I_Lineage' /\ I_Chain' /\ I_MembersS' /\ I_HoldAtt' /\ I_Reverted' /\ I_Session'
        /\ Inv_TrustComplete' /\ I_NoBadLoss' /\ Inv_AckedHeld'
    BY <1>a, <1>u, F_Lineage, F_Chain, F_MembersS, F_HoldAtt, F_Reverted, F_Session, F_TC, F_NoBadLoss,
       F_AckedHeld
  <2>3. I_Pend'
    <3>0. TypeOKT /\ I_Pend /\ I_Vers /\ I_RangesS BY <1>a, <1>K
    <3>N. /\ ver \in Nat /\ nextSeq \in Nat /\ acked[x] \in Nat
          /\ \A w \in pend : w.v \in Nat /\ w.cutAt \in Nat
      BY <3>0, Nats
    <3>1. ver + 1 > acked[x] BY <3>0, <3>N DEF I_Vers
    <3>2. \A w \in pend : w.b # x BY <1>p DEF Pending
    <3>3. cutK # 0 => nextSeq >= cutK BY <3>0, <3>N DEF I_RangesS
    <3>4. \A w1, w2 \in pend' : w1.b = w2.b => w1 = w2 BY <3>0, <3>2, <1>p DEF I_Pend
    <3>5. ASSUME NEW w \in pend'
          PROVE  /\ w.v > acked'[w.b] /\ w.v <= ver'
                 /\ w.landed \cap w.dropped = {}
                 /\ w.landed \cup w.dropped \subseteq w.to
                 /\ members' \subseteq w.to \ w.dropped
                 /\ \A q \in w.landed \cap members' : head'[q][w.b] = w.v
                 /\ w.cutAt <= nextSeq' /\ w.cutAt >= nextSeq' - 1
                 /\ cutK' # 0 => w.cutAt >= cutK'
      <4>1. CASE w = nw BY <4>1, <3>1, <3>3, <3>N, <1>p, <1>u
      <4>2. CASE w \in pend BY <4>2, <3>0, <3>N, <1>p, <1>u DEF I_Pend
      <4>. QED BY <4>1, <4>2, <1>p
    <3>. QED BY <3>4, <3>5 DEF I_Pend
  <2>4. I_PendSeen' BY <1>a, <1>T, <1>u, <1>p, <1>n DEF I_PendSeen
  <2>5. I_Vers'
    <3>1. ver \in Nat /\ (\A y \in Blocks : acked[y] \in Nat)
          /\ (\A q \in R : \A y \in Blocks : head[q][y] \in Nat)
          /\ (\A q \in R : \A e \in Epochs : \A y \in Blocks : sCon[q][e][y] \in Nat)
      BY <1>K, Nats
    <3>2. \A q \in R : sPres[q] \subseteq Epochs BY <1>K, Groups DEF TySnap
    <3>. QED BY <1>a, <1>T, <1>u, <1>p, <3>1, <3>2 DEF I_Vers
  <2>6. I_HeadPend' BY <1>a, <1>T, <1>u, <1>p, <1>n DEF I_HeadPend, CatchingUp, HiOf
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6 DEF IndT
<1>S. IndS'
  <2>1. I_AckedEverS' /\ I_WHiS' /\ I_AckMono' /\ I_HeadLoS' /\ I_FreshS'
    BY <1>a, <1>u, <1>s2, F_AckedEverS, F_WHiS, F_AckMono, F_HeadLoS, F_FreshS
  <2>2. I_LegalS'
    <3>1. \A y \in Blocks : PendVal(y) \subseteq PendVal(y)' BY <1>p DEF PendVal
    <3>. QED BY <1>a, <1>u, <1>s2, <3>1 DEF I_LegalS, LegalV
  <2>. QED BY <2>1, <2>2 DEF IndS
<1>vd. \A q \in R : Valid(stamp[q])' <=> Valid(stamp[q])
  <2>1. UNCHANGED <<stamp, sole>> BY <1>s DEF stampVars
  <2>. QED BY <2>1, ZD_ValidSame
<1>N. ZD_V7'
  <2>1. /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_ZLive' /\ J_RelLe' /\ J_ZRel'
        /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen'
    BY <1>V, <1>u, <1>s, ZD_FV7 DEF stampVars
  <2>2. J_GenTop' BY <1>V, <1>u, <1>s, ZD_FGenTop DEF stampVars
  <2>3. I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC' BY <1>V, <1>u, ZD_FHL
  <2>4. J_RelHoldS' BY <1>V, <1>u, <1>s2 DEF J_RelHoldS, InSyncR
  <2>5. I_SnapPend' BY <1>V, <1>u, <1>p, <1>n DEF I_SnapPend
  <2>6. I_LegalS2' /\ I_StandbyLegal' /\ I_SnapLegal' /\ I_CutLegal' /\ I_InSyncLegal' /\ I_ValidLegal'
    <3>1. \A y \in Blocks : PendVal(y) \subseteq PendVal(y)' BY <1>p DEF PendVal
    <3>2. I_LegalS2' BY <1>V, <1>u, <1>s2, <3>1 DEF I_LegalS2, LegalV2
    <3>3. I_StandbyLegal' BY <1>V, <1>u, <3>1 DEF I_StandbyLegal
    <3>4. I_SnapLegal' BY <1>V, <1>u, <3>1 DEF I_SnapLegal
    <3>5. I_CutLegal' /\ I_InSyncLegal' BY <1>V, <1>u, <3>1 DEF I_CutLegal, I_InSyncLegal, InSyncR
    <3>6. I_ValidLegal' BY <1>V, <1>u, <3>1, <1>vd DEF I_ValidLegal, InSyncR
    <3>. QED BY <3>2, <3>3, <3>4, <3>5, <3>6
  <2>7. I_PendTop'
    <3>1. \A q \in R : head[q][x] <= ver /\ \A e \in sPres[q] : sCon[q][e][x] <= ver BY <1>a DEF I_Vers
    <3>2. \A q \in R : head[q][x] \in Nat /\ \A e \in sPres[q] : sCon[q][e][x] \in Nat BY <1>K, <1>T, Nats
    <3>3. \A q \in R : head[q][x] <= ver + 1 /\ \A e \in sPres[q] : sCon[q][e][x] <= ver + 1
      BY <3>1, <3>2, <1>v
    <3>. QED BY <3>3, <1>V, <1>u, <1>p DEF I_PendTop
  <2>8. I_PendNext' BY <1>V, <1>u, <1>p DEF I_PendNext
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>8 DEF ZD_V7
<1>. QED BY <1>1, <1>j, <1>t, <1>S, <1>N, IndSplitP

-----------------------------------------------------------------------------
LEMMA I_Complete ==
  ASSUME IndInv, ZD_V7, NEW w \in pend,
         Complete(w) /\ badAck' = (badAck \/ (Stamp /\ \E q \in members : Core(stamp[q]) # Core(CurStamp)))
                     /\ UNCHANGED <<stampVars, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  PROVE  IndInv' /\ ZD_V7'
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>K. TypeOKT BY <1>0, TypeOKParts
<1>V. /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
      /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
      /\ J_SoleGen
  BY DEF ZD_V7
<1>a. /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY <1>0 DEF IndT, IndS
<1>J. J_DueHold /\ J_Rel /\ J_Cur /\ J_RelInSync /\ J_RelHold /\ J_NoAckBad BY <1>0 DEF IndJ
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R /\ Healthy \subseteq R /\ Bases \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>K, Basics
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, members, attached, path, dState, mark, reverted, sb, pin>>
      /\ UNCHANGED <<fails, riskRec, badAdmit, badLoss, restamp, zx>>
      /\ UNCHANGED <<cfgAt, conf, tr, htr, cutAck>>
  BY DEF Complete, trustVars
<1>s. UNCHANGED stampVars /\ zjv' = zjv /\ zpost' = zpost OBVIOUS
<1>s2. UNCHANGED <<rmemA, hold, due, stamp, aseq, agen, asize, rgenA>> BY <1>s DEF stampVars
<1>w. w \in Write BY <1>K, Groups DEF TyPend
<1>L. (Cardinality(w.landed) >= WriteQuorum) <=> w.landed # {} BY <1>w, OneLanding DEF Write
<1>p. /\ w.landed \cup w.dropped = w.to /\ pend' = pend \ {w}
      /\ acked' = IF w.landed # {} THEN [acked EXCEPT ![w.b] = w.v] ELSE acked
      /\ ackedEver' = IF w.landed # {} THEN [ackedEver EXCEPT ![w.b] = @ \cup {w.v}] ELSE ackedEver
  BY <1>L DEF Complete
<1>at. attached BY <1>a DEF I_RangesS
<1>nh. ~hold /\ ~due BY <1>J, Full DEF Complete, J_DueHold
<1>rm. rmemA = members BY <1>J, <1>at, <1>nh DEF J_Rel
<1>o. \A u \in pend : u # w => u.b # w.b BY <1>a DEF I_Pend
<1>g. w.v > acked[w.b] /\ w.v \in Nat /\ acked[w.b] \in Nat /\ w.v <= ver /\ w.b \in Blocks
  BY <1>a, <1>K, Nats DEF I_Pend
<1>m. members \subseteq w.landed BY <1>a, <1>p DEF I_Pend
<1>hm. \A q \in members : head[q][w.b] = w.v BY <1>a, <1>m DEF I_Pend
<1>ne. members \cap InSyncR # {} BY <1>J, <1>rm DEF J_RelInSync
<1>ld. w.landed # {} BY <1>ne, <1>m
<1>ak. /\ \A y \in Blocks : y # w.b => acked'[y] = acked[y] /\ ackedEver'[y] = ackedEver[y]
       /\ acked'[w.b] = w.v /\ ackedEver'[w.b] = ackedEver[w.b] \cup {w.v}
  <2>1. /\ acked' = [acked EXCEPT ![w.b] = w.v]
        /\ ackedEver' = [ackedEver EXCEPT ![w.b] = @ \cup {w.v}]
    BY <1>p, <1>ld
  <2>. QED BY <2>1, <1>g, <1>K, Groups DEF TyPend
<1>P. \A y \in Blocks : Pending(y)' <=> (Pending(y) /\ y # w.b) BY <1>p, <1>o DEF Pending
<1>1. TypeOK' BY <1>0, S_TyComplete
<1>j. IndJ'
  <2>1. J_NoAckBad'
    <3>1. \A q \in members : Core(stamp[q]) = Core(CurStamp) BY <1>J, <1>at, <1>nh DEF J_Cur
    <3>2. ~badAck BY <1>J DEF J_NoAckBad
    <3>. QED BY <3>1, <3>2 DEF J_NoAckBad
  <2>2. J_RelHold'
    <3>. SUFFICES ASSUME NEW q \in rmemA \cap InSyncR, NEW y \in Blocks, ~Pending(y)'
                  PROVE  head[q][y] >= acked'[y]
      BY <1>u, <1>s2 DEF J_RelHold, InSyncR
    <3>1. CASE y = w.b BY <3>1, <1>ak, <1>hm, <1>rm, <1>g
    <3>2. CASE y # w.b
      <4>1. ~Pending(y) BY <3>2, <1>P
      <4>. QED BY <4>1, <3>2, <1>ak, <1>J DEF J_RelHold
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <1>0, <1>s, <1>u, <2>1, <2>2, ZD_FJ
<1>t. IndT'
  <2>1. I_RangesS' BY <1>a, <1>u, <1>p, <1>at DEF I_RangesS
  <2>2. /\ I_Lineage' /\ I_Chain' /\ I_MembersS' /\ I_Reverted' /\ I_Session' /\ Inv_TrustComplete'
        /\ I_NoBadLoss'
    BY <1>a, <1>u, F_Lineage, F_Chain, F_MembersS, F_Reverted, F_Session, F_TC, F_NoBadLoss
  <2>3. I_Pend'
    <3>1. \A u \in pend' : acked'[u.b] = acked[u.b] BY <1>p, <1>o, <1>ak, <1>K, Groups DEF TyPend, Write
    <3>. QED BY <1>a, <1>T, <1>u, <1>p, <3>1 DEF I_Pend
  <2>4. I_HoldAtt'
    <3>. SUFFICES ASSUME attached, NEW q \in members, NEW y \in Blocks PROVE head[q][y] >= acked'[y]
      BY <1>u DEF I_HoldAtt
    <3>1. CASE y = w.b BY <3>1, <1>ak, <1>hm, <1>g
    <3>2. CASE y # w.b BY <3>2, <1>ak, <1>a DEF I_HoldAtt
    <3>. QED BY <3>1, <3>2
  <2>5. Inv_AckedHeld'
    <3>. SUFFICES ASSUME NEW y \in Blocks PROVE \E q \in R : dState[q] = "insync" /\ head[q][y] >= acked'[y]
      BY <1>u DEF Inv_AckedHeld
    <3>1. CASE y = w.b
      <4>1. PICK q \in members \cap InSyncR : TRUE BY <1>ne
      <4>2. q \in R /\ dState[q] = "insync" BY <4>1 DEF InSyncR
      <4>. QED BY <3>1, <4>1, <4>2, <1>ak, <1>hm, <1>g
    <3>2. CASE y # w.b BY <3>2, <1>ak, <1>a DEF Inv_AckedHeld
    <3>. QED BY <3>1, <3>2
  <2>6. I_PendSeen' /\ I_HeadPend' BY <1>a, <1>u, <1>p DEF I_PendSeen, I_HeadPend, CatchingUp, HiOf
  <2>7. I_Vers'
    <3>1. \A y \in Blocks : acked'[y] <= ver BY <1>ak, <1>g, <1>a DEF I_Vers
    <3>. QED BY <3>1, <1>a, <1>u DEF I_Vers
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7 DEF IndT
<1>S. IndS'
  <2>1. I_WHiS' /\ I_HeadLoS' /\ I_FreshS'
    BY <1>a, <1>u, <1>s2, F_WHiS, F_HeadLoS, F_FreshS
  <2>2. I_AckedEverS'
    <3>. SUFFICES ASSUME NEW y \in Blocks PROVE acked'[y] \in ackedEver'[y] /\ 0 \in ackedEver'[y]
      BY DEF I_AckedEverS
    <3>1. CASE y = w.b BY <3>1, <1>ak, <1>a DEF I_AckedEverS
    <3>2. CASE y # w.b BY <3>2, <1>ak, <1>a DEF I_AckedEverS
    <3>. QED BY <3>1, <3>2
  <2>3. I_AckMono'
    <3>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres[q], NEW y \in Blocks PROVE cutAck[q][e][y] <= acked'[y]
      BY <1>u DEF I_AckMono
    <3>0. e \in Epochs BY <1>T
    <3>N. cutAck[q][e][y] \in Nat /\ acked[y] \in Nat BY <3>0, <1>K, Nats
    <3>1. cutAck[q][e][y] <= acked[y] BY <1>a DEF I_AckMono
    <3>2. CASE y = w.b BY <3>2, <3>1, <3>N, <1>ak, <1>g
    <3>3. CASE y # w.b BY <3>3, <3>1, <1>ak
    <3>. QED BY <3>2, <3>3
  <2>4. I_LegalS'
    <3>1. \A y \in Blocks : y # w.b => PendVal(y)' = PendVal(y) BY <1>p DEF PendVal
    <3>2. PendVal(w.b) = {w.v} /\ PendVal(w.b)' = {} BY <1>p, <1>o DEF PendVal
    <3>3. \A y \in Blocks : LegalV(y)' = LegalV(y) BY <3>1, <3>2, <1>ak, <1>s DEF LegalV
    <3>. QED BY <1>a, <1>u, <3>3 DEF I_LegalS
  <2>. QED BY <2>1, <2>2, <2>3, <2>4 DEF IndS
<1>vd. \A q \in R : Valid(stamp[q])' <=> Valid(stamp[q])
  <2>1. UNCHANGED <<stamp, sole>> BY <1>s DEF stampVars
  <2>. QED BY <2>1, ZD_ValidSame
<1>N. ZD_V7'
  <2>0. I_Session /\ I_Reverted /\ I_Pend /\ I_RangesS /\ I_HeadPend BY <1>a
  <2>1. /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_ZLive' /\ J_RelLe' /\ J_ZRel'
        /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen'
    BY <1>V, <1>u, <1>s, ZD_FV7 DEF stampVars
  <2>2. J_GenTop' BY <1>V, <1>u, <1>s, ZD_FGenTop DEF stampVars
  <2>3. J_RelHoldS'
    <3>. SUFFICES ASSUME NEW q \in rmemA \cap InSyncR, NEW y \in Blocks PROVE head[q][y] >= acked'[y]
      BY <1>u, <1>s2 DEF J_RelHoldS, InSyncR
    <3>1. CASE y = w.b BY <3>1, <1>ak, <1>hm, <1>rm, <1>g
    <3>2. CASE y # w.b BY <3>2, <1>ak, <1>V DEF J_RelHoldS
