LEMMA I_RevertD ==
  ASSUME IndInv,
         \* (I_SnapPend is this lemma's NEEDS-INV: T's I_RevertD took I_HeadPend from I_Legal, which S drops)
         J_RelHoldS, I_FreshS2, I_LegalS2, I_SnapPend, J_ZxIdle, J_SeqLe, J_SoleRel, J_GenTop, J_ZLive,
         J_RelLe, I_WHiC, I_HeadLoC, I_HeadLoA, I_StandbyLegal, I_HeadHiC, I_SnapLegal, I_PendTop, I_PendNext,
         J_ZRel, I_CutLegal, I_InSyncLegal, I_ValidLegal, J_ZNoValid, J_ZM0, J_SoleGen,
         NEW r \in R, RevertD(r) /\ NoStamp
  PROVE  IndInv' /\ ZS_V7' /\ ZS_V7c'
<1>0. /\ TypeOK /\ TypeOKT /\ TyStampS /\ IndJ
      /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY ZS_Open
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>0, Basics
<1>. DEFINE keep == IF sb[r] = 0 THEN {e \in sPres[r] : e < Min(recorded)}
                                  ELSE {e \in sPres[r] : e <= sb[r]}
<1>. DEFINE base == IF sb[r] = 0 THEN Zero ELSE sCon[r][sb[r]]
<1>so. SessionOK(r) /\ RevOK(r) BY <1>0 DEF I_Session, I_Reverted
<1>g. /\ dState[r] = "stale" /\ path[r] = "back" /\ sb[r] # -1 /\ reverted[r] = -1
      /\ (sb[r] > 0 => sb[r] \in sPres[r])
  BY DEF RevertD
<1>t. /\ sb[r] \in 0..MaxEpoch /\ recorded # {} /\ recorded \subseteq Nat
      /\ Min(recorded) \in recorded /\ \A e \in recorded : Min(recorded) <= e
  <2>1. sb[r] \in 0..MaxEpoch /\ recorded # {} BY <1>so, <1>g, <1>0, Groups DEF SessionOK, TyLeg
  <2>2. recorded \subseteq Nat BY <1>0, Groups DEF TySets, Epochs
  <2>. QED BY <2>1, <2>2, MinProp
<1>c. ChainShape(sPres[r], sPar[r], anc[r]) /\ ChainReads(sPres[r], sPar[r], sAl[r], sCon[r])
  BY <1>0, LegChain
<1>k. /\ keep \subseteq sPres[r]
      /\ \A e \in keep : e <= sb[r] \/ (sb[r] = 0 /\ \A f \in recorded : e < f)
      /\ sb[r] > 0 => sb[r] \in keep
      /\ \A e \in keep : sPar[r][e] # 0 => sPar[r][e] \in keep
      /\ \A e \in sPres[r] : e > sb[r] /\ sb[r] > 0 => e \notin keep
  <2>1. sPres[r] \subseteq Nat BY <1>0, Groups DEF TySnap, Epochs
  <2>2. \A e \in sPres[r] : sPar[r][e] < e /\ (sPar[r][e] # 0 => sPar[r][e] \in sPres[r]) /\ sPar[r][e] \in Nat
    BY <1>c DEF ChainShape
  <2>. QED BY <1>g, <1>t, <2>1, <2>2
<1>b. \A x \in Blocks : base[x] = Up(sPar[r], sCon[r], sb[r], x) /\ base[x] \in Nat
  BY <1>t, <1>g, <1>0, Nats DEF Up, Zero, Epochs
<1>. HIDE DEF keep, base
<1>u. /\ UNCHANGED <<ver, sCon, sAl, sPar, recorded, nextSeq, cutK, cutTgt, cutDone>>
      /\ UNCHANGED <<members, attached, path, dState, mark, sb, pin>>
      /\ UNCHANGED <<pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, restamp, zx>>
      /\ UNCHANGED <<cfgAt, conf, htr>>
      /\ UNCHANGED <<stampVars, sGhost>>
  BY Full DEF RevertD, NoStamp
<1>us. /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zgen>>
       /\ UNCHANGED <<badAck, zjv, zpost>>
  BY ZS_NoStamp
<1>p. /\ sPres' = [sPres EXCEPT ![r] = keep]
      /\ anc' = [anc EXCEPT ![r] = [c \in Epochs |-> IF c \in keep THEN anc[r][c] ELSE {}]]
      /\ tr' = [tr EXCEPT ![r] = @ \cap keep]
      /\ cutAck' = [cutAck EXCEPT ![r] = [c \in Epochs |-> IF c \in keep THEN @[c] ELSE Zero]]
      /\ head' = [head EXCEPT ![r] = base]
      /\ hAl' = [hAl EXCEPT ![r] = {}] /\ hPar' = [hPar EXCEPT ![r] = sb[r]]
      /\ reverted' = [reverted EXCEPT ![r] = sb[r]]
      /\ cutGone' = IF cutK # 0 /\ r \in cutTgt \ cutDone THEN cutGone \cup {r} ELSE cutGone
  BY Full DEF RevertD, keep, base
<1>m. \A q \in R \ {r} : /\ sPres'[q] = sPres[q] /\ anc'[q] = anc[q] /\ tr'[q] = tr[q]
                          /\ cutAck'[q] = cutAck[q] /\ head'[q] = head[q] /\ hAl'[q] = hAl[q]
                          /\ hPar'[q] = hPar[q] /\ reverted'[q] = reverted[q]
  BY <1>p, <1>0, Groups DEF TySnap, TyTrust, TyHead, TyLeg
<1>n. /\ sPres'[r] = keep /\ tr'[r] = tr[r] \cap keep /\ hAl'[r] = {} /\ hPar'[r] = sb[r]
      /\ head'[r] = base /\ reverted'[r] = sb[r]
      /\ \A c \in keep : anc'[r][c] = anc[r][c] /\ cutAck'[r][c] = cutAck[r][c]
      /\ \A c \in Epochs \ keep : anc'[r][c] = {}
  <2>1. /\ sPres'[r] = keep /\ tr'[r] = tr[r] \cap keep /\ hAl'[r] = {} /\ hPar'[r] = sb[r]
        /\ head'[r] = base /\ reverted'[r] = sb[r]
    BY <1>p, <1>0, Groups DEF TySnap, TyTrust, TyHead, TyLeg
  <2>2. /\ anc'[r] = [c \in Epochs |-> IF c \in keep THEN anc[r][c] ELSE {}]
        /\ cutAck'[r] = [c \in Epochs |-> IF c \in keep THEN cutAck[r][c] ELSE Zero]
    BY <1>p, <1>0, Groups DEF TySnap, TyTrust
  <2>3. keep \subseteq Epochs BY <1>k, <1>T
  <2>. QED BY <2>1, <2>2, <2>3
<1>s. r \notin members /\ r \notin InSyncR /\ ~CatchingUp(r)
  BY <1>0, <1>g, <1>so DEF I_MembersS, I_RangesS, InSyncR, CatchingUp
<1>sP. \A q \in R : sPres'[q] \subseteq sPres[q] /\ tr'[q] \subseteq tr[q] /\ tr'[q] \subseteq sPres'[q]
               /\ \A c \in sPres'[q] : cutAck'[q][c] = cutAck[q][c]
  <2>1. \A q \in R : tr[q] \subseteq sPres[q] BY <1>0 DEF I_RangesS
  <2>. QED BY <1>m, <1>n, <1>k, <2>1
<1>hq. \A q \in InSyncR : head'[q] = head[q] BY <1>m, <1>s, <1>T
<1>bv. \A x \in Blocks : base[x] = 0 \/ (sb[r] \in sPres[r] /\ base[x] = sCon[r][sb[r]][x])
  <2>. SUFFICES ASSUME NEW x \in Blocks PROVE base[x] = 0 \/ (sb[r] \in sPres[r] /\ base[x] = sCon[r][sb[r]][x])
    OBVIOUS
  <2>1. CASE sb[r] = 0 BY <2>1, <1>b DEF Up
  <2>2. CASE sb[r] # 0 BY <2>2, <1>b, <1>g, <1>t DEF Up
  <2>. QED BY <2>1, <2>2
<1>1. TypeOK'
  <2>1. (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp OBVIOUS
  <2>. QED BY <2>1, <1>0, S_TyCatchup
<1>2. IndJ'
  <2>1. /\ J_DueHold' /\ J_HoldAtt' /\ J_Rel' /\ J_Cur' /\ J_ZxOut' /\ J_Aseq' /\ J_SeqSync' /\ J_MemRel'
        /\ J_NoAckBad' /\ J_M0'
    BY <1>0, <1>u, <1>us, F_DueHold, F_JHoldAtt, F_Rel, F_Cur, F_ZxOut, F_Aseq, F_SeqSync, F_MemRel,
       F_NoAckBad, F_M0 DEF IndJ
  <2>2. /\ J_RelValid' /\ J_MinorRel' /\ J_RelInSync' /\ J_ViewIn' /\ J_ViewOut' /\ J_SoleSeq'
        /\ J_GenBound' /\ J_ZGen'
    BY <1>0, <1>u, <1>us, F_RelValid, F_MinorRel, F_RelInSync, F_ViewIn, F_ViewOut, F_SoleSeq,
       F_GenBound, F_ZGen DEF IndJ
  <2>3. J_RelHold'
    <3>. SUFFICES ASSUME NEW q \in rmemA' \cap InSyncR', NEW x \in Blocks, ~Pending(x)'
                 PROVE  head'[q][x] >= acked'[x]
      BY DEF J_RelHold
    <3>1. q \in rmemA \cap InSyncR BY <1>u, <1>us DEF InSyncR
    <3>2. ~Pending(x) BY <1>u DEF Pending
    <3>3. head[q][x] >= acked[x] BY <3>1, <3>2, <1>0 DEF IndJ, J_RelHold
    <3>. QED BY <3>1, <3>3, <1>hq, <1>u
  <2>. QED BY <2>1, <2>2, <2>3 DEF IndJ
<1>3. I_RangesS'
  <2>1. tr'[r] \subseteq sPres'[r] BY <1>n
  <2>2. hPar'[r] \in sPres'[r] \cup {0} BY <1>n, <1>k, <1>t
  <2>3. \A q \in R : /\ sPres'[q] \subseteq 1..nextSeq'
                     /\ tr'[q] \subseteq sPres'[q] \cap 1..(nextSeq' - 1)
                     /\ hPar'[q] \in sPres'[q] \cup {0}
    BY <1>0, <1>u, <1>m, <1>sP, <2>1, <2>2 DEF I_RangesS
  <2>4. /\ cutK' # 0 => cutK' = nextSeq'
        /\ ~attached' => pend' = {} /\ cutK' = 0 /\ members' = {}
        /\ recorded' \subseteq 1..(nextSeq' - 1)
        /\ \A e \in Epochs : ~conf'[e] => attached' /\ e < nextSeq'
    BY <1>0, <1>u DEF I_RangesS
  <2>. QED BY <2>3, <2>4 DEF I_RangesS
<1>4. I_Lineage'
  <2>1. ChainShape(keep, sPar[r], anc'[r]) BY <1>c, <1>k, <1>n DEF ChainShape
  <2>. QED BY <1>0, <1>T, <1>m, <1>n, <1>u, <2>1 DEF I_Lineage
<1>5. I_Chain'
  <2>1. ChainReads(keep, sPar[r], sAl[r], sCon[r]) BY <1>c, <1>k DEF ChainReads, Up
  <2>2. \A x \in Blocks : head'[r][x] = Up(sPar[r], sCon[r], hPar'[r], x) BY <1>n, <1>b
  <2>. QED BY <1>0, <1>T, <1>m, <1>n, <1>u, <2>1, <2>2 DEF I_Chain
<1>6. I_Pend' /\ I_MembersS' /\ I_HoldAtt'
  <2>0. \A q \in members : head'[q] = head[q] BY <1>m, <1>s, <1>T
  <2>1. I_Pend'
    <3>. SUFFICES ASSUME NEW w \in pend
                 PROVE  \A q \in w.landed \cap members : head'[q][w.b] = w.v
      BY <1>0, <1>u DEF I_Pend
    <3>. QED BY <2>0, <1>0 DEF I_Pend
  <2>2. I_HoldAtt' BY <2>0, <1>0, <1>u DEF I_HoldAtt
  <2>. QED BY <1>0, <1>u, <2>1, <2>2, F_MembersS
<1>7. I_PendSeen' /\ I_Vers'
  <2>3. I_PendSeen'
    <3>. SUFFICES ASSUME NEW w \in pend,
                        \E q \in R : head'[q][w.b] = w.v \/ \E e \in sPres'[q] : sCon[q][e][w.b] = w.v
                 PROVE  w.landed # {}
      BY <1>u DEF I_PendSeen
    <3>1. w.b \in Blocks /\ w.v >= 1 BY <1>0, Nats
    <3>2. head'[r][w.b] = w.v => sCon[r][sb[r]][w.b] = w.v /\ sb[r] \in sPres[r] BY <3>1, <1>bv, <1>n
    <3>3. \E q \in R : head[q][w.b] = w.v \/ \E e \in sPres[q] : sCon[q][e][w.b] = w.v
      BY <3>2, <1>m, <1>sP
    <3>. QED BY <3>3, <1>0 DEF I_PendSeen
  <2>4. I_Vers'
    <3>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
                 PROVE  head'[q][x] <= ver /\ \A e \in sPres'[q] : sCon[q][e][x] <= ver
      BY <1>u, <1>0 DEF I_Vers
    <3>1. CASE q = r
      <4>1. base[x] = 0 \/ (sb[r] \in sPres[r] /\ base[x] = sCon[r][sb[r]][x]) BY <1>bv
      <4>2. ver \in Nat BY <1>0, Nats
      <4>3. base[x] <= ver BY <4>1, <4>2, <1>0 DEF I_Vers
      <4>4. \A e \in sPres'[r] : sCon[r][e][x] <= ver BY <1>sP, <1>0 DEF I_Vers
      <4>. QED BY <3>1, <4>3, <4>4, <1>n
    <3>2. CASE q # r BY <3>2, <1>m, <1>sP, <1>0 DEF I_Vers
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>3, <2>4
<1>8. I_LegalS'
  <2>0. \A x \in Blocks : LegalV(x)' = LegalV(x) BY <1>u, <1>us DEF LegalV, PendVal
  <2>z. \A x \in Blocks : 0 \in LegalV(x) BY <1>0 DEF I_AckedEverS, LegalV
  <2>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
               PROVE  /\ head'[q][x] \in LegalV(x)
                      /\ \A e \in sPres'[q] : sCon[q][e][x] \in LegalV(x)
    BY <2>0, <1>u DEF I_LegalS
  <2>L. \A q2 \in R : \A y \in Blocks : head[q2][y] \in LegalV(y) /\ \A e \in sPres[q2] : sCon[q2][e][y] \in LegalV(y)
    BY <1>0 DEF I_LegalS
  <2>1. \A e \in sPres'[q] : sCon[q][e][x] \in LegalV(x) BY <1>sP, <2>L
  <2>2. CASE q = r
    <3>1. CASE base[x] = 0 BY <3>1, <2>z, <1>n, <2>2, <2>1
    <3>2. CASE base[x] # 0
      <4>1. sb[r] \in sPres[r] /\ base[x] = sCon[r][sb[r]][x] BY <3>2, <1>bv
      <4>2. sCon[r][sb[r]][x] \in LegalV(x) BY <4>1, <2>L
      <4>. QED BY <4>1, <4>2, <1>n, <2>2, <2>1
    <3>. QED BY <3>1, <3>2, <2>1
  <2>3. CASE q # r
    <3>1. head'[q] = head[q] BY <2>3, <1>m
    <3>2. head[q][x] \in LegalV(x) BY <2>L
    <3>. QED BY <3>1, <3>2, <2>1
  <2>. QED BY <2>2, <2>3
<1>9. I_WHiS' /\ I_AckMono' /\ Inv_TrustComplete'
  <2>1. I_WHiS' BY <1>0, <1>sP DEF I_WHiS
  <2>2. I_AckMono' BY <1>0, <1>u, <1>sP DEF I_AckMono
  <2>3. Inv_TrustComplete' BY <1>0, <1>u, <1>sP DEF Inv_TrustComplete
  <2>. QED BY <2>1, <2>2, <2>3
<1>10. I_HeadLoS'
  <2>1. CatchingUp(r)' /\ HiOf(r)' = sb[r] BY <1>n, <1>g, <1>u DEF CatchingUp, HiOf
  <2>2. \A q \in R \ {r} : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q) BY <1>m, <1>u DEF CatchingUp, HiOf
  <2>4. \A q \in R : \A p \in sPres'[q] : p < sb[r] => \A x \in Blocks : cutAck'[q][p][x] <= base[x]
    <3>. SUFFICES ASSUME NEW q \in R, NEW p \in sPres'[q], p < sb[r], NEW x \in Blocks
                 PROVE  cutAck'[q][p][x] <= base[x]
      OBVIOUS
    <3>2. p \in sPres[q] /\ p \in Epochs /\ cutAck'[q][p] = cutAck[q][p] BY <1>sP, <1>0, Groups DEF TySnap
    <3>0. sb[r] > 0 BY <3>2, <1>t DEF Epochs
    <3>1. sb[r] > 0 /\ sb[r] \in sPres[r] /\ sb[r] \in tr[r] BY <3>0, <1>g, <1>t, <1>so DEF SessionOK
    <3>3. cutAck[q][p][x] <= cutAck[r][sb[r]][x] BY <3>1, <3>2, <1>0 DEF I_WHiS
    <3>4. cutAck[r][sb[r]][x] <= sCon[r][sb[r]][x] BY <3>1, <1>0 DEF Inv_TrustComplete
    <3>5. base[x] = sCon[r][sb[r]][x] BY <3>1, <1>b DEF Up
    <3>6. cutAck[q][p][x] \in Nat /\ cutAck[r][sb[r]][x] \in Nat /\ sCon[r][sb[r]][x] \in Nat
      BY <3>1, <3>2, <1>0, Nats, Groups DEF TySnap
    <3>. QED BY <3>2, <3>3, <3>4, <3>5, <3>6
  <2>5. \A q \in R \ {r} : CatchingUp(q)' => \A q1 \in R : \A p \in sPres'[q1] : p < HiOf(q)' =>
          \A x \in Blocks : cutAck'[q1][p][x] <= head'[q][x]
    BY <1>0, <1>m, <1>sP, <2>2 DEF I_HeadLoS
  <2>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q1 \in R, NEW p \in sPres'[q1], p < HiOf(q)',
