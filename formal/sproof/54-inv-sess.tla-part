(* (S) The invariant layer: the catch-up session's selection, failure and  *)
(* revert (each with NoStamp: the stamp layer carries over by its frames;  *)
(* the leg being caught up is stale, so no J conjunct, Inv_AckedHeld or    *)
(* I_HoldAtt reads its head).  Ported from FlintCatchupTProof's             *)
(* I_SelectBase, I_SessionFail, I_RevertD.                                 *)

\* the invariant's groups, opened
LEMMA ZS_Open ==
  ASSUME IndInv
  PROVE  /\ TypeOK /\ TypeOKT /\ TyStampS /\ IndJ
         /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
         /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
         /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
<1>1. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>2. TypeOKT /\ TyStampS BY <1>1, TypeOKParts
<1>. QED BY <1>1, <1>2 DEF IndT, IndS

\* the stamp variables a NoStamp step leaves alone, one by one
LEMMA ZS_NoStamp ==
  ASSUME NoStamp
  PROVE  /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zseq, zgen, zsize, zm0>>
         /\ UNCHANGED <<zrgen, zrmem, zst, badAck, zjv, zpost>>
BY DEF NoStamp, stampVars, sGhost

\* --- IndInv v7's candidates (FlintCatchupSInd.tla de01921e; main 10-31: NEEDS-INV hypotheses until 40-ind-base
\* takes them): the replacements J_RelHoldS, I_FreshS2, I_LegalS2 and the adds, each proved preserved here
ZS_V7 ==
  /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop /\ J_ZLive
  /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal /\ I_PendTop
  /\ I_PendNext
LEMMA ZS_F_RelHoldS == J_RelHoldS /\ UNCHANGED <<rmemA, dState, head, acked>> => J_RelHoldS'
BY DEF J_RelHoldS, InSyncR
LEMMA ZS_F_FreshS2 == I_FreshS2 /\ UNCHANGED <<dState, rmemA, sPres, nextSeq, conf, sCon, cutAck>> => I_FreshS2'
BY DEF I_FreshS2, InSyncR
LEMMA ZS_F_LegalS2 == I_LegalS2 /\ UNCHANGED <<head, sPres, sCon, ackedEver, pend, zpost>> => I_LegalS2'
BY DEF I_LegalS2, LegalV2, PendVal
LEMMA ZS_F_SnapPend == I_SnapPend /\ UNCHANGED <<sPres, sCon, pend>> => I_SnapPend' BY DEF I_SnapPend
LEMMA ZS_F_ZxIdle == J_ZxIdle /\ UNCHANGED <<zx, dState, sb, reverted, stamp, zseq>> => J_ZxIdle' BY DEF J_ZxIdle
LEMMA ZS_F_SeqLe == J_SeqLe /\ UNCHANGED <<stamp, nseq, sole, zseq>> => J_SeqLe' BY DEF J_SeqLe
LEMMA ZS_F_SoleRel == J_SoleRel /\ UNCHANGED <<sole, nseq, rmemA, asize>> => J_SoleRel' BY DEF J_SoleRel
LEMMA ZS_F_GenTop == J_GenTop /\ UNCHANGED <<attached, dState, stamp, agen, due, members, sole>> => J_GenTop'
BY DEF J_GenTop, InSyncR, View, Valid, Majority, SolePairs
LEMMA ZS_F_ZLive ==
  J_ZLive /\ UNCHANGED <<zx, dState, attached, rmemA, zseq, nseq, zsize, asize, zgen, agen, zrgen, rgenA, zrmem>>
  => J_ZLive'
BY DEF J_ZLive
LEMMA ZS_F_RelLe == J_RelLe /\ UNCHANGED <<rgenA, agen>> => J_RelLe' BY DEF J_RelLe
LEMMA ZS_F_WHiC == I_WHiC /\ UNCHANGED <<sPres, sCon, cutAck, acked>> => I_WHiC' BY DEF I_WHiC, AckW
LEMMA ZS_F_HeadLoC ==
  I_HeadLoC /\ UNCHANGED <<dState, reverted, mark, sPres, sCon, cutAck, acked, head>> => I_HeadLoC'
BY DEF I_HeadLoC, AckW, CatchingUp, HiOf
LEMMA ZS_F_HeadLoA == I_HeadLoA /\ UNCHANGED <<dState, reverted, mark, sPres, sCon, acked, head>> => I_HeadLoA'
BY DEF I_HeadLoA, CatchingUp, HiOf
LEMMA ZS_F_StandbyLegal == I_StandbyLegal /\ UNCHANGED <<dState, head, ackedEver, pend>> => I_StandbyLegal'
BY DEF I_StandbyLegal, PendVal
LEMMA ZS_F_HeadHiC ==
  I_HeadHiC /\ UNCHANGED <<dState, reverted, mark, sPres, cutAck, acked, head>> => I_HeadHiC'
BY DEF I_HeadHiC, AckW, CatchingUp, HiOf
LEMMA ZS_F_SnapLegal == I_SnapLegal /\ UNCHANGED <<sPres, sCon, ackedEver, pend>> => I_SnapLegal'
BY DEF I_SnapLegal, PendVal
LEMMA ZS_F_PendTop == I_PendTop /\ UNCHANGED <<pend, head, sPres, sCon>> => I_PendTop' BY DEF I_PendTop
LEMMA ZS_F_PendNext == I_PendNext /\ UNCHANGED <<pend, nextSeq, sPres>> => I_PendNext' BY DEF I_PendNext
\* the later candidates (Ind e50f1573: inv-zombie, inv-cut, inv-admit), not yet assigned: a group of their own
ZS_V7c == J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0 /\ J_SoleGen
LEMMA ZS_F_ZRel == J_ZRel /\ UNCHANGED <<zx, zm0, zseq, zgen, zsize, zrgen, zrmem, sole, dState>> => J_ZRel'
BY DEF J_ZRel, ZombieReleases, Majority, Valid, SolePairs, InSyncR
LEMMA ZS_F_CutLegal == I_CutLegal /\ UNCHANGED <<cutK, cutTgt, head, ackedEver, pend>> => I_CutLegal'
BY DEF I_CutLegal, PendVal
LEMMA ZS_F_InSyncLegal == I_InSyncLegal /\ UNCHANGED <<attached, dState, head, ackedEver, pend>> => I_InSyncLegal'
BY DEF I_InSyncLegal, InSyncR, PendVal
LEMMA ZS_F_ValidLegal == I_ValidLegal /\ UNCHANGED <<dState, stamp, sole, head, ackedEver, pend>> => I_ValidLegal'
BY DEF I_ValidLegal, InSyncR, Valid, Majority, SolePairs, PendVal
LEMMA ZS_F_ZNoValid == J_ZNoValid /\ UNCHANGED <<zx, zst, dState, stamp, sole>> => J_ZNoValid'
BY DEF J_ZNoValid, Valid, Majority, SolePairs
LEMMA ZS_F_ZM0 == J_ZM0 /\ UNCHANGED <<zx, zm0, zsize>> => J_ZM0' BY DEF J_ZM0
LEMMA ZS_F_SoleGen == J_SoleGen /\ UNCHANGED <<sole, nseq, agen>> => J_SoleGen' BY DEF J_SoleGen
\* the stamp-only ones of the group carry over by their frames
LEMMA ZS_F_V7cStamp ==
  ASSUME ZS_V7c, NoStamp, UNCHANGED <<zx, dState>> PROVE J_ZRel' /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen'
<1>1. UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zseq, zgen, zsize, zm0>>
      /\ UNCHANGED <<zrgen, zrmem, zst, badAck, zjv, zpost>>
  BY ZS_NoStamp
<1>. QED BY <1>1, ZS_F_ZRel, ZS_F_ZNoValid, ZS_F_ZM0, ZS_F_SoleGen DEF ZS_V7c

\* every v7 candidate a step that leaves the stamp alone carries over by its frame, but the five it names
LEMMA ZS_F_V7Stamp ==
  ASSUME ZS_V7, NoStamp, UNCHANGED <<zx, dState, attached, members>>
  PROVE  J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe'
<1>1. UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zseq, zgen, zsize, zm0>>
      /\ UNCHANGED <<zrgen, zrmem, zst, badAck, zjv, zpost>>
  BY ZS_NoStamp
<1>. QED BY <1>1, ZS_F_SeqLe, ZS_F_SoleRel, ZS_F_GenTop, ZS_F_ZLive, ZS_F_RelLe DEF ZS_V7

\* the acked values (AckW) are numbers
LEMMA ZS_AckWNat == ASSUME TypeOKT, NEW x \in Blocks PROVE AckW(x) \subseteq Nat
<1>1. \A q \in R : sPres[q] \subseteq Epochs BY Basics
<1>2. acked[x] \in Nat /\ \A q \in R : \A e \in Epochs : cutAck[q][e][x] \in Nat BY Nats
<1>. QED BY <1>1, <1>2 DEF AckW

LEMMA I_SelectBase ==
  ASSUME IndInv,
         J_RelHoldS, I_FreshS2, I_LegalS2, I_SnapPend, J_ZxIdle, J_SeqLe, J_SoleRel, J_GenTop, J_ZLive,
         J_RelLe, I_WHiC, I_HeadLoC, I_HeadLoA, I_StandbyLegal, I_HeadHiC, I_SnapLegal, I_PendTop, I_PendNext,
         J_ZRel, I_CutLegal, I_InSyncLegal, I_ValidLegal, J_ZNoValid, J_ZM0, J_SoleGen,
         NEW r \in R, SelectBase(r) /\ NoStamp
  PROVE  IndInv' /\ ZS_V7' /\ ZS_V7c'
<1>0. /\ TypeOK /\ TypeOKT /\ IndJ
      /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY ZS_Open
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>0, Basics
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, members, attached, path, dState, mark>>
      /\ UNCHANGED <<pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, restamp, zx>>
      /\ UNCHANGED <<cfgAt, conf, tr, htr, cutAck>>
      /\ UNCHANGED <<stampVars, sGhost>>
  BY DEF SelectBase, trustVars, NoStamp
<1>us. UNCHANGED <<rmemA, zjv, zpost>> BY ZS_NoStamp
<1>g. dState[r] = "stale" /\ path[r] = "back" /\ sb[r] = -1 /\ recorded # {} BY DEF SelectBase
<1>r. reverted[r] = -1 BY <1>0, <1>g DEF I_Session, SessionOK
<1>p. PICK b \in BaseCandidates(r) \cup {0} :
        LET b2 == IF CoverageWalk /\ b # 0 /\ CoverSet(r, Tgt, b) = {} THEN 0 ELSE b
        IN /\ sb' = [sb EXCEPT ![r] = b2]
           /\ reverted' = [reverted EXCEPT ![r] = IF reverted[r] = b2 /\ ~mustRev[r] THEN reverted[r] ELSE -1]
  BY DEF SelectBase
<1>q. PICK b2 \in BaseCandidates(r) \cup {0} :
        /\ sb' = [sb EXCEPT ![r] = b2] /\ reverted' = [reverted EXCEPT ![r] = -1]
  <2>1. BaseCandidates(r) \subseteq Epochs BY <1>0, <1>T, Groups DEF BaseCandidates, TySets
  <2>2. b \in Nat BY <2>1, <1>T DEF Epochs
  <2>. QED BY <1>p, <1>r, <2>2
<1>rv. reverted' = reverted BY <1>q, <1>r, <1>0, Groups DEF TyLeg
<1>c. b2 # 0 => b2 \in recorded /\ b2 \in sPres[r] /\ b2 \in tr[r] BY <1>q, Full DEF BaseCandidates
<1>n. b2 \in 0..(nextSeq - 1) /\ b2 # -1
  <2>1. recorded \subseteq 1..(nextSeq - 1) BY <1>0 DEF I_RangesS
  <2>2. nextSeq \in 1..(MaxEpoch + 1) BY <1>0, Groups DEF TyScalar
  <2>. QED BY <1>c, <2>1, <2>2
<1>s. pin'[r] = (IF b2 = 0 THEN Min(recorded) ELSE b2) /\ \A q \in R \ {r} : pin'[q] = pin[q]
  BY <1>q, <1>0, Full, Groups DEF SelectBase, TyLeg
<1>a. \A q \in R \ {r} : sb'[q] = sb[q] /\ reverted'[q] = reverted[q] BY <1>q, <1>rv, <1>0, Groups DEF TyLeg
<1>1. TypeOK'
  <2>1. (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp OBVIOUS
  <2>. QED BY <2>1, <1>0, S_TyCatchup
<1>2. IndJ' BY <1>0, <1>u, F_IndJ
<1>3. /\ I_RangesS' /\ I_Lineage' /\ I_Chain' /\ I_Pend' /\ I_MembersS' /\ I_HoldAtt' /\ I_PendSeen'
      /\ I_Vers' /\ I_HeadPend' /\ Inv_TrustComplete' /\ I_NoBadLoss' /\ Inv_AckedHeld'
  BY <1>0, <1>u, <1>rv, F_RangesS, F_Lineage, F_Chain, F_Pend, F_MembersS, F_HoldAtt, F_PendSeen, F_Vers,
     F_HeadPend, F_TC, F_NoBadLoss, F_AckedHeld
<1>4. IndS'
  <2>1. I_AckedEverS' /\ I_LegalS' /\ I_WHiS' /\ I_AckMono'
    BY <1>0, <1>u, <1>us, F_AckedEverS, F_LegalS, F_WHiS, F_AckMono
  <2>2. I_HeadLoS' /\ I_FreshS' BY <1>0, <1>u, <1>us, <1>rv, F_HeadLoS, F_FreshS
  <2>. QED BY <2>1, <2>2 DEF IndS
<1>5. I_Reverted'
  <2>1. \A q \in R \ {r} : RevOK(q)' BY <1>0, <1>T, <1>u, <1>a, RevOther DEF I_Reverted
  <2>2. RevOK(r)'
    <3>1. reverted'[r] = -1 BY <1>rv, <1>r
    <3>. QED BY <3>1 DEF RevOK
  <2>. QED BY <2>1, <2>2 DEF I_Reverted
<1>6. I_Session'
  <2>0. sb'[r] = b2 BY <1>q, <1>0, Groups DEF TyLeg
  <2>1. sb'[r] # -1 => dState'[r] = "stale" /\ sb'[r] < nextSeq' /\ recorded' # {}
    <3>1. dState'[r] = "stale" /\ nextSeq' = nextSeq /\ recorded' = recorded BY <1>g, <1>u
    <3>2. b2 < nextSeq BY <1>n, <1>T
    <3>. QED BY <2>0, <3>1, <3>2, <1>g
  <2>2. dState'[r] = "stale" /\ sb'[r] > 0 => pin'[r] = sb'[r] /\ sb'[r] \in recorded
    BY <2>0, <1>s, <1>c, <1>u, <1>0, <1>T
  <2>3. dState'[r] = "stale" /\ sb'[r] > 0 /\ reverted'[r] = -1 /\ sb'[r] \in sPres'[r] => sb'[r] \in tr'[r]
    BY <2>0, <1>c, <1>u
  <2>4. \A q \in R \ {r} : SessionOK(q)' BY <1>0, <1>T, <1>u, <1>a, <1>s, SessionOther DEF I_Session
  <2>5. SessionOK(r)'
    <3>1. dState'[r] = "stale" /\ reverted'[r] = -1 /\ ~CatchingUp(r)'
      BY <1>u, <1>g, <1>rv, <1>r DEF CatchingUp
    <3>2. sb'[r] # -1 /\ dState'[r] # "insync" /\ dState'[r] # "standby" BY <3>1, <2>0, <1>n
    <3>3. recorded' = recorded /\ nextSeq' = nextSeq /\ cutK' = cutK BY <1>u
    <3>. QED BY <3>1, <3>2, <3>3, <2>1, <2>2, <2>3 DEF SessionOK
  <2>. QED BY <2>4, <2>5 DEF I_Session
<1>7. IndT' BY <1>3, <1>5, <1>6 DEF IndT
<1>v. ZS_V7'
  <2>0. UNCHANGED <<stamp, zseq>> BY ZS_NoStamp
  <2>1. J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe' BY <1>u, ZS_F_V7Stamp DEF ZS_V7
  <2>2. J_RelHoldS' /\ I_FreshS2' /\ I_LegalS2' /\ I_SnapPend' /\ I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA'
        /\ I_StandbyLegal'
    BY <1>u, <1>us, <1>rv, ZS_F_RelHoldS, ZS_F_FreshS2, ZS_F_LegalS2, ZS_F_SnapPend, ZS_F_WHiC, ZS_F_HeadLoC,
       ZS_F_HeadLoA, ZS_F_StandbyLegal DEF ZS_V7
  <2>3. I_HeadHiC' /\ I_SnapLegal' /\ I_PendTop' /\ I_PendNext'
    BY <1>u, <1>rv, ZS_F_HeadHiC, ZS_F_SnapLegal, ZS_F_PendTop, ZS_F_PendNext DEF ZS_V7
  <2>4. J_ZxIdle'
    <3>1. r # zx BY Full DEF SelectBase
    <3>2. zx # 0 => zx \in R \ {r} BY <3>1, <1>0, Groups DEF TyScalar
    <3>3. J_ZxIdle BY DEF ZS_V7
    <3>. QED BY <3>2, <3>3, <1>a, <1>rv, <1>u, <2>0 DEF J_ZxIdle
  <2>. QED BY <2>1, <2>2, <2>3, <2>4 DEF ZS_V7
<1>vc. ZS_V7c'
  <2>1. J_ZRel' /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen' BY <1>u, ZS_F_V7cStamp DEF ZS_V7c
  <2>2. I_CutLegal' /\ I_InSyncLegal' /\ I_ValidLegal'
    BY <1>u, ZS_NoStamp, ZS_F_CutLegal, ZS_F_InSyncLegal, ZS_F_ValidLegal DEF ZS_V7c
  <2>. QED BY <2>1, <2>2 DEF ZS_V7c
<1>. QED BY <1>1, <1>2, <1>7, <1>4, <1>v, <1>vc, IndSplitP

LEMMA I_SessionFail ==
  ASSUME IndInv,
         J_RelHoldS, I_FreshS2, I_LegalS2, I_SnapPend, J_ZxIdle, J_SeqLe, J_SoleRel, J_GenTop, J_ZLive,
         J_RelLe, I_WHiC, I_HeadLoC, I_HeadLoA, I_StandbyLegal, I_HeadHiC, I_SnapLegal, I_PendTop, I_PendNext,
         J_ZRel, I_CutLegal, I_InSyncLegal, I_ValidLegal, J_ZNoValid, J_ZM0, J_SoleGen,
         NEW r \in R, SessionFail(r) /\ NoStamp
  PROVE  IndInv' /\ ZS_V7' /\ ZS_V7c'
<1>0. /\ TypeOK /\ TypeOKT /\ IndJ
      /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY ZS_Open
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>0, Basics
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, members, attached, path, dState, mark, pin>>
      /\ UNCHANGED <<pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, restamp, zx>>
      /\ UNCHANGED <<cfgAt, conf, tr, htr, cutAck>>
      /\ UNCHANGED <<stampVars, sGhost>>
  BY DEF SessionFail, trustVars, NoStamp
<1>us. UNCHANGED <<rmemA, zjv, zpost>> BY ZS_NoStamp
<1>p. /\ dState[r] = "stale" /\ sb' = [sb EXCEPT ![r] = -1] /\ reverted' = [reverted EXCEPT ![r] = -1]
  BY DEF SessionFail
<1>a. \A q \in R \ {r} : sb'[q] = sb[q] /\ reverted'[q] = reverted[q] BY <1>p, <1>0, Groups DEF TyLeg
<1>r. sb'[r] = -1 /\ reverted'[r] = -1 BY <1>p, <1>0, Groups DEF TyLeg
<1>b. ~CatchingUp(r)' /\ \A q \in R \ {r} : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q)
  BY <1>u, <1>p, <1>a, <1>r DEF CatchingUp, HiOf
<1>1. TypeOK'
  <2>1. (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp OBVIOUS
  <2>. QED BY <2>1, <1>0, S_TyCatchup
<1>2. IndJ' BY <1>0, <1>u, F_IndJ
<1>3. /\ I_RangesS' /\ I_Lineage' /\ I_Chain' /\ I_Pend' /\ I_MembersS' /\ I_HoldAtt' /\ I_PendSeen'
      /\ I_Vers' /\ Inv_TrustComplete' /\ I_NoBadLoss' /\ Inv_AckedHeld'
  BY <1>0, <1>u, F_RangesS, F_Lineage, F_Chain, F_Pend, F_MembersS, F_HoldAtt, F_PendSeen, F_Vers,
     F_TC, F_NoBadLoss, F_AckedHeld
<1>4. I_HeadPend'
  <2>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW w \in pend', head'[q][w.b] = w.v
               PROVE  w.cutAt <= HiOf(q)'
    BY DEF I_HeadPend
  <2>1. q # r BY <1>b
  <2>. QED BY <2>1, <1>b, <1>u, <1>0 DEF I_HeadPend
<1>5. I_HeadLoS'
  <2>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q2 \in R, NEW p \in sPres'[q2], p < HiOf(q)',
                      NEW x \in Blocks
               PROVE  cutAck'[q2][p][x] <= head'[q][x]
    BY DEF I_HeadLoS
  <2>1. q # r BY <1>b
  <2>. QED BY <2>1, <1>b, <1>u, <1>0 DEF I_HeadLoS
<1>6. IndS'
  <2>1. I_AckedEverS' /\ I_LegalS' /\ I_WHiS' /\ I_AckMono' /\ I_FreshS'
    BY <1>0, <1>u, <1>us, F_AckedEverS, F_LegalS, F_WHiS, F_AckMono, F_FreshS
  <2>. QED BY <2>1, <1>5 DEF IndS
<1>7. I_Reverted'
  <2>1. \A q \in R \ {r} : RevOK(q)' BY <1>0, <1>T, <1>u, <1>a, RevOther DEF I_Reverted
  <2>2. RevOK(r)' BY <1>r DEF RevOK
  <2>. QED BY <2>1, <2>2 DEF I_Reverted
<1>8. I_Session'
  <2>1. \A q \in R \ {r} : SessionOK(q)' BY <1>0, <1>T, <1>u, <1>a, SessionOther DEF I_Session
  <2>2. SessionOK(r)'
    <3>1. sb'[r] = -1 /\ reverted'[r] = -1 /\ dState'[r] = "stale" BY <1>r, <1>p, <1>u
    <3>. QED BY <3>1, <1>b DEF SessionOK
  <2>. QED BY <2>1, <2>2 DEF I_Session
<1>9. IndT' BY <1>3, <1>4, <1>7, <1>8 DEF IndT
<1>v. ZS_V7'
  <2>0. UNCHANGED <<stamp, zseq>> BY ZS_NoStamp
  <2>1. J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe' BY <1>u, ZS_F_V7Stamp DEF ZS_V7
  <2>2. J_RelHoldS' /\ I_FreshS2' /\ I_LegalS2' /\ I_SnapPend' /\ I_WHiC' /\ I_StandbyLegal'
    BY <1>u, <1>us, ZS_F_RelHoldS, ZS_F_FreshS2, ZS_F_LegalS2, ZS_F_SnapPend, ZS_F_WHiC, ZS_F_StandbyLegal
    DEF ZS_V7
  <2>6. I_SnapLegal' /\ I_PendTop' /\ I_PendNext' BY <1>u, ZS_F_SnapLegal, ZS_F_PendTop, ZS_F_PendNext DEF ZS_V7
  <2>7. I_HeadHiC'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q2 \in R, NEW e2 \in sPres'[q2], e2 > HiOf(q)',
                        NEW x \in Blocks, NEW v \in AckW(x)', v <= head'[q][x]
                 PROVE  v <= cutAck'[q2][e2][x]
      BY DEF I_HeadHiC
    <3>1. q # r BY <1>b
    <3>2. AckW(x)' = AckW(x) BY <1>u DEF AckW
    <3>3. I_HeadHiC BY DEF ZS_V7
    <3>. QED BY <3>1, <3>2, <3>3, <1>b, <1>u DEF I_HeadHiC
  <2>3. I_HeadLoC'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q2 \in R, NEW p \in sPres'[q2], p < HiOf(q)',
                        NEW x \in Blocks, NEW v \in AckW(x)', v <= sCon'[q2][p][x]
                 PROVE  v <= head'[q][x]
      BY DEF I_HeadLoC
    <3>1. q # r BY <1>b
    <3>2. AckW(x)' = AckW(x) BY <1>u DEF AckW
    <3>3. I_HeadLoC BY DEF ZS_V7
    <3>. QED BY <3>1, <3>2, <3>3, <1>b, <1>u DEF I_HeadLoC
  <2>5. I_HeadLoA'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q2 \in R, NEW p \in sPres'[q2], p < HiOf(q)',
                        NEW x \in Blocks, acked'[x] <= sCon'[q2][p][x]
                 PROVE  acked'[x] <= head'[q][x]
      BY DEF I_HeadLoA
    <3>1. q # r BY <1>b
    <3>3. I_HeadLoA BY DEF ZS_V7
    <3>. QED BY <3>1, <3>3, <1>b, <1>u DEF I_HeadLoA
  <2>4. J_ZxIdle'
    <3>. SUFFICES ASSUME zx' # 0
                 PROVE  dState'[zx'] # "standby" /\ sb'[zx'] = -1 /\ reverted'[zx'] = -1 /\ stamp'[zx'].seq = zseq'
      BY DEF J_ZxIdle
    <3>1. zx \in R /\ zx # 0 BY <1>u, <1>0, Groups DEF TyScalar
    <3>2. dState[zx] # "standby" /\ sb[zx] = -1 /\ reverted[zx] = -1 /\ stamp[zx].seq = zseq
      BY <3>1 DEF ZS_V7, J_ZxIdle
    <3>3. sb'[zx] = -1 /\ reverted'[zx] = -1 BY <3>1, <3>2, <1>a, <1>r
    <3>. QED BY <3>2, <3>3, <1>u, <2>0
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7 DEF ZS_V7
<1>vc. ZS_V7c'
