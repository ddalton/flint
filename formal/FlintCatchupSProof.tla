  <2>4. I_SnapPend' /\ I_PendTop' /\ I_PendNext' BY <1>V, <1>u, <1>p DEF I_SnapPend, I_PendTop, I_PendNext
  <2>5. I_LegalS2' /\ I_StandbyLegal' /\ I_SnapLegal' /\ I_CutLegal' /\ I_InSyncLegal' /\ I_ValidLegal'
    <3>1. \A y \in Blocks : y # w.b => PendVal(y)' = PendVal(y) BY <1>p DEF PendVal
    <3>2. PendVal(w.b) = {w.v} /\ PendVal(w.b)' = {} BY <1>p, <1>o DEF PendVal
    <3>3. \A y \in Blocks : ackedEver'[y] \cup PendVal(y)' = ackedEver[y] \cup PendVal(y) BY <3>1, <3>2, <1>ak
    <3>4. \A y \in Blocks : LegalV2(y)' = LegalV2(y) BY <3>3, <1>s DEF LegalV2
    <3>5. I_LegalS2' BY <3>4, <1>V, <1>u DEF I_LegalS2
    <3>6. I_StandbyLegal' /\ I_SnapLegal' BY <3>3, <1>V, <1>u DEF I_StandbyLegal, I_SnapLegal
    <3>7. I_CutLegal' /\ I_InSyncLegal' BY <3>3, <1>V, <1>u DEF I_CutLegal, I_InSyncLegal, InSyncR
    <3>8. I_ValidLegal' BY <3>3, <1>V, <1>u, <1>vd DEF I_ValidLegal, InSyncR
    <3>. QED BY <3>5, <3>6, <3>7, <3>8
  <2>a. \A y \in Blocks : \A v \in AckW(y)' : v \in AckW(y) \/ (y = w.b /\ v = w.v) BY <1>ak, <1>u DEF AckW
  <2>c. \A q \in R : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q) BY <1>u DEF CatchingUp, HiOf
  <2>6. I_WHiC'
    <3>. SUFFICES ASSUME NEW q \in R, NEW q2 \in R, NEW p \in sPres[q], NEW e2 \in sPres[q2], p < e2,
                        NEW y \in Blocks, NEW v \in AckW(y)', v <= sCon[q][p][y]
                 PROVE  v <= cutAck[q2][e2][y]
      BY <1>u DEF I_WHiC
    <3>1. CASE v \in AckW(y) BY <3>1, <1>V DEF I_WHiC
    <3>2. CASE y = w.b /\ v = w.v
      <4>0. w.v <= sCon[q][p][w.b] BY <3>2
      <4>1. w.cutAt <= p /\ w.cutAt >= nextSeq - 1 /\ w.cutAt \in Nat /\ p \in Nat
        BY <4>0, <1>K, <1>V, <2>0, ZD_SnapHi
      <4>2. e2 <= nextSeq /\ e2 \in Nat BY <2>0, <1>T DEF I_RangesS
      <4>3. e2 = nextSeq BY <4>1, <4>2, <1>T
      <4>4. w.cutAt = nextSeq BY <4>3, <1>V DEF I_PendNext
      <4>. QED BY <4>1, <4>2, <4>3, <4>4, <1>T
    <3>. QED BY <3>1, <3>2, <2>a
  <2>7. I_HeadLoC'
    <3>. SUFFICES ASSUME NEW r \in R, CatchingUp(r), NEW q \in R, NEW p \in sPres[q], p < HiOf(r),
                        NEW y \in Blocks, NEW v \in AckW(y)', v <= sCon[q][p][y]
                 PROVE  v <= head[r][y]
      BY <1>u, <2>c DEF I_HeadLoC
    <3>1. CASE v \in AckW(y) BY <3>1, <1>V DEF I_HeadLoC
    <3>2. CASE y = w.b /\ v = w.v
      <4>0. w.v <= sCon[q][p][w.b] BY <3>2
      <4>1. w.cutAt <= p /\ w.cutAt >= nextSeq - 1 /\ w.cutAt \in Nat /\ p \in Nat
        BY <4>0, <1>K, <1>V, <2>0, ZD_SnapHi
      <4>2. HiOf(r) \in Int /\ HiOf(r) < nextSeq BY <1>K, <2>0, ZD_HiLt
      <4>. QED BY <4>1, <4>2, <1>T
    <3>. QED BY <3>1, <3>2, <2>a
  <2>8. I_HeadLoA'
    <3>. SUFFICES ASSUME NEW r \in R, CatchingUp(r), NEW q \in R, NEW p \in sPres[q], p < HiOf(r),
                        NEW y \in Blocks, acked'[y] <= sCon[q][p][y]
                 PROVE  acked'[y] <= head[r][y]
      BY <1>u, <2>c DEF I_HeadLoA
    <3>1. CASE y # w.b BY <3>1, <1>ak, <1>V DEF I_HeadLoA
    <3>2. CASE y = w.b
      <4>0. w.v <= sCon[q][p][w.b] BY <3>2, <1>ak
      <4>1. w.cutAt <= p /\ w.cutAt >= nextSeq - 1 /\ w.cutAt \in Nat /\ p \in Nat
        BY <4>0, <1>K, <1>V, <2>0, ZD_SnapHi
      <4>2. HiOf(r) \in Int /\ HiOf(r) < nextSeq BY <1>K, <2>0, ZD_HiLt
      <4>. QED BY <4>1, <4>2, <1>T
    <3>. QED BY <3>1, <3>2
  <2>9. I_HeadHiC'
    <3>. SUFFICES ASSUME NEW r \in R, CatchingUp(r), NEW q2 \in R, NEW e2 \in sPres[q2], e2 > HiOf(r),
                        NEW y \in Blocks, NEW v \in AckW(y)', v <= head[r][y]
                 PROVE  v <= cutAck[q2][e2][y]
      BY <1>u, <2>c DEF I_HeadHiC
    <3>1. CASE v \in AckW(y) BY <3>1, <1>V DEF I_HeadHiC
    <3>2. CASE y = w.b /\ v = w.v
      <4>0. head[r][w.b] \in Nat /\ head[r][w.b] <= w.v BY <1>K, <1>V, <1>g, Nats DEF I_PendTop
      <4>1. head[r][w.b] = w.v BY <4>0, <3>2, <1>g
      <4>2. w.cutAt <= HiOf(r) BY <4>1, <2>0 DEF I_HeadPend
      <4>3. HiOf(r) \in Int /\ HiOf(r) < nextSeq BY <1>K, <2>0, ZD_HiLt
      <4>4. w.cutAt >= nextSeq - 1 /\ w.cutAt \in Nat BY <2>0, <1>K, Nats DEF I_Pend
      <4>5. e2 <= nextSeq /\ e2 \in Nat BY <2>0, <1>T DEF I_RangesS
      <4>6. e2 = nextSeq BY <4>2, <4>3, <4>4, <4>5, <1>T
      <4>7. w.cutAt = nextSeq BY <4>6, <1>V DEF I_PendNext
      <4>. QED BY <4>2, <4>3, <4>7, <1>T
    <3>. QED BY <3>1, <3>2, <2>a
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>8, <2>9 DEF ZD_V7
