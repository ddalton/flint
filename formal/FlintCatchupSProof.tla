    BY DEF I_FreshS
  <2>4. q \in BasesS /\ q \in R /\ f \in sPres[q] /\ f \in Epochs BY <2>2, <2>3, <1>u, <1>T
  <2>5. f >= nextSeq \/ ~conf[f] BY <2>4, <2>1
  <2>. QED BY <2>4, <2>5, <1>u, <1>0 DEF I_FreshS
<1>v. ZC_V7'
  <2>1. J_RelHoldS' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe' /\ I_StandbyLegal' /\ J_ZRel'
    BY <1>u, ZC_KeepV7
  <2>2. I_LegalS2' /\ I_SnapPend' /\ I_WHiC' BY <1>u, <1>z, ZC_FLegalS2, ZC_FSnapPend, ZC_FWHiC DEF ZC_V7
  <2>4. I_HeadLoC' /\ I_HeadLoA'
    <3>1. \A x \in Blocks : AckW(x)' = AckW(x) BY <1>u, ZC_FAckW
    <3>2. I_HeadLoC' BY <3>1, <1>h, <1>u DEF ZC_V7, I_HeadLoC
    <3>3. I_HeadLoA' BY <1>h, <1>u DEF ZC_V7, I_HeadLoA
    <3>. QED BY <3>2, <3>3
  <2>3. I_FreshS2'
