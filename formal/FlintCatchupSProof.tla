    <3>1. zx \in R /\ zx # 0 BY <1>u, <1>0, Groups DEF TyScalar
    <3>2. dState[zx] # "standby" /\ sb[zx] = -1 /\ reverted[zx] = -1 /\ stamp[zx].seq = zseq
      BY <3>1, <2>V DEF J_ZxIdle
    <3>3. zx # r BY <3>2, <1>g
    <3>4. reverted'[zx] = -1 BY <3>1, <3>2, <3>3, <1>m
    <3>. QED BY <3>2, <3>4, <1>u, <2>0
  <2>5. I_LegalS2'
    <3>0. \A x \in Blocks : LegalV2(x)' = LegalV2(x) BY <1>u, <1>us DEF LegalV2, PendVal
    <3>z. \A x \in Blocks : 0 \in LegalV2(x) BY <1>0 DEF I_AckedEverS, LegalV2
    <3>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
                 PROVE  /\ head'[q][x] \in LegalV2(x)
                        /\ \A e \in sPres'[q] : sCon[q][e][x] \in LegalV2(x)
      BY <3>0, <1>u DEF I_LegalS2
    <3>L. \A q2 \in R : \A y \in Blocks :
            head[q2][y] \in LegalV2(y) /\ \A e \in sPres[q2] : sCon[q2][e][y] \in LegalV2(y)
      BY <2>V DEF I_LegalS2
    <3>1. \A e \in sPres'[q] : sCon[q][e][x] \in LegalV2(x) BY <1>sP, <3>L
    <3>2. CASE q = r
      <4>1. CASE base[x] = 0 BY <4>1, <3>z, <1>n, <3>2, <3>1
      <4>2. CASE base[x] # 0
        <5>1. sb[r] \in sPres[r] /\ base[x] = sCon[r][sb[r]][x] BY <4>2, <1>bv
        <5>2. sCon[r][sb[r]][x] \in LegalV2(x) BY <5>1, <3>L
        <5>. QED BY <5>1, <5>2, <1>n, <3>2, <3>1
      <4>. QED BY <4>1, <4>2, <3>1
    <3>3. CASE q # r
      <4>1. head'[q] = head[q] BY <3>3, <1>m
      <4>2. head[q][x] \in LegalV2(x) BY <3>L
      <4>. QED BY <4>1, <4>2, <3>1
    <3>. QED BY <3>2, <3>3
  <2>6. I_StandbyLegal'
    <3>. SUFFICES ASSUME NEW q \in R, dState'[q] = "standby", NEW x \in Blocks
                 PROVE  head'[q][x] \in ackedEver'[x] \cup PendVal(x)'
      BY DEF I_StandbyLegal
    <3>1. q # r /\ dState[q] = "standby" BY <1>g, <1>u
    <3>2. head'[q] = head[q] BY <3>1, <1>m
    <3>3. PendVal(x)' = PendVal(x) BY <1>u DEF PendVal
    <3>. QED BY <3>1, <3>2, <3>3, <1>u, <2>V DEF I_StandbyLegal
  <2>7. I_WHiC'
    <3>. SUFFICES ASSUME NEW q \in R, NEW q2 \in R, NEW p \in sPres'[q], NEW e2 \in sPres'[q2], p < e2,
                        NEW x \in Blocks, NEW v \in AckW(x)', v <= sCon'[q][p][x]
                 PROVE  v <= cutAck'[q2][e2][x]
      BY DEF I_WHiC
    <3>1. p \in sPres[q] /\ e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <1>sP
    <3>2. v \in AckW(x) BY <2>A
    <3>. QED BY <3>1, <3>2, <1>u, <2>V DEF I_WHiC
  \* the reverted leg: an acked value an older snapshot holds is in the base's cut (I_WHiC), so in the base
  \* (trusted: Inv_TrustComplete)
  <2>8. \A q \in R : \A p \in sPres'[q] : p < sb[r] =>
          \A x \in Blocks : \A v \in AckW(x) : v <= sCon[q][p][x] => v <= base[x]
    <3>. SUFFICES ASSUME NEW q \in R, NEW p \in sPres'[q], p < sb[r], NEW x \in Blocks, NEW v \in AckW(x),
                        v <= sCon[q][p][x]
                 PROVE  v <= base[x]
      OBVIOUS
    <3>2. p \in sPres[q] /\ p \in Epochs BY <1>sP, <1>0, Groups DEF TySnap
    <3>0. sb[r] > 0 BY <3>2, <1>t DEF Epochs
    <3>1. sb[r] \in sPres[r] /\ sb[r] \in tr[r] BY <3>0, <1>g, <1>t, <1>so DEF SessionOK
    <3>3. v <= cutAck[r][sb[r]][x] BY <3>1, <3>2, <2>V DEF I_WHiC
    <3>4. cutAck[r][sb[r]][x] <= sCon[r][sb[r]][x] BY <3>1, <1>0 DEF Inv_TrustComplete
    <3>5. base[x] = sCon[r][sb[r]][x] BY <3>0, <1>b DEF Up
    <3>6. v \in Nat /\ cutAck[r][sb[r]][x] \in Nat /\ sCon[r][sb[r]][x] \in Nat
      BY <3>1, <2>A, <1>0, Nats, Groups DEF TySnap
    <3>. QED BY <3>3, <3>4, <3>5, <3>6
  <2>c. /\ CatchingUp(r)' /\ HiOf(r)' = sb[r]
        /\ \A q \in R \ {r} : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q)
    BY <1>n, <1>g, <1>m, <1>u DEF CatchingUp, HiOf
  <2>9. I_HeadLoC'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q2 \in R, NEW p \in sPres'[q2], p < HiOf(q)',
                        NEW x \in Blocks, NEW v \in AckW(x)', v <= sCon'[q2][p][x]
                 PROVE  v <= head'[q][x]
      BY DEF I_HeadLoC
    <3>0. v \in AckW(x) /\ p \in sPres[q2] BY <2>A, <1>sP
    <3>1. CASE q = r BY <3>0, <3>1, <2>c, <2>8, <1>n, <1>u
    <3>2. CASE q # r BY <3>0, <3>2, <2>c, <1>m, <1>u, <2>V DEF I_HeadLoC
    <3>. QED BY <3>1, <3>2
  <2>10. I_HeadLoA'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q2 \in R, NEW p \in sPres'[q2], p < HiOf(q)',
                        NEW x \in Blocks, acked'[x] <= sCon'[q2][p][x]
                 PROVE  acked'[x] <= head'[q][x]
      BY DEF I_HeadLoA
    <3>0. acked[x] \in AckW(x) /\ p \in sPres[q2] BY <1>sP DEF AckW
    <3>1. CASE q = r BY <3>0, <3>1, <2>c, <2>8, <1>n, <1>u
    <3>2. CASE q # r BY <3>0, <3>2, <2>c, <1>m, <1>u, <2>V DEF I_HeadLoA
    <3>. QED BY <3>1, <3>2
  <2>11. I_HeadHiC'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q2 \in R, NEW e2 \in sPres'[q2], e2 > HiOf(q)',
                        NEW x \in Blocks, NEW v \in AckW(x)', v <= head'[q][x]
                 PROVE  v <= cutAck'[q2][e2][x]
      BY DEF I_HeadHiC
    <3>0. v \in AckW(x) /\ v \in Nat /\ e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <2>A, <1>sP
    <3>n. cutAck[q2][e2][x] \in Nat BY <3>0, <1>0, Nats, Groups DEF TySnap
    <3>1. CASE q = r
      <4>1. head'[q][x] = base[x] /\ e2 > sb[r] BY <3>1, <1>n, <2>c
      <4>2. CASE sb[r] = 0
        <5>1. base[x] = 0 BY <4>2, <1>b DEF Up
        <5>. QED BY <5>1, <4>1, <3>0, <3>n
      <4>3. CASE sb[r] # 0
        <5>1. sb[r] \in sPres[r] /\ base[x] = sCon[r][sb[r]][x] BY <4>3, <1>g, <1>t, <1>b DEF Up
        <5>2. v <= sCon[r][sb[r]][x] BY <5>1, <4>1
        <5>. QED BY <5>1, <5>2, <4>1, <3>0, <2>V DEF I_WHiC
      <4>. QED BY <4>2, <4>3
    <3>2. CASE q # r BY <3>0, <3>2, <2>c, <1>m, <1>u, <2>V DEF I_HeadHiC
    <3>. QED BY <3>1, <3>2
  <2>12. I_SnapLegal'
    <3>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres'[q], NEW x \in Blocks
                 PROVE  sCon'[q][e][x] \in ackedEver'[x] \cup PendVal(x)'
      BY DEF I_SnapLegal
    <3>1. e \in sPres[q] BY <1>sP
    <3>2. PendVal(x)' = PendVal(x) BY <1>u DEF PendVal
    <3>. QED BY <3>1, <3>2, <1>u, <2>V DEF I_SnapLegal
  <2>13. I_PendTop'
    <3>. SUFFICES ASSUME NEW w \in pend, NEW q \in R
                 PROVE  head'[q][w.b] <= w.v /\ \A e \in sPres'[q] : sCon[q][e][w.b] <= w.v
      BY <1>u DEF I_PendTop
    <3>1. w.b \in Blocks /\ w.v \in Nat /\ w.v >= 1 BY <1>0, Nats
    <3>2. \A e \in sPres'[q] : sCon[q][e][w.b] <= w.v BY <1>sP, <2>V DEF I_PendTop
    <3>3. CASE q = r
      <4>1. base[w.b] = 0 \/ (sb[r] \in sPres[r] /\ base[w.b] = sCon[r][sb[r]][w.b]) BY <3>1, <1>bv
      <4>2. sb[r] \in sPres[r] => sCon[r][sb[r]][w.b] <= w.v BY <2>V DEF I_PendTop
      <4>. QED BY <4>1, <4>2, <3>1, <3>2, <3>3, <1>n
    <3>4. CASE q # r
      <4>1. head'[q] = head[q] BY <3>4, <1>m
      <4>2. head[q][w.b] <= w.v BY <2>V DEF I_PendTop
      <4>. QED BY <4>1, <4>2, <3>2
    <3>. QED BY <3>3, <3>4
  <2>14. I_PendNext'
    <3>. SUFFICES ASSUME NEW w \in pend, NEW q \in R, nextSeq \in sPres'[q] PROVE w.cutAt = nextSeq
      BY <1>u DEF I_PendNext
    <3>. QED BY <1>sP, <2>V DEF I_PendNext
  <2>. QED BY <2>s, <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>9, <2>10, <2>11, <2>12, <2>13, <2>14 DEF ZS_V7
<1>vc. ZS_V7c'
  <2>V. I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ I_SnapLegal /\ I_AckedEverS BY <1>0 DEF ZS_V7c, ZS_V7
  <2>P. \A x \in Blocks : PendVal(x)' = PendVal(x) BY <1>u DEF PendVal
  <2>1. J_ZRel' /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen' BY <1>u, ZS_F_V7cStamp DEF ZS_V7c
  <2>2. I_CutLegal'
    <3>. SUFFICES ASSUME cutK' # 0, NEW q \in cutTgt', NEW x \in Blocks
                 PROVE  head'[q][x] \in ackedEver'[x] \cup PendVal(x)'
      BY DEF I_CutLegal
    <3>0. cutK # 0 /\ q \in cutTgt /\ q \in R /\ PendVal(x)' = PendVal(x) /\ ackedEver' = ackedEver
      BY <1>u, <1>T, <2>P
    <3>1. CASE q = r
      <4>1. head'[q][x] = base[x] BY <3>1, <1>n
      <4>2. CASE base[x] = 0
        <5>1. 0 \in ackedEver[x] BY <2>V DEF I_AckedEverS
        <5>. QED BY <5>1, <4>1, <4>2, <3>0
      <4>3. CASE base[x] # 0
        <5>1. sb[r] \in sPres[r] /\ base[x] = sCon[r][sb[r]][x] BY <4>3, <1>bv
        <5>2. sCon[r][sb[r]][x] \in ackedEver[x] \cup PendVal(x) BY <5>1, <2>V DEF I_SnapLegal
        <5>. QED BY <5>1, <5>2, <4>1, <3>0
      <4>. QED BY <4>2, <4>3
    <3>2. CASE q # r
      <4>1. head'[q] = head[q] BY <3>2, <3>0, <1>m
      <4>2. head[q][x] \in ackedEver[x] \cup PendVal(x) BY <3>0, <2>V DEF I_CutLegal
      <4>. QED BY <4>1, <4>2, <3>0
    <3>. QED BY <3>1, <3>2
  <2>3. I_InSyncLegal'
    <3>. SUFFICES ASSUME attached', NEW q \in InSyncR', NEW x \in Blocks
                 PROVE  head'[q][x] \in ackedEver'[x] \cup PendVal(x)'
      BY DEF I_InSyncLegal
    <3>1. q \in InSyncR /\ attached BY <1>u DEF InSyncR
    <3>. QED BY <3>1, <1>hq, <1>u, <2>P, <2>V DEF I_InSyncLegal
  <2>4. I_ValidLegal'
    <3>. SUFFICES ASSUME NEW q \in InSyncR', Valid(stamp[q])', NEW x \in Blocks
                 PROVE  head'[q][x] \in ackedEver'[x] \cup PendVal(x)'
      BY DEF I_ValidLegal
    <3>0. UNCHANGED <<stamp, sole>> BY ZS_NoStamp
    <3>1. q \in InSyncR /\ Valid(stamp[q]) BY <3>0, <1>u DEF InSyncR, Valid, Majority, SolePairs
    <3>. QED BY <3>1, <1>hq, <1>u, <2>P, <2>V DEF I_ValidLegal
  <2>. QED BY <2>1, <2>2, <2>3, <2>4 DEF ZS_V7c
<1>. QED BY <1>1, <1>2, <1>16, <1>17, <1>v, <1>vc, IndSplitP

\* --- the final form (main 10-31): the whole invariant IndAll == IndInv /\ IndNew (41-ind-new) ------------------
LEMMA I_SelectBaseAll ==
  ASSUME IndInv, IndNew, NEW r \in R, SelectBase(r) /\ NoStamp PROVE IndInv' /\ IndNew'
<1>1. /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
      /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
      /\ J_SoleGen /\ J_ZCut
  BY IndNewSplit
<1>2. IndInv' /\ ZS_V7' /\ ZS_V7c' BY <1>1, I_SelectBase
<1>3. J_ZCut' BY <1>1, F_ZCut DEF SelectBase
<1>. QED BY <1>2, <1>3, IndNewSplitP DEF ZS_V7, ZS_V7c

LEMMA I_SessionFailAll ==
  ASSUME IndInv, IndNew, NEW r \in R, SessionFail(r) /\ NoStamp PROVE IndInv' /\ IndNew'
<1>1. /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
      /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
      /\ J_SoleGen /\ J_ZCut
  BY IndNewSplit
<1>2. IndInv' /\ ZS_V7' /\ ZS_V7c' BY <1>1, I_SessionFail
<1>3. J_ZCut' BY <1>1, F_ZCut DEF SessionFail
<1>. QED BY <1>2, <1>3, IndNewSplitP DEF ZS_V7, ZS_V7c

LEMMA I_RevertDAll ==
  ASSUME IndInv, IndNew, NEW r \in R, RevertD(r) /\ NoStamp PROVE IndInv' /\ IndNew'
<1>1. /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
      /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
      /\ J_SoleGen /\ J_ZCut
  BY IndNewSplit
<1>2. IndInv' /\ ZS_V7' /\ ZS_V7c' BY <1>1, I_RevertD
<1>3. J_ZCut' BY <1>1, F_ZCut DEF RevertD
<1>. QED BY <1>2, <1>3, IndNewSplitP DEF ZS_V7, ZS_V7c

-----------------------------------------------------------------------------
(* (S) The invariant layer, the copy (copy_chain_and_align): BulkCopy and  *)
(* Chase, each with NoStamp.  The leg r copied onto is stale or standby    *)
(* before and after, so InSyncR, the members, their heads and the stamp    *)
(* stay (ZY_Keep); the lineage, the session and the contents are           *)
(* FlintCatchupTProof's CopyFacts / CopySnap / CopyHeadOnly / I_BulkCopy / *)
(* I_Chase on I_RangesS, with the S restatements over cutAck and the v7    *)
(* candidates (acked-value forms I_WHiC, I_HeadLoC, I_HeadHiC).            *)

\* the invariant's groups, opened, and closed again
LEMMA ZY_Open ==
  ASSUME IndInv
  PROVE  /\ TypeOK /\ TypeOKT /\ IndJ
         /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
         /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
         /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
BY IndSplit, TypeOKParts DEF IndT, IndS

LEMMA ZY_Close ==
  ASSUME TypeOK', IndJ',
         I_RangesS', I_Lineage', I_Chain', I_Pend', I_MembersS', I_HoldAtt', I_PendSeen', I_Vers',
         I_Reverted', I_HeadPend', I_Session', Inv_TrustComplete', I_NoBadLoss', Inv_AckedHeld',
         I_AckedEverS', I_LegalS', I_WHiS', I_AckMono', I_HeadLoS', I_FreshS'
  PROVE  IndInv'
BY IndSplitP DEF IndT, IndS

\* the v7 candidates (main, 10-31, FlintCatchupSInd.tla): assumed by name, proved primed, until IndInv carries them
\* (J_RelHoldS, I_FreshS2, I_LegalS2 replace J_RelHold, I_FreshS, I_LegalS; the old ones are proved too)
ZY_V7 ==
  /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
  /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
  /\ I_PendTop /\ I_PendNext

\* NEEDS-INV (G1, sent to main 10-31): a copy's untouched blocks already hold what its target's cut acked.  T had it
\* from I_HeadLo; S's I_HeadLoS reads only the older cuts' acked maps (a value in flight at the base's parent cut and
\* acked by the target's is not on it).  ZY_CopyLoC derives it from the candidate I_HeadLoC.
ZY_CopyLo ==
  \A rr \in R : CatchingUp(rr) =>
    \A ss \in InSyncR \ {rr} : \A tt \in tr[ss] : \A x \in Blocks :
      tt \in Lin(ss) /\ HiOf(rr) <= tt /\ (HiOf(rr) = 0 \/ HiOf(rr) \in Lin(ss)) /\ x \notin Copied(ss, HiOf(rr), tt)
        => cutAck[ss][tt][x] <= head[rr][x]

\* --- FlintCatchupTProof's helpers, on I_RangesS ---------------------------------------------
LEMMA ZY_CoverSetFacts ==
  ASSUME NEW r \in R, NEW t, NEW b, NEW s \in CoverSet(r, t, b)
  PROVE  s \in Sources(r) /\ t \in Lin(s) /\ (b <= 0 \/ b \in Lin(s)) /\ t \in tr[s]
<1>1. Sources(r) \subseteq R BY DEF Sources
<1>2. Sources(r) # {} => First(Sources(r)) \in Sources(r) BY <1>1, RNat, MinProp DEF First
<1>. QED BY <1>2, Full DEF CoverSet, Covers, LinCovers

LEMMA ZY_TgtFacts ==
  ASSUME I_RangesS, TypeOKT, Tgt # 0
  PROVE  Tgt \in recorded /\ Tgt \in Epochs /\ Tgt < nextSeq /\ Tgt >= 1
<1>0. TySets /\ TyScalar BY Groups
<1>1. Tgt \in recorded /\ Tgt \in Epochs BY <1>0, TgtType
<1>2. nextSeq \in Nat /\ recorded \subseteq 1..(nextSeq - 1) BY <1>0, Const DEF TyScalar, I_RangesS
<1>. QED BY <1>1, <1>2 DEF Epochs

LEMMA ZY_LinPrefix ==
  ASSUME I_Lineage, I_RangesS, TypeOKT, NEW s \in R, NEW t \in Lin(s)
  PROVE  /\ t \in sPres[s] /\ hPar[s] \in sPres[s]
         /\ anc[s][t] = {g \in Lin(s) : g <= t}
<1>1. hPar[s] # 0 /\ Lin(s) = anc[s][hPar[s]] BY DEF Lin, AncOf
<1>2. hPar[s] \in sPres[s] BY <1>1 DEF I_RangesS
<1>3. ChainShape(sPres[s], sPar[s], anc[s]) BY DEF I_Lineage
<1>4. anc[s][hPar[s]] \subseteq sPres[s] BY <1>2, <1>3, AncBound
<1>5. anc[s][t] = {g \in anc[s][hPar[s]] : g <= t} BY <1>1, <1>2, <1>3, AncPrefix
<1>. QED BY <1>1, <1>2, <1>4, <1>5

LEMMA ZY_LinSub ==
  ASSUME I_Lineage, I_RangesS, TypeOKT, NEW s \in R PROVE Lin(s) \subseteq sPres[s]
<1>1. CASE hPar[s] = 0 BY <1>1 DEF Lin, AncOf
<1>2. CASE hPar[s] # 0
  <2>1. hPar[s] \in sPres[s] BY <1>2 DEF I_RangesS
  <2>2. ChainShape(sPres[s], sPar[s], anc[s]) BY DEF I_Lineage
  <2>. QED BY <1>2, <2>1, <2>2, AncBound DEF Lin, AncOf
<1>. QED BY <1>1, <1>2

LEMMA ZY_LegExtend ==
  ASSUME I_Lineage, I_Chain, I_RangesS, TypeOKT, NEW q \in R, NEW k \in Epochs,
         k \notin sPres[q], hPar[q] < k,
         sPres'[q] = sPres[q] \cup {k}, sPar'[q][k] = hPar[q],
         anc'[q][k] = {k} \cup (IF hPar[q] = 0 THEN {} ELSE anc[q][hPar[q]]),
         \A e \in sPres[q] : /\ sPar'[q][e] = sPar[q][e] /\ anc'[q][e] = anc[q][e]
                            /\ sAl'[q][e] = sAl[q][e] /\ sCon'[q][e] = sCon[q][e],
         \A x \in Blocks : x \notin sAl'[q][k] => sCon'[q][k][x] = Up(sPar[q], sCon[q], hPar[q], x)
  PROVE  ChainShape(sPres'[q], sPar'[q], anc'[q]) /\ ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q])
<1>1. ChainShape(sPres[q], sPar[q], anc[q]) /\ ChainReads(sPres[q], sPar[q], sAl[q], sCon[q])
  BY DEF I_Lineage, I_Chain
<1>2. hPar[q] \in sPres[q] \cup {0} /\ hPar[q] \in 0..MaxEpoch BY DEF I_RangesS, TypeOKT, TyHead
<1>3. \A e \in sPres[q] : /\ sPar[q][e] \in 0..MaxEpoch /\ sPar[q][e] < e
                         /\ (sPar[q][e] # 0 => sPar[q][e] \in sPres[q] /\ sPar[q][e] # k)
                         /\ anc[q][e] = {e} \cup (IF sPar[q][e] = 0 THEN {} ELSE anc[q][sPar[q][e]])
  BY <1>1 DEF ChainShape
<1>4. sPres[q] \subseteq Epochs BY DEF TypeOKT, TySnap
<1>5. ChainShape(sPres'[q], sPar'[q], anc'[q])
  <2>1. sPres'[q] \subseteq Epochs BY <1>4
  <2>2. ASSUME NEW e \in sPres'[q]
        PROVE  /\ sPar'[q][e] \in 0..MaxEpoch /\ sPar'[q][e] < e
               /\ (sPar'[q][e] # 0 => sPar'[q][e] \in sPres'[q])
               /\ anc'[q][e] = {e} \cup (IF sPar'[q][e] = 0 THEN {} ELSE anc'[q][sPar'[q][e]])
    <3>1. CASE e = k
      <4>1. hPar[q] # 0 => anc'[q][hPar[q]] = anc[q][hPar[q]] BY <1>2
      <4>. QED BY <3>1, <1>2, <4>1
    <3>2. CASE e # k
      <4>1. e \in sPres[q] BY <3>2
      <4>2. sPar[q][e] # 0 => anc'[q][sPar[q][e]] = anc[q][sPar[q][e]] BY <4>1, <1>3
      <4>. QED BY <4>1, <4>2, <1>3
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2 DEF ChainShape
<1>6. ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q])
  <2>. SUFFICES ASSUME NEW e \in sPres'[q], NEW x \in Blocks, x \notin sAl'[q][e]
               PROVE  sCon'[q][e][x] = Up(sPar'[q], sCon'[q], sPar'[q][e], x)
    BY DEF ChainReads
  <2>1. CASE e = k
    <3>1. hPar[q] # 0 => sCon'[q][hPar[q]] = sCon[q][hPar[q]] BY <1>2
    <3>. QED BY <2>1, <3>1 DEF Up
  <2>2. CASE e # k
    <3>1. e \in sPres[q] /\ x \notin sAl[q][e] BY <2>2
    <3>2. sCon[q][e][x] = Up(sPar[q], sCon[q], sPar[q][e], x) BY <3>1, <1>1 DEF ChainReads
    <3>3. sPar[q][e] # 0 => sCon'[q][sPar[q][e]] = sCon[q][sPar[q][e]] BY <3>1, <1>3
    <3>. QED BY <3>1, <3>2, <3>3 DEF Up
  <2>. QED BY <2>1, <2>2
<1>. QED BY <1>5, <1>6

LEMMA ZY_CopyRead ==
  ASSUME I_Lineage, I_Chain, I_RangesS, TypeOKT, NEW s \in R, NEW t \in Lin(s),
         NEW lo \in Nat, lo = 0 \/ (lo \in Lin(s) /\ lo <= t), NEW x \in Blocks
  PROVE  LET H == {e \in CopyElems(s, lo, t) : x \in sAl[s][e]}
         IN  /\ H # {} => Max(H) \in H /\ sCon[s][Max(H)][x] = sCon[s][t][x]
             /\ H = {} /\ lo # 0 => sCon[s][t][x] = Up(sPar[s], sCon[s], sPar[s][lo], x)
             /\ H = {} /\ lo = 0 => sCon[s][t][x] = 0
<1>. DEFINE H == {e \in CopyElems(s, lo, t) : x \in sAl[s][e]}
<1>0. ChainShape(sPres[s], sPar[s], anc[s]) /\ ChainReads(sPres[s], sPar[s], sAl[s], sCon[s])
  BY LegChain
<1>1. t \in sPres[s] /\ anc[s][t] = {g \in Lin(s) : g <= t} BY ZY_LinPrefix
<1>2. Lin(s) \subseteq Nat BY LinType DEF TypeOKT, TyHead, TySnap, Epochs
<1>3. H = {f \in anc[s][t] : lo <= f /\ x \in sAl[s][f]} BY <1>1, <1>2 DEF CopyElems
<1>4. CASE lo # 0
  <2>1. lo \in anc[s][t] BY <1>1, <1>4
  <2>2. /\ RT(anc[s], sAl[s], t, lo, x) = {} => sCon[s][t][x] = Up(sPar[s], sCon[s], sPar[s][lo], x)
        /\ RT(anc[s], sAl[s], t, lo, x) # {} =>
              /\ Max(RT(anc[s], sAl[s], t, lo, x)) \in RT(anc[s], sAl[s], t, lo, x)
              /\ sCon[s][t][x] = sCon[s][Max(RT(anc[s], sAl[s], t, lo, x))][x]
    <3>1. ChainShape(sPres[s], sPar[s], anc[s]) /\ ChainReads(sPres[s], sPar[s], sAl[s], sCon[s]) BY <1>0
    <3>2. t \in sPres[s] /\ lo \in anc[s][t] BY <1>1, <2>1
    <3>. QED BY <3>1, <3>2, ReadAt
  <2>3. H = RT(anc[s], sAl[s], t, lo, x) BY <1>3 DEF RT
  <2>. QED BY <1>4, <2>2, <2>3
<1>5. CASE lo = 0
  <2>1. \A f \in anc[s][t] : 0 <= f BY <1>1, <1>2
  <2>2. H = {f \in anc[s][t] : x \in sAl[s][f]} BY <1>3, <1>5, <2>1
  <2>a. H = RTall(anc[s], sAl[s], t, x) BY <2>2 DEF RTall
  <2>b. ChainShape(sPres[s], sPar[s], anc[s]) /\ ChainReads(sPres[s], sPar[s], sAl[s], sCon[s]) /\ t \in sPres[s]
    BY <1>0, <1>1
  <2>3. H # {} => Max(H) \in H /\ sCon[s][t][x] = sCon[s][Max(H)][x]
    <3>1. RTall(anc[s], sAl[s], t, x) # {} =>
            Max(RTall(anc[s], sAl[s], t, x)) \in RTall(anc[s], sAl[s], t, x)
            /\ sCon[s][t][x] = sCon[s][Max(RTall(anc[s], sAl[s], t, x))][x]
      BY <2>b, ReadMax
    <3>. QED BY <3>1, <2>a
  <2>4. H = {} => sCon[s][t][x] = 0
    <3>1. \A e \in sPres[s] : (\A f \in anc[s][e] : x \notin sAl[s][f]) => sCon[s][e][x] = 0
      BY <2>b, ReadBottom
    <3>. QED BY <3>1, <2>b, <2>2
  <2>. QED BY <1>5, <2>3, <2>4
<1>. QED BY <1>4, <1>5

\* the acked values a cut recorded (AckW), as membership; each is a number, at most the acked map
LEMMA ZY_AckWIn ==
  ASSUME NEW x, NEW v
  PROVE  /\ v \in AckW(x) <=> (v = acked[x] \/ \E q \in R : \E e \in sPres[q] : v = cutAck[q][e][x])
         /\ v \in AckW(x)' <=> (v = acked'[x] \/ \E q \in R : \E e \in sPres'[q] : v = cutAck'[q][e][x])
BY DEF AckW

LEMMA ZY_AckWNat ==
  ASSUME TypeOKT, I_AckMono, NEW x \in Blocks, NEW v \in AckW(x)
  PROVE  v \in Nat /\ v <= acked[x]
<1>1. CASE v = acked[x] BY <1>1, Nats
<1>2. CASE \E q \in R : \E e \in sPres[q] : v = cutAck[q][e][x]
  <2>1. PICK q \in R : \E e \in sPres[q] : v = cutAck[q][e][x] BY <1>2
  <2>2. PICK e \in sPres[q] : v = cutAck[q][e][x] BY <2>1
  <2>3. e \in Epochs BY Groups DEF TySnap
  <2>. QED BY <2>2, <2>3, Nats DEF I_AckMono
<1>. QED BY <1>1, <1>2, ZY_AckWIn

\* --- what the copy leaves alone: the J layer and the record's legs -----------------------------
LEMMA ZY_IndJ ==
  ASSUME IndJ,
         UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zgen, badAck>>,
         UNCHANGED <<attached, members, zx, acked, pend>>,
         InSyncR' = InSyncR, \A q \in InSyncR : head'[q] = head[q]
  PROVE  IndJ'
<1>0. /\ J_DueHold /\ J_HoldAtt /\ J_Rel /\ J_Cur /\ J_ZxOut /\ J_Aseq /\ J_SeqSync /\ J_MemRel /\ J_RelHold
      /\ J_NoAckBad /\ J_M0 /\ J_RelValid /\ J_MinorRel /\ J_RelInSync /\ J_ViewIn /\ J_ViewOut /\ J_SoleSeq
      /\ J_GenBound /\ J_ZGen
  BY DEF IndJ
<1>1. /\ J_DueHold' /\ J_HoldAtt' /\ J_Rel' /\ J_Cur' /\ J_ZxOut' /\ J_Aseq' /\ J_MemRel' /\ J_NoAckBad'
      /\ J_RelValid' /\ J_GenBound' /\ J_ZGen'
  BY <1>0, F_DueHold, F_JHoldAtt, F_Rel, F_Cur, F_ZxOut, F_Aseq, F_MemRel, F_NoAckBad, F_RelValid,
     F_GenBound, F_ZGen
<1>2. J_SeqSync' BY <1>0 DEF J_SeqSync
<1>3. J_RelHold' BY <1>0 DEF J_RelHold, Pending
<1>4. J_M0' BY <1>0 DEF J_M0, SeqLegs
<1>5. J_MinorRel' /\ J_RelInSync' BY <1>0 DEF J_MinorRel, J_RelInSync, RelStamp, Majority
<1>6. J_ViewIn' /\ J_ViewOut' BY <1>0 DEF J_ViewIn, J_ViewOut, View, Valid, Majority, SolePairs
<1>7. J_SoleSeq' BY <1>0 DEF J_SoleSeq
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>7 DEF IndJ

LEMMA ZY_Keep ==
  ASSUME IndInv, ZY_V7, NoStamp, NEW r \in R,
         dState[r] # "insync", dState'[r] # "insync", zx # r,
         UNCHANGED <<attached, members, zx, acked, pend, nextSeq, conf, badLoss, ackedEver>>,
         \A q \in R \ {r} : /\ head'[q] = head[q] /\ sPres'[q] = sPres[q] /\ sCon'[q] = sCon[q]
                           /\ cutAck'[q] = cutAck[q] /\ dState'[q] = dState[q] /\ sb'[q] = sb[q]
                           /\ reverted'[q] = reverted[q]
  PROVE  /\ IndJ' /\ I_MembersS' /\ I_HoldAtt' /\ Inv_AckedHeld' /\ I_FreshS' /\ I_AckedEverS' /\ I_NoBadLoss'
         /\ J_RelHoldS' /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe'
<1>0. /\ TypeOK /\ TypeOKT /\ IndJ /\ I_MembersS /\ I_HoldAtt /\ Inv_AckedHeld /\ I_FreshS /\ I_AckedEverS
      /\ I_NoBadLoss
  BY ZY_Open
<1>v. J_RelHoldS /\ I_FreshS2 /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop /\ J_ZLive /\ J_RelLe BY DEF ZY_V7
<1>s. UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zseq, zgen, zsize, zm0,
                  zrgen, zrmem, zst, badAck>>
  BY DEF NoStamp, stampVars, sGhost
<1>T. members \subseteq R /\ InSyncR \subseteq R BY <1>0, Basics
<1>i. InSyncR' = InSyncR /\ r \notin InSyncR BY DEF InSyncR
<1>m. attached => r \notin members BY <1>0, <1>i DEF I_MembersS
<1>h. \A q \in InSyncR : head'[q] = head[q] /\ sPres'[q] = sPres[q] /\ sCon'[q] = sCon[q] /\ cutAck'[q] = cutAck[q]
  BY <1>i, <1>T
<1>1. IndJ' BY <1>0, <1>s, <1>i, <1>h, ZY_IndJ
<1>2. I_MembersS' BY <1>0, <1>i DEF I_MembersS
<1>3. I_HoldAtt'
  <2>. SUFFICES ASSUME attached, NEW q \in members, NEW x \in Blocks PROVE head'[q][x] >= acked[x]
    BY DEF I_HoldAtt
  <2>1. q \in R \ {r} BY <1>m, <1>T
  <2>. QED BY <2>1, <1>0 DEF I_HoldAtt
<1>4. Inv_AckedHeld'
  <2>. SUFFICES ASSUME NEW x \in Blocks PROVE \E q \in R : dState'[q] = "insync" /\ head'[q][x] >= acked'[x]
    BY DEF Inv_AckedHeld
  <2>1. PICK q \in R : dState[q] = "insync" /\ head[q][x] >= acked[x] BY <1>0 DEF Inv_AckedHeld
  <2>2. q \in R \ {r} BY <2>1
  <2>. QED BY <2>1, <2>2
<1>5. I_FreshS'
  <2>1. BasesS' = BasesS /\ r \notin BasesS /\ BasesS \subseteq R BY <1>i, <1>m, <1>s, <1>T DEF BasesS
  <2>2. \A q \in BasesS : sPres'[q] = sPres[q] /\ sCon'[q] = sCon[q] /\ cutAck'[q] = cutAck[q] BY <2>1
  <2>. QED BY <2>1, <2>2, <1>0 DEF I_FreshS
<1>6. I_AckedEverS' /\ I_NoBadLoss' BY <1>0, F_AckedEverS, F_NoBadLoss
<1>7. J_RelHoldS' BY <1>v, <1>i, <1>h, <1>s DEF J_RelHoldS
<1>8. I_FreshS2' BY <1>v, <1>i, <1>h, <1>s DEF I_FreshS2
<1>9. J_ZxIdle' /\ J_ZLive'
  <2>1. zx # 0 => zx \in R \ {r} BY <1>0, Groups DEF TyScalar
  <2>2. J_ZxIdle' BY <2>1, <1>v, <1>s DEF J_ZxIdle
  <2>3. J_ZLive' BY <2>1, <1>v, <1>s DEF J_ZLive
  <2>. QED BY <2>2, <2>3
<1>10. J_SeqLe' /\ J_SoleRel' /\ J_RelLe' BY <1>v, <1>s DEF J_SeqLe, J_SoleRel, J_RelLe, RelStamp, Majority
<1>11. J_GenTop' BY <1>v, <1>s, <1>i DEF J_GenTop, View, Valid, Majority, SolePairs
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>7, <1>8, <1>9, <1>10, <1>11

-----------------------------------------------------------------------------
(* The copy: what a base-inclusive copy of source s's lineage from the     *)
(* leg's head epoch H0 through a trusted target t leaves on the leg.       *)
(* Shared by BulkCopy (H0 = the base) and Chase (H0 = the mark).           *)

ZY_NH(r, s, H0, t) == AfterCopy(head[r], s, H0, t)

LEMMA ZY_CopyFacts ==
  ASSUME IndInv, ZY_CopyLo, NEW r \in R, NEW s \in InSyncR \ {r}, NEW t \in Epochs, NEW H0 \in 0..MaxEpoch,
         CatchingUp(r), HiOf(r) = H0, H0 <= t,
         t \in Lin(s), t \in tr[s], H0 = 0 \/ H0 \in Lin(s)
  PROVE  /\ \A x \in Blocks : \/ x \in Copied(s, H0, t) /\ ZY_NH(r, s, H0, t)[x] = sCon[s][t][x]
                              \/ x \notin Copied(s, H0, t) /\ ZY_NH(r, s, H0, t)[x] = head[r][x]
         /\ \A x \in Blocks : ZY_NH(r, s, H0, t)[x] >= cutAck[s][t][x]
<1>0. /\ TypeOK /\ TypeOKT /\ I_RangesS /\ I_Lineage /\ I_Chain /\ Inv_TrustComplete BY ZY_Open
<1>s. s \in R /\ s # r BY DEF InSyncR
<1>l. t \in sPres[s] BY <1>0, <1>s, ZY_LinPrefix
<1>tc. \A x \in Blocks : cutAck[s][t][x] <= sCon[s][t][x] BY <1>0, <1>s DEF Inv_TrustComplete
<1>v. \A x \in Blocks : head[r][x] \in Nat /\ sCon[s][t][x] \in Nat /\ cutAck[s][t][x] \in Nat
  BY <1>0, <1>s, Nats
<1>1. ASSUME NEW x \in Blocks
      PROVE  \/ x \in Copied(s, H0, t) /\ ZY_NH(r, s, H0, t)[x] = sCon[s][t][x]
             \/ x \notin Copied(s, H0, t) /\ ZY_NH(r, s, H0, t)[x] = head[r][x]
  <2>. DEFINE Hx == {e \in CopyElems(s, H0, t) : x \in sAl[s][e]}
  <2>a. H0 \in Nat BY Const
  <2>b. H0 = 0 \/ (H0 \in Lin(s) /\ H0 <= t) OBVIOUS
  <2>r. Hx # {} => Max(Hx) \in Hx /\ sCon[s][Max(Hx)][x] = sCon[s][t][x]
    BY <1>0, <1>s, <2>a, <2>b, ZY_CopyRead
  <2>d. ZY_NH(r, s, H0, t)[x] = IF Hx = {} THEN head[r][x] ELSE sCon[s][Max(Hx)][x]
    BY DEF ZY_NH, AfterCopy
  <2>e. x \in Copied(s, H0, t) <=> Hx # {} BY DEF Copied
  <2>. QED BY <2>r, <2>d, <2>e
<1>2. \A x \in Blocks : ZY_NH(r, s, H0, t)[x] >= cutAck[s][t][x]
  <2>. SUFFICES ASSUME NEW x \in Blocks PROVE ZY_NH(r, s, H0, t)[x] >= cutAck[s][t][x] OBVIOUS
  <2>1. CASE x \in Copied(s, H0, t) BY <2>1, <1>1, <1>tc, <1>v
  <2>2. CASE x \notin Copied(s, H0, t)
    <3>1. ZY_NH(r, s, H0, t)[x] = head[r][x] BY <2>2, <1>1
    <3>2. cutAck[s][t][x] <= head[r][x] BY <2>2 DEF ZY_CopyLo
    <3>. QED BY <3>1, <3>2, <1>v
  <2>. QED BY <2>1, <2>2
<1>. QED BY <1>1, <1>2

\* (the candidate I_HeadLoC gives ZY_CopyLo: the untouched block reads through to the base's parent, older than HiOf)
LEMMA ZY_CopyLoC ==
  ASSUME IndInv, I_HeadLoC PROVE ZY_CopyLo
<1>0. /\ TypeOK /\ TypeOKT /\ I_RangesS /\ I_Lineage /\ I_Chain /\ Inv_TrustComplete BY ZY_Open
<1>. SUFFICES ASSUME NEW rr \in R, CatchingUp(rr), NEW ss \in InSyncR \ {rr}, NEW tt \in tr[ss], NEW x \in Blocks,
                    tt \in Lin(ss), HiOf(rr) <= tt, HiOf(rr) = 0 \/ HiOf(rr) \in Lin(ss),
                    x \notin Copied(ss, HiOf(rr), tt)
             PROVE  cutAck[ss][tt][x] <= head[rr][x]
  BY DEF ZY_CopyLo
<1>. DEFINE H0 == HiOf(rr)
<1>. DEFINE Hx == {e \in CopyElems(ss, H0, tt) : x \in sAl[ss][e]}
<1>s. ss \in R BY DEF InSyncR
<1>h. H0 \in 0..MaxEpoch
  <2>1. mark[rr] \in 0..MaxEpoch /\ reverted[rr] \in -1..MaxEpoch BY <1>0, Groups DEF TyLeg
  <2>. QED BY <2>1 DEF CatchingUp, HiOf
<1>l. tt \in sPres[ss] /\ tt \in Epochs BY <1>0, <1>s, ZY_LinPrefix, Groups DEF TySnap
<1>e. Hx = {} BY DEF Copied
<1>r. /\ H0 # 0 => sCon[ss][tt][x] = Up(sPar[ss], sCon[ss], sPar[ss][H0], x)
      /\ H0 = 0 => sCon[ss][tt][x] = 0
  <2>1. H0 \in Nat /\ (H0 = 0 \/ (H0 \in Lin(ss) /\ H0 <= tt)) BY <1>h, Const
  <2>. QED BY <1>0, <1>s, <1>e, <2>1, ZY_CopyRead
<1>tc. cutAck[ss][tt][x] <= sCon[ss][tt][x] BY <1>0, <1>s DEF Inv_TrustComplete
<1>v. cutAck[ss][tt][x] \in Nat /\ sCon[ss][tt][x] \in Nat /\ head[rr][x] \in Nat BY <1>0, <1>s, <1>l, Nats
<1>1. CASE H0 = 0 BY <1>1, <1>r, <1>tc, <1>v
<1>2. CASE H0 # 0
  <2>1. H0 \in sPres[ss] BY <1>2, <1>0, <1>s, ZY_LinSub
  <2>2. sPar[ss][H0] < H0 /\ (sPar[ss][H0] # 0 => sPar[ss][H0] \in sPres[ss])
    BY <2>1, <1>0, <1>s, LegChain DEF ChainShape
  <2>3. CASE sPar[ss][H0] = 0 BY <2>3, <1>2, <1>r, <1>tc, <1>v DEF Up
  <2>4. CASE sPar[ss][H0] # 0
    <3>1. sCon[ss][tt][x] = sCon[ss][sPar[ss][H0]][x] BY <2>4, <1>2, <1>r DEF Up
    <3>2. cutAck[ss][tt][x] \in AckW(x) BY <1>s, <1>l, ZY_AckWIn
    <3>3. cutAck[ss][tt][x] <= sCon[ss][sPar[ss][H0]][x] BY <3>1, <1>tc
    <3>. QED BY <2>2, <2>4, <3>2, <3>3, <1>s DEF I_HeadLoC
  <2>. QED BY <2>3, <2>4
<1>. QED BY <1>1, <1>2

\* A copy step that cuts a new snapshot t on r (r's head becomes that snapshot).
LEMMA ZY_CopySnap ==
  ASSUME IndInv, ZY_V7, NEW r \in R, NEW s \in R, NEW t \in Epochs, NEW N,
         s # r, t \in sPres[s], t \in tr[s], t \notin sPres[r], CatchingUp(r), HiOf(r) < t,
         \A x \in Blocks : N[x] = sCon[s][t][x] \/ N[x] = head[r][x],
         \A x \in Blocks : N[x] >= cutAck[s][t][x],
         \A x \in Blocks : \A w \in pend : N[x] = w.v /\ w.b = x => w.cutAt <= t,
         \A x \in Blocks : head[r][x] \in ackedEver[x] \cup PendVal(x),
         sPres'[r] = sPres[r] \cup {t}, sCon'[r][t] = N, cutAck'[r][t] = cutAck[s][t],
         tr'[r] = tr[r] \cup {t}, head'[r] = N,
         \A e \in sPres[r] : sCon'[r][e] = sCon[r][e] /\ cutAck'[r][e] = cutAck[r][e],
         \A q \in R \ {r} : /\ sPres'[q] = sPres[q] /\ sCon'[q] = sCon[q] /\ cutAck'[q] = cutAck[q]
                           /\ tr'[q] = tr[q] /\ head'[q] = head[q],
         CatchingUp(r)', HiOf(r)' = t, dState'[r] = "standby",
         \A q \in R \ {r} : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q) /\ dState'[q] = dState[q],
         t < nextSeq,
         UNCHANGED <<pend, acked, ackedEver, ver, zjv, zpost, nextSeq>>
  PROVE  /\ I_WHiS' /\ Inv_TrustComplete' /\ I_LegalS' /\ I_LegalS2' /\ I_PendSeen' /\ I_Vers' /\ I_AckMono'
         /\ I_HeadLoS' /\ I_HeadPend' /\ I_SnapPend' /\ I_SnapLegal' /\ I_StandbyLegal'
         /\ I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC' /\ I_PendTop' /\ I_PendNext'
<1>0. /\ TypeOK /\ TypeOKT /\ I_RangesS /\ I_LegalS /\ I_PendSeen /\ I_Vers /\ I_WHiS /\ I_AckMono /\ I_HeadLoS
      /\ I_HeadPend /\ Inv_TrustComplete /\ I_Pend
  BY ZY_Open
<1>v. /\ I_LegalS2 /\ I_SnapPend /\ I_WHiC /\ I_HeadLoC /\ I_HeadHiC /\ I_SnapLegal /\ I_StandbyLegal
      /\ I_PendTop /\ I_PendNext
  BY DEF ZY_V7
<1>N. /\ \A q \in R : sPres[q] \subseteq Epochs
      /\ Epochs \subseteq Nat /\ t \in Nat
      /\ \A q \in R : \A e \in Epochs : \A x \in Blocks : sCon[q][e][x] \in Nat /\ cutAck[q][e][x] \in Nat
      /\ \A q \in R : \A x \in Blocks : head[q][x] \in Nat
      /\ \A x \in Blocks : acked[x] \in Nat
  <2>1. \A q \in R : sPres[q] \subseteq Epochs BY <1>0, Groups DEF TySnap
  <2>2. Epochs \subseteq Nat /\ t \in Nat BY Const DEF Epochs
  <2>3. /\ \A q \in R : \A e \in Epochs : \A x \in Blocks : sCon[q][e][x] \in Nat /\ cutAck[q][e][x] \in Nat
        /\ \A q \in R : \A x \in Blocks : head[q][x] \in Nat
        /\ \A x \in Blocks : acked[x] \in Nat
    BY <1>0, Nats
  <2>. QED BY <2>1, <2>2, <2>3
<1>NV. \A x \in Blocks : N[x] \in Nat BY <1>N
<1>h. HiOf(r) \in 0..MaxEpoch BY <1>0, Groups DEF TyLeg, CatchingUp, HiOf
<1>tc. \A x \in Blocks : cutAck[s][t][x] <= sCon[s][t][x] BY <1>0 DEF Inv_TrustComplete
<1>sp. \A q \in R : \A e \in sPres'[q] :
         \/ q = r /\ e = t
         \/ ~(q = r /\ e = t) /\ e \in sPres[q] /\ sCon'[q][e] = sCon[q][e] /\ cutAck'[q][e] = cutAck[q][e]
  OBVIOUS
<1>aw. \A x \in Blocks : \A v : v \in AckW(x)' <=> v \in AckW(x)
  <2>. SUFFICES ASSUME NEW x \in Blocks, NEW v PROVE v \in AckW(x)' <=> v \in AckW(x) OBVIOUS
  <2>1. ASSUME NEW q \in R, NEW e \in sPres'[q], v = cutAck'[q][e][x]
        PROVE  \E q1 \in R : \E e1 \in sPres[q1] : v = cutAck[q1][e1][x]
    <3>1. CASE q = r /\ e = t BY <3>1, <2>1
    <3>2. CASE ~(q = r /\ e = t) BY <3>2, <2>1, <1>sp
    <3>. QED BY <3>1, <3>2
  <2>2. ASSUME NEW q \in R, NEW e \in sPres[q], v = cutAck[q][e][x]
        PROVE  \E q1 \in R : \E e1 \in sPres'[q1] : v = cutAck'[q1][e1][x]
    <3>1. CASE q = r BY <3>1, <2>2
    <3>2. CASE q # r BY <3>2, <2>2
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2, ZY_AckWIn
<1>an. \A x \in Blocks : \A v \in AckW(x) : v \in Nat BY <1>0, ZY_AckWNat
<1>1. I_WHiS'
  <2>. SUFFICES ASSUME NEW q1 \in R, NEW q2 \in R, NEW e1 \in sPres'[q1], NEW e2 \in sPres'[q2],
                      e1 < e2, NEW x \in Blocks
               PROVE  cutAck'[q1][e1][x] <= cutAck'[q2][e2][x]
    BY DEF I_WHiS
  <2>1. CASE q2 = r /\ e2 = t
    <3>1. e1 \in sPres[q1] /\ cutAck'[q1][e1] = cutAck[q1][e1] BY <2>1, <1>sp, <1>N
    <3>. QED BY <3>1, <2>1, <1>0 DEF I_WHiS
  <2>2. CASE q1 = r /\ e1 = t /\ ~(q2 = r /\ e2 = t)
    <3>1. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <2>2, <1>sp
    <3>. QED BY <3>1, <2>2, <1>0 DEF I_WHiS
  <2>3. CASE ~(q2 = r /\ e2 = t) /\ ~(q1 = r /\ e1 = t)
    <3>1. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <2>3, <1>sp
    <3>2. e1 \in sPres[q1] /\ cutAck'[q1][e1] = cutAck[q1][e1] BY <2>3, <1>sp
    <3>. QED BY <3>1, <3>2, <1>0 DEF I_WHiS
  <2>. QED BY <2>1, <2>2, <2>3
<1>2. Inv_TrustComplete'
  <2>. SUFFICES ASSUME NEW q \in R, NEW e \in tr'[q], NEW x \in Blocks
               PROVE  sCon'[q][e][x] >= cutAck'[q][e][x]
    BY DEF Inv_TrustComplete
  <2>1. CASE q = r /\ e = t BY <2>1
  <2>2. CASE ~(q = r /\ e = t)
    <3>1. e \in tr[q] /\ e \in sPres[q] BY <2>2, <1>0 DEF I_RangesS
    <3>2. sCon'[q][e] = sCon[q][e] /\ cutAck'[q][e] = cutAck[q][e] BY <3>1, <2>2
    <3>. QED BY <3>1, <3>2, <1>0 DEF Inv_TrustComplete
  <2>. QED BY <2>1, <2>2
<1>3. I_LegalS' /\ I_LegalS2'
  <2>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
               PROVE  /\ head'[q][x] \in LegalV(x) /\ \A e \in sPres'[q] : sCon'[q][e][x] \in LegalV(x)
                      /\ head'[q][x] \in LegalV2(x) /\ \A e \in sPres'[q] : sCon'[q][e][x] \in LegalV2(x)
    BY DEF I_LegalS, I_LegalS2, LegalV, LegalV2, PendVal
  <2>0. N[x] \in LegalV(x) /\ N[x] \in LegalV2(x) BY <1>0, <1>v DEF I_LegalS, I_LegalS2
  <2>1. CASE q = r BY <2>0, <2>1, <1>sp, <1>0, <1>v DEF I_LegalS, I_LegalS2
  <2>2. CASE q # r BY <2>2, <1>0, <1>v DEF I_LegalS, I_LegalS2
  <2>. QED BY <2>1, <2>2
<1>4. I_PendSeen'
  <2>. SUFFICES ASSUME NEW w \in pend,
                      \E q \in R : head'[q][w.b] = w.v \/ \E e \in sPres'[q] : sCon'[q][e][w.b] = w.v
               PROVE  w.landed # {}
    BY DEF I_PendSeen
  <2>1. w.b \in Blocks BY <1>0, Nats
  <2>2. N[w.b] = w.v => (sCon[s][t][w.b] = w.v \/ head[r][w.b] = w.v) BY <2>1
  <2>3. \E q \in R : head[q][w.b] = w.v \/ \E e \in sPres[q] : sCon[q][e][w.b] = w.v BY <2>2, <1>sp
  <2>. QED BY <2>3, <1>0 DEF I_PendSeen
<1>5. I_Vers'
  <2>1. \A x \in Blocks : N[x] <= ver BY <1>0 DEF I_Vers
  <2>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
               PROVE  head'[q][x] <= ver /\ \A e \in sPres'[q] : sCon'[q][e][x] <= ver
    BY <1>0 DEF I_Vers
  <2>2. CASE q = r BY <2>1, <2>2, <1>sp, <1>0 DEF I_Vers
  <2>3. CASE q # r BY <2>3, <1>0 DEF I_Vers
  <2>. QED BY <2>2, <2>3
<1>6. I_AckMono'
  <2>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres'[q], NEW x \in Blocks PROVE cutAck'[q][e][x] <= acked[x]
    BY DEF I_AckMono
  <2>1. CASE q = r /\ e = t BY <2>1, <1>0 DEF I_AckMono
  <2>2. CASE ~(q = r /\ e = t) BY <2>2, <1>sp, <1>0 DEF I_AckMono
  <2>. QED BY <2>1, <2>2
<1>7. I_HeadLoS'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW q \in R, NEW p \in sPres'[q], p < HiOf(r1)',
                      NEW x \in Blocks
               PROVE  cutAck'[q][p][x] <= head'[r1][x]
    BY DEF I_HeadLoS
  <2>1. CASE r1 = r
    <3>1. ~(q = r /\ p = t) /\ p < t BY <2>1
    <3>2. p \in sPres[q] /\ cutAck'[q][p] = cutAck[q][p] BY <3>1, <1>sp
    <3>3. cutAck[q][p][x] <= cutAck[s][t][x] BY <3>1, <3>2, <1>0 DEF I_WHiS
    <3>. QED BY <2>1, <3>2, <3>3, <1>N, <1>NV
  <2>2. CASE r1 # r
    <3>0. CatchingUp(r1) /\ HiOf(r1)' = HiOf(r1) /\ head'[r1] = head[r1] BY <2>2
    <3>1. CASE q = r /\ p = t BY <3>0, <3>1, <1>0 DEF I_HeadLoS
    <3>2. CASE ~(q = r /\ p = t)
      <4>1. p \in sPres[q] /\ cutAck'[q][p] = cutAck[q][p] BY <3>2, <1>sp
      <4>. QED BY <3>0, <4>1, <1>0 DEF I_HeadLoS
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2
<1>8. I_HeadPend'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW w \in pend, head'[r1][w.b] = w.v
               PROVE  w.cutAt <= HiOf(r1)'
    BY DEF I_HeadPend
  <2>0. w.b \in Blocks BY <1>0, Nats
  <2>1. CASE r1 = r BY <2>0, <2>1
  <2>2. CASE r1 # r BY <2>2, <1>0 DEF I_HeadPend
  <2>. QED BY <2>1, <2>2
<1>9. I_SnapPend'
  <2>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres'[q], NEW w \in pend, sCon'[q][e][w.b] = w.v
               PROVE  w.cutAt <= e
    BY DEF I_SnapPend
  <2>0. w.b \in Blocks BY <1>0, Nats
  <2>1. CASE q = r /\ e = t BY <2>0, <2>1
  <2>2. CASE ~(q = r /\ e = t) BY <2>0, <2>2, <1>sp, <1>v DEF I_SnapPend
  <2>. QED BY <2>1, <2>2
<1>10. I_SnapLegal' /\ I_StandbyLegal'
  <2>0. \A x \in Blocks : N[x] \in ackedEver[x] \cup PendVal(x) BY <1>v DEF I_SnapLegal
  <2>1. I_SnapLegal'
    <3>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres'[q], NEW x \in Blocks
                 PROVE  sCon'[q][e][x] \in ackedEver[x] \cup PendVal(x)
      BY DEF I_SnapLegal, PendVal
    <3>1. CASE q = r /\ e = t BY <3>1, <2>0
    <3>2. CASE ~(q = r /\ e = t) BY <3>2, <1>sp, <1>v DEF I_SnapLegal
    <3>. QED BY <3>1, <3>2
  <2>2. I_StandbyLegal'
    <3>. SUFFICES ASSUME NEW q \in R, dState'[q] = "standby", NEW x \in Blocks
                 PROVE  head'[q][x] \in ackedEver[x] \cup PendVal(x)
      BY DEF I_StandbyLegal, PendVal
    <3>1. CASE q = r BY <3>1, <2>0
    <3>2. CASE q # r BY <3>2, <1>v DEF I_StandbyLegal
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2
<1>11. I_WHiC'
  <2>. SUFFICES ASSUME NEW q \in R, NEW q2 \in R, NEW p \in sPres'[q], NEW e2 \in sPres'[q2], p < e2,
                      NEW x \in Blocks, NEW v \in AckW(x)', v <= sCon'[q][p][x]
               PROVE  v <= cutAck'[q2][e2][x]
    BY DEF I_WHiC
  <2>0. v \in AckW(x) /\ v \in Nat BY <1>aw, <1>an
  <2>1. CASE q2 = r /\ e2 = t
    <3>1. p \in sPres[q] /\ sCon'[q][p] = sCon[q][p] BY <2>1, <1>sp, <1>N
    <3>. QED BY <3>1, <2>0, <2>1, <1>v DEF I_WHiC
  <2>2. CASE q = r /\ p = t /\ ~(q2 = r /\ e2 = t)
    <3>1. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <2>2, <1>sp
    <3>2. v <= N[x] BY <2>2
    <3>3. CASE N[x] = sCon[s][t][x] BY <3>1, <3>2, <3>3, <2>0, <2>2, <1>v DEF I_WHiC
    <3>4. CASE N[x] = head[r][x]
      <4>1. e2 > HiOf(r) BY <2>2, <3>1, <1>N, <1>h
      <4>. QED BY <3>1, <3>2, <3>4, <4>1, <2>0, <1>v DEF I_HeadHiC
    <3>. QED BY <3>3, <3>4
  <2>3. CASE ~(q2 = r /\ e2 = t) /\ ~(q = r /\ p = t)
    <3>1. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <2>3, <1>sp
    <3>2. p \in sPres[q] /\ sCon'[q][p] = sCon[q][p] BY <2>3, <1>sp
    <3>. QED BY <3>1, <3>2, <2>0, <1>v DEF I_WHiC
  <2>. QED BY <2>1, <2>2, <2>3
<1>12. I_HeadLoC'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW q \in R, NEW p \in sPres'[q], p < HiOf(r1)',
                      NEW x \in Blocks, NEW v \in AckW(x)', v <= sCon'[q][p][x]
               PROVE  v <= head'[r1][x]
    BY DEF I_HeadLoC
  <2>0. v \in AckW(x) /\ v \in Nat BY <1>aw, <1>an
  <2>1. CASE r1 = r
    <3>1. ~(q = r /\ p = t) /\ p < t BY <2>1
    <3>2. p \in sPres[q] /\ sCon'[q][p] = sCon[q][p] BY <3>1, <1>sp
    <3>3. v <= cutAck[s][t][x] BY <3>1, <3>2, <2>0, <1>v DEF I_WHiC
    <3>. QED BY <2>1, <3>3, <2>0, <1>N, <1>NV
  <2>2. CASE r1 # r
    <3>0. CatchingUp(r1) /\ HiOf(r1)' = HiOf(r1) /\ head'[r1] = head[r1] BY <2>2
    <3>1. CASE q = r /\ p = t
      <4>0. v <= N[x] /\ t < HiOf(r1) BY <3>0, <3>1
      <4>1. CASE N[x] = sCon[s][t][x] BY <4>0, <4>1, <3>0, <2>0, <1>v DEF I_HeadLoC
      <4>2. CASE N[x] = head[r][x]
        <5>1. v <= cutAck[s][t][x] BY <4>0, <4>2, <2>0, <1>v DEF I_HeadHiC
        <5>2. cutAck[s][t][x] <= head[r1][x] BY <4>0, <3>0, <1>0 DEF I_HeadLoS
        <5>. QED BY <5>1, <5>2, <3>0, <2>0, <1>N
      <4>. QED BY <4>1, <4>2
    <3>2. CASE ~(q = r /\ p = t)
      <4>1. p \in sPres[q] /\ sCon'[q][p] = sCon[q][p] BY <3>2, <1>sp
      <4>. QED BY <3>0, <4>1, <2>0, <1>v DEF I_HeadLoC
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2
<1>13. I_HeadLoA'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW q \in R, NEW p \in sPres'[q], p < HiOf(r1)',
                      NEW x \in Blocks, acked'[x] <= sCon'[q][p][x]
               PROVE  acked'[x] <= head'[r1][x]
    BY DEF I_HeadLoA
  <2>1. acked'[x] \in AckW(x)' BY ZY_AckWIn
  <2>. QED BY <2>1, <1>12 DEF I_HeadLoC
<1>14. I_HeadHiC'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW q2 \in R, NEW e2 \in sPres'[q2], e2 > HiOf(r1)',
                      NEW x \in Blocks, NEW v \in AckW(x)', v <= head'[r1][x]
               PROVE  v <= cutAck'[q2][e2][x]
    BY DEF I_HeadHiC
  <2>0. v \in AckW(x) /\ v \in Nat BY <1>aw, <1>an
  <2>1. CASE r1 = r
    <3>1. ~(q2 = r /\ e2 = t) /\ e2 > t BY <2>1
    <3>2. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <3>1, <1>sp
    <3>3. v <= N[x] BY <2>1
    <3>4. CASE N[x] = sCon[s][t][x] BY <3>1, <3>2, <3>3, <3>4, <2>0, <1>v DEF I_WHiC
    <3>5. CASE N[x] = head[r][x]
      <4>1. e2 > HiOf(r) BY <3>1, <3>2, <1>N, <1>h
      <4>. QED BY <3>2, <3>3, <3>5, <4>1, <2>0, <1>v DEF I_HeadHiC
    <3>. QED BY <3>4, <3>5
  <2>2. CASE r1 # r
    <3>0. CatchingUp(r1) /\ HiOf(r1)' = HiOf(r1) /\ head'[r1] = head[r1] BY <2>2
    <3>1. CASE q2 = r /\ e2 = t BY <3>0, <3>1, <2>0, <1>v DEF I_HeadHiC
    <3>2. CASE ~(q2 = r /\ e2 = t)
      <4>1. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <3>2, <1>sp
      <4>. QED BY <3>0, <4>1, <2>0, <1>v DEF I_HeadHiC
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2
<1>15. I_PendTop'
  <2>. SUFFICES ASSUME NEW w \in pend, NEW q \in R
               PROVE  head'[q][w.b] <= w.v /\ \A e \in sPres'[q] : sCon'[q][e][w.b] <= w.v
    BY DEF I_PendTop
  <2>0. w.b \in Blocks BY <1>0, Nats
  <2>1. N[w.b] <= w.v BY <2>0, <1>v DEF I_PendTop
  <2>2. CASE q = r BY <2>1, <2>2, <1>sp, <1>v DEF I_PendTop
  <2>3. CASE q # r BY <2>3, <1>v DEF I_PendTop
  <2>. QED BY <2>2, <2>3
<1>16. I_PendNext'
  <2>. SUFFICES ASSUME NEW w \in pend, NEW q \in R, nextSeq \in sPres'[q] PROVE w.cutAt = nextSeq
    BY DEF I_PendNext
  <2>1. nextSeq \in sPres[q] BY <1>N
  <2>. QED BY <2>1, <1>v DEF I_PendNext
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>7, <1>8, <1>9, <1>10, <1>11, <1>12, <1>13, <1>14, <1>15, <1>16

\* A copy onto the base epoch itself (no new snapshot): only r's head moves.
LEMMA ZY_CopyHeadOnly ==
  ASSUME IndInv, ZY_V7, NEW r \in R, NEW s \in R, NEW t \in Epochs, NEW N,
         t \in sPres[s], CatchingUp(r), HiOf(r) = t,
         \A x \in Blocks : N[x] = sCon[s][t][x] \/ N[x] = head[r][x],
         \A x \in Blocks : N[x] >= cutAck[s][t][x],
         \A x \in Blocks : \A w \in pend : N[x] = w.v /\ w.b = x => w.cutAt <= t,
         \A x \in Blocks : head[r][x] \in ackedEver[x] \cup PendVal(x),
         head'[r] = N, \A q \in R \ {r} : head'[q] = head[q],
         CatchingUp(r)', HiOf(r)' = t, dState'[r] = "standby",
         \A q \in R \ {r} : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q) /\ dState'[q] = dState[q],
         UNCHANGED <<sPres, sCon, cutAck, tr, pend, acked, ackedEver, ver, zjv, zpost, nextSeq>>
  PROVE  /\ I_WHiS' /\ Inv_TrustComplete' /\ I_LegalS' /\ I_LegalS2' /\ I_PendSeen' /\ I_Vers' /\ I_AckMono'
         /\ I_HeadLoS' /\ I_HeadPend' /\ I_SnapPend' /\ I_SnapLegal' /\ I_StandbyLegal'
         /\ I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC' /\ I_PendTop' /\ I_PendNext'
<1>0. /\ TypeOK /\ TypeOKT /\ I_LegalS /\ I_PendSeen /\ I_Vers /\ I_WHiS /\ I_AckMono /\ I_HeadLoS
      /\ I_HeadPend /\ Inv_TrustComplete
  BY ZY_Open
<1>v. /\ I_LegalS2 /\ I_SnapPend /\ I_WHiC /\ I_HeadLoC /\ I_HeadHiC /\ I_SnapLegal /\ I_StandbyLegal
      /\ I_PendTop /\ I_PendNext
  BY DEF ZY_V7
<1>N. /\ \A q \in R : \A e \in Epochs : \A x \in Blocks : sCon[q][e][x] \in Nat /\ cutAck[q][e][x] \in Nat
      /\ \A q \in R : \A x \in Blocks : head[q][x] \in Nat
      /\ \A q \in R : sPres[q] \subseteq Epochs
  BY <1>0, Nats, Groups DEF TySnap
<1>NV. \A x \in Blocks : N[x] \in Nat BY <1>N
<1>aw. \A x \in Blocks : AckW(x)' = AckW(x) BY DEF AckW
<1>an. \A x \in Blocks : \A v \in AckW(x) : v \in Nat BY <1>0, ZY_AckWNat
<1>1. I_WHiS' /\ Inv_TrustComplete' /\ I_AckMono' /\ I_SnapPend' /\ I_SnapLegal' /\ I_WHiC'
  BY <1>0, <1>v, <1>aw, F_WHiS, F_TC, F_AckMono DEF I_SnapPend, I_SnapLegal, I_WHiC, PendVal
<1>2. I_LegalS' /\ I_LegalS2'
  <2>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
               PROVE  /\ head'[q][x] \in LegalV(x) /\ head'[q][x] \in LegalV2(x)
    BY <1>0, <1>v DEF I_LegalS, I_LegalS2, LegalV, LegalV2, PendVal
  <2>0. N[x] \in LegalV(x) /\ N[x] \in LegalV2(x) BY <1>0, <1>v DEF I_LegalS, I_LegalS2
  <2>1. CASE q = r BY <2>0, <2>1
  <2>2. CASE q # r BY <2>2, <1>0, <1>v DEF I_LegalS, I_LegalS2
  <2>. QED BY <2>1, <2>2
<1>3. I_PendSeen'
  <2>. SUFFICES ASSUME NEW w \in pend,
                      \E q \in R : head'[q][w.b] = w.v \/ \E e \in sPres[q] : sCon[q][e][w.b] = w.v
               PROVE  w.landed # {}
    BY DEF I_PendSeen
  <2>1. w.b \in Blocks BY <1>0, Nats
  <2>. QED BY <2>1, <1>0 DEF I_PendSeen
<1>4. I_Vers'
  <2>1. \A x \in Blocks : N[x] <= ver BY <1>0 DEF I_Vers
  <2>. QED BY <2>1, <1>0 DEF I_Vers
<1>5. I_HeadLoS'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW q \in R, NEW p \in sPres[q], p < HiOf(r1)',
                      NEW x \in Blocks
               PROVE  cutAck[q][p][x] <= head'[r1][x]
    BY DEF I_HeadLoS
  <2>1. CASE r1 = r
    <3>1. cutAck[q][p][x] <= cutAck[s][t][x] BY <2>1, <1>0 DEF I_WHiS
    <3>. QED BY <2>1, <3>1, <1>N, <1>NV
  <2>2. CASE r1 # r BY <2>2, <1>0 DEF I_HeadLoS
  <2>. QED BY <2>1, <2>2
<1>6. I_HeadPend'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW w \in pend, head'[r1][w.b] = w.v
               PROVE  w.cutAt <= HiOf(r1)'
    BY DEF I_HeadPend
  <2>0. w.b \in Blocks BY <1>0, Nats
  <2>1. CASE r1 = r BY <2>0, <2>1
  <2>2. CASE r1 # r BY <2>2, <1>0 DEF I_HeadPend
  <2>. QED BY <2>1, <2>2
<1>7. I_StandbyLegal'
  <2>0. \A x \in Blocks : N[x] \in ackedEver[x] \cup PendVal(x) BY <1>v DEF I_SnapLegal
  <2>. SUFFICES ASSUME NEW q \in R, dState'[q] = "standby", NEW x \in Blocks
               PROVE  head'[q][x] \in ackedEver[x] \cup PendVal(x)
    BY DEF I_StandbyLegal, PendVal
  <2>1. CASE q = r BY <2>1, <2>0
  <2>2. CASE q # r BY <2>2, <1>v DEF I_StandbyLegal
  <2>. QED BY <2>1, <2>2
<1>8. I_HeadLoC'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW q \in R, NEW p \in sPres[q], p < HiOf(r1)',
                      NEW x \in Blocks, NEW v \in AckW(x), v <= sCon[q][p][x]
               PROVE  v <= head'[r1][x]
    BY <1>aw DEF I_HeadLoC
  <2>0. v \in Nat BY <1>an
  <2>1. CASE r1 = r
    <3>1. v <= cutAck[s][t][x] BY <2>1, <1>v DEF I_WHiC
    <3>. QED BY <2>1, <3>1, <2>0, <1>N, <1>NV
  <2>2. CASE r1 # r BY <2>2, <1>v DEF I_HeadLoC
  <2>. QED BY <2>1, <2>2
<1>9. I_HeadLoA'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW q \in R, NEW p \in sPres[q], p < HiOf(r1)',
                      NEW x \in Blocks, acked[x] <= sCon[q][p][x]
               PROVE  acked[x] <= head'[r1][x]
    BY DEF I_HeadLoA
  <2>1. acked[x] \in AckW(x) BY ZY_AckWIn
  <2>. QED BY <2>1, <1>8, <1>aw DEF I_HeadLoC
<1>10. I_HeadHiC'
  <2>. SUFFICES ASSUME NEW r1 \in R, CatchingUp(r1)', NEW q2 \in R, NEW e2 \in sPres[q2], e2 > HiOf(r1)',
                      NEW x \in Blocks, NEW v \in AckW(x), v <= head'[r1][x]
               PROVE  v <= cutAck[q2][e2][x]
    BY <1>aw DEF I_HeadHiC
  <2>1. CASE r1 = r
    <3>1. CASE N[x] = sCon[s][t][x] BY <2>1, <3>1, <1>v DEF I_WHiC
    <3>2. CASE N[x] = head[r][x] BY <2>1, <3>2, <1>v DEF I_HeadHiC
    <3>. QED BY <3>1, <3>2
  <2>2. CASE r1 # r BY <2>2, <1>v DEF I_HeadHiC
  <2>. QED BY <2>1, <2>2
<1>11. I_PendTop' /\ I_PendNext'
  <2>1. I_PendTop'
    <3>. SUFFICES ASSUME NEW w \in pend, NEW q \in R
                 PROVE  head'[q][w.b] <= w.v /\ \A e \in sPres[q] : sCon[q][e][w.b] <= w.v
      BY DEF I_PendTop
    <3>0. w.b \in Blocks BY <1>0, Nats
    <3>1. N[w.b] <= w.v BY <3>0, <1>v DEF I_PendTop
    <3>2. CASE q = r BY <3>1, <3>2, <1>v DEF I_PendTop
    <3>3. CASE q # r BY <3>3, <1>v DEF I_PendTop
    <3>. QED BY <3>2, <3>3
  <2>2. I_PendNext' BY <1>v DEF I_PendNext
  <2>. QED BY <2>1, <2>2
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>7, <1>8, <1>9, <1>10, <1>11

-----------------------------------------------------------------------------
(* The two steps.                                                          *)

LEMMA I_BulkCopy ==
  ASSUME IndInv, ZY_V7, NEW r \in R, BulkCopy(r) /\ NoStamp,
         ZY_CopyLo   \* NEEDS-INV (G1): ZY_CopyLoC derives it from the candidate I_HeadLoC
  PROVE  IndInv' /\ ZY_V7'
<1>0. /\ TypeOK /\ TypeOKT /\ IndJ
      /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY ZY_Open
<1>v. I_SnapPend /\ J_ZxIdle /\ I_SnapLegal BY DEF ZY_V7
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>0, Basics
<1>g. /\ dState[r] = "stale" /\ path[r] = "back" /\ reverted[r] # -1 /\ sb[r] = reverted[r]
      /\ Tgt # 0 /\ sb[r] <= Tgt
      /\ dState' = [dState EXCEPT ![r] = "standby"] /\ sb' = [sb EXCEPT ![r] = -1]
  BY Full DEF BulkCopy
<1>. DEFINE t == Tgt
<1>. DEFINE b == sb[r]
<1>s. PICK s \in CoverSet(r, t, b) :
        /\ CopyAlign(r, s, b, t)
        /\ mark' = [mark EXCEPT ![r] = t] /\ pin' = [pin EXCEPT ![r] = t]
  BY Full DEF BulkCopy
<1>u. /\ UNCHANGED <<ver, recorded, nextSeq, cutK, cutTgt, cutDone, cutGone, members, attached, path>>
      /\ UNCHANGED <<reverted, pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, restamp, zx>>
      /\ UNCHANGED <<cfgAt, conf, htr>>
  BY DEF BulkCopy
<1>us. UNCHANGED <<rmemA, zjv, zpost>> BY DEF NoStamp, stampVars, sGhost
<1>cf. s \in Sources(r) /\ t \in Lin(s) /\ (b <= 0 \/ b \in Lin(s)) /\ t \in tr[s] BY <1>s, ZY_CoverSetFacts
<1>t. t \in recorded /\ t \in Epochs /\ t < nextSeq /\ t >= 1 BY <1>0, <1>g, ZY_TgtFacts
<1>b. b \in 0..MaxEpoch /\ b <= t /\ (b = 0 \/ b \in Lin(s)) BY <1>0, <1>T, <1>g, <1>cf, Groups DEF TyLeg
<1>cu. CatchingUp(r) /\ HiOf(r) = b BY <1>g DEF CatchingUp, HiOf
<1>ro. RevOK(r) /\ SessionOK(r) BY <1>0 DEF I_Reverted, I_Session
<1>rv. /\ hAl[r] = {} /\ hPar[r] = b /\ (b > 0 => b \in sPres[r])
       /\ head[r] = IF b = 0 THEN Zero ELSE sCon[r][b]
       /\ \A e \in sPres[r] : e <= b \/ (b = 0 /\ \A f \in recorded : e < f)
  BY <1>ro, <1>g DEF RevOK
<1>sv. s \in R /\ s # r /\ t \in sPres[s] /\ s \in InSyncR BY <1>cf, <1>0, ZY_LinSub DEF Sources, InSyncR
<1>N. /\ t \in Nat /\ b \in Nat /\ nextSeq \in Nat
      /\ \A w \in pend : w.cutAt \in Nat /\ w.b \in Blocks /\ w.v \in Nat
      /\ \A x \in Blocks : acked[x] \in Nat /\ head[r][x] \in Nat /\ sCon[s][t][x] \in Nat
  BY <1>0, <1>T, <1>t, <1>b, <1>sv, Nats, Const DEF Epochs
<1>F. /\ \A x \in Blocks : \/ x \in Copied(s, b, t) /\ ZY_NH(r, s, b, t)[x] = sCon[s][t][x]
                           \/ x \notin Copied(s, b, t) /\ ZY_NH(r, s, b, t)[x] = head[r][x]
      /\ \A x \in Blocks : ZY_NH(r, s, b, t)[x] >= cutAck[s][t][x]
  BY <1>t, <1>b, <1>cu, <1>cf, <1>sv, ZY_CopyFacts
<1>lo. (IF BaseInclusive \/ b = 0 THEN b ELSE b + 1) = b BY Full
<1>pv. \A x \in Blocks : \A w \in pend : ZY_NH(r, s, b, t)[x] = w.v /\ w.b = x => w.cutAt <= t
  <2>. SUFFICES ASSUME NEW x \in Blocks, NEW w \in pend, ZY_NH(r, s, b, t)[x] = w.v, w.b = x
               PROVE  w.cutAt <= t
    OBVIOUS
  <2>2. CASE x \in Copied(s, b, t)
    <3>1. sCon[s][t][w.b] = w.v BY <2>2, <1>F
    <3>. QED BY <3>1, <1>sv, <1>v DEF I_SnapPend
  <2>3. CASE x \notin Copied(s, b, t)
    <3>1. head[r][w.b] = w.v BY <2>3, <1>F
    <3>2. w.cutAt <= b BY <3>1, <1>cu, <1>0 DEF I_HeadPend
    <3>. QED BY <3>2, <1>b, <1>N
  <2>. QED BY <2>2, <2>3
<1>lg. \A x \in Blocks : head[r][x] \in ackedEver[x] \cup PendVal(x)
  <2>. SUFFICES ASSUME NEW x \in Blocks PROVE head[r][x] \in ackedEver[x] \cup PendVal(x) OBVIOUS
  <2>1. CASE b = 0 BY <2>1, <1>rv, <1>0 DEF Zero, I_AckedEverS
  <2>2. CASE b # 0
    <3>1. b \in sPres[r] /\ head[r][x] = sCon[r][b][x] BY <2>2, <1>rv, <1>b
    <3>. QED BY <3>1, <1>v DEF I_SnapLegal
  <2>. QED BY <2>1, <2>2
<1>ms. /\ mark'[r] = t /\ pin'[r] = t /\ dState'[r] = "standby" /\ sb'[r] = -1
       /\ \A q \in R \ {r} : mark'[q] = mark[q] /\ pin'[q] = pin[q] /\ dState'[q] = dState[q] /\ sb'[q] = sb[q]
  BY <1>s, <1>g, <1>0, Groups DEF TyLeg
<1>cu2. /\ CatchingUp(r)' /\ HiOf(r)' = t
        /\ \A q \in R \ {r} : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q) /\ dState'[q] = dState[q]
  BY <1>ms, <1>u DEF CatchingUp, HiOf
<1>hq. \A q \in R \ {r} : /\ head'[q] = head[q] /\ hAl'[q] = hAl[q] /\ hPar'[q] = hPar[q]
                          /\ sPres'[q] = sPres[q] /\ sCon'[q] = sCon[q] /\ cutAck'[q] = cutAck[q]
  BY <1>s, <1>0, Groups DEF CopyAlign, TyHead, TySnap, TyTrust
<1>1. TypeOK'
  <2>1. (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp OBVIOUS
  <2>. QED BY <2>1, <1>0, S_TyCatchup
<1>K. /\ IndJ' /\ I_MembersS' /\ I_HoldAtt' /\ Inv_AckedHeld' /\ I_FreshS' /\ I_AckedEverS' /\ I_NoBadLoss'
      /\ J_RelHoldS' /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe'
  <2>1. zx # r BY <1>v, <1>g, RNat DEF J_ZxIdle
  <2>2. \A q \in R \ {r} : reverted'[q] = reverted[q] BY <1>u
  <2>. QED BY <2>1, <2>2, <1>g, <1>ms, <1>hq, <1>u, ZY_Keep
<1>2. I_Pend'
  <2>1. r \notin members BY <1>0, <1>g DEF I_MembersS, I_RangesS, InSyncR
  <2>2. \A q \in members : head'[q] = head[q] BY <2>1, <1>hq, <1>T
  <2>. SUFFICES ASSUME NEW w \in pend
               PROVE  \A q \in w.landed \cap members : head'[q][w.b] = w.v
    BY <1>0, <1>u DEF I_Pend
  <2>. QED BY <2>2, <1>0 DEF I_Pend
<1>rest. I_Reverted'
  <2>1. \A q \in R \ {r} : RevOK(q)'
    <3>. SUFFICES ASSUME NEW q \in R \ {r} PROVE RevOK(q)' OBVIOUS
    <3>1. RevOK(q) BY <1>0 DEF I_Reverted
    <3>. QED BY <3>1, <1>hq, <1>ms, <1>u, RevOther
  <2>2. RevOK(r)' BY <1>ms DEF RevOK
  <2>. QED BY <2>1, <2>2 DEF I_Reverted
<1>3. CASE b = t
  <2>c. /\ head' = [head EXCEPT ![r] = ZY_NH(r, s, b, t)]
        /\ hAl' = [hAl EXCEPT ![r] = hAl[r] \cup Copied(s, b, t)]
        /\ UNCHANGED <<sPres, sCon, sAl, sPar, hPar, anc, tr, cutAck>>
    BY <1>3, <1>s, <1>lo DEF CopyAlign, ZY_NH
  <2>hr. head'[r] = ZY_NH(r, s, b, t) /\ hAl'[r] = Copied(s, b, t) BY <2>c, <1>rv, <1>0, Groups DEF TyHead
  <2>1. I_RangesS' /\ I_Lineage' BY <1>0, <1>u, <2>c, F_RangesS, F_Lineage
  <2>2. I_Chain'
    <3>1. \A x \in Blocks : x \notin hAl'[r] => head'[r][x] = Up(sPar[r], sCon[r], hPar[r], x)
      <4>. SUFFICES ASSUME NEW x \in Blocks, x \notin hAl'[r] PROVE head'[r][x] = Up(sPar[r], sCon[r], hPar[r], x)
        OBVIOUS
      <4>1. ZY_NH(r, s, b, t)[x] = head[r][x] BY <2>hr, <1>F
      <4>. QED BY <4>1, <2>hr, <1>rv, <1>0 DEF I_Chain
    <3>. QED BY <1>0, <1>hq, <2>c, <3>1 DEF I_Chain
  <2>3. /\ I_WHiS' /\ Inv_TrustComplete' /\ I_LegalS' /\ I_LegalS2' /\ I_PendSeen' /\ I_Vers' /\ I_AckMono'
        /\ I_HeadLoS' /\ I_HeadPend' /\ I_SnapPend' /\ I_SnapLegal' /\ I_StandbyLegal'
        /\ I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC' /\ I_PendTop' /\ I_PendNext'
    <3>1. \A x \in Blocks : ZY_NH(r, s, b, t)[x] = sCon[s][t][x] \/ ZY_NH(r, s, b, t)[x] = head[r][x] BY <1>F
    <3>2. CatchingUp(r) /\ HiOf(r) = t BY <1>cu, <1>3
    <3>. QED BY <1>sv, <1>t, <3>1, <3>2, <1>F, <1>pv, <1>lg, <2>hr, <1>hq, <1>ms, <1>cu2, <2>c, <1>u, <1>us,
                ZY_CopyHeadOnly
  <2>4. I_Session'
    <3>1. \A q \in R \ {r} : SessionOK(q)'
      <4>. SUFFICES ASSUME NEW q \in R \ {r} PROVE SessionOK(q)' OBVIOUS
      <4>1. SessionOK(q) BY <1>0 DEF I_Session
      <4>. QED BY <4>1, <1>u, <1>ms, <2>c, <1>hq, SessionOther
    <3>2. SessionOK(r)'
      <4>1. \A e \in sPres[r] : e <= t \/ \A f \in recorded : e < f BY <1>rv, <1>3
      <4>2. r \notin members /\ nextSeq \notin sPres[r]
        BY <1>ro, <1>0, <1>g DEF SessionOK, CatchingUp, I_MembersS, I_RangesS, InSyncR
      <4>. QED BY <1>ms, <1>t, <1>rv, <1>3, <4>1, <4>2, <2>c, <1>u, <1>g, <1>cu, <1>cu2, <1>ro
              DEF SessionOK, CatchingUp
    <3>. QED BY <3>1, <3>2 DEF I_Session
  <2>. QED BY <1>1, <1>K, <1>2, <1>rest, <2>1, <2>2, <2>3, <2>4, ZY_Close DEF ZY_V7
<1>4. CASE b # t
  <2>0. b < t /\ t \notin sPres[r]
    <3>1. b < t BY <1>4, <1>b, <1>N
    <3>2. t \notin sPres[r] BY <3>1, <1>rv, <1>t, <1>N
    <3>. QED BY <3>1, <3>2
  <2>c. /\ head' = [head EXCEPT ![r] = ZY_NH(r, s, b, t)]
        /\ sPres' = [sPres EXCEPT ![r] = @ \cup {t}]
        /\ sCon' = [sCon EXCEPT ![r][t] = ZY_NH(r, s, b, t)]
        /\ sAl' = [sAl EXCEPT ![r][t] = hAl[r] \cup Copied(s, b, t)]
        /\ sPar' = [sPar EXCEPT ![r][t] = hPar[r]]
        /\ anc' = [anc EXCEPT ![r][t] = NewAnc(r, t)]
        /\ hPar' = [hPar EXCEPT ![r] = t] /\ hAl' = [hAl EXCEPT ![r] = {}]
        /\ tr' = [tr EXCEPT ![r] = @ \cup {t}]
        /\ cutAck' = [cutAck EXCEPT ![r][t] = cutAck[s][t]]
    BY <1>4, <2>0, <1>s, <1>lo, Full DEF CopyAlign, ZY_NH
  <2>m. \A q \in R \ {r} : /\ head'[q] = head[q] /\ sPres'[q] = sPres[q] /\ sCon'[q] = sCon[q]
                            /\ sAl'[q] = sAl[q] /\ sPar'[q] = sPar[q] /\ anc'[q] = anc[q]
                            /\ hPar'[q] = hPar[q] /\ hAl'[q] = hAl[q] /\ tr'[q] = tr[q]
                            /\ cutAck'[q] = cutAck[q]
    BY <2>c, <1>0, Groups DEF TyHead, TySnap, TyTrust
  <2>o. \A e \in sPres[r] : /\ sCon'[r][e] = sCon[r][e] /\ sAl'[r][e] = sAl[r][e]
                             /\ sPar'[r][e] = sPar[r][e] /\ anc'[r][e] = anc[r][e]
                             /\ cutAck'[r][e] = cutAck[r][e]
    BY <2>c, <2>0, <1>t, <1>0, Groups DEF TySnap, TyTrust
  <2>n. /\ sPres'[r] = sPres[r] \cup {t} /\ sCon'[r][t] = ZY_NH(r, s, b, t)
        /\ sAl'[r][t] = Copied(s, b, t) /\ sPar'[r][t] = b /\ anc'[r][t] = NewAnc(r, t)
        /\ hPar'[r] = t /\ hAl'[r] = {} /\ head'[r] = ZY_NH(r, s, b, t) /\ tr'[r] = tr[r] \cup {t}
        /\ cutAck'[r][t] = cutAck[s][t]
    BY <2>c, <1>rv, <1>t, <1>0, Groups DEF TyHead, TySnap, TyTrust
  <2>1. I_RangesS'
    <3>1. sPres'[r] \subseteq 1..nextSeq /\ tr'[r] \subseteq sPres'[r] \cap 1..(nextSeq - 1) /\ hPar'[r] \in sPres'[r]
      BY <2>n, <1>t, <1>0 DEF I_RangesS, Epochs
    <3>. QED BY <1>0, <1>u, <2>m, <3>1 DEF I_RangesS
  <2>rd. \A x \in Blocks : x \notin sAl'[r][t] => sCon'[r][t][x] = Up(sPar[r], sCon[r], hPar[r], x)
    <3>. SUFFICES ASSUME NEW x \in Blocks, x \notin sAl'[r][t] PROVE sCon'[r][t][x] = Up(sPar[r], sCon[r], hPar[r], x)
      OBVIOUS
    <3>1. ZY_NH(r, s, b, t)[x] = head[r][x] BY <2>n, <1>F
    <3>. QED BY <3>1, <2>n, <1>rv, <1>0 DEF I_Chain
  <2>LE. ChainShape(sPres'[r], sPar'[r], anc'[r]) /\ ChainReads(sPres'[r], sPar'[r], sAl'[r], sCon'[r])
    <3>1. anc'[r][t] = {t} \cup (IF hPar[r] = 0 THEN {} ELSE anc[r][hPar[r]]) BY <2>n, <1>rv DEF NewAnc, AncOf
    <3>2. hPar[r] < t /\ sPar'[r][t] = hPar[r] BY <2>0, <2>n, <1>rv
    <3>. QED BY <1>0, <1>t, <2>0, <2>n, <2>o, <2>rd, <3>1, <3>2, ZY_LegExtend
  <2>2. I_Lineage'
    <3>1. ChainShape(sPres'[r], sPar'[r], anc'[r]) BY <2>LE
    <3>2. \A e \in Epochs \ sPres'[r] : anc'[r][e] = {} BY <2>c, <2>n, <1>0, Groups DEF TySnap, I_Lineage
    <3>. QED BY <1>0, <2>m, <3>1, <3>2 DEF I_Lineage
  <2>3. I_Chain'
    <3>1. ChainReads(sPres'[r], sPar'[r], sAl'[r], sCon'[r]) BY <2>LE
    <3>2. \A x \in Blocks : head'[r][x] = Up(sPar'[r], sCon'[r], hPar'[r], x) BY <2>n, <1>t DEF Up
    <3>. QED BY <1>0, <2>m, <3>1, <3>2 DEF I_Chain
  <2>4. /\ I_WHiS' /\ Inv_TrustComplete' /\ I_LegalS' /\ I_LegalS2' /\ I_PendSeen' /\ I_Vers' /\ I_AckMono'
        /\ I_HeadLoS' /\ I_HeadPend' /\ I_SnapPend' /\ I_SnapLegal' /\ I_StandbyLegal'
        /\ I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC' /\ I_PendTop' /\ I_PendNext'
    <3>1. \A x \in Blocks : ZY_NH(r, s, b, t)[x] = sCon[s][t][x] \/ ZY_NH(r, s, b, t)[x] = head[r][x] BY <1>F
    <3>2. HiOf(r) < t BY <1>cu, <2>0
    <3>. QED BY <1>sv, <1>t, <2>0, <1>cu, <1>cf, <3>1, <3>2, <1>F, <1>pv, <1>lg, <2>n, <2>o, <2>m,
                <1>cu2, <1>ms, <1>u, <1>us, ZY_CopySnap
  <2>5. I_Session'
    <3>1. \A q \in R \ {r} : SessionOK(q)'
      <4>. SUFFICES ASSUME NEW q \in R \ {r} PROVE SessionOK(q)' OBVIOUS
      <4>1. SessionOK(q) BY <1>0 DEF I_Session
      <4>. QED BY <4>1, <1>u, <1>ms, <2>m, SessionOther
    <3>2. SessionOK(r)'
      <4>1. \A e \in sPres'[r] : e <= t \/ \A f \in recorded : e < f BY <1>rv, <2>n, <2>0, <1>b, <1>N, <1>T
      <4>2. r \notin members /\ nextSeq \notin sPres'[r]
        <5>1. r \notin members BY <1>0, <1>g DEF I_MembersS, I_RangesS, InSyncR
        <5>2. nextSeq \notin sPres[r] BY <1>ro, <1>cu DEF SessionOK
        <5>3. t # nextSeq BY <1>t, <1>N
        <5>. QED BY <5>1, <5>2, <5>3, <2>n
      <4>. QED BY <1>ms, <1>t, <2>n, <4>1, <4>2, <1>u, <1>g, <1>cu, <1>cu2, <1>ro DEF SessionOK, CatchingUp
    <3>. QED BY <3>1, <3>2 DEF I_Session
  <2>. QED BY <1>1, <1>K, <1>2, <1>rest, <2>1, <2>2, <2>3, <2>4, <2>5, ZY_Close DEF ZY_V7
<1>. QED BY <1>3, <1>4

LEMMA I_Chase ==
  ASSUME IndInv, ZY_V7, NEW r \in R, Chase(r) /\ NoStamp,
         ZY_CopyLo   \* NEEDS-INV (G1): ZY_CopyLoC derives it from the candidate I_HeadLoC
  PROVE  IndInv' /\ ZY_V7'
<1>0. /\ TypeOK /\ TypeOKT /\ IndJ
      /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY ZY_Open
<1>v. I_SnapPend /\ J_ZxIdle /\ I_StandbyLegal BY DEF ZY_V7
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>0, Basics
<1>. DEFINE t == Tgt
<1>. DEFINE b == mark[r]
<1>g. /\ dState[r] = "standby" /\ path[r] = "back" /\ Tgt # 0 /\ t > b /\ r # zx
  BY Full DEF Chase
<1>u. /\ UNCHANGED <<ver, recorded, nextSeq, cutK, cutTgt, cutDone, cutGone, members, attached, path>>
      /\ UNCHANGED <<sb, pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, zx>>
      /\ UNCHANGED <<cfgAt, conf, htr>>
  BY DEF Chase
<1>us. UNCHANGED <<rmemA, zjv, zpost>> BY DEF NoStamp, stampVars, sGhost
<1>t. t \in recorded /\ t \in Epochs /\ t < nextSeq /\ t >= 1 BY <1>0, <1>g, ZY_TgtFacts
<1>so. SessionOK(r) BY <1>0 DEF I_Session
<1>sb. /\ b >= 1 /\ b \in recorded /\ hPar[r] <= b /\ hPar[r] \in sPres[r] \cup {0}
       /\ \A e \in sPres[r] : e <= b \/ \A f \in recorded : e < f
       /\ r \notin members /\ sb[r] = -1 /\ b \in 0..MaxEpoch /\ hPar[r] \in 0..MaxEpoch
  BY <1>so, <1>g, <1>0, Groups DEF SessionOK, I_RangesS, TyLeg, TyHead
<1>5. CASE CoverSet(r, t, b) = {}
  <2>c. /\ dState' = [dState EXCEPT ![r] = "stale"] /\ reverted' = [reverted EXCEPT ![r] = -1]
        /\ UNCHANGED <<head, hAl, hPar, sPres, sCon, sAl, sPar, anc, mark, pin, tr, cutAck>>
    BY <1>5, Full DEF Chase, Demote
  <2>a. \A q \in R \ {r} : dState'[q] = dState[q] /\ reverted'[q] = reverted[q] BY <2>c, <1>0, Groups DEF TyLeg
  <2>r. dState'[r] = "stale" /\ reverted'[r] = -1 BY <2>c, <1>0, Groups DEF TyLeg
  <2>b. ~CatchingUp(r)' /\ \A q \in R \ {r} : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q)
    BY <2>c, <2>a, <2>r, <1>u DEF CatchingUp, HiOf
  <2>1. TypeOK'
    <3>1. (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp OBVIOUS
    <3>. QED BY <3>1, <1>0, S_TyCatchup
  <2>K. /\ IndJ' /\ I_MembersS' /\ I_HoldAtt' /\ Inv_AckedHeld' /\ I_FreshS' /\ I_AckedEverS' /\ I_NoBadLoss'
        /\ J_RelHoldS' /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe'
    BY <1>g, <2>a, <2>r, <2>c, <1>u, ZY_Keep
  <2>2. /\ I_RangesS' /\ I_Lineage' /\ I_Chain' /\ I_Pend' /\ I_LegalS' /\ I_PendSeen' /\ I_Vers'
        /\ I_WHiS' /\ I_AckMono' /\ Inv_TrustComplete'
    BY <1>0, <1>u, <1>us, <2>c, F_RangesS, F_Lineage, F_Chain, F_Pend, F_LegalS, F_PendSeen, F_Vers,
       F_WHiS, F_AckMono, F_TC
  <2>3. I_LegalS2' /\ I_SnapPend' /\ I_SnapLegal' /\ I_WHiC' /\ I_PendTop' /\ I_PendNext'
    <3>1. I_LegalS2' BY <1>u, <1>us, <2>c DEF ZY_V7, I_LegalS2, LegalV2, PendVal
    <3>2. I_SnapPend' BY <1>u, <2>c DEF ZY_V7, I_SnapPend
    <3>3. I_SnapLegal' BY <1>u, <2>c DEF ZY_V7, I_SnapLegal, PendVal
    <3>4. I_WHiC' BY <1>u, <2>c DEF ZY_V7, I_WHiC, AckW
    <3>5. I_PendTop' /\ I_PendNext' BY <1>u, <2>c DEF ZY_V7, I_PendTop, I_PendNext
    <3>. QED BY <3>1, <3>2, <3>3, <3>4, <3>5
  <2>4. I_HeadLoS' /\ I_HeadPend' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC'
    <3>0. \A r1 \in R : CatchingUp(r1)' => r1 \in R \ {r} /\ CatchingUp(r1) /\ HiOf(r1)' = HiOf(r1) BY <2>b
    <3>1. I_HeadLoS' BY <3>0, <1>0, <1>u, <2>c DEF I_HeadLoS
    <3>2. I_HeadPend' BY <3>0, <1>0, <1>u, <2>c DEF I_HeadPend
    <3>3. I_HeadLoC' BY <3>0, <1>u, <2>c DEF ZY_V7, I_HeadLoC, AckW
    <3>4. I_HeadLoA' BY <3>0, <1>u, <2>c DEF ZY_V7, I_HeadLoA
    <3>5. I_HeadHiC' BY <3>0, <1>u, <2>c DEF ZY_V7, I_HeadHiC, AckW
    <3>. QED BY <3>1, <3>2, <3>3, <3>4, <3>5
  <2>5. I_StandbyLegal'
    <3>. SUFFICES ASSUME NEW q \in R, dState'[q] = "standby", NEW x \in Blocks
                 PROVE  head'[q][x] \in ackedEver[x] \cup PendVal(x)
      BY <1>u DEF I_StandbyLegal, PendVal
    <3>1. q # r BY <2>r
    <3>. QED BY <3>1, <2>a, <2>c, <1>v DEF I_StandbyLegal
  <2>6. I_Reverted'
    <3>1. \A q \in R \ {r} : RevOK(q)'
      <4>. SUFFICES ASSUME NEW q \in R \ {r} PROVE RevOK(q)' OBVIOUS
      <4>1. RevOK(q) BY <1>0 DEF I_Reverted
      <4>. QED BY <4>1, <2>a, <2>c, <1>u, RevOther
    <3>2. RevOK(r)' BY <2>r DEF RevOK
    <3>. QED BY <3>1, <3>2 DEF I_Reverted
  <2>7. I_Session'
    <3>1. \A q \in R \ {r} : SessionOK(q)'
      <4>. SUFFICES ASSUME NEW q \in R \ {r} PROVE SessionOK(q)' OBVIOUS
      <4>1. SessionOK(q) BY <1>0 DEF I_Session
      <4>. QED BY <4>1, <1>u, <2>a, <2>c, SessionOther
    <3>2. SessionOK(r)' BY <2>r, <2>b, <1>sb, <1>u DEF SessionOK
    <3>. QED BY <3>1, <3>2 DEF I_Session
  <2>. QED BY <2>1, <2>K, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, ZY_Close DEF ZY_V7
<1>6. CASE CoverSet(r, t, b) # {}
  <2>s. PICK s \in CoverSet(r, t, b) :
          /\ CopyAlign(r, s, b, t)
          /\ mark' = [mark EXCEPT ![r] = t] /\ pin' = [pin EXCEPT ![r] = t]
          /\ UNCHANGED <<dState, reverted, restamp>>
    BY <1>6, Full DEF Chase
  <2>cf. s \in Sources(r) /\ t \in Lin(s) /\ (b <= 0 \/ b \in Lin(s)) /\ t \in tr[s] BY <2>s, ZY_CoverSetFacts
  <2>sv. s \in R /\ s # r /\ t \in sPres[s] /\ s \in InSyncR BY <2>cf, <1>0, ZY_LinSub DEF Sources, InSyncR
  <2>b. b \in 0..MaxEpoch /\ b <= t /\ (b = 0 \/ b \in Lin(s)) BY <1>sb, <1>g, <2>cf
  <2>cu. CatchingUp(r) /\ HiOf(r) = b BY <1>g DEF CatchingUp, HiOf
  <2>F. /\ \A x \in Blocks : \/ x \in Copied(s, b, t) /\ ZY_NH(r, s, b, t)[x] = sCon[s][t][x]
                             \/ x \notin Copied(s, b, t) /\ ZY_NH(r, s, b, t)[x] = head[r][x]
        /\ \A x \in Blocks : ZY_NH(r, s, b, t)[x] >= cutAck[s][t][x]
    BY <1>t, <2>b, <2>cu, <2>cf, <2>sv, ZY_CopyFacts
  <2>N. /\ t \in Nat /\ b \in Nat /\ nextSeq \in Nat /\ hPar[r] \in Nat
        /\ \A w \in pend : w.cutAt \in Nat /\ w.b \in Blocks /\ w.v \in Nat
        /\ \A x \in Blocks : acked[x] \in Nat /\ sCon[s][t][x] \in Nat
    BY <1>0, <1>T, <1>t, <1>sb, <2>sv, Nats, Const DEF Epochs
  <2>lo. (IF BaseInclusive \/ b = 0 THEN b ELSE b + 1) = b BY Full
  <2>0. b < t /\ t \notin sPres[r] /\ hPar[r] < t
    <3>1. b < t /\ hPar[r] < t BY <1>g, <1>sb, <2>N
    <3>2. t \notin sPres[r] BY <3>1, <1>sb, <1>t, <2>N
    <3>. QED BY <3>1, <3>2
  <2>pv. \A x \in Blocks : \A w \in pend : ZY_NH(r, s, b, t)[x] = w.v /\ w.b = x => w.cutAt <= t
    <3>. SUFFICES ASSUME NEW x \in Blocks, NEW w \in pend, ZY_NH(r, s, b, t)[x] = w.v, w.b = x
                 PROVE  w.cutAt <= t
      OBVIOUS
    <3>2. CASE x \in Copied(s, b, t)
      <4>1. sCon[s][t][w.b] = w.v BY <3>2, <2>F
      <4>. QED BY <4>1, <2>sv, <1>v DEF I_SnapPend
    <3>3. CASE x \notin Copied(s, b, t)
      <4>1. head[r][w.b] = w.v BY <3>3, <2>F
      <4>2. w.cutAt <= b BY <4>1, <2>cu, <1>0 DEF I_HeadPend
      <4>. QED BY <4>2, <2>0, <2>N
    <3>. QED BY <3>2, <3>3
  <2>lg. \A x \in Blocks : head[r][x] \in ackedEver[x] \cup PendVal(x) BY <1>g, <1>v DEF I_StandbyLegal
  <2>c. /\ head' = [head EXCEPT ![r] = ZY_NH(r, s, b, t)]
        /\ sPres' = [sPres EXCEPT ![r] = @ \cup {t}]
        /\ sCon' = [sCon EXCEPT ![r][t] = ZY_NH(r, s, b, t)]
        /\ sAl' = [sAl EXCEPT ![r][t] = hAl[r] \cup Copied(s, b, t)]
        /\ sPar' = [sPar EXCEPT ![r][t] = hPar[r]]
        /\ anc' = [anc EXCEPT ![r][t] = NewAnc(r, t)]
        /\ hPar' = [hPar EXCEPT ![r] = t] /\ hAl' = [hAl EXCEPT ![r] = {}]
        /\ tr' = [tr EXCEPT ![r] = @ \cup {t}]
        /\ cutAck' = [cutAck EXCEPT ![r][t] = cutAck[s][t]]
    BY <2>0, <2>s, <2>lo, Full DEF CopyAlign, ZY_NH
  <2>m. \A q \in R \ {r} : /\ head'[q] = head[q] /\ sPres'[q] = sPres[q] /\ sCon'[q] = sCon[q]
                            /\ sAl'[q] = sAl[q] /\ sPar'[q] = sPar[q] /\ anc'[q] = anc[q]
                            /\ hPar'[q] = hPar[q] /\ hAl'[q] = hAl[q] /\ tr'[q] = tr[q]
                            /\ cutAck'[q] = cutAck[q]
    BY <2>c, <1>0, Groups DEF TyHead, TySnap, TyTrust
  <2>o. \A e \in sPres[r] : /\ sCon'[r][e] = sCon[r][e] /\ sAl'[r][e] = sAl[r][e]
                             /\ sPar'[r][e] = sPar[r][e] /\ anc'[r][e] = anc[r][e]
                             /\ cutAck'[r][e] = cutAck[r][e]
    BY <2>c, <2>0, <1>t, <1>0, Groups DEF TySnap, TyTrust
  <2>n. /\ sPres'[r] = sPres[r] \cup {t} /\ sCon'[r][t] = ZY_NH(r, s, b, t)
        /\ sAl'[r][t] = hAl[r] \cup Copied(s, b, t) /\ sPar'[r][t] = hPar[r] /\ anc'[r][t] = NewAnc(r, t)
        /\ hPar'[r] = t /\ hAl'[r] = {} /\ head'[r] = ZY_NH(r, s, b, t) /\ tr'[r] = tr[r] \cup {t}
        /\ cutAck'[r][t] = cutAck[s][t]
    BY <2>c, <1>t, <1>0, Groups DEF TyHead, TySnap, TyTrust
  <2>ms. /\ mark'[r] = t /\ pin'[r] = t
         /\ \A q \in R \ {r} : mark'[q] = mark[q] /\ pin'[q] = pin[q]
    BY <2>s, <1>0, Groups DEF TyLeg
  <2>cu2. /\ CatchingUp(r)' /\ HiOf(r)' = t /\ dState'[r] = "standby"
          /\ \A q \in R \ {r} : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q) /\ dState'[q] = dState[q]
    BY <2>s, <2>ms, <1>g, <1>u DEF CatchingUp, HiOf
  <2>1. TypeOK'
    <3>1. (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp OBVIOUS
    <3>. QED BY <3>1, <1>0, S_TyCatchup
  <2>K. /\ IndJ' /\ I_MembersS' /\ I_HoldAtt' /\ Inv_AckedHeld' /\ I_FreshS' /\ I_AckedEverS' /\ I_NoBadLoss'
        /\ J_RelHoldS' /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe'
    <3>1. \A q \in R \ {r} : dState'[q] = dState[q] /\ sb'[q] = sb[q] /\ reverted'[q] = reverted[q] BY <2>s, <1>u
    <3>. QED BY <3>1, <1>g, <2>s, <2>m, <1>u, ZY_Keep
  <2>2. I_Pend'
    <3>1. \A q \in members : head'[q] = head[q] BY <1>sb, <2>m, <1>T
    <3>. SUFFICES ASSUME NEW w \in pend
                 PROVE  \A q \in w.landed \cap members : head'[q][w.b] = w.v
      BY <1>0, <1>u DEF I_Pend
    <3>. QED BY <3>1, <1>0 DEF I_Pend
  <2>3. I_RangesS'
    <3>1. sPres'[r] \subseteq 1..nextSeq /\ tr'[r] \subseteq sPres'[r] \cap 1..(nextSeq - 1) /\ hPar'[r] \in sPres'[r]
      BY <2>n, <1>t, <1>0 DEF I_RangesS, Epochs
    <3>. QED BY <1>0, <1>u, <2>m, <3>1 DEF I_RangesS
  <2>rd. \A x \in Blocks : x \notin sAl'[r][t] => sCon'[r][t][x] = Up(sPar[r], sCon[r], hPar[r], x)
    <3>. SUFFICES ASSUME NEW x \in Blocks, x \notin sAl'[r][t] PROVE sCon'[r][t][x] = Up(sPar[r], sCon[r], hPar[r], x)
      OBVIOUS
    <3>1. x \notin hAl[r] /\ x \notin Copied(s, b, t) BY <2>n
    <3>2. ZY_NH(r, s, b, t)[x] = head[r][x] BY <3>1, <2>F
    <3>. QED BY <3>1, <3>2, <2>n, <1>0 DEF I_Chain
  <2>LE. ChainShape(sPres'[r], sPar'[r], anc'[r]) /\ ChainReads(sPres'[r], sPar'[r], sAl'[r], sCon'[r])
    <3>1. anc'[r][t] = {t} \cup (IF hPar[r] = 0 THEN {} ELSE anc[r][hPar[r]]) BY <2>n DEF NewAnc, AncOf
    <3>. QED BY <1>0, <1>t, <2>0, <2>n, <2>o, <2>rd, <3>1, ZY_LegExtend
  <2>4. I_Lineage'
    <3>1. ChainShape(sPres'[r], sPar'[r], anc'[r]) BY <2>LE
    <3>2. \A e \in Epochs \ sPres'[r] : anc'[r][e] = {} BY <2>c, <2>n, <1>0, Groups DEF TySnap, I_Lineage
    <3>. QED BY <1>0, <2>m, <3>1, <3>2 DEF I_Lineage
  <2>5. I_Chain'
    <3>1. ChainReads(sPres'[r], sPar'[r], sAl'[r], sCon'[r]) BY <2>LE
    <3>2. \A x \in Blocks : head'[r][x] = Up(sPar'[r], sCon'[r], hPar'[r], x) BY <2>n, <1>t DEF Up
    <3>. QED BY <1>0, <2>m, <3>1, <3>2 DEF I_Chain
  <2>6. /\ I_WHiS' /\ Inv_TrustComplete' /\ I_LegalS' /\ I_LegalS2' /\ I_PendSeen' /\ I_Vers' /\ I_AckMono'
        /\ I_HeadLoS' /\ I_HeadPend' /\ I_SnapPend' /\ I_SnapLegal' /\ I_StandbyLegal'
        /\ I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC' /\ I_PendTop' /\ I_PendNext'
    <3>1. \A x \in Blocks : ZY_NH(r, s, b, t)[x] = sCon[s][t][x] \/ ZY_NH(r, s, b, t)[x] = head[r][x] BY <2>F
    <3>2. HiOf(r) < t BY <2>cu, <2>0
    <3>. QED BY <2>sv, <1>t, <2>0, <2>cu, <2>cf, <3>1, <3>2, <2>F, <2>pv, <2>lg, <2>n, <2>o, <2>m,
                <2>cu2, <1>u, <1>us, ZY_CopySnap
  <2>7. I_Reverted'
    <3>1. \A q \in R \ {r} : RevOK(q)'
      <4>. SUFFICES ASSUME NEW q \in R \ {r} PROVE RevOK(q)' OBVIOUS
      <4>1. RevOK(q) BY <1>0 DEF I_Reverted
      <4>. QED BY <4>1, <2>m, <2>s, <1>u, RevOther
    <3>2. RevOK(r)' BY <1>g, <2>s DEF RevOK
    <3>. QED BY <3>1, <3>2 DEF I_Reverted
  <2>8. I_Session'
    <3>1. \A q \in R \ {r} : SessionOK(q)'
      <4>. SUFFICES ASSUME NEW q \in R \ {r} PROVE SessionOK(q)' OBVIOUS
      <4>1. SessionOK(q) BY <1>0 DEF I_Session
      <4>. QED BY <4>1, <1>u, <2>ms, <2>m, <2>s, SessionOther
    <3>2. SessionOK(r)'
      <4>1. \A e \in sPres'[r] : e <= t \/ \A f \in recorded : e < f BY <1>sb, <2>n, <2>0, <2>N, <2>b, <1>T
      <4>2. nextSeq \notin sPres'[r] BY <1>so, <1>g, <2>n, <1>t DEF SessionOK, CatchingUp
      <4>. QED BY <2>ms, <1>t, <2>n, <4>1, <4>2, <1>u, <1>g, <1>sb, <1>so, <2>s, <2>cu2 DEF SessionOK, CatchingUp
    <3>. QED BY <3>1, <3>2 DEF I_Session
  <2>. QED BY <2>1, <2>K, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>8, ZY_Close DEF ZY_V7
<1>. QED BY <1>5, <1>6

-----------------------------------------------------------------------------
(* The rest of IndNew (41-ind-new): inv-zombie's J_ZRel, J_ZNoValid,       *)
(* J_ZM0, J_ZCut, inv-cut's I_CutLegal / I_InSyncLegal, inv-admit's         *)
(* I_ValidLegal, J_SoleGen.  The copy leaves the stamp, the zombie's leg,  *)
(* the cut, the record's in_sync legs and their heads alone; the leg it    *)
(* writes is a standby after it (or was one), so its head is legal by      *)
(* I_StandbyLegal.                                                         *)

ZY_V7X == /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal
          /\ J_ZNoValid /\ J_ZM0 /\ J_SoleGen /\ J_ZCut

LEMMA ZY_KeepX ==
  ASSUME ZY_V7X, NoStamp, NEW r \in R,
         dState[r] # "insync", dState'[r] # "insync", zx # r, zx \in R \cup {0},
         UNCHANGED <<zx, cutK, cutTgt, ackedEver, pend, attached>>, cutTgt \subseteq R,
         \A q \in R \ {r} : head'[q] = head[q] /\ dState'[q] = dState[q],
         \A x \in Blocks : head'[r][x] \in ackedEver[x] \cup PendVal(x)
  PROVE  ZY_V7X'
<1>s. UNCHANGED <<stamp, sole, nseq, agen, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>> BY DEF NoStamp, stampVars
<1>i. InSyncR' = InSyncR /\ r \notin InSyncR BY DEF InSyncR
<1>h. \A q \in InSyncR : head'[q] = head[q] BY <1>i DEF InSyncR
<1>1. J_ZRel' BY <1>s, <1>i DEF ZY_V7X, J_ZRel, ZombieReleases, Valid, Majority, SolePairs
<1>2. I_CutLegal'
  <2>. SUFFICES ASSUME cutK # 0, NEW q \in cutTgt, NEW x \in Blocks
               PROVE  head'[q][x] \in ackedEver[x] \cup PendVal(x)
    BY DEF I_CutLegal, PendVal
  <2>1. CASE q = r BY <2>1
  <2>2. CASE q # r
    <3>1. head[q][x] \in ackedEver[x] \cup PendVal(x) BY DEF ZY_V7X, I_CutLegal
    <3>. QED BY <3>1, <2>2
  <2>. QED BY <2>1, <2>2
<1>3. I_InSyncLegal' BY <1>i, <1>h DEF ZY_V7X, I_InSyncLegal, PendVal
<1>4. I_ValidLegal' BY <1>s, <1>i, <1>h DEF ZY_V7X, I_ValidLegal, PendVal, Valid, Majority, SolePairs
<1>5. J_ZNoValid'
  <2>. SUFFICES ASSUME zx # 0, zst, dState'[zx] = "insync" PROVE ~Valid(stamp[zx])
    BY <1>s DEF J_ZNoValid, Valid, Majority, SolePairs
  <2>1. zx \in R \ {r} OBVIOUS
  <2>. QED BY <2>1 DEF ZY_V7X, J_ZNoValid
<1>6. J_ZM0' /\ J_SoleGen' /\ J_ZCut' BY <1>s, F_ZM0, F_SoleGen, F_ZCut DEF ZY_V7X
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6 DEF ZY_V7X

LEMMA I_BulkCopyX ==
  ASSUME IndInv, ZY_V7, ZY_V7X, NEW r \in R, BulkCopy(r) /\ NoStamp,
         ZY_CopyLo   \* NEEDS-INV (G1), as I_BulkCopy
  PROVE  ZY_V7X'
<1>0. TypeOK /\ TypeOKT BY ZY_Open
<1>a. I_StandbyLegal' BY I_BulkCopy DEF ZY_V7
<1>g. /\ dState[r] = "stale" /\ reverted[r] # -1
      /\ dState' = [dState EXCEPT ![r] = "standby"]
      /\ UNCHANGED <<zx, cutK, cutTgt, ackedEver, pend, attached>>
  BY DEF BulkCopy
<1>z. zx # r /\ zx \in R \cup {0} BY <1>g, <1>0, RNat, Groups DEF ZY_V7, J_ZxIdle, TyScalar
<1>s. PICK s \in CoverSet(r, Tgt, sb[r]) : CopyAlign(r, s, sb[r], Tgt) BY DEF BulkCopy
<1>h. \A q \in R \ {r} : head'[q] = head[q] /\ dState'[q] = dState[q]
  BY <1>s, <1>g, <1>0, Groups DEF CopyAlign, TyHead, TyLeg
<1>r. dState'[r] = "standby" BY <1>g, <1>0, Groups DEF TyLeg
<1>l. \A x \in Blocks : head'[r][x] \in ackedEver[x] \cup PendVal(x) BY <1>a, <1>r, <1>g DEF I_StandbyLegal, PendVal
<1>T. cutTgt \subseteq R BY <1>0, Basics
<1>. QED BY <1>g, <1>z, <1>h, <1>r, <1>l, <1>T, ZY_KeepX

LEMMA I_ChaseX ==
  ASSUME IndInv, ZY_V7, ZY_V7X, NEW r \in R, Chase(r) /\ NoStamp,
         ZY_CopyLo   \* NEEDS-INV (G1), as I_Chase
  PROVE  ZY_V7X'
<1>0. TypeOK /\ TypeOKT BY ZY_Open
<1>a. I_StandbyLegal' BY I_Chase DEF ZY_V7
<1>g. /\ dState[r] = "standby" /\ r # zx
      /\ UNCHANGED <<zx, cutK, cutTgt, ackedEver, pend, attached>>
  BY Full DEF Chase
<1>z. zx \in R \cup {0} BY <1>0, Groups DEF TyScalar
<1>T. cutTgt \subseteq R BY <1>0, Basics
<1>. DEFINE t == Tgt
<1>1. CASE CoverSet(r, t, mark[r]) = {}
  <2>c. dState' = [dState EXCEPT ![r] = "stale"] /\ UNCHANGED head BY <1>1, Full DEF Chase
  <2>h. \A q \in R \ {r} : head'[q] = head[q] /\ dState'[q] = dState[q] BY <2>c, <1>0, Groups DEF TyLeg
  <2>r. dState'[r] = "stale" BY <2>c, <1>0, Groups DEF TyLeg
  <2>l. \A x \in Blocks : head'[r][x] \in ackedEver[x] \cup PendVal(x) BY <2>c, <1>g DEF ZY_V7, I_StandbyLegal
  <2>. QED BY <1>g, <1>z, <1>T, <2>h, <2>r, <2>l, ZY_KeepX
<1>2. CASE CoverSet(r, t, mark[r]) # {}
  <2>s. PICK s \in CoverSet(r, t, mark[r]) : CopyAlign(r, s, mark[r], t) /\ UNCHANGED dState
    BY <1>2, Full DEF Chase
  <2>h. \A q \in R \ {r} : head'[q] = head[q] /\ dState'[q] = dState[q] BY <2>s, <1>0, Groups DEF CopyAlign, TyHead
  <2>l. \A x \in Blocks : head'[r][x] \in ackedEver[x] \cup PendVal(x) BY <1>a, <2>s, <1>g DEF I_StandbyLegal, PendVal
  <2>. QED BY <1>g, <1>z, <1>T, <2>h, <2>s, <2>l, ZY_KeepX
<1>. QED BY <1>1, <1>2

-----------------------------------------------------------------------------
(* The final form (main, 10-31): IndInv /\ IndNew carries over each copy  *)
(* step.  ZY_CopyLo is no hypothesis here: ZY_CopyLoC gives it from        *)
(* I_HeadLoC.                                                              *)

LEMMA ZY_NewOpen ==
  ASSUME IndInv, IndNew PROVE ZY_V7 /\ ZY_V7X /\ ZY_CopyLo
<1>1. ZY_V7 /\ ZY_V7X BY IndNewSplit DEF ZY_V7, ZY_V7X
<1>2. ZY_CopyLo BY <1>1, ZY_CopyLoC DEF ZY_V7
<1>. QED BY <1>1, <1>2

LEMMA I_BulkCopyAll ==
  ASSUME IndInv, IndNew, NEW r \in R, BulkCopy(r) /\ NoStamp
  PROVE  IndInv' /\ IndNew'
<1>1. ZY_V7 /\ ZY_V7X /\ ZY_CopyLo BY ZY_NewOpen
<1>2. IndInv' /\ ZY_V7' BY <1>1, I_BulkCopy
<1>3. ZY_V7X' BY <1>1, I_BulkCopyX
<1>. QED BY <1>2, <1>3, IndNewSplitP DEF ZY_V7, ZY_V7X

LEMMA I_ChaseAll ==
  ASSUME IndInv, IndNew, NEW r \in R, Chase(r) /\ NoStamp
  PROVE  IndInv' /\ IndNew'
<1>1. ZY_V7 /\ ZY_V7X /\ ZY_CopyLo BY ZY_NewOpen
<1>2. IndInv' /\ ZY_V7' BY <1>1, I_Chase
<1>3. ZY_V7X' BY <1>1, I_ChaseX
<1>. QED BY <1>2, <1>3, IndNewSplitP DEF ZY_V7, ZY_V7X

-----------------------------------------------------------------------------
(* (S) The invariant layer: the consumer's unstage (drained, crashed) and   *)
(* its stage.  Capture is FALSE: the unstage marks nothing, so a leg the    *)
(* raid lost under a barrier stays in_sync in the last release (rmemA) and  *)
(* is a base of the detached volume (I_FreshS2, J_RelHoldS).  The stage     *)
(* assembles legs of rmemA that are in_sync (S_StageRead), so they hold     *)
(* every acked write; NewAsm restarts the stamp layer on them.              *)

\* NodeUnstage, drained (Capture FALSE: no record write; the pending epochs confirmed by nothing)
LEMMA ZU_Unstage ==
  ASSUME IndInv, Unstage, EndRaidS,
         \* NEEDS-INV (v7 candidate, inv-stage N2): the detached bases, while attached too
         I_FreshS2
  PROVE  IndInv'
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>j. /\ J_DueHold /\ J_HoldAtt /\ J_Rel /\ J_Cur /\ J_ZxOut /\ J_Aseq /\ J_SeqSync /\ J_MemRel /\ J_RelHold
      /\ J_NoAckBad /\ J_M0 /\ J_RelValid /\ J_MinorRel /\ J_RelInSync /\ J_ViewIn /\ J_ViewOut /\ J_SoleSeq
      /\ J_GenBound /\ J_ZGen
  BY <1>0 DEF IndJ
<1>t. /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
  BY <1>0 DEF IndT
<1>s. I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS BY <1>0 DEF IndS
<1>ty. \A q \in R : sPres[q] \subseteq Epochs BY <1>0, TypeOKParts, Basics
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, path, mark, reverted, sb, pin>>
      /\ UNCHANGED <<pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, zx>>
      /\ UNCHANGED <<used, mustRev, cfgAt, cutAck>>
  BY DEF Unstage
<1>p. /\ attached /\ pend = {} /\ cutK = 0 /\ attached' = FALSE /\ members' = {}
      /\ UNCHANGED <<dState, tainted, floor, restamp>>
      /\ conf' = [e \in Epochs |-> TRUE] /\ tr' = tr
  BY Full DEF Unstage
<1>e. /\ hold' = FALSE /\ due' = FALSE
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
      /\ UNCHANGED <<badAck, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched,
                     tornMarked, tornServed, tornBare, zpost>>
  BY DEF EndRaidS, sGhost
<1>1. TypeOK' BY <1>0, S_TyEndRaid
<1>J1. J_DueHold' /\ J_HoldAtt' /\ J_Rel' /\ J_Cur' /\ J_ZxOut' /\ J_MemRel' /\ J_GenBound'
  BY <1>p, <1>e DEF J_DueHold, J_HoldAtt, J_Rel, J_Cur, J_ZxOut, J_MemRel, J_GenBound
<1>J2. J_Aseq' /\ J_SeqSync' /\ J_RelHold' /\ J_NoAckBad' /\ J_M0' /\ J_RelValid' /\ J_MinorRel'
  BY <1>j, <1>p, <1>e, <1>u, F_Aseq, F_SeqSync, F_RelHold, F_NoAckBad, F_M0, F_RelValid, F_MinorRel
<1>J3. J_RelInSync' /\ J_ViewIn' /\ J_ViewOut' /\ J_SoleSeq' /\ J_ZGen'
  BY <1>j, <1>p, <1>e, <1>u, F_RelInSync, F_ViewIn, F_ViewOut, F_SoleSeq, F_ZGen
<1>J. IndJ' BY <1>J1, <1>J2, <1>J3 DEF IndJ
<1>T1. I_RangesS' BY <1>t, <1>p, <1>u DEF I_RangesS
<1>T2. I_Lineage' /\ I_Chain' /\ I_PendSeen' /\ I_Vers' /\ I_Reverted' /\ I_HeadPend'
  BY <1>t, <1>p, <1>u, F_Lineage, F_Chain, F_PendSeen, F_Vers, F_Reverted, F_HeadPend
<1>T3. Inv_TrustComplete' /\ I_NoBadLoss' /\ Inv_AckedHeld' BY <1>t, <1>p, <1>u, F_TC, F_NoBadLoss, F_AckedHeld
<1>T4. I_Pend' /\ I_MembersS' /\ I_HoldAtt' BY <1>p, <1>u DEF I_Pend, I_MembersS, I_HoldAtt
<1>T5. I_Session'
  <2>. SUFFICES ASSUME NEW q \in R PROVE SessionOK(q)' BY DEF I_Session
  <2>0. SessionOK(q) BY <1>t DEF I_Session
  <2>. QED BY <2>0, <1>p, <1>u DEF SessionOK, CatchingUp
<1>T. IndT' BY <1>T1, <1>T2, <1>T3, <1>T4, <1>T5 DEF IndT
<1>S1. I_AckedEverS' /\ I_LegalS' /\ I_WHiS' /\ I_AckMono' /\ I_HeadLoS'
  BY <1>s, <1>p, <1>u, <1>e, F_AckedEverS, F_LegalS, F_WHiS, F_AckMono, F_HeadLoS
<1>S2. I_FreshS'
  <2>. SUFFICES ASSUME NEW q \in InSyncR \cap rmemA, NEW e \in sPres[q], e >= nextSeq \/ ~conf'[e],
                      NEW x \in Blocks
               PROVE  sCon[q][e][x] >= cutAck[q][e][x]
    BY <1>p, <1>u, <1>e DEF I_FreshS, BasesS, InSyncR
  <2>1. e \in Epochs BY <1>ty DEF InSyncR
  <2>2. e >= nextSeq BY <2>1, <1>p
  <2>. QED BY <2>2 DEF I_FreshS2
<1>S. IndS' BY <1>S1, <1>S2 DEF IndS
<1>. QED BY <1>1, <1>J, <1>T, <1>S, IndSplitP

\* the crash: a value in flight that a leg shows has landed (I_PendSeen), so it joins ackedEver
LEMMA ZU_CrashLegal ==
  ASSUME TypeOK, I_PendSeen, CrashUnstage, NEW x \in Blocks, NEW v \in ackedEver[x] \cup PendVal(x),
         \E q \in R : v = head[q][x] \/ \E e \in sPres[q] : v = sCon[q][e][x]
  PROVE  v \in ackedEver'[x]
<1>1. ackedEver'[x] = ackedEver[x] \cup {w.v : w \in {u \in pend : u.b = x /\ u.landed # {}}} BY DEF CrashUnstage
<1>2. CASE v \in ackedEver[x] BY <1>1, <1>2
<1>3. CASE v \in PendVal(x)
  <2>1. PICK w \in pend : w.b = x /\ w.v = v BY <1>3 DEF PendVal
  <2>2. w.landed # {} BY <2>1 DEF I_PendSeen
  <2>3. w \in {u \in pend : u.b = x /\ u.landed # {}} BY <2>1, <2>2
  <2>. QED BY <2>1, <2>3, <1>1
<1>. QED BY <1>2, <1>3

\* the consumer crashes mid write: no capture, the writes in flight torn, the cut abandoned
LEMMA ZU_Crash ==
  ASSUME IndInv, CrashUnstage, EndRaidS,
         \* NEEDS-INV (v7 candidate, inv-stage N1): a released in_sync leg holds the in-flight blocks' acked values too
         J_RelHoldS,
         \* NEEDS-INV (v7 candidate, inv-stage N2): the detached bases, while attached too
         I_FreshS2
  PROVE  IndInv'
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>j. /\ J_DueHold /\ J_HoldAtt /\ J_Rel /\ J_Cur /\ J_ZxOut /\ J_Aseq /\ J_SeqSync /\ J_MemRel /\ J_RelHold
      /\ J_NoAckBad /\ J_M0 /\ J_RelValid /\ J_MinorRel /\ J_RelInSync /\ J_ViewIn /\ J_ViewOut /\ J_SoleSeq
      /\ J_GenBound /\ J_ZGen
  BY <1>0 DEF IndJ
<1>t. /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
  BY <1>0 DEF IndT
<1>s. I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS BY <1>0 DEF IndS
<1>ty. \A q \in R : sPres[q] \subseteq Epochs BY <1>0, TypeOKParts, Basics
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin>>
      /\ UNCHANGED <<acked, fails, riskRec, badAdmit, badLoss, restamp, zx>>
      /\ UNCHANGED <<used, tainted, floor, mustRev, cfgAt, tr, cutAck>>
  BY DEF CrashUnstage, tieVars
<1>p. /\ attached /\ attached' = FALSE /\ members' = {} /\ pend' = {}
      /\ ackedEver' = [x \in Blocks |-> ackedEver[x] \cup {w.v : w \in {u \in pend : u.b = x /\ u.landed # {}}}]
      /\ cutK' = 0 /\ cutTgt' = {} /\ cutDone' = {} /\ cutGone' = {}
      /\ conf' = [e \in Epochs |-> TRUE]
  BY Full DEF CrashUnstage
<1>e. /\ hold' = FALSE /\ due' = FALSE
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
      /\ UNCHANGED <<badAck, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched,
                     tornMarked, tornServed, tornBare, zpost>>
  BY DEF EndRaidS, sGhost
<1>1. TypeOK' BY <1>0, S_TyEndRaid
<1>J1. J_DueHold' /\ J_HoldAtt' /\ J_Rel' /\ J_Cur' /\ J_ZxOut' /\ J_MemRel' /\ J_GenBound'
  BY <1>p, <1>e DEF J_DueHold, J_HoldAtt, J_Rel, J_Cur, J_ZxOut, J_MemRel, J_GenBound
<1>J2. J_Aseq' /\ J_SeqSync' /\ J_NoAckBad' /\ J_M0' /\ J_RelValid' /\ J_MinorRel'
  BY <1>j, <1>e, <1>u, F_Aseq, F_SeqSync, F_NoAckBad, F_M0, F_RelValid, F_MinorRel
<1>J3. J_RelInSync' /\ J_ViewIn' /\ J_ViewOut' /\ J_SoleSeq' /\ J_ZGen'
  BY <1>j, <1>e, <1>u, F_RelInSync, F_ViewIn, F_ViewOut, F_SoleSeq, F_ZGen
\* the writes in flight are gone: J_RelHold' needs every block, J_RelHoldS gives it
<1>J4. J_RelHold' BY <1>u, <1>e DEF J_RelHold, J_RelHoldS, InSyncR
<1>J. IndJ' BY <1>J1, <1>J2, <1>J3, <1>J4 DEF IndJ
<1>T1. I_RangesS' BY <1>t, <1>p, <1>u DEF I_RangesS
<1>T2. I_Lineage' /\ I_Chain' /\ I_Vers' /\ I_Reverted'
  BY <1>t, <1>u, F_Lineage, F_Chain, F_Vers, F_Reverted
<1>T3. Inv_TrustComplete' /\ I_NoBadLoss' /\ Inv_AckedHeld' BY <1>t, <1>u, F_TC, F_NoBadLoss, F_AckedHeld
<1>T4. I_Pend' /\ I_PendSeen' /\ I_HeadPend' /\ I_MembersS' /\ I_HoldAtt'
  BY <1>p DEF I_Pend, I_PendSeen, I_HeadPend, I_MembersS, I_HoldAtt
<1>T5. I_Session'
  <2>. SUFFICES ASSUME NEW q \in R PROVE SessionOK(q)' BY DEF I_Session
  <2>0. SessionOK(q) BY <1>t DEF I_Session
  <2>. QED BY <2>0, <1>p, <1>u DEF SessionOK, CatchingUp
<1>T. IndT' BY <1>T1, <1>T2, <1>T3, <1>T4, <1>T5 DEF IndT
<1>S1. I_WHiS' /\ I_AckMono' /\ I_HeadLoS' BY <1>s, <1>u, F_WHiS, F_AckMono, F_HeadLoS
<1>S2. I_AckedEverS' BY <1>s, <1>p, <1>u DEF I_AckedEverS
\* a torn write's value shows on a leg only if it landed (I_PendSeen), and then it joins ackedEver
<1>S3. I_LegalS'
  <2>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
               PROVE  /\ head[q][x] \in LegalV(x)'
                      /\ \A e \in sPres[q] : sCon[q][e][x] \in LegalV(x)'
    BY <1>u DEF I_LegalS
  <2>1. ASSUME NEW v \in LegalV(x), \E q2 \in R : v = head[q2][x] \/ \E e \in sPres[q2] : v = sCon[q2][e][x]
        PROVE  v \in LegalV(x)'
    <3>1. CASE v \in ackedEver[x] \cup PendVal(x)
      <4>1. v \in ackedEver'[x] BY <3>1, <2>1, <1>0, <1>t, ZU_CrashLegal
      <4>. QED BY <4>1 DEF LegalV
    <3>2. CASE v \in zjv \cup zpost BY <3>2, <1>e DEF LegalV
    <3>. QED BY <3>1, <3>2 DEF LegalV
  <2>2. head[q][x] \in LegalV(x)' BY <2>1, <1>s DEF I_LegalS
  <2>3. \A e \in sPres[q] : sCon[q][e][x] \in LegalV(x)' BY <2>1, <1>s DEF I_LegalS
  <2>. QED BY <2>2, <2>3
<1>S4. I_FreshS'
  <2>. SUFFICES ASSUME NEW q \in InSyncR \cap rmemA, NEW e \in sPres[q], e >= nextSeq \/ ~conf'[e],
                      NEW x \in Blocks
               PROVE  sCon[q][e][x] >= cutAck[q][e][x]
    BY <1>p, <1>u, <1>e DEF I_FreshS, BasesS, InSyncR
  <2>1. e \in Epochs BY <1>ty DEF InSyncR
  <2>2. e >= nextSeq BY <2>1, <1>p
  <2>. QED BY <2>2 DEF I_FreshS2
<1>S. IndS' BY <1>S1, <1>S2, <1>S3, <1>S4 DEF IndS
<1>. QED BY <1>1, <1>J, <1>T, <1>S, IndSplitP

LEMMA I_EndRaid ==
  ASSUME IndInv, (Unstage \/ CrashUnstage) /\ EndRaidS,
         \* NEEDS-INV (v7 candidate, inv-stage N1): a released in_sync leg holds every acked value
         J_RelHoldS,
         \* NEEDS-INV (v7 candidate, inv-stage N2): I_FreshS with the detached bases at every time
         I_FreshS2
  PROVE  IndInv'
<1>1. CASE Unstage BY <1>1, ZU_Unstage
<1>2. CASE CrashUnstage BY <1>2, ZU_Crash
<1>. QED BY <1>1, <1>2

\* NodeStage: the stamp's read names the members (S_StageRead); the assembly write marks every
\* other in_sync leg stale; NewAsm restarts the stamp layer on the members
LEMMA I_Stage ==
  ASSUME IndInv, Stage,
         \* NEEDS-INV (v7 candidate, inv-stage N4): a confirmation of the live seq holds the release, a minority
         J_SoleRel,
         \* NEEDS-INV (v7 candidate, inv-stage N3): no stamp, confirmation or zombie copy is ahead of the live seq
         J_SeqLe
  PROVE  IndInv'
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>j. /\ J_DueHold /\ J_HoldAtt /\ J_Rel /\ J_Cur /\ J_ZxOut /\ J_Aseq /\ J_SeqSync /\ J_MemRel /\ J_RelHold
      /\ J_NoAckBad /\ J_M0 /\ J_RelValid /\ J_MinorRel /\ J_RelInSync /\ J_ViewIn /\ J_ViewOut /\ J_SoleSeq
      /\ J_GenBound /\ J_ZGen
  BY <1>0 DEF IndJ
<1>t. /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
  BY <1>0 DEF IndT
<1>s. I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS BY <1>0 DEF IndS
<1>. DEFINE M == AsmSet
<1>g. ~attached /\ CanStampStage BY Full DEF Stage
<1>K. /\ M # {} /\ M \subseteq rmemA \cap InSyncR /\ M \subseteq Attachable
      /\ \A q \in M : \A x \in Blocks : head[q][x] >= acked[x]
  BY <1>g, S_StageRead
<1>R. M \subseteq R /\ InSyncR \subseteq R BY <1>K DEF InSyncR
<1>z. zx \notin M BY <1>K, Full DEF Attachable
<1>r. pend = {} /\ cutK = 0 /\ members = {} /\ \A e \in Epochs : conf[e] BY <1>t, <1>g DEF I_RangesS
<1>mk. AsmMarks(M) = InSyncR \ M
  <2>1. AsmExcl(M) = InSyncR \ M BY Full DEF AsmExcl
  <2>2. Attachable \ M \subseteq InSyncR \ M BY Full DEF Attachable
  <2>3. DecreeSet \subseteq InSyncR \ M BY <1>z DEF DecreeSet
  <2>. QED BY <2>1, <2>2, <2>3, Full DEF AsmMarks
<1>p. /\ attached' = TRUE /\ members' = M
      /\ path' = [q \in R |-> IF q \in M THEN "ok" ELSE path[q]]
      /\ dState' = [q \in R |-> IF q \in InSyncR \ M THEN "stale" ELSE dState[q]]
      /\ restamp' = [q \in R |-> IF q \in InSyncR \ M THEN FALSE ELSE restamp[q]]
      /\ UNCHANGED <<tainted, floor>>
  BY <1>mk, Full DEF Stage, StaleMarks
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, mark, reverted, sb, pin>>
      /\ UNCHANGED <<pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, zx>>
      /\ UNCHANGED <<used, mustRev, cfgAt, conf, tr, cutAck>>
  BY DEF Stage
<1>n. /\ nseq' = nseq + 1 /\ aseq' = nseq + 1 /\ agen' = 0 /\ asize' = Cardinality(M)
      /\ stamp' = [q \in R |-> IF q \in M THEN [seq |-> nseq + 1, gen |-> 0, size |-> Cardinality(M), mem |-> M,
                                                 rgen |-> 0, rmem |-> M]
                                           ELSE stamp[q]]
      /\ rgenA' = 0 /\ rmemA' = M /\ hold' = FALSE /\ due' = FALSE
      /\ UNCHANGED <<sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst, badAck, zAcked, zLeg, zjv>>
      /\ UNCHANGED <<riskTail, zpost>>
  BY Full DEF Stage, NewAsm, StageGhosts
<1>c. Cardinality(M) \in Nat /\ Cardinality(M) >= 1
  <2>1. IsFiniteSet(M) BY <1>R, RNat, FS_Subset
  <2>2. Cardinality(M) \in Nat BY <2>1, FS_CardinalityType
  <2>3. Cardinality(M) # 0 BY <2>1, <1>K, FS_EmptySet
  <2>. QED BY <2>2, <2>3
<1>i. InSyncR' = M BY <1>p, <1>R, <1>K DEF InSyncR
<1>st. \A q \in M : stamp'[q] = [seq |-> nseq + 1, gen |-> 0, size |-> Cardinality(M), mem |-> M,
                                 rgen |-> 0, rmem |-> M]
  BY <1>n, <1>R
<1>1. TypeOK' BY <1>0, S_TyStage
\* --- the stamp layer restarts on M ---
<1>J1. J_DueHold' /\ J_HoldAtt' /\ J_Rel' /\ J_Aseq' /\ J_MemRel'
  BY <1>n, <1>p DEF J_DueHold, J_HoldAtt, J_Rel, J_Aseq, J_MemRel
<1>J2. J_ZxOut' /\ J_NoAckBad' /\ J_ZGen' BY <1>n, <1>p, <1>u, <1>z, <1>j DEF J_ZxOut, J_NoAckBad, J_ZGen
<1>J3. J_Cur' BY <1>n, <1>p, <1>st DEF J_Cur, Core, CurStamp
<1>J4. J_SeqSync' BY <1>i, <1>n, <1>st DEF J_SeqSync
<1>J5. J_RelHold' BY <1>K, <1>i, <1>n, <1>u DEF J_RelHold
<1>J6. J_M0'
  <2>1. \A q \in R : stamp[q].seq <= nseq /\ stamp[q].seq \in Nat BY <1>0, Const DEF J_SeqLe, TypeOK, StampRec
  <2>2. nseq \in Nat BY <1>0 DEF TypeOK
  <2>3. SeqLegs' = M BY <2>1, <2>2, <1>n, <1>R DEF SeqLegs
  <2>. QED BY <2>3, <1>n, <1>i DEF J_M0
<1>J7. J_RelValid' /\ J_MinorRel' /\ J_RelInSync'
  BY <1>n, <1>c, <1>K, <1>i DEF J_RelValid, J_MinorRel, J_RelInSync, Valid, Majority, RelStamp
<1>J8. J_ViewIn' /\ J_ViewOut'
  <2>1. \A q \in M : 2 * Cardinality(stamp'[q].mem) > stamp'[q].size BY <1>st, <1>c
  <2>2. \A q \in M : stamp'[q].seq = nseq' /\ stamp'[q].gen = 0 /\ stamp'[q].mem = M BY <1>st, <1>n
  <2>3. J_ViewIn' BY <2>1, <2>2, <1>i, <1>n DEF J_ViewIn, View, Valid, Majority
  <2>4. J_ViewOut' BY <1>i, <1>n DEF J_ViewOut
  <2>. QED BY <2>3, <2>4
<1>J9. J_SoleSeq'
  <2>1. \A c \in sole : c[1] <= nseq BY DEF J_SeqLe
  <2>2. nseq \in Nat BY <1>0 DEF TypeOK
  <2>. QED BY <2>1, <2>2, <1>n DEF J_SoleSeq
<1>J10. J_GenBound' BY <1>n, <1>p, <1>c DEF J_GenBound
<1>J. IndJ' BY <1>J1, <1>J2, <1>J3, <1>J4, <1>J5, <1>J6, <1>J7, <1>J8, <1>J9, <1>J10 DEF IndJ
\* --- the old conjuncts ---
<1>T1. I_RangesS' BY <1>t, <1>r, <1>u, <1>p DEF I_RangesS
<1>T2. I_Lineage' /\ I_Chain' /\ I_PendSeen' /\ I_Vers' /\ Inv_TrustComplete' /\ I_NoBadLoss'
  BY <1>t, <1>u, F_Lineage, F_Chain, F_PendSeen, F_Vers, F_TC, F_NoBadLoss
<1>T3. I_Pend' /\ I_HeadPend' BY <1>r, <1>u DEF I_Pend, I_HeadPend
<1>T4. I_MembersS' /\ I_HoldAtt' BY <1>p, <1>i, <1>K, <1>u DEF I_MembersS, I_HoldAtt
<1>q. \A q \in InSyncR : reverted[q] = -1 /\ sb[q] = -1 BY <1>t DEF I_Session, SessionOK, InSyncR
<1>cu. \A q \in R : /\ CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q)
                    /\ (CatchingUp(q) => q \notin InSyncR)
  BY <1>p, <1>u, <1>q DEF CatchingUp, HiOf, InSyncR
<1>T5. I_Reverted'
  <2>. SUFFICES ASSUME NEW q \in R PROVE RevOK(q)' BY DEF I_Reverted
  <2>1. CASE q \in InSyncR \ M BY <2>1, <1>q, <1>u DEF RevOK
  <2>2. CASE q \notin InSyncR \ M
    <3>1. dState'[q] = dState[q] BY <2>2, <1>p
    <3>2. RevOK(q) BY <1>t DEF I_Reverted
    <3>. QED BY <3>1, <3>2, <1>u, RevOther
  <2>. QED BY <2>1, <2>2
<1>T6. I_Session'
  <2>. SUFFICES ASSUME NEW q \in R PROVE SessionOK(q)' BY DEF I_Session
  <2>0. SessionOK(q) BY <1>t DEF I_Session
  <2>1. CASE q \in InSyncR \ M
    <3>1. reverted[q] = -1 /\ sb[q] = -1 /\ dState'[q] = "stale" BY <2>1, <1>q, <1>p
    <3>. QED BY <3>1, <1>u, <1>r DEF SessionOK, CatchingUp
  <2>2. CASE q \notin InSyncR \ M
    <3>1. dState'[q] = dState[q] BY <2>2, <1>p
    <3>2. dState[q] # "insync" => q \notin M /\ path'[q] = path[q] BY <1>K, <1>p DEF InSyncR
    <3>. QED BY <2>0, <3>1, <3>2, <1>u, <1>p, <1>r DEF SessionOK, CatchingUp
  <2>. QED BY <2>1, <2>2
<1>T7. Inv_AckedHeld'
  <2>. SUFFICES ASSUME NEW x \in Blocks PROVE \E r \in R : dState'[r] = "insync" /\ head'[r][x] >= acked'[x]
    BY DEF Inv_AckedHeld
  <2>1. PICK r \in M : TRUE BY <1>K
  <2>2. r \in R /\ dState'[r] = "insync" BY <2>1, <1>p, <1>K DEF InSyncR
  <2>. QED BY <2>1, <2>2, <1>K, <1>u
<1>T. IndT' BY <1>T1, <1>T2, <1>T3, <1>T4, <1>T5, <1>T6, <1>T7 DEF IndT
\* --- the restatements ---
<1>S1. I_AckedEverS' /\ I_LegalS' /\ I_WHiS' /\ I_AckMono'
  BY <1>s, <1>u, <1>n, F_AckedEverS, F_LegalS, F_WHiS, F_AckMono
<1>S2. I_HeadLoS' BY <1>s, <1>cu, <1>u DEF I_HeadLoS
<1>S3. I_FreshS'
  <2>. SUFFICES ASSUME NEW q \in M, NEW e \in sPres[q], e >= nextSeq \/ ~conf[e], NEW x \in Blocks
               PROVE  sCon[q][e][x] >= cutAck[q][e][x]
    BY <1>p, <1>u DEF I_FreshS, BasesS
  <2>1. q \in BasesS BY <1>K, <1>g DEF BasesS
  <2>. QED BY <2>1, <1>s DEF I_FreshS
<1>S. IndS' BY <1>S1, <1>S2, <1>S3 DEF IndS
<1>. QED BY <1>1, <1>J, <1>T, <1>S, IndSplitP

\* --- the v7 candidates across the consumer's steps (ready for when IndInv takes them) ---------------
ZU_V7 ==
  /\ I_SnapPend /\ J_ZxIdle /\ J_ZLive /\ J_RelLe /\ I_LegalS2 /\ J_RelHoldS /\ I_FreshS2 /\ J_SeqLe /\ J_SoleRel
  /\ J_GenTop /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal /\ I_PendTop
  /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_ValidLegal /\ I_InSyncLegal

LEMMA ZU_UnstageV7 ==
  ASSUME IndInv, ZU_V7, Unstage, EndRaidS PROVE ZU_V7'
<1>v. /\ I_SnapPend /\ J_ZxIdle /\ J_ZLive /\ J_RelLe /\ I_LegalS2 /\ J_RelHoldS /\ I_FreshS2 /\ J_SeqLe
      /\ J_SoleRel /\ J_GenTop /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_ValidLegal /\ I_InSyncLegal
  BY DEF ZU_V7
<1>0. TypeOK BY IndSplit
<1>ty. \A q \in R : sPres[q] \subseteq Epochs BY <1>0, TypeOKParts, Basics
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, path, mark, reverted, sb, pin>>
      /\ UNCHANGED <<pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, zx>>
      /\ UNCHANGED <<used, mustRev, cfgAt, cutAck>>
  BY DEF Unstage
<1>p. /\ attached /\ pend = {} /\ cutK = 0 /\ attached' = FALSE /\ members' = {}
      /\ UNCHANGED <<dState, tainted, floor, restamp>>
      /\ conf' = [e \in Epochs |-> TRUE] /\ tr' = tr
  BY Full DEF Unstage
<1>e. /\ hold' = FALSE /\ due' = FALSE
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
      /\ UNCHANGED <<badAck, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched,
                     tornMarked, tornServed, tornBare, zpost>>
  BY DEF EndRaidS, sGhost
<1>1. I_SnapPend' /\ I_WHiC' BY <1>v, <1>u DEF I_SnapPend, I_WHiC, AckW
<1>2. J_ZxIdle' /\ J_RelLe' /\ J_SeqLe' /\ J_SoleRel' BY <1>v, <1>u, <1>p, <1>e DEF J_ZxIdle, J_RelLe, J_SeqLe, J_SoleRel
<1>3. J_ZLive' /\ J_GenTop' BY <1>v, <1>u, <1>p DEF J_ZLive, J_GenTop
<1>4. I_LegalS2' /\ I_StandbyLegal' BY <1>v, <1>u, <1>p, <1>e DEF I_LegalS2, LegalV2, PendVal, I_StandbyLegal
<1>5. J_RelHoldS' BY <1>v, <1>u, <1>p, <1>e DEF J_RelHoldS, InSyncR
<1>6. I_HeadLoC' /\ I_HeadLoA' BY <1>v, <1>u, <1>p DEF I_HeadLoC, I_HeadLoA, AckW, CatchingUp, HiOf
<1>7. I_FreshS2'
  <2>. SUFFICES ASSUME NEW q \in InSyncR \cap rmemA, NEW e \in sPres[q], e >= nextSeq \/ ~conf'[e],
                      NEW x \in Blocks
               PROVE  sCon[q][e][x] >= cutAck[q][e][x]
    BY <1>p, <1>u, <1>e DEF I_FreshS2, InSyncR
  <2>1. e \in Epochs BY <1>ty DEF InSyncR
  <2>2. e >= nextSeq BY <2>1, <1>p
  <2>. QED BY <2>2, <1>v DEF I_FreshS2
<1>8. I_HeadHiC' BY <1>v, <1>u, <1>p DEF I_HeadHiC, AckW, CatchingUp, HiOf
<1>9. I_SnapLegal' /\ I_PendTop' /\ I_PendNext' BY <1>v, <1>u DEF I_SnapLegal, PendVal, I_PendTop, I_PendNext
<1>10. J_ZRel' BY <1>v, <1>u, <1>p, <1>e DEF J_ZRel, ZombieReleases, Valid, SolePairs, Majority, InSyncR
<1>11. I_CutLegal' BY <1>u, <1>p DEF I_CutLegal
<1>12. I_ValidLegal' BY <1>v, <1>u, <1>p, <1>e DEF I_ValidLegal, InSyncR, Valid, SolePairs, Majority, PendVal
<1>13. I_InSyncLegal' BY <1>p DEF I_InSyncLegal
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>7, <1>8, <1>9, <1>10, <1>11, <1>12, <1>13 DEF ZU_V7

LEMMA ZU_CrashV7 ==
  ASSUME IndInv, ZU_V7, CrashUnstage, EndRaidS PROVE ZU_V7'
<1>v. /\ I_SnapPend /\ J_ZxIdle /\ J_ZLive /\ J_RelLe /\ I_LegalS2 /\ J_RelHoldS /\ I_FreshS2 /\ J_SeqLe
      /\ J_SoleRel /\ J_GenTop /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_ValidLegal /\ I_InSyncLegal
  BY DEF ZU_V7
<1>0. TypeOK /\ IndT BY IndSplit
<1>ps. I_PendSeen BY <1>0 DEF IndT
<1>ty. \A q \in R : sPres[q] \subseteq Epochs BY <1>0, TypeOKParts, Basics
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin>>
      /\ UNCHANGED <<acked, fails, riskRec, badAdmit, badLoss, restamp, zx>>
      /\ UNCHANGED <<used, tainted, floor, mustRev, cfgAt, tr, cutAck>>
  BY DEF CrashUnstage, tieVars
<1>p. /\ attached /\ attached' = FALSE /\ members' = {} /\ pend' = {}
      /\ cutK' = 0 /\ cutTgt' = {} /\ cutDone' = {} /\ cutGone' = {}
      /\ conf' = [e \in Epochs |-> TRUE]
  BY Full DEF CrashUnstage
<1>e. /\ hold' = FALSE /\ due' = FALSE
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
      /\ UNCHANGED <<badAck, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched,
                     tornMarked, tornServed, tornBare, zpost>>
  BY DEF EndRaidS, sGhost
<1>1. I_SnapPend' /\ I_PendTop' /\ I_PendNext' BY <1>p DEF I_SnapPend, I_PendTop, I_PendNext
<1>2. I_WHiC' BY <1>v, <1>u DEF I_WHiC, AckW
<1>3. J_ZxIdle' /\ J_RelLe' /\ J_SeqLe' /\ J_SoleRel' BY <1>v, <1>u, <1>e DEF J_ZxIdle, J_RelLe, J_SeqLe, J_SoleRel
<1>4. J_ZLive' /\ J_GenTop' BY <1>v, <1>u, <1>p DEF J_ZLive, J_GenTop
<1>5. J_RelHoldS' BY <1>v, <1>u, <1>e DEF J_RelHoldS, InSyncR
<1>6. I_HeadLoC' /\ I_HeadLoA' BY <1>v, <1>u DEF I_HeadLoC, I_HeadLoA, AckW, CatchingUp, HiOf
<1>6b. I_HeadHiC' BY <1>v, <1>u DEF I_HeadHiC, AckW, CatchingUp, HiOf
<1>7. I_FreshS2'
  <2>. SUFFICES ASSUME NEW q \in InSyncR \cap rmemA, NEW e \in sPres[q], e >= nextSeq \/ ~conf'[e],
                      NEW x \in Blocks
               PROVE  sCon[q][e][x] >= cutAck[q][e][x]
    BY <1>p, <1>u, <1>e DEF I_FreshS2, InSyncR
  <2>1. e \in Epochs BY <1>ty DEF InSyncR
  <2>2. e >= nextSeq BY <2>1, <1>p
  <2>. QED BY <2>2, <1>v DEF I_FreshS2
<1>8. I_LegalS2'
  <2>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
               PROVE  /\ head[q][x] \in LegalV2(x)'
                      /\ \A e \in sPres[q] : sCon[q][e][x] \in LegalV2(x)'
    BY <1>u DEF I_LegalS2
  <2>1. ASSUME NEW v \in LegalV2(x), \E q2 \in R : v = head[q2][x] \/ \E e \in sPres[q2] : v = sCon[q2][e][x]
        PROVE  v \in LegalV2(x)'
    <3>1. CASE v \in ackedEver[x] \cup PendVal(x)
      <4>1. v \in ackedEver'[x] BY <3>1, <2>1, <1>0, <1>ps, ZU_CrashLegal
      <4>. QED BY <4>1 DEF LegalV2
    <3>2. CASE v \in zpost BY <3>2, <1>e DEF LegalV2
    <3>. QED BY <3>1, <3>2 DEF LegalV2
  <2>2. head[q][x] \in LegalV2(x)' BY <2>1, <1>v DEF I_LegalS2
  <2>3. \A e \in sPres[q] : sCon[q][e][x] \in LegalV2(x)' BY <2>1, <1>v DEF I_LegalS2
  <2>. QED BY <2>2, <2>3
<1>9. I_StandbyLegal'
  <2>. SUFFICES ASSUME NEW q \in R, dState[q] = "standby", NEW x \in Blocks
               PROVE  head[q][x] \in ackedEver'[x]
    BY <1>u DEF I_StandbyLegal
  <2>1. head[q][x] \in ackedEver[x] \cup PendVal(x) BY <1>v DEF I_StandbyLegal
  <2>. QED BY <2>1, <1>0, <1>ps, ZU_CrashLegal
<1>10. I_SnapLegal'
  <2>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres[q], NEW x \in Blocks
               PROVE  sCon[q][e][x] \in ackedEver'[x]
    BY <1>u DEF I_SnapLegal
  <2>1. sCon[q][e][x] \in ackedEver[x] \cup PendVal(x) BY <1>v DEF I_SnapLegal
  <2>. QED BY <2>1, <1>0, <1>ps, ZU_CrashLegal
<1>11. J_ZRel' BY <1>v, <1>u, <1>e DEF J_ZRel, ZombieReleases, Valid, SolePairs, Majority, InSyncR
<1>12. I_CutLegal' BY <1>p DEF I_CutLegal
<1>13. I_ValidLegal'
  <2>. SUFFICES ASSUME NEW q \in InSyncR, Valid(stamp[q]), NEW x \in Blocks
               PROVE  head[q][x] \in ackedEver'[x]
    BY <1>u, <1>e DEF I_ValidLegal, InSyncR, Valid, SolePairs, Majority
  <2>0. q \in R BY DEF InSyncR
  <2>1. head[q][x] \in ackedEver[x] \cup PendVal(x) BY <1>v DEF I_ValidLegal
  <2>. QED BY <2>0, <2>1, <1>0, <1>ps, ZU_CrashLegal
<1>14. I_InSyncLegal' BY <1>p DEF I_InSyncLegal
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>6b, <1>7, <1>8, <1>9, <1>10, <1>11, <1>12, <1>13, <1>14 DEF ZU_V7

LEMMA ZU_StageV7 ==
  ASSUME IndInv, ZU_V7, Stage PROVE ZU_V7'
<1>v. /\ I_SnapPend /\ J_ZxIdle /\ J_ZLive /\ J_RelLe /\ I_LegalS2 /\ J_RelHoldS /\ I_FreshS2 /\ J_SeqLe
      /\ J_SoleRel /\ J_GenTop /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_ValidLegal /\ I_InSyncLegal
  BY DEF ZU_V7
<1>0. TypeOK /\ IndT BY IndSplit
<1>t. I_RangesS /\ I_Session BY <1>0 DEF IndT
<1>. DEFINE M == AsmSet
<1>g. ~attached /\ CanStampStage /\ Attachable # {} BY Full DEF Stage
<1>K. /\ M # {} /\ M \subseteq rmemA \cap InSyncR /\ M \subseteq Attachable
      /\ \A q \in M : \A x \in Blocks : head[q][x] >= acked[x]
  BY <1>g, <1>v, S_StageRead
<1>R. M \subseteq R /\ InSyncR \subseteq R BY <1>K DEF InSyncR
<1>z. zx \notin M BY <1>K, Full DEF Attachable
<1>r. pend = {} /\ cutK = 0 /\ \A e \in Epochs : conf[e] BY <1>t, <1>g DEF I_RangesS
<1>mk. AsmMarks(M) = InSyncR \ M
  <2>1. AsmExcl(M) = InSyncR \ M BY Full DEF AsmExcl
  <2>2. Attachable \ M \subseteq InSyncR \ M BY Full DEF Attachable
  <2>3. DecreeSet \subseteq InSyncR \ M BY <1>z DEF DecreeSet
  <2>. QED BY <2>1, <2>2, <2>3, Full DEF AsmMarks
<1>p. /\ attached' = TRUE /\ members' = M
      /\ dState' = [q \in R |-> IF q \in InSyncR \ M THEN "stale" ELSE dState[q]]
  BY <1>mk, Full DEF Stage, StaleMarks
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, mark, reverted, sb, pin>>
      /\ UNCHANGED <<pend, acked, fails, riskRec, badAdmit, badLoss, ackedEver, zx>>
      /\ UNCHANGED <<used, mustRev, cfgAt, conf, tr, cutAck>>
  BY DEF Stage
<1>n. /\ nseq' = nseq + 1 /\ aseq' = nseq + 1 /\ agen' = 0 /\ asize' = Cardinality(M)
      /\ stamp' = [q \in R |-> IF q \in M THEN [seq |-> nseq + 1, gen |-> 0, size |-> Cardinality(M), mem |-> M,
                                                 rgen |-> 0, rmem |-> M]
                                           ELSE stamp[q]]
      /\ rgenA' = 0 /\ rmemA' = M /\ hold' = FALSE /\ due' = FALSE
      /\ UNCHANGED <<sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst, badAck, zAcked, zLeg, zjv>>
      /\ UNCHANGED <<riskTail, zpost>>
  BY Full DEF Stage, NewAsm, StageGhosts
<1>c. Cardinality(M) \in Nat /\ Cardinality(M) >= 1
  <2>1. IsFiniteSet(M) BY <1>R, RNat, FS_Subset
  <2>2. Cardinality(M) \in Nat BY <2>1, FS_CardinalityType
  <2>3. Cardinality(M) # 0 BY <2>1, <1>K, FS_EmptySet
  <2>. QED BY <2>2, <2>3
<1>i. InSyncR' = M BY <1>p, <1>R, <1>K DEF InSyncR
<1>st. \A q \in M : stamp'[q] = [seq |-> nseq + 1, gen |-> 0, size |-> Cardinality(M), mem |-> M,
                                 rgen |-> 0, rmem |-> M]
  BY <1>n, <1>R
<1>N. /\ nseq \in Nat /\ zseq \in Nat /\ \A q \in R : stamp[q].seq \in Nat
      /\ \A c \in sole : c[1] \in Nat
  BY <1>0, Const DEF TypeOK, StampRec
<1>q. \A q \in InSyncR : reverted[q] = -1 BY <1>t DEF I_Session, SessionOK, InSyncR
<1>cu. \A q \in R : /\ CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q)
  BY <1>p, <1>u, <1>q DEF CatchingUp, HiOf, InSyncR
<1>1. I_SnapPend' /\ I_PendTop' /\ I_PendNext' BY <1>r, <1>u DEF I_SnapPend, I_PendTop, I_PendNext
<1>2. I_WHiC' BY <1>v, <1>u DEF I_WHiC, AckW
<1>3. J_ZxIdle'
  <2>. SUFFICES ASSUME zx # 0 PROVE (dState[zx] # "standby" /\ sb[zx] = -1 /\ reverted[zx] = -1 /\ stamp[zx].seq = zseq)'
    BY <1>u DEF J_ZxIdle
  <2>1. zx \in R BY <1>0 DEF TypeOK
  <2>2. dState[zx] # "standby" /\ sb[zx] = -1 /\ reverted[zx] = -1 /\ stamp[zx].seq = zseq BY <1>v DEF J_ZxIdle
  <2>3. stamp'[zx] = stamp[zx] BY <2>1, <1>z, <1>n
  <2>4. dState'[zx] # "standby" BY <2>1, <2>2, <1>p
  <2>. QED BY <2>2, <2>3, <2>4, <1>u, <1>n
<1>4. J_ZLive'
  <2>. SUFFICES ASSUME zx # 0, dState'[zx] = "insync" PROVE FALSE BY <1>u DEF J_ZLive
  <2>1. zx \in R BY <1>0 DEF TypeOK
  <2>2. zx \in InSyncR' BY <2>1, <1>u DEF InSyncR
  <2>. QED BY <2>2, <1>i, <1>z, <1>u
<1>5. J_RelLe' BY <1>n DEF J_RelLe
<1>6. I_LegalS2' BY <1>v, <1>u, <1>n DEF I_LegalS2, LegalV2, PendVal
<1>7. J_RelHoldS' BY <1>K, <1>i, <1>n, <1>u DEF J_RelHoldS
<1>8. I_FreshS2' BY <1>v, <1>K, <1>i, <1>n, <1>u DEF I_FreshS2
<1>9. J_SeqLe'
  <2>1. \A q \in R : stamp'[q].seq <= nseq'
    <3>. SUFFICES ASSUME NEW q \in R PROVE stamp'[q].seq <= nseq' OBVIOUS
    <3>1. CASE q \in M BY <3>1, <1>st, <1>n, <1>N
    <3>2. CASE q \notin M
      <4>1. stamp'[q] = stamp[q] BY <3>2, <1>n
      <4>2. stamp[q].seq <= nseq BY <1>v DEF J_SeqLe
      <4>. QED BY <4>1, <4>2, <1>n, <1>N
    <3>. QED BY <3>1, <3>2
  <2>2. \A c \in sole' : c[1] <= nseq' BY <1>v, <1>n, <1>N DEF J_SeqLe
  <2>3. zseq' <= nseq' BY <1>v, <1>n, <1>N DEF J_SeqLe
  <2>. QED BY <2>1, <2>2, <2>3 DEF J_SeqLe
<1>10. J_SoleRel'
  <2>. SUFFICES ASSUME NEW c \in sole' PROVE c[1] <= nseq' /\ c[1] # nseq' BY DEF J_SoleRel
  <2>1. c \in sole /\ c[1] <= nseq BY <1>v, <1>n DEF J_SoleRel
  <2>. QED BY <2>1, <1>n, <1>N
<1>11. J_GenTop'
  <2>1. \A q \in M : 2 * Cardinality(stamp'[q].mem) > stamp'[q].size /\ stamp'[q].gen = 0 BY <1>st, <1>c
  <2>. QED BY <2>1, <1>i, <1>n, <1>p DEF J_GenTop, View, Valid, Majority
<1>12. I_HeadLoC' /\ I_HeadLoA' BY <1>v, <1>cu, <1>u DEF I_HeadLoC, I_HeadLoA, AckW
<1>12b. I_HeadHiC' BY <1>v, <1>cu, <1>u DEF I_HeadHiC, AckW
<1>13. I_StandbyLegal'
  <2>. SUFFICES ASSUME NEW q \in R, dState'[q] = "standby", NEW x \in Blocks
               PROVE  head[q][x] \in ackedEver[x] \cup PendVal(x)
    BY <1>u DEF I_StandbyLegal, PendVal
  <2>1. dState[q] = "standby" BY <1>p DEF InSyncR
  <2>. QED BY <2>1, <1>v DEF I_StandbyLegal
<1>14. I_SnapLegal' BY <1>v, <1>u DEF I_SnapLegal, PendVal
\* a zombie that may acknowledge would be the only in_sync leg, and it is never attachable
<1>15. J_ZRel'
  <2>1. ~ZombieReleases
    <3>. SUFFICES ASSUME ZombieReleases PROVE FALSE OBVIOUS
    <3>1. InSyncR = {zx} BY <1>v DEF J_ZRel
    <3>. QED BY <3>1, <1>g, Full DEF Attachable
  <2>2. ZombieReleases' = ZombieReleases BY <1>u, <1>n DEF ZombieReleases, Valid, SolePairs, Majority
  <2>. QED BY <2>1, <2>2 DEF J_ZRel
<1>16. I_CutLegal' BY <1>r, <1>u DEF I_CutLegal
\* the members are the clean members of the newest valid stamp: each one's own stamp is valid (I_ValidLegal)
<1>cm. \A q \in M : Valid(stamp[q]) /\ q \in InSyncR
  <2>1. M = CleanMem BY <1>g, Full DEF AsmSet, CanStampStage
  <2>. QED BY <2>1, <1>K DEF CleanMem, TornAtt, StampMem
<1>17. I_ValidLegal' /\ I_InSyncLegal'
  <2>1. \A q \in M : \A x \in Blocks : head[q][x] \in ackedEver[x] \cup PendVal(x) BY <1>cm, <1>v DEF I_ValidLegal
  <2>. QED BY <2>1, <1>i, <1>u DEF I_ValidLegal, I_InSyncLegal, PendVal
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>7, <1>8, <1>9, <1>10, <1>11, <1>12, <1>12b, <1>13, <1>14, <1>15,
            <1>16, <1>17 DEF ZU_V7

\* --- the final form: IndAll == IndInv /\ IndNew (41-ind-new) ------------------------------------------
\* inv-zombie's four conjuncts across the raid's end: frames (the crash's cutK' = 0)
LEMMA ZU_EndRaidZ4 ==
  ASSUME IndInv, IndNew, (Unstage \/ CrashUnstage) /\ EndRaidS
  PROVE  J_ZNoValid' /\ J_ZM0' /\ J_SoleGen' /\ J_ZCut'
<1>n. J_ZNoValid /\ J_ZM0 /\ J_SoleGen /\ J_ZCut BY IndNewSplit
<1>e. /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
  BY DEF EndRaidS
<1>1. CASE Unstage
  <2>1. UNCHANGED <<zx, dState, cutK, cutTgt>> BY <1>1, Full DEF Unstage
  <2>. QED BY <1>n, <1>e, <2>1, F_ZNoValid, F_ZM0, F_SoleGen, F_ZCut
<1>2. CASE CrashUnstage
  <2>1. UNCHANGED <<zx, dState>> /\ cutK' = 0 BY <1>2 DEF CrashUnstage
  <2>2. J_ZCut' BY <2>1 DEF J_ZCut
  <2>. QED BY <1>n, <1>e, <2>1, <2>2, F_ZNoValid, F_ZM0, F_SoleGen
<1>. QED BY <1>1, <1>2

LEMMA I_EndRaidAll ==
  ASSUME IndInv, IndNew, (Unstage \/ CrashUnstage) /\ EndRaidS PROVE IndInv' /\ IndNew'
<1>v. ZU_V7 BY IndNewSplit DEF ZU_V7
<1>h. J_RelHoldS /\ I_FreshS2 BY IndNewSplit
<1>1. IndInv' BY <1>h, I_EndRaid
<1>2. ZU_V7'
  <2>1. CASE Unstage BY <2>1, <1>v, ZU_UnstageV7
  <2>2. CASE CrashUnstage BY <2>2, <1>v, ZU_CrashV7
  <2>. QED BY <2>1, <2>2
<1>3. J_ZNoValid' /\ J_ZM0' /\ J_SoleGen' /\ J_ZCut' BY ZU_EndRaidZ4
<1>. QED BY <1>1, <1>2, <1>3, IndNewSplitP DEF ZU_V7

\* the four across the stage: the new stamps miss zx (Attachable), NewAsm leaves zst, zm0, zsize alone,
\* nseq' = nseq + 1 has no confirmation (J_SeqLe), no cut is in flight
LEMMA ZU_StageZ4 ==
  ASSUME IndInv, IndNew, Stage
  PROVE  J_ZNoValid' /\ J_ZM0' /\ J_SoleGen' /\ J_ZCut'
<1>n. J_ZNoValid /\ J_ZM0 /\ J_SoleGen /\ J_ZCut /\ J_SoleRel /\ J_SeqLe BY IndNewSplit
<1>0. TypeOK /\ IndT BY IndSplit
<1>. DEFINE M == AsmSet
<1>g. ~attached /\ CanStampStage BY Full DEF Stage
<1>K. M \subseteq rmemA \cap InSyncR /\ M \subseteq Attachable BY <1>g, <1>n, S_StageRead
<1>R. M \subseteq R BY <1>K DEF InSyncR
<1>z. zx \notin M BY <1>K, Full DEF Attachable
<1>r. cutK = 0 BY <1>0, <1>g DEF IndT, I_RangesS
<1>mk. AsmMarks(M) = InSyncR \ M
  <2>1. AsmExcl(M) = InSyncR \ M BY Full DEF AsmExcl
  <2>2. Attachable \ M \subseteq InSyncR \ M BY Full DEF Attachable
  <2>3. DecreeSet \subseteq InSyncR \ M BY <1>z DEF DecreeSet
  <2>. QED BY <2>1, <2>2, <2>3, Full DEF AsmMarks
<1>p. dState' = [q \in R |-> IF q \in InSyncR \ M THEN "stale" ELSE dState[q]]
  BY <1>mk, Full DEF Stage, StaleMarks
<1>u. UNCHANGED <<zx, cutK, cutTgt>> BY DEF Stage
<1>e. /\ nseq' = nseq + 1 /\ agen' = 0
      /\ UNCHANGED <<sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
  BY Full DEF Stage, NewAsm
<1>N. nseq \in Nat BY <1>0 DEF TypeOK
<1>1. J_ZNoValid'
  <2>. SUFFICES ASSUME zx # 0, dState'[zx] = "insync" PROVE FALSE BY <1>u DEF J_ZNoValid
  <2>1. zx \in R BY <1>0 DEF TypeOK
  <2>2. zx \notin InSyncR \ M BY <2>1, <1>p
  <2>3. dState[zx] = "insync" BY <2>1, <2>2, <1>p
  <2>. QED BY <2>1, <2>2, <2>3, <1>z DEF InSyncR
<1>2. J_ZM0' BY <1>n, <1>u, <1>e, F_ZM0
<1>3. J_SoleGen'
  <2>1. \A c \in sole : c[1] <= nseq BY <1>n DEF J_SeqLe
  <2>. QED BY <2>1, <1>e, <1>N DEF J_SoleGen
<1>4. J_ZCut' BY <1>r, <1>u DEF J_ZCut
<1>. QED BY <1>1, <1>2, <1>3, <1>4

LEMMA I_StageAll ==
  ASSUME IndInv, IndNew, Stage PROVE IndInv' /\ IndNew'
<1>v. ZU_V7 BY IndNewSplit DEF ZU_V7
<1>h. J_SoleRel /\ J_SeqLe BY IndNewSplit
<1>1. IndInv' BY <1>h, I_Stage
<1>2. ZU_V7' BY <1>v, ZU_StageV7
<1>3. J_ZNoValid' /\ J_ZM0' /\ J_SoleGen' /\ J_ZCut' BY ZU_StageZ4
<1>. QED BY <1>1, <1>2, <1>3, IndNewSplitP DEF ZU_V7

-----------------------------------------------------------------------------
(* (S) The invariant layer, the stage admission (57-inv-admit): StageAdmit  *)
(* with the assembly's stamp, and the tie's refusal (never under Full).     *)
(* StageAdmit is FlintCatchupTProof's I_StageAdmit with the stamp's         *)
(* assembly: the stage's read (S_StageRead, 45-stage-read) puts AsmSet in   *)
(* the released in_sync legs, which hold every acked write (T: I_Hold, the  *)
(* detached half); the standby's untouched blocks hold the acked map by     *)
(* I_HeadLoA (T: I_HeadLo); the new stamp makes the J layer the gen-0 one.  *)

\* The final invariant is IndAll == IndInv /\ IndNew (41-ind-new).  The conjuncts of IndNew this part needed and
\* proposed (each was a NEEDS-INV, now in IndNew): J_ZxIdle (zx is not the standby), I_HeadLoA (the standby's untouched
\* blocks hold the acked map), I_StandbyLegal (its values are legal: badLoss), I_ValidLegal (the assembly's heads are
\* legal: the cut k, I_InSyncLegal'); it also uses J_SeqLe (no stamp or confirmation at the new seq) and J_SoleRel
\* (S_StageRead, 45-stage-read).

\* the invariant, conjunct by conjunct, and back
LEMMA ZK_Open ==
  ASSUME IndInv
  PROVE  /\ TypeOK /\ TypeOKT /\ TyStampS
         /\ J_DueHold /\ J_HoldAtt /\ J_Rel /\ J_Cur /\ J_ZxOut /\ J_Aseq /\ J_SeqSync /\ J_MemRel /\ J_RelHold
         /\ J_NoAckBad /\ J_M0 /\ J_RelValid /\ J_MinorRel /\ J_RelInSync /\ J_ViewIn /\ J_ViewOut /\ J_SoleSeq
         /\ J_GenBound /\ J_ZGen
         /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
         /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
         /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
BY IndSplit, TypeOKParts DEF IndJ, IndT, IndS

LEMMA ZK_Close ==
  ASSUME TypeOK',
         J_DueHold', J_HoldAtt', J_Rel', J_Cur', J_ZxOut', J_Aseq', J_SeqSync', J_MemRel', J_RelHold',
         J_NoAckBad', J_M0', J_RelValid', J_MinorRel', J_RelInSync', J_ViewIn', J_ViewOut', J_SoleSeq',
         J_GenBound', J_ZGen',
         I_RangesS', I_Lineage', I_Chain', I_Pend', I_MembersS', I_HoldAtt', I_PendSeen', I_Vers',
         I_Reverted', I_HeadPend', I_Session', Inv_TrustComplete', I_NoBadLoss', Inv_AckedHeld',
         I_AckedEverS', I_LegalS', I_WHiS', I_AckMono', I_HeadLoS', I_FreshS'
  PROVE  IndInv'
BY IndSplitP DEF IndJ, IndT, IndS

\* FlintCatchupTProof's LinSub and LegExtend on I_RangesS (they read only hPar's range there)
LEMMA ZK_LinSub ==
  ASSUME I_Lineage, I_RangesS, TypeOKT, NEW s \in R PROVE Lin(s) \subseteq sPres[s]
<1>1. CASE hPar[s] = 0 BY <1>1 DEF Lin, AncOf
<1>2. CASE hPar[s] # 0
  <2>1. hPar[s] \in sPres[s] BY <1>2 DEF I_RangesS
  <2>2. ChainShape(sPres[s], sPar[s], anc[s]) BY DEF I_Lineage
  <2>. QED BY <1>2, <2>1, <2>2, AncBound DEF Lin, AncOf
<1>. QED BY <1>1, <1>2

LEMMA ZK_LegExtend ==
  ASSUME I_Lineage, I_Chain, I_RangesS, TypeOKT, NEW q \in R, NEW k \in Epochs,
         k \notin sPres[q], hPar[q] < k,
         sPres'[q] = sPres[q] \cup {k}, sPar'[q][k] = hPar[q],
         anc'[q][k] = {k} \cup (IF hPar[q] = 0 THEN {} ELSE anc[q][hPar[q]]),
         \A e \in sPres[q] : /\ sPar'[q][e] = sPar[q][e] /\ anc'[q][e] = anc[q][e]
                            /\ sAl'[q][e] = sAl[q][e] /\ sCon'[q][e] = sCon[q][e],
         \A x \in Blocks : x \notin sAl'[q][k] => sCon'[q][k][x] = Up(sPar[q], sCon[q], hPar[q], x)
  PROVE  ChainShape(sPres'[q], sPar'[q], anc'[q]) /\ ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q])
<1>1. ChainShape(sPres[q], sPar[q], anc[q]) /\ ChainReads(sPres[q], sPar[q], sAl[q], sCon[q])
  BY DEF I_Lineage, I_Chain
<1>2. hPar[q] \in sPres[q] \cup {0} /\ hPar[q] \in 0..MaxEpoch BY DEF I_RangesS, TypeOKT, TyHead
<1>3. \A e \in sPres[q] : /\ sPar[q][e] \in 0..MaxEpoch /\ sPar[q][e] < e
                         /\ (sPar[q][e] # 0 => sPar[q][e] \in sPres[q] /\ sPar[q][e] # k)
                         /\ anc[q][e] = {e} \cup (IF sPar[q][e] = 0 THEN {} ELSE anc[q][sPar[q][e]])
  BY <1>1 DEF ChainShape
<1>4. sPres[q] \subseteq Epochs BY DEF TypeOKT, TySnap
<1>5. ChainShape(sPres'[q], sPar'[q], anc'[q])
  <2>1. sPres'[q] \subseteq Epochs BY <1>4
  <2>2. ASSUME NEW e \in sPres'[q]
        PROVE  /\ sPar'[q][e] \in 0..MaxEpoch /\ sPar'[q][e] < e
               /\ (sPar'[q][e] # 0 => sPar'[q][e] \in sPres'[q])
               /\ anc'[q][e] = {e} \cup (IF sPar'[q][e] = 0 THEN {} ELSE anc'[q][sPar'[q][e]])
    <3>1. CASE e = k
      <4>1. hPar[q] # 0 => anc'[q][hPar[q]] = anc[q][hPar[q]] BY <1>2
      <4>. QED BY <3>1, <1>2, <4>1
    <3>2. CASE e # k
      <4>1. e \in sPres[q] BY <3>2
      <4>2. sPar[q][e] # 0 => anc'[q][sPar[q][e]] = anc[q][sPar[q][e]] BY <4>1, <1>3
      <4>. QED BY <4>1, <4>2, <1>3
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2 DEF ChainShape
<1>6. ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q])
  <2>. SUFFICES ASSUME NEW e \in sPres'[q], NEW x \in Blocks, x \notin sAl'[q][e]
               PROVE  sCon'[q][e][x] = Up(sPar'[q], sCon'[q], sPar'[q][e], x)
    BY DEF ChainReads
  <2>1. CASE e = k
    <3>1. hPar[q] # 0 => sCon'[q][hPar[q]] = sCon[q][hPar[q]] BY <1>2
    <3>. QED BY <2>1, <3>1 DEF Up
  <2>2. CASE e # k
    <3>1. e \in sPres[q] /\ x \notin sAl[q][e] BY <2>2
    <3>2. sCon[q][e][x] = Up(sPar[q], sCon[q], sPar[q][e], x) BY <3>1, <1>1 DEF ChainReads
    <3>3. sPar[q][e] # 0 => sCon'[q][sPar[q][e]] = sCon[q][sPar[q][e]] BY <3>1, <1>3
    <3>. QED BY <3>1, <3>2, <3>3 DEF Up
  <2>. QED BY <2>1, <2>2
<1>. QED BY <1>5, <1>6

\* FlintCatchupTProof's AdmHold on S: the admitted head holds every acked write its source holds (the source, a
\* member of the assembly, holds them all: S_StageRead); a block the source's lineage leaves untouched from the mark
\* on is the standby's own, which I_HeadLoA bounds (T: I_HeadLo); every value is the source's head or the standby's
LEMMA ZK_AdmHold ==
  ASSUME IndInv, I_HeadLoA, NEW r \in R, NEW s \in R, AdmGuard(r, s),
         \A y \in Blocks : head[s][y] >= acked[y], NEW x \in Blocks
  PROVE  /\ AdmHead(r, s)[x] >= acked[x]
         /\ AdmHead(r, s)[x] = head[s][x] \/ AdmHead(r, s)[x] = head[r][x]
<1>0. /\ TypeOK /\ TypeOKT /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Session BY ZK_Open
<1>g. /\ ~attached /\ dState[r] = "standby" /\ s \in AdmT /\ LinCovers(s, mark[r])
      /\ AdmK \notin sPres[s] /\ AdmK = nextSeq /\ nextSeq <= MaxEpoch
  BY DEF AdmGuard, AdmK
<1>hs. head[s][x] >= acked[x] /\ head[s][x] \in Nat /\ acked[x] \in Nat /\ head[r][x] \in Nat
  BY <1>0, Nats
<1>m. mark[r] >= 1 /\ HiOf(r) = mark[r] /\ CatchingUp(r) /\ mark[r] < nextSeq
  BY <1>0, <1>g DEF I_Session, SessionOK, HiOf, CatchingUp
<1>mn. mark[r] \in 0..MaxEpoch /\ nextSeq \in 1..(MaxEpoch + 1) /\ MaxEpoch \in Nat
  BY <1>0, Const, Groups DEF TyLeg, TyScalar
<1>l. mark[r] \in Lin(s) BY <1>g, <1>m, <1>mn DEF LinCovers
<1>h. hPar[s] # 0 /\ hPar[s] \in sPres[s] /\ Lin(s) = anc[s][hPar[s]]
  BY <1>l, <1>0 DEF Lin, AncOf, I_RangesS
<1>c. ChainShape(sPres[s], sPar[s], anc[s]) /\ ChainReads(sPres[s], sPar[s], sAl[s], sCon[s])
  BY <1>0, LegChain
<1>sp. /\ sPres[s] \subseteq 1..(nextSeq - 1) /\ Lin(s) \subseteq sPres[s]
       /\ AdmK \in Epochs /\ Lin(s) \subseteq Nat
  <2>1. sPres[s] \subseteq 1..nextSeq BY <1>0 DEF I_RangesS
  <2>2. Lin(s) \subseteq sPres[s] BY <1>0, ZK_LinSub
  <2>3. AdmK \in Epochs BY <1>mn, <1>g DEF Epochs
  <2>. QED BY <2>1, <2>2, <2>3, <1>g, <1>mn DEF Epochs
<1>. DEFINE Hs == {e \in Lin(s) : mark[r] <= e /\ x \in sAl[s][e]}
<1>1. CASE x \in hAl[s]
  <2>0. mark[r] < nextSeq /\ mark[r] \in Nat /\ nextSeq \in Nat BY <1>m, <1>mn
  <2>1. AdmK \in AdmHits(r, s, x) BY <2>0, <1>1, <1>g DEF AdmHits, AdmElems, AdmAl
  <2>2. AdmHits(r, s, x) \subseteq 0..MaxEpoch /\ \A e \in AdmHits(r, s, x) : e <= AdmK
    <3>1. AdmElems(r, s) \subseteq Lin(s) \cup {AdmK} BY DEF AdmElems
    <3>2. Lin(s) \cup {AdmK} \subseteq Epochs BY <1>sp, <1>mn DEF Epochs
    <3>. QED BY <3>1, <3>2 DEF AdmHits, AdmElems, Epochs
  <2>3. Max(AdmHits(r, s, x)) = AdmK
    <3>1. Max(AdmHits(r, s, x)) \in AdmHits(r, s, x) /\ \A u \in AdmHits(r, s, x) : u <= Max(AdmHits(r, s, x))
      BY <2>1, <2>2, MaxProp, Const
    <3>. QED BY <3>1, <2>1, <2>2, <1>g, <1>0, Groups DEF TyScalar
  <2>4. AdmHead(r, s)[x] = head[s][x] BY <2>1, <2>3 DEF AdmHead, AdmCon
  <2>. QED BY <2>4, <1>hs
<1>2. CASE x \notin hAl[s]
  <2>0. head[s][x] = sCon[s][hPar[s]][x] BY <1>2, <1>h, <1>0 DEF I_Chain, Up
  <2>1. AdmHits(r, s, x) = Hs
    <3>1. \A e \in Lin(s) : e < AdmK /\ e # AdmK /\ e \in Nat BY <1>sp, <1>g, <1>mn
    <3>2. AdmK \notin {e \in Lin(s) \cup {AdmK} : mark[r] <= e /\ e <= AdmK /\ x \in AdmAl(s, e)} BY <1>2 DEF AdmAl
    <3>. QED BY <3>1, <3>2 DEF AdmHits, AdmElems, AdmAl
  <2>2. /\ Hs = {} => sCon[s][hPar[s]][x] = Up(sPar[s], sCon[s], sPar[s][mark[r]], x)
        /\ Hs # {} => Max(Hs) \in Hs /\ sCon[s][hPar[s]][x] = sCon[s][Max(Hs)][x]
    <3>1. mark[r] \in anc[s][hPar[s]] BY <1>l, <1>h
    <3>2. RT(anc[s], sAl[s], hPar[s], mark[r], x) = Hs BY <1>h DEF RT
    <3>3. /\ RT(anc[s], sAl[s], hPar[s], mark[r], x) = {} =>
              sCon[s][hPar[s]][x] = Up(sPar[s], sCon[s], sPar[s][mark[r]], x)
          /\ RT(anc[s], sAl[s], hPar[s], mark[r], x) # {} =>
              /\ Max(RT(anc[s], sAl[s], hPar[s], mark[r], x)) \in RT(anc[s], sAl[s], hPar[s], mark[r], x)
              /\ sCon[s][hPar[s]][x] = sCon[s][Max(RT(anc[s], sAl[s], hPar[s], mark[r], x))][x]
      <4>1. hPar[s] \in sPres[s] /\ mark[r] \in anc[s][hPar[s]] BY <1>h, <3>1
      <4>. QED BY <1>c, <4>1, ReadAt
    <3>. QED BY <3>2, <3>3
  <2>3. CASE Hs # {}
    <3>1. Max(Hs) # AdmK /\ Max(Hs) \in sPres[s] BY <2>2, <2>3, <1>sp, <1>g
    <3>2. AdmHead(r, s)[x] = sCon[s][Max(Hs)][x] BY <2>1, <2>3, <3>1 DEF AdmHead, AdmCon
    <3>. QED BY <3>1, <3>2, <2>0, <2>2, <2>3, <1>hs
  <2>4. CASE Hs = {}
    <3>1. AdmHead(r, s)[x] = head[r][x] BY <2>1, <2>4 DEF AdmHead
    <3>2. acked[x] <= head[r][x]
      <4>1. mark[r] \in sPres[s] /\ sPar[s][mark[r]] < mark[r]
            /\ (sPar[s][mark[r]] # 0 => sPar[s][mark[r]] \in sPres[s])
        BY <1>l, <1>sp, <1>c DEF ChainShape
      <4>2. CASE sPar[s][mark[r]] = 0 BY <4>2, <2>0, <2>2, <2>4, <1>hs DEF Up
      <4>3. CASE sPar[s][mark[r]] # 0
        <5>1. acked[x] <= sCon[s][sPar[s][mark[r]]][x] BY <4>3, <2>0, <2>2, <2>4, <1>hs DEF Up
        <5>2. sPar[s][mark[r]] \in sPres[s] /\ sPar[s][mark[r]] < HiOf(r) BY <4>1, <4>3, <1>m
        <5>. QED BY <5>1, <5>2, <1>m DEF I_HeadLoA
      <4>. QED BY <4>2, <4>3
    <3>. QED BY <3>1, <3>2, <1>hs
  <2>. QED BY <2>3, <2>4
<1>. QED BY <1>1, <1>2

-----------------------------------------------------------------------------
\* The tie's refusal: Policy = "tie", so it never steps under Full.
LEMMA I_AdmitRefuseAll ==
  ASSUME IndInv, IndNew, NEW r \in R, AdmitRefuse(r) /\ NoStamp PROVE IndInv' /\ IndNew'
<1>1. Policy = "tie" BY DEF AdmitRefuse
<1>. QED BY <1>1, Full

-----------------------------------------------------------------------------
\* The stage admission: the assembly AsmSet (the stamp's read) and the standby r, the strict final cut k on both, r's
\* final delta from source s, a new stamp (seq nseq + 1, gen 0) on every member.
LEMMA I_StageAdmitAll ==
  ASSUME IndInv, IndNew, NEW r \in R,
         StageAdmit(r) /\ NewAsm(members') /\ (IF Stamp THEN StageGhosts ELSE TRUE)
  PROVE  IndInv' /\ IndNew'
<1>0. /\ TypeOK /\ TypeOKT /\ TyStampS
      /\ J_DueHold /\ J_HoldAtt /\ J_Rel /\ J_Cur /\ J_ZxOut /\ J_Aseq /\ J_SeqSync /\ J_MemRel /\ J_RelHold
      /\ J_NoAckBad /\ J_M0 /\ J_RelValid /\ J_MinorRel /\ J_RelInSync /\ J_ViewIn /\ J_ViewOut /\ J_SoleSeq
      /\ J_GenBound /\ J_ZGen
      /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY ZK_Open
<1>v. /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
      /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal
      /\ I_HeadHiC /\ I_SnapLegal /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal
      /\ J_ZNoValid /\ J_ZM0 /\ J_SoleGen /\ J_ZCut
  BY IndNewSplit
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R /\ Healthy \subseteq R /\ Bases \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>0, Basics
<1>N. /\ \A x \in Blocks : acked[x] \in Nat /\ ackedEver[x] \subseteq Nat
      /\ \A q \in R : \A x \in Blocks : head[q][x] \in Nat
      /\ \A q \in R : \A e \in Epochs : \A x \in Blocks : sCon[q][e][x] \in Nat /\ cutAck[q][e][x] \in Nat
  BY <1>0, Nats
<1>s. PICK s \in R : AdmGuard(r, s) /\ AdmSnap(r, s) /\ AdmRest(r, s) BY StageAdmitFacts
<1>. DEFINE T == AdmT
<1>. DEFINE k == AdmK
<1>. DEFINE dH == AdmHead(r, s)
<1>. DEFINE U == T \cup {r}
<1>. DEFINE Mk == AdmM
<1>. DEFINE St == [seq |-> nseq + 1, gen |-> 0, size |-> Cardinality(U), mem |-> U, rgen |-> 0, rmem |-> U]
<1>g. /\ ~attached /\ cutK = 0 /\ dState[r] = "standby" /\ path[r] = "back"
      /\ nextSeq <= MaxEpoch /\ T # {} /\ \A q \in T : k \notin sPres[q] /\ k \notin sPres[r]
      /\ s \in T /\ k = nextSeq /\ mark[r] \in tr[r] /\ recorded # {}
  BY <1>s DEF AdmGuard, AdmK
<1>cs. CanStampStage BY Full DEF StageAdmit
\* the stage's read: the assembly is released in_sync legs, holding every acked write
<1>rd. /\ T \subseteq rmemA \cap InSyncR /\ T \subseteq Attachable
       /\ \A q \in T : \A x \in Blocks : head[q][x] >= acked[x]
  <2>1. /\ AsmSet \subseteq rmemA \cap InSyncR
        /\ \A q \in AsmSet : \A x \in Blocks : head[q][x] >= acked[x]
    BY <1>g, <1>cs, <1>v, S_StageRead
  <2>. QED BY <2>1, AsmSetSub DEF AdmT
<1>r. pend = {} /\ members = {} /\ \A e \in Epochs : conf[e] BY <1>0, <1>g DEF I_RangesS
<1>t. /\ T \subseteq InSyncR /\ r \notin T /\ T \subseteq R /\ U \subseteq R /\ r \in U
      /\ \A q \in T : dState[q] = "insync"
      /\ zx \notin U
  <2>1. T \subseteq InSyncR /\ T \subseteq Attachable BY <1>rd
  <2>2. r \notin T BY <2>1, <1>g DEF InSyncR
  <2>3. zx \notin T BY <2>1, Full DEF Attachable
  <2>4. zx # r
    <3>1. zx = r => zx # 0 BY RNat
    <3>. QED BY <3>1, <1>g, <1>v DEF J_ZxIdle
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <1>T DEF InSyncR
\* the assembly's write: the in_sync legs it lacks go stale (AsmExcl), the attachable ones too, the decree's z
<1>M. Mk \subseteq InSyncR \ T /\ InSyncR \ T \subseteq Mk /\ r \notin Mk
  <2>1. Mk = (InSyncR \ T) \cup (Attachable \ T) \cup DecreeSet BY Full DEF AdmM, AsmMarks, AsmExcl, AdmT
  <2>2. Attachable \subseteq InSyncR BY Full DEF Attachable
  <2>3. DecreeSet \subseteq InSyncR \ T BY <1>t, Full DEF DecreeSet
  <2>. QED BY <2>1, <2>2, <2>3, <1>g DEF InSyncR
<1>k. k \in Epochs /\ k \in Nat /\ nextSeq \in Nat BY <1>g, <1>0, <1>T, Const, Groups DEF TyScalar, Epochs
<1>kU. \A q \in U : k \notin sPres[q] BY <1>g
<1>sp. \A q \in R : sPres[q] \subseteq 1..nextSeq /\ sPres[q] \subseteq Epochs
  BY <1>0, <1>T, Groups DEF I_RangesS, TySnap
<1>hp. \A q \in U : hPar[q] \in 0..(k - 1) /\ (hPar[q] # 0 => hPar[q] \in sPres[q])
  <2>. SUFFICES ASSUME NEW q \in U PROVE hPar[q] \in 0..(k - 1) /\ (hPar[q] # 0 => hPar[q] \in sPres[q]) OBVIOUS
  <2>1. hPar[q] \in sPres[q] \cup {0} /\ q \in R BY <1>0, <1>T, <1>t DEF I_RangesS
  <2>2. hPar[q] # k BY <2>1, <1>kU, <1>k DEF Epochs
  <2>. QED BY <2>1, <2>2, <1>sp, <1>k, <1>g
\* the final delta: every acked write, and each value the source's head or the standby's
<1>H. \A x \in Blocks : /\ dH[x] >= acked[x]
                        /\ dH[x] = head[s][x] \/ dH[x] = head[r][x]
  <2>. SUFFICES ASSUME NEW x \in Blocks
               PROVE  /\ dH[x] >= acked[x]
                      /\ dH[x] = head[s][x] \/ dH[x] = head[r][x]
    OBVIOUS
  <2>1. \A y \in Blocks : head[s][y] >= acked[y] BY <1>rd, <1>g
  <2>2. I_HeadLoA BY <1>v
  <2>. QED BY <2>1, <2>2, <1>s, ZK_AdmHold
<1>dt. dH \in [Blocks -> Vers] BY <1>0, <1>T, <1>g, AdmHeadType, Groups
<1>rest. /\ badAdmit' = (badAdmit \/ dH # head[s])
         /\ badLoss' = (badLoss \/ \E x \in Blocks :
                          \/ head[s][x] >= acked[x] /\ dH[x] < acked[x]
                          \/ dH[x] \notin ackedEver[x] \cup {head[q][x] : q \in T})
         /\ tr' = [q \in R |-> IF (q \in T /\ htr[q]) \/ (q = r /\ htr[s]) THEN tr[q] \cup {k} ELSE tr[q] \ {k}]
         /\ cutAck' = [q \in R |-> IF q \in U THEN [cutAck[q] EXCEPT ![k] = acked] ELSE cutAck[q]]
         /\ recorded' = recorded \cup {k} /\ nextSeq' = nextSeq + 1
         /\ mark' = [q \in R |-> IF q \in U THEN k ELSE mark[q]]
         /\ members' = U
         /\ path' = [q \in R |-> IF q \in U THEN "ok" ELSE path[q]]
         /\ dState' = [q \in R |-> IF q = r THEN "insync" ELSE IF q \in Mk THEN "stale" ELSE dState[q]]
         /\ reverted' = [reverted EXCEPT ![r] = -1] /\ pin' = [pin EXCEPT ![r] = 0]
         /\ attached' = TRUE
         /\ UNCHANGED <<ver, cutK, cutTgt, cutDone, cutGone, sb, pend, acked, fails, cfgAt, conf, zx, ackedEver>>
  BY <1>s DEF AdmRest
<1>snap. /\ sPres' = [q \in R |-> IF q \in U THEN sPres[q] \cup {k} ELSE sPres[q]]
         /\ sCon' = [q \in R |-> IF q \in T THEN [sCon[q] EXCEPT ![k] = head[q]]
                                 ELSE IF q = r THEN [sCon[q] EXCEPT ![k] = dH] ELSE sCon[q]]
         /\ sAl' = [q \in R |-> IF q \in T THEN [sAl[q] EXCEPT ![k] = hAl[q]]
                                ELSE IF q = r THEN [sAl[q] EXCEPT ![k] = AdmAlD(r, s)] ELSE sAl[q]]
         /\ sPar' = [q \in R |-> IF q \in U THEN [sPar[q] EXCEPT ![k] = hPar[q]] ELSE sPar[q]]
         /\ anc' = [q \in R |-> IF q \in U THEN [anc[q] EXCEPT ![k] = NewAnc(q, k)] ELSE anc[q]]
         /\ hPar' = [q \in R |-> IF q \in U THEN k ELSE hPar[q]]
         /\ hAl' = [q \in R |-> IF q \in U THEN {} ELSE hAl[q]]
         /\ head' = [head EXCEPT ![r] = dH]
  BY <1>s DEF AdmSnap
\* the new stamp (seq nseq + 1, gen 0) on every member; the ghosts the invariant reads stay
<1>na. /\ nseq' = nseq + 1 /\ aseq' = nseq + 1 /\ agen' = 0 /\ asize' = Cardinality(U)
       /\ stamp' = [q \in R |-> IF q \in U THEN St ELSE stamp[q]]
       /\ rgenA' = 0 /\ rmemA' = U /\ hold' = FALSE /\ due' = FALSE
       /\ UNCHANGED <<sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst, badAck, zAcked, zLeg, zjv>>
       /\ UNCHANGED <<riskTail, zpost>>
  <2>1. NewAsm(U) /\ StageGhosts BY <1>rest, Full
  <2>. QED BY <2>1, Full DEF NewAsm, StageGhosts
<1>card. IsFiniteSet(U) /\ Cardinality(U) \in Nat /\ Cardinality(U) >= 1
  <2>1. IsFiniteSet(U) BY <1>t, RNat, FS_Subset
  <2>2. Cardinality(U) \in Nat BY <2>1, FS_CardinalityType
  <2>3. Cardinality(U) # 0 BY <2>1, <1>t, FS_EmptySet
  <2>. QED BY <2>1, <2>2, <2>3
<1>St. Majority(St) /\ St.seq = nseq + 1 /\ St.gen = 0 /\ St.mem = U /\ St.size = Cardinality(U)
  BY <1>card DEF Majority
<1>is. InSyncR' = U
  <2>1. \A q \in R : dState'[q] = "insync" <=> q \in U BY <1>rest, <1>M, <1>t DEF InSyncR
  <2>. QED BY <2>1, <1>t DEF InSyncR
<1>7. \A q \in R \ U : /\ sPres'[q] = sPres[q] /\ sCon'[q] = sCon[q] /\ sAl'[q] = sAl[q]
                       /\ sPar'[q] = sPar[q] /\ anc'[q] = anc[q] /\ hPar'[q] = hPar[q]
                       /\ hAl'[q] = hAl[q] /\ head'[q] = head[q] /\ cutAck'[q] = cutAck[q]
                       /\ mark'[q] = mark[q] /\ path'[q] = path[q] /\ pin'[q] = pin[q]
                       /\ reverted'[q] = reverted[q] /\ stamp'[q] = stamp[q]
  BY <1>snap, <1>rest, <1>na, <1>0, <1>T, Groups DEF TyHead, TyLeg
<1>8. ASSUME NEW q \in U
      PROVE  /\ sPres'[q] = sPres[q] \cup {k} /\ hPar'[q] = k /\ hAl'[q] = {}
             /\ sPar'[q][k] = hPar[q] /\ anc'[q][k] = NewAnc(q, k)
             /\ cutAck'[q][k] = acked /\ mark'[q] = k /\ path'[q] = "ok" /\ stamp'[q] = St
             /\ \A e \in sPres[q] : /\ sCon'[q][e] = sCon[q][e] /\ sAl'[q][e] = sAl[q][e]
                                   /\ sPar'[q][e] = sPar[q][e] /\ anc'[q][e] = anc[q][e]
                                   /\ cutAck'[q][e] = cutAck[q][e]
  <2>1. q \in R BY <1>t
  <2>2. \A e \in sPres[q] : e # k BY <1>kU
  <2>. QED BY <2>1, <2>2, <1>snap, <1>rest, <1>na, <1>k, <1>0, <1>T, Groups DEF TySnap, TyTrust
<1>9. /\ \A q \in T : sCon'[q][k] = head[q] /\ sAl'[q][k] = hAl[q] /\ head'[q] = head[q]
      /\ sCon'[r][k] = dH /\ sAl'[r][k] = AdmAlD(r, s) /\ head'[r] = dH
  BY <1>snap, <1>t, <1>k, <1>0, <1>T, Groups DEF TySnap, TyHead
<1>tr. \A q \in R : k \notin tr[q]
  <2>1. \A q \in R : tr[q] \subseteq 1..(nextSeq - 1) BY <1>0 DEF I_RangesS
  <2>. QED BY <2>1, <1>g, <1>k
<1>lq. ASSUME NEW q \in U
      PROVE  ChainShape(sPres'[q], sPar'[q], anc'[q]) /\ ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q])
  <2>1. anc'[q][k] = {k} \cup (IF hPar[q] = 0 THEN {} ELSE anc[q][hPar[q]]) BY <1>8 DEF NewAnc, AncOf
  <2>2. hPar[q] < k /\ k \notin sPres[q] /\ q \in R BY <1>hp, <1>kU, <1>t, <1>k
  <2>3. \A x \in Blocks : x \notin sAl'[q][k] => sCon'[q][k][x] = Up(sPar[q], sCon[q], hPar[q], x)
    <3>1. \A x \in Blocks : x \notin hAl[q] => head[q][x] = Up(sPar[q], sCon[q], hPar[q], x) BY <1>0, <1>T, <2>2 DEF I_Chain
    <3>2. CASE q \in T BY <3>2, <1>9, <3>1
    <3>3. CASE q = r
      <4>. SUFFICES ASSUME NEW x \in Blocks, x \notin AdmAlD(r, s) PROVE dH[x] = head[r][x] /\ x \notin hAl[r]
        BY <3>3, <1>9, <3>1
      <4>1. x \notin hAl[r] /\ AdmHits(r, s, x) = {} BY DEF AdmAlD, AdmHits
      <4>. QED BY <4>1 DEF AdmHead
    <3>. QED BY <3>2, <3>3
  <2>. QED BY <1>0, <1>T, <1>k, <1>8, <2>1, <2>2, <2>3, ZK_LegExtend
\* every member holds every acked write
<1>hd. \A q \in U : \A x \in Blocks : head'[q][x] >= acked[x]
  <2>. SUFFICES ASSUME NEW q \in U, NEW x \in Blocks PROVE head'[q][x] >= acked[x] OBVIOUS
  <2>1. CASE q \in T BY <2>1, <1>9, <1>rd
  <2>2. CASE q = r BY <2>2, <1>9, <1>H
  <2>. QED BY <2>1, <2>2
\* a leg the step leaves out: catching up as before, unless the assembly's write marks it (then it was in_sync)
<1>c. \A q \in R \ U : /\ CatchingUp(q)' = (CatchingUp(q) /\ q \notin Mk)
                       /\ (CatchingUp(q) => q \notin Mk /\ HiOf(q)' = HiOf(q))
  <2>. SUFFICES ASSUME NEW q \in R \ U
               PROVE  /\ CatchingUp(q)' = (CatchingUp(q) /\ q \notin Mk)
                      /\ (CatchingUp(q) => q \notin Mk /\ HiOf(q)' = HiOf(q))
    OBVIOUS
  <2>1. SessionOK(q) BY <1>0, <1>T DEF I_Session
  <2>2. CASE q \in Mk
    <3>1. dState[q] = "insync" /\ reverted[q] = -1 /\ dState'[q] = "stale" /\ reverted'[q] = -1
      BY <2>1, <2>2, <1>M, <1>rest, <1>7 DEF SessionOK, InSyncR
    <3>. QED BY <3>1 DEF CatchingUp, HiOf
  <2>3. CASE q \notin Mk
    <3>1. dState'[q] = dState[q] /\ reverted'[q] = reverted[q] /\ mark'[q] = mark[q] BY <2>3, <1>rest, <1>7
    <3>. QED BY <3>1, <2>3 DEF CatchingUp, HiOf
  <2>. QED BY <2>2, <2>3
<1>u2. ~CatchingUp(r)' /\ \A q \in T : ~CatchingUp(q)'
  BY <1>rest, <1>t, <1>M DEF CatchingUp
<1>hi. \A q \in R \ U : CatchingUp(q) => HiOf(q) < k /\ HiOf(q) \in Int
  <2>. SUFFICES ASSUME NEW q \in R \ U, CatchingUp(q) PROVE HiOf(q) < k /\ HiOf(q) \in Int OBVIOUS
  <2>1. SessionOK(q) /\ RevOK(q) BY <1>0, <1>T DEF I_Session, I_Reverted
  <2>2. mark[q] \in Int /\ reverted[q] \in Int /\ sb[q] \in Int BY <1>0, <1>T, Groups DEF TyLeg
  <2>. QED BY <2>1, <2>2, <1>g DEF SessionOK, RevOK, CatchingUp, HiOf
\* the acked values a cut map holds: none new (the new epoch's map is acked), all at most acked
<1>aw. \A x \in Blocks : AckW(x)' \subseteq AckW(x) /\ \A v \in AckW(x) : v <= acked[x]
  <2>. SUFFICES ASSUME NEW x \in Blocks PROVE AckW(x)' \subseteq AckW(x) /\ \A v \in AckW(x) : v <= acked[x]
    OBVIOUS
  <2>1. AckW(x)' \subseteq AckW(x)
    <3>. SUFFICES ASSUME NEW v \in AckW(x)' PROVE v \in AckW(x) OBVIOUS
    <3>1. CASE v = acked'[x] BY <3>1, <1>rest DEF AckW
    <3>2. CASE v # acked'[x]
      <4>1. PICK q \in R : \E e \in sPres'[q] : v = cutAck'[q][e][x] BY <3>2 DEF AckW
      <4>2. PICK e \in sPres'[q] : v = cutAck'[q][e][x] BY <4>1
      <4>3. CASE q \in U /\ e = k BY <4>2, <4>3, <1>8 DEF AckW
      <4>4. CASE ~(q \in U /\ e = k)
        <5>1. e \in sPres[q] /\ cutAck'[q][e] = cutAck[q][e] BY <4>4, <1>7, <1>8
        <5>. QED BY <4>2, <5>1 DEF AckW
      <4>. QED BY <4>3, <4>4
    <3>. QED BY <3>1, <3>2
  <2>2. \A v \in AckW(x) : v <= acked[x]
    <3>. SUFFICES ASSUME NEW v \in AckW(x) PROVE v <= acked[x] OBVIOUS
    <3>1. CASE v = acked[x] BY <3>1, <1>N
    <3>2. CASE v # acked[x]
      <4>1. PICK q \in R : \E e \in sPres[q] : v = cutAck[q][e][x] BY <3>2 DEF AckW
      <4>. QED BY <4>1, <1>0 DEF I_AckMono
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2

\* --- the conjuncts ---------------------------------------------------------------------------
<1>1. TypeOK' BY <1>0, S_TyStageAdmit
\* the J layer: the new stamp is gen 0 of a fresh seq on every member, released at once
<1>j1. J_DueHold' /\ J_HoldAtt' /\ J_Rel' /\ J_Aseq' /\ J_MemRel' /\ J_NoAckBad' /\ J_ZGen'
  BY <1>na, <1>rest, <1>0 DEF J_DueHold, J_HoldAtt, J_Rel, J_Aseq, J_MemRel, J_NoAckBad, J_ZGen
<1>j2. J_Cur'
  <2>. SUFFICES ASSUME NEW q \in members' PROVE Core(stamp'[q]) = Core(CurStamp') BY <1>rest DEF J_Cur
  <2>1. q \in U /\ stamp'[q] = St BY <1>rest, <1>8
  <2>. QED BY <2>1, <1>na, <1>rest DEF Core, CurStamp
<1>j3. J_ZxOut' BY <1>t, <1>rest DEF J_ZxOut
<1>j4. J_SeqSync' BY <1>na, <1>is, <1>8 DEF J_SeqSync
<1>j5. J_RelHold' /\ J_RelHoldS' BY <1>hd, <1>na, <1>is, <1>rest DEF J_RelHold, J_RelHoldS
<1>j6. J_M0'
  <2>1. \A q \in R \ U : stamp[q].seq <= nseq /\ stamp[q].seq \in Nat /\ stamp'[q] = stamp[q]
    BY <1>v, <1>0, <1>7, Const DEF J_SeqLe, TypeOK, StampRec
  <2>2. nseq \in Nat BY <1>0, Const DEF TypeOK
  <2>3. \A q \in U : stamp'[q].seq = nseq + 1 BY <1>8
  <2>4. SeqLegs' = U BY <2>1, <2>2, <2>3, <1>na, <1>t DEF SeqLegs
  <2>. QED BY <2>4, <1>na, <1>is DEF J_M0
<1>j7. J_RelValid' /\ J_MinorRel'
  <2>1. Majority(RelStamp)' BY <1>na, <1>card DEF RelStamp, Majority
  <2>. QED BY <2>1 DEF J_RelValid, J_MinorRel, Valid
<1>j8. J_RelInSync' BY <1>na, <1>is, <1>t DEF J_RelInSync
<1>j9. J_ViewIn'
  <2>1. \A q \in InSyncR' \cap rmemA' : stamp'[q] = St BY <1>is, <1>8
  <2>2. 2 * Cardinality(St.mem) > St.size /\ St.mem = U /\ St.gen = 0 /\ St.seq = nseq + 1 BY <1>St DEF Majority
  <2>. QED BY <2>1, <2>2, <1>na DEF J_ViewIn, View, Valid, Majority
<1>j10. J_ViewOut' BY <1>na, <1>is DEF J_ViewOut
<1>j11. J_SoleSeq' /\ J_SeqLe' /\ J_SoleRel'
  <2>1. \A c \in sole : c[1] <= nseq /\ c[1] \in Nat BY <1>v, <1>0, Const DEF J_SeqLe, TypeOK
  <2>2. nseq \in Nat /\ zseq <= nseq BY <1>v, <1>0, Const DEF TypeOK, J_SeqLe
  <2>3. \A q \in R : stamp'[q].seq <= nseq + 1
    <3>. SUFFICES ASSUME NEW q \in R PROVE stamp'[q].seq <= nseq + 1 OBVIOUS
    <3>1. CASE q \in U BY <3>1, <1>8, <2>2
    <3>2. CASE q \notin U BY <3>2, <1>7, <1>v, <1>0, <2>2, Const DEF J_SeqLe, TypeOK, StampRec
    <3>. QED BY <3>1, <3>2
  <2>4. J_SoleSeq' BY <2>1, <2>2, <1>na DEF J_SoleSeq
  <2>5. J_SeqLe'
    <3>1. zseq \in Nat BY <1>0, Const DEF TypeOK
    <3>. QED BY <2>1, <2>2, <2>3, <3>1, <1>na DEF J_SeqLe
  <2>6. J_SoleRel' BY <2>1, <2>2, <1>na DEF J_SoleRel
  <2>. QED BY <2>4, <2>5, <2>6
<1>j12. J_GenBound' /\ J_RelLe' BY <1>na, <1>rest, <1>card DEF J_GenBound, J_RelLe
<1>j13. J_GenTop'
  <2>1. \A q \in InSyncR' : stamp'[q] = St /\ q \in members' BY <1>is, <1>8, <1>rest
  <2>2. 2 * Cardinality(St.mem) > St.size /\ St.gen = 0 BY <1>St DEF Majority
  <2>. QED BY <2>1, <2>2, <1>na, <1>rest DEF J_GenTop, View, Valid, Majority
<1>j14. J_ZxIdle' /\ J_ZLive'
  <2>. SUFFICES ASSUME zx # 0
               PROVE  /\ dState'[zx] # "standby" /\ sb'[zx] = -1 /\ reverted'[zx] = -1 /\ stamp'[zx].seq = zseq'
                      /\ dState'[zx] # "insync"
    BY <1>rest DEF J_ZxIdle, J_ZLive
  <2>1. zx \in R \ U BY <1>0, <1>t DEF TypeOK
  <2>2. dState[zx] # "standby" /\ sb[zx] = -1 /\ reverted[zx] = -1 /\ stamp[zx].seq = zseq BY <1>v DEF J_ZxIdle
  <2>3. dState'[zx] = (IF zx \in Mk THEN "stale" ELSE dState[zx]) /\ dState'[zx] # "insync"
    BY <2>1, <1>rest, <1>is DEF InSyncR
  <2>. QED BY <2>1, <2>2, <2>3, <1>7, <1>rest, <1>na
<1>j. IndJ' /\ J_RelHoldS' /\ J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZxIdle' /\ J_ZLive' /\ J_RelLe'
  BY <1>j1, <1>j2, <1>j3, <1>j4, <1>j5, <1>j6, <1>j7, <1>j8, <1>j9, <1>j10, <1>j11, <1>j12, <1>j13, <1>j14 DEF IndJ

\* the data plane: nothing in flight, the members hold every acked write
<1>3. I_Pend' /\ I_PendSeen' /\ I_HeadPend' /\ I_SnapPend' BY <1>rest, <1>r DEF I_Pend, I_PendSeen, I_HeadPend, I_SnapPend
<1>4. I_AckedEverS' BY <1>0, <1>rest, F_AckedEverS
<1>5. I_MembersS' BY <1>rest, <1>is DEF I_MembersS
<1>6. I_HoldAtt' BY <1>rest, <1>hd DEF I_HoldAtt
<1>ah. Inv_AckedHeld'
  <2>1. dState'[r] = "insync" /\ \A x \in Blocks : head'[r][x] >= acked'[x] BY <1>rest, <1>t, <1>hd
  <2>. QED BY <2>1 DEF Inv_AckedHeld
<1>nb. I_NoBadLoss'
  <2>1. \A x \in Blocks : ~(head[s][x] >= acked[x] /\ dH[x] < acked[x])
    <3>. SUFFICES ASSUME NEW x \in Blocks PROVE ~(head[s][x] >= acked[x] /\ dH[x] < acked[x]) OBVIOUS
    <3>1. acked[x] \in Nat /\ dH[x] \in Nat BY <1>N, <1>dt DEF Vers
    <3>. QED BY <3>1, <1>H
  <2>2. \A x \in Blocks : dH[x] \in ackedEver[x] \cup {head[q][x] : q \in T}
    <3>. SUFFICES ASSUME NEW x \in Blocks PROVE dH[x] \in ackedEver[x] \cup {head[q][x] : q \in T} OBVIOUS
    <3>1. CASE dH[x] = head[s][x] BY <3>1, <1>g
    <3>2. CASE dH[x] = head[r][x]
      <4>1. head[r][x] \in ackedEver[x] \cup PendVal(x) BY <1>v, <1>g DEF I_StandbyLegal
      <4>2. PendVal(x) = {} BY <1>r DEF PendVal
      <4>. QED BY <3>2, <4>1, <4>2
    <3>. QED BY <3>1, <3>2, <1>H
  <2>. QED BY <2>1, <2>2, <1>0, <1>rest DEF I_NoBadLoss
<1>10. I_RangesS'
  <2>1. \A q \in R : tr'[q] \subseteq sPres'[q] \cap 1..(nextSeq' - 1)
    <3>. SUFFICES ASSUME NEW q \in R, NEW e \in tr'[q] PROVE e \in sPres'[q] /\ e \in 1..(nextSeq' - 1) OBVIOUS
    <3>1. CASE e = k /\ q \in U BY <3>1, <1>8, <1>k, <1>g, <1>rest DEF Epochs
    <3>2. CASE ~(e = k /\ q \in U)
      <4>1. e \in tr[q] BY <3>2, <1>rest
      <4>2. e \in sPres[q] /\ e \in 1..(nextSeq - 1) BY <4>1, <1>0, <1>T DEF I_RangesS
      <4>3. e \in sPres'[q] BY <4>2, <1>7, <1>8
      <4>. QED BY <4>2, <4>3, <1>rest, <1>k
    <3>. QED BY <3>1, <3>2
  <2>2. \A q \in R : sPres'[q] \subseteq 1..nextSeq' /\ hPar'[q] \in sPres'[q] \cup {0}
    <3>. SUFFICES ASSUME NEW q \in R PROVE sPres'[q] \subseteq 1..nextSeq' /\ hPar'[q] \in sPres'[q] \cup {0} OBVIOUS
    <3>1. CASE q \in U BY <3>1, <1>8, <1>sp, <1>k, <1>g, <1>rest DEF Epochs
    <3>2. CASE q \notin U BY <3>2, <1>7, <1>sp, <1>k, <1>rest, <1>0, <1>T DEF I_RangesS
    <3>. QED BY <3>1, <3>2
  <2>3. recorded' \subseteq 1..(nextSeq' - 1) BY <1>rest, <1>0, <1>T, <1>k, <1>g DEF I_RangesS, Epochs
  <2>. QED BY <1>rest, <1>r, <1>g, <2>1, <2>2, <2>3 DEF I_RangesS
<1>11. I_Lineage'
  <2>. SUFFICES ASSUME NEW q \in R
               PROVE  /\ ChainShape(sPres'[q], sPar'[q], anc'[q])
                      /\ \A e \in Epochs \ sPres'[q] : anc'[q][e] = {}
    BY DEF I_Lineage
  <2>1. CASE q \in U
    <3>3. ChainShape(sPres'[q], sPar'[q], anc'[q]) BY <2>1, <1>lq
    <3>4. \A e \in Epochs \ sPres'[q] : anc'[q][e] = {}
      <4>. SUFFICES ASSUME NEW e \in Epochs \ sPres'[q] PROVE anc'[q][e] = {} OBVIOUS
      <4>1. e # k /\ e \notin sPres[q] BY <1>8, <2>1
      <4>2. anc'[q][e] = anc[q][e] BY <4>1, <1>snap, <2>1, <1>t, <1>0, <1>T, Groups DEF TySnap
      <4>. QED BY <4>1, <4>2, <1>0, <1>T, <1>t, <2>1 DEF I_Lineage
    <3>. QED BY <3>3, <3>4
  <2>2. CASE q \notin U BY <2>2, <1>7, <1>0, <1>T DEF I_Lineage
  <2>. QED BY <2>1, <2>2
<1>12. I_Chain'
  <2>. SUFFICES ASSUME NEW q \in R
               PROVE  /\ ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q])
                      /\ \A x \in Blocks : x \notin hAl'[q] => head'[q][x] = Up(sPar'[q], sCon'[q], hPar'[q], x)
    BY DEF I_Chain
  <2>1. CASE q \in U
    <3>5. ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q]) BY <2>1, <1>lq
    <3>6. \A x \in Blocks : head'[q][x] = sCon'[q][k][x] BY <1>9, <2>1
    <3>. QED BY <3>5, <3>6, <1>8, <2>1, <1>k DEF Up, Epochs
  <2>2. CASE q \notin U BY <2>2, <1>7, <1>0, <1>T DEF I_Chain
  <2>. QED BY <2>1, <2>2
\* values: the admitted ones are the source's head or the standby's
<1>13. I_Vers' /\ I_LegalS' /\ I_LegalS2'
  <2>0. \A x \in Blocks : LegalV(x)' = LegalV(x) /\ LegalV2(x)' = LegalV2(x)
    BY <1>rest, <1>na DEF LegalV, LegalV2, PendVal
  <2>1. \A q \in R : \A x \in Blocks : /\ head'[q][x] \in {head[q2][x] : q2 \in R}
                                      /\ \A e \in sPres'[q] : sCon'[q][e][x] \in {head[q2][x] : q2 \in R}
                                                                             \cup {sCon[q][e2][x] : e2 \in sPres[q]}
    <3>. SUFFICES ASSUME NEW q \in R, NEW x \in Blocks
                 PROVE  /\ head'[q][x] \in {head[q2][x] : q2 \in R}
                        /\ \A e \in sPres'[q] : sCon'[q][e][x] \in {head[q2][x] : q2 \in R}
                                                                   \cup {sCon[q][e2][x] : e2 \in sPres[q]}
      OBVIOUS
    <3>1. dH[x] \in {head[q2][x] : q2 \in R} BY <1>H, <1>g, <1>t
    <3>2. head'[q][x] \in {head[q2][x] : q2 \in R}
      <4>1. CASE q = r BY <4>1, <1>9, <3>1
      <4>2. CASE q # r BY <4>2, <1>snap, <1>0, <1>T, Groups DEF TyHead
      <4>. QED BY <4>1, <4>2
    <3>3. ASSUME NEW e \in sPres'[q]
          PROVE  sCon'[q][e][x] \in {head[q2][x] : q2 \in R} \cup {sCon[q][e2][x] : e2 \in sPres[q]}
      <4>1. CASE q \in T /\ e = k BY <4>1, <1>9, <1>t
      <4>2. CASE q = r /\ e = k BY <4>2, <1>9, <3>1
      <4>3. CASE q \in U /\ e # k BY <4>3, <1>8
      <4>4. CASE q \notin U BY <4>4, <1>7
      <4>. QED BY <4>1, <4>2, <4>3, <4>4
    <3>. QED BY <3>2, <3>3
  <2>2. I_Vers'
    <3>1. \A x \in Blocks : acked[x] <= ver BY <1>0 DEF I_Vers
    <3>2. \A q \in R : \A x \in Blocks : head'[q][x] <= ver /\ \A e \in sPres'[q] : sCon'[q][e][x] <= ver
      BY <2>1, <1>0 DEF I_Vers
    <3>. QED BY <3>1, <3>2, <1>rest DEF I_Vers
  <2>3. I_LegalS'
    <3>1. \A q \in R : \A x \in Blocks : head[q][x] \in LegalV(x) /\ \A e \in sPres[q] : sCon[q][e][x] \in LegalV(x)
      BY <1>0 DEF I_LegalS
    <3>. QED BY <3>1, <2>0, <2>1 DEF I_LegalS
  <2>4. I_LegalS2'
    <3>1. \A q \in R : \A x \in Blocks : head[q][x] \in LegalV2(x) /\ \A e \in sPres[q] : sCon[q][e][x] \in LegalV2(x)
      BY <1>v DEF I_LegalS2
    <3>. QED BY <3>1, <2>0, <2>1 DEF I_LegalS2
  <2>. QED BY <2>2, <2>3, <2>4
\* the cut maps: the new epoch's is acked, the newest
<1>14. I_WHiS'
  <2>. SUFFICES ASSUME NEW q1 \in R, NEW q2 \in R, NEW e1 \in sPres'[q1], NEW e2 \in sPres'[q2], e1 < e2,
                      NEW x \in Blocks
               PROVE  cutAck'[q1][e1][x] <= cutAck'[q2][e2][x]
    BY DEF I_WHiS
  <2>0. e1 \in Nat /\ e2 \in Nat /\ e1 <= k /\ e2 <= k
    <3>1. \A q \in R : sPres'[q] \subseteq 1..k
      <4>. SUFFICES ASSUME NEW q \in R PROVE sPres'[q] \subseteq 1..k OBVIOUS
      <4>1. CASE q \in U BY <4>1, <1>8, <1>sp, <1>g, <1>k DEF Epochs
      <4>2. CASE q \notin U BY <4>2, <1>7, <1>sp, <1>g
      <4>. QED BY <4>1, <4>2
    <3>. QED BY <3>1
  <2>1. e1 # k BY <2>0
  <2>2. e1 \in sPres[q1] /\ cutAck'[q1][e1] = cutAck[q1][e1] BY <2>1, <1>7, <1>8
  <2>3. CASE q2 \in U /\ e2 = k
    <3>1. cutAck[q1][e1][x] <= acked[x] BY <2>2, <1>0 DEF I_AckMono
    <3>. QED BY <3>1, <2>2, <2>3, <1>8
  <2>4. CASE ~(q2 \in U /\ e2 = k)
    <3>1. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <2>4, <1>7, <1>8
    <3>. QED BY <3>1, <2>2, <1>0 DEF I_WHiS
  <2>. QED BY <2>3, <2>4
<1>am. I_AckMono'
  <2>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres'[q], NEW x \in Blocks PROVE cutAck'[q][e][x] <= acked'[x]
    BY DEF I_AckMono
  <2>1. CASE q \in U /\ e = k BY <2>1, <1>8, <1>rest, <1>N
  <2>2. CASE ~(q \in U /\ e = k)
    <3>1. e \in sPres[q] /\ cutAck'[q][e] = cutAck[q][e] BY <2>2, <1>7, <1>8
    <3>. QED BY <3>1, <1>0, <1>rest DEF I_AckMono
  <2>. QED BY <2>1, <2>2
<1>wc. I_WHiC'
  <2>. SUFFICES ASSUME NEW q \in R, NEW q2 \in R, NEW p \in sPres'[q], NEW e2 \in sPres'[q2], p < e2,
                      NEW x \in Blocks, NEW v \in AckW(x)', v <= sCon'[q][p][x]
               PROVE  v <= cutAck'[q2][e2][x]
    BY DEF I_WHiC
  <2>0. p \in Nat /\ e2 \in Nat /\ p <= k /\ e2 <= k
    <3>1. \A qq \in R : sPres'[qq] \subseteq 1..k
      <4>. SUFFICES ASSUME NEW qq \in R PROVE sPres'[qq] \subseteq 1..k OBVIOUS
      <4>1. CASE qq \in U BY <4>1, <1>8, <1>sp, <1>g, <1>k DEF Epochs
      <4>2. CASE qq \notin U BY <4>2, <1>7, <1>sp, <1>g
      <4>. QED BY <4>1, <4>2
    <3>. QED BY <3>1
  <2>1. p # k BY <2>0
  <2>2. p \in sPres[q] /\ sCon'[q][p] = sCon[q][p] BY <2>1, <1>7, <1>8
  <2>3. v \in AckW(x) /\ v <= acked[x] BY <1>aw
  <2>4. CASE q2 \in U /\ e2 = k BY <2>3, <2>4, <1>8
  <2>5. CASE ~(q2 \in U /\ e2 = k)
    <3>1. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <2>5, <1>7, <1>8
    <3>. QED BY <3>1, <2>2, <2>3, <1>v DEF I_WHiC
  <2>. QED BY <2>4, <2>5
\* a leg catching up: not in the assembly, its own epoch below k, its head unchanged
<1>cu. ASSUME NEW q \in R, CatchingUp(q)'
      PROVE  /\ q \in R \ U /\ CatchingUp(q) /\ HiOf(q)' = HiOf(q) /\ head'[q] = head[q]
             /\ HiOf(q) < k /\ HiOf(q) \in Int
  <2>1. q \notin U BY <1>cu, <1>u2
  <2>. QED BY <2>1, <1>cu, <1>c, <1>7, <1>hi
<1>15. I_HeadLoS' /\ I_HeadLoA' /\ I_HeadLoC' /\ I_StandbyLegal'
  <2>0. ASSUME NEW q \in R, CatchingUp(q)'
        PROVE  q \in R \ U /\ CatchingUp(q) /\ HiOf(q)' = HiOf(q) /\ head'[q] = head[q] /\ HiOf(q) < k
    BY <2>0, <1>cu
  <2>1. ASSUME NEW q \in R, CatchingUp(q)', NEW q1 \in R, NEW p \in sPres'[q1], p < HiOf(q)'
        PROVE  p \in sPres[q1] /\ sCon'[q1][p] = sCon[q1][p] /\ cutAck'[q1][p] = cutAck[q1][p] /\ p < HiOf(q)
    <3>0. HiOf(q)' = HiOf(q) /\ HiOf(q) < k /\ HiOf(q) \in Int BY <2>1, <1>cu
    <3>1. p # k BY <3>0, <2>1, <1>k
    <3>. QED BY <3>0, <3>1, <2>1, <1>7, <1>8
  <2>2. I_HeadLoS'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q1 \in R, NEW p \in sPres'[q1], p < HiOf(q)',
                        NEW x \in Blocks
                 PROVE  cutAck'[q1][p][x] <= head'[q][x]
      BY DEF I_HeadLoS
    <3>. QED BY <2>0, <2>1, <1>0 DEF I_HeadLoS
  <2>3. I_HeadLoA'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q1 \in R, NEW p \in sPres'[q1], p < HiOf(q)',
                        NEW x \in Blocks, acked'[x] <= sCon'[q1][p][x]
                 PROVE  acked'[x] <= head'[q][x]
      BY DEF I_HeadLoA
    <3>. QED BY <2>0, <2>1, <1>v, <1>rest DEF I_HeadLoA
  <2>4. I_HeadLoC'
    <3>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q1 \in R, NEW p \in sPres'[q1], p < HiOf(q)',
                        NEW x \in Blocks, NEW v \in AckW(x)', v <= sCon'[q1][p][x]
                 PROVE  v <= head'[q][x]
      BY DEF I_HeadLoC
    <3>1. v \in AckW(x) BY <1>aw
    <3>. QED BY <3>1, <2>0, <2>1, <1>v DEF I_HeadLoC
  <2>5. I_StandbyLegal'
    <3>. SUFFICES ASSUME NEW q \in R, dState'[q] = "standby", NEW x \in Blocks
                 PROVE  head'[q][x] \in ackedEver'[x] \cup PendVal(x)'
      BY DEF I_StandbyLegal
    <3>1. q \notin U /\ q \notin Mk BY <1>rest, <1>t, <1>M
    <3>2. dState[q] = "standby" /\ head'[q] = head[q] BY <3>1, <1>rest, <1>7
    <3>. QED BY <3>2, <1>v, <1>rest DEF I_StandbyLegal, PendVal
  <2>. QED BY <2>2, <2>3, <2>4, <2>5
<1>16. I_Reverted'
  <2>. SUFFICES ASSUME NEW q \in R PROVE RevOK(q)' BY DEF I_Reverted
  <2>1. CASE q \in U BY <2>1, <1>rest, <1>t, <1>M DEF RevOK, InSyncR
  <2>2. CASE q \in Mk
    <3>1. q \notin U /\ reverted'[q] = reverted[q] BY <2>2, <1>M, <1>7, <1>t
    <3>2. reverted[q] = -1 BY <2>2, <1>M, <1>0, <1>T DEF I_Session, SessionOK, InSyncR
    <3>. QED BY <3>1, <3>2 DEF RevOK
  <2>3. CASE q \notin U /\ q \notin Mk
    <3>1. RevOK(q) /\ SessionOK(q) BY <1>0, <1>T DEF I_Reverted, I_Session
    <3>2. dState'[q] = dState[q] /\ reverted'[q] = reverted[q] BY <2>3, <1>rest, <1>7
    <3>3. dState[q] = "stale" /\ reverted[q] # -1 => \A e \in sPres[q] : e < k
      BY <3>1, <1>sp, <1>g, <1>k DEF SessionOK, CatchingUp
    <3>. QED BY <3>1, <3>2, <3>3, <2>3, <1>7, <1>rest DEF RevOK
  <2>. QED BY <2>1, <2>2, <2>3
<1>17. I_Session'
  <2>. SUFFICES ASSUME NEW q \in R PROVE SessionOK(q)' BY DEF I_Session
  <2>0. SessionOK(q) BY <1>0, <1>T DEF I_Session
  <2>1. CASE q = r
    <3>a. dState'[r] = "insync" /\ reverted'[r] = -1 BY <1>rest, <1>0, Groups DEF TyLeg
    <3>b. sb'[r] = -1 BY <1>rest, <2>0, <2>1, <1>g DEF SessionOK
    <3>1. dState'[r] = "insync" /\ reverted'[r] = -1 /\ sb'[r] = -1 BY <3>a, <3>b
    <3>. QED BY <3>1, <2>1, <1>u2 DEF SessionOK
  <2>2. CASE q \in T
    <3>1. dState'[q] = "insync" /\ reverted'[q] = reverted[q] /\ sb'[q] = sb[q] /\ dState[q] = "insync"
      BY <2>2, <1>rest, <1>t, <1>M, <1>0, <1>T, Groups DEF TyLeg
    <3>. QED BY <3>1, <2>0, <2>2, <1>u2, <1>rest DEF SessionOK
  <2>3. CASE q \in Mk
    <3>1. dState'[q] = "stale" /\ reverted'[q] = -1 /\ sb'[q] = -1 /\ ~CatchingUp(q)'
      BY <2>3, <2>0, <1>rest, <1>M, <1>7, <1>c, <1>t DEF SessionOK, InSyncR
    <3>. QED BY <3>1 DEF SessionOK
  <2>4. CASE q \notin U /\ q \notin Mk
    <3>1. dState'[q] = dState[q] /\ reverted'[q] = reverted[q] /\ sb'[q] = sb[q] /\ mark'[q] = mark[q]
          /\ pin'[q] = pin[q] /\ path'[q] = path[q] /\ hPar'[q] = hPar[q] /\ sPres'[q] = sPres[q]
          /\ tr'[q] = tr[q]
      BY <2>4, <1>rest, <1>7, <1>tr, <1>0, <1>T, Groups DEF TyTrust
    <3>2. CatchingUp(q) => \A e \in sPres[q] : e < k BY <2>0, <1>sp, <1>g, <1>k DEF SessionOK
    <3>3. CatchingUp(q)' = CatchingUp(q) BY <2>4, <1>c DEF CatchingUp
    <3>4. dState[q] = "standby" => q \notin U BY <2>4
    <3>5. /\ CatchingUp(q) => nextSeq' \notin sPres[q]
          /\ recorded \subseteq recorded' /\ nextSeq < nextSeq' /\ cutK' = 0 /\ members' = U
      BY <1>sp, <1>rest, <1>k, <1>g
    <3>6. dState[q] = "standby" =>
            /\ \A e \in sPres[q] : e <= mark[q] \/ \A f \in recorded' : e < f
            /\ mark[q] < nextSeq' /\ mark[q] \in recorded' /\ q \notin members'
      <4>1. dState[q] = "standby" => CatchingUp(q) BY DEF CatchingUp
      <4>2. dState[q] = "standby" => /\ mark[q] < nextSeq /\ mark[q] \in recorded
                                    /\ \A e \in sPres[q] : e <= mark[q] \/ \A f \in recorded : e < f
        BY <2>0 DEF SessionOK
      <4>3. sPres[q] \subseteq Nat /\ mark[q] \in Nat /\ nextSeq' = nextSeq + 1 /\ recorded' = recorded \cup {k}
        BY <1>T, <1>rest
      <4>. QED BY <4>1, <4>2, <4>3, <3>2, <3>4, <3>5, <1>k
    <3>7. sb[q] # -1 => sb[q] < nextSeq' /\ recorded' # {} BY <2>0, <3>5, <1>rest, <1>T DEF SessionOK
    <3>. QED BY <2>0, <3>1, <3>3, <3>5, <3>6, <3>7, <1>rest DEF SessionOK, CatchingUp
  <2>. QED BY <2>1, <2>2, <2>3, <2>4
<1>18. Inv_TrustComplete'
  <2>. SUFFICES ASSUME NEW q \in R, NEW e \in tr'[q], NEW x \in Blocks
               PROVE  sCon'[q][e][x] >= cutAck'[q][e][x]
    BY DEF Inv_TrustComplete
  <2>1. CASE e = k /\ q \in U
    <3>1. sCon'[q][k][x] >= acked[x]
      <4>1. CASE q \in T BY <4>1, <1>9, <1>rd
      <4>2. CASE q = r BY <4>2, <1>9, <1>H
      <4>. QED BY <4>1, <4>2, <2>1
    <3>. QED BY <3>1, <1>8, <2>1
  <2>2. CASE ~(e = k /\ q \in U)
    <3>1. e \in tr[q] BY <2>2, <1>rest
    <3>2. e \in sPres[q] BY <3>1, <1>0, <1>T DEF I_RangesS
    <3>3. sCon'[q][e] = sCon[q][e] /\ cutAck'[q][e] = cutAck[q][e] BY <3>2, <1>7, <1>8
    <3>. QED BY <3>1, <3>3, <1>0, <1>T DEF Inv_TrustComplete
  <2>. QED BY <2>1, <2>2
\* the fresh bases: every epoch is below nextSeq' and confirmed (detached before the step)
<1>19. I_FreshS' /\ I_FreshS2'
  <2>1. \A qq \in R : \A ee \in sPres'[qq] : ee \in Epochs /\ ee < nextSeq'
    BY <1>7, <1>8, <1>sp, <1>g, <1>k, <1>rest
  <2>2. \A ee \in Epochs : conf'[ee] BY <1>r, <1>rest
  <2>3. \A qq \in R : \A ee \in sPres'[qq] : ~(ee >= nextSeq' \/ ~conf'[ee]) BY <2>1, <2>2, <1>T, <1>rest, <1>k
  <2>4. BasesS' \subseteq R /\ InSyncR' \cap rmemA' \subseteq R BY <1>rest, <1>is, <1>na, <1>t DEF BasesS
  <2>. QED BY <2>3, <2>4 DEF I_FreshS, I_FreshS2
\* the legal values (IndNew's): the assembly's heads are legal (valid stamps), so the cut k and the raid's in_sync legs
<1>vl. \A q \in T : \A x \in Blocks : head[q][x] \in ackedEver[x]
  <2>1. \A q \in T : q \in InSyncR /\ Valid(stamp[q])
    <3>1. CleanMem # {} BY <1>cs, Full DEF CanStampStage
    <3>2. AsmSet = CleanMem BY <3>1, Full DEF AsmSet
    <3>3. \A q \in CleanMem : q \in Attachable /\ Valid(stamp[q]) BY DEF CleanMem, StampMem, TornAtt
    <3>. QED BY <3>2, <3>3, <1>t DEF AdmT
  <2>2. \A x \in Blocks : PendVal(x) = {} BY <1>r DEF PendVal
  <2>. QED BY <2>1, <2>2, <1>v DEF I_ValidLegal
<1>cl. \A q \in U : \A x \in Blocks : head'[q][x] \in ackedEver[x] /\ sCon'[q][k][x] = head'[q][x]
  <2>. SUFFICES ASSUME NEW q \in U, NEW x \in Blocks
               PROVE  head'[q][x] \in ackedEver[x] /\ sCon'[q][k][x] = head'[q][x]
    OBVIOUS
  <2>1. CASE q \in T BY <2>1, <1>9, <1>vl
  <2>2. CASE q = r
    <3>1. dH[x] \in ackedEver[x]
      <4>1. CASE dH[x] = head[s][x] BY <4>1, <1>vl, <1>g
      <4>2. CASE dH[x] = head[r][x]
        <5>1. head[r][x] \in ackedEver[x] \cup PendVal(x) BY <1>v, <1>g DEF I_StandbyLegal
        <5>2. PendVal(x) = {} BY <1>r DEF PendVal
        <5>. QED BY <4>2, <5>1, <5>2
      <4>. QED BY <4>1, <4>2, <1>H
    <3>. QED BY <3>1, <2>2, <1>9
  <2>. QED BY <2>1, <2>2
<1>lg. I_SnapLegal' /\ I_InSyncLegal' /\ I_CutLegal' /\ I_ValidLegal' /\ I_PendTop' /\ I_PendNext'
  <2>0. \A x \in Blocks : PendVal(x)' = {} /\ ackedEver'[x] = ackedEver[x] BY <1>rest, <1>r DEF PendVal
  <2>1. I_SnapLegal'
    <3>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres'[q], NEW x \in Blocks
                 PROVE  sCon'[q][e][x] \in ackedEver'[x] \cup PendVal(x)'
      BY DEF I_SnapLegal
    <3>1. CASE q \in U /\ e = k BY <3>1, <1>cl, <2>0
    <3>2. CASE ~(q \in U /\ e = k)
      <4>1. e \in sPres[q] /\ sCon'[q][e] = sCon[q][e] BY <3>2, <1>7, <1>8
      <4>. QED BY <4>1, <1>v, <1>rest DEF I_SnapLegal, PendVal
    <3>. QED BY <3>1, <3>2
  <2>2. I_InSyncLegal' /\ I_ValidLegal' BY <1>is, <1>cl, <2>0 DEF I_InSyncLegal, I_ValidLegal
  <2>3. I_CutLegal' /\ I_PendTop' /\ I_PendNext' BY <1>rest, <1>r, <1>g DEF I_CutLegal, I_PendTop, I_PendNext
  <2>. QED BY <2>1, <2>2, <2>3
<1>hh. I_HeadHiC'
  <2>. SUFFICES ASSUME NEW q \in R, CatchingUp(q)', NEW q2 \in R, NEW e2 \in sPres'[q2], e2 > HiOf(q)',
                      NEW x \in Blocks, NEW v \in AckW(x)', v <= head'[q][x]
               PROVE  v <= cutAck'[q2][e2][x]
    BY DEF I_HeadHiC
  <2>1. CatchingUp(q) /\ HiOf(q)' = HiOf(q) /\ head'[q] = head[q] BY <1>cu
  <2>2. v \in AckW(x) /\ v <= acked[x] BY <1>aw
  <2>3. CASE q2 \in U /\ e2 = k BY <2>2, <2>3, <1>8
  <2>4. CASE ~(q2 \in U /\ e2 = k)
    <3>1. e2 \in sPres[q2] /\ cutAck'[q2][e2] = cutAck[q2][e2] BY <2>4, <1>7, <1>8
    <3>. QED BY <3>1, <2>1, <2>2, <1>v DEF I_HeadHiC
  <2>. QED BY <2>3, <2>4
<1>zr. J_ZRel'
  <2>1. ~ZombieReleases
    <3>1. s \in InSyncR /\ s # zx BY <1>g, <1>t
    <3>. QED BY <3>1, <1>v DEF J_ZRel
  <2>2. ZombieReleases' = ZombieReleases BY <1>na, <1>rest, Full DEF ZombieReleases, Majority, Valid, SolePairs
  <2>. QED BY <2>1, <2>2 DEF J_ZRel
\* the zombie's registers and the new seq: zx is out of the raid and stale or not in_sync; no confirmation at nseq + 1
<1>nw. J_ZNoValid' /\ J_ZM0' /\ J_SoleGen' /\ J_ZCut'
  <2>1. zx # 0 => dState'[zx] # "insync" BY <1>t, <1>is, <1>0 DEF InSyncR, TypeOK
  <2>2. J_ZNoValid' BY <2>1, <1>rest DEF J_ZNoValid
  <2>3. J_ZM0' BY <1>v, <1>na, <1>rest, F_ZM0
  <2>4. J_SoleGen'
    <3>1. \A c \in sole : c[1] <= nseq /\ c[1] \in Nat BY <1>v, <1>0, Const DEF J_SeqLe, TypeOK
    <3>2. nseq \in Nat BY <1>0, Const DEF TypeOK
    <3>. QED BY <3>1, <3>2, <1>na DEF J_SoleGen
  <2>5. J_ZCut' BY <1>rest, <1>g DEF J_ZCut
  <2>. QED BY <2>2, <2>3, <2>4, <2>5
<1>t9. IndT' BY <1>10, <1>11, <1>12, <1>3, <1>5, <1>6, <1>13, <1>16, <1>17, <1>18, <1>nb, <1>ah DEF IndT
<1>s9. IndS' BY <1>4, <1>13, <1>14, <1>am, <1>15, <1>19 DEF IndS
<1>. QED BY <1>1, <1>j, <1>t9, <1>s9, <1>3, <1>13, <1>19, <1>wc, <1>15, <1>lg, <1>hh, <1>zr, <1>nw,
            IndSplitP, IndNewSplitP

-----------------------------------------------------------------------------
(* (S) The zombie's six Next disjuncts (inv-zombie, 10-31): the write it   *)
(* makes after it lost the volume, its ack (a confirmed sole continuation), *)
(* the move, its late monitor (never under Full), hygiene, its own stamp.  *)
(* Each lemma I_<X>All: ASSUME IndInv, IndNew, <disjunct> PROVE IndInv'   *)
(* /\ IndNew' (IndNew: 41-ind-new).                                        *)

\* --- frames for the v7 conjuncts -------------------------------------------------------------
LEMMA ZZ_FRelHoldS == J_RelHoldS /\ UNCHANGED <<rmemA, dState, head, acked>> => J_RelHoldS'
BY DEF J_RelHoldS, InSyncR
LEMMA ZZ_FFreshS2 == I_FreshS2 /\ UNCHANGED <<dState, rmemA, sPres, nextSeq, conf, sCon, cutAck>> => I_FreshS2'
BY DEF I_FreshS2, InSyncR
LEMMA ZZ_FLegalS2 == I_LegalS2 /\ UNCHANGED <<head, sPres, sCon, ackedEver, pend, zpost>> => I_LegalS2'
BY DEF I_LegalS2, LegalV2, PendVal
LEMMA ZZ_FSnapPend == I_SnapPend /\ UNCHANGED <<sPres, sCon, pend>> => I_SnapPend' BY DEF I_SnapPend
LEMMA ZZ_FZxIdle == J_ZxIdle /\ UNCHANGED <<zx, dState, sb, reverted, stamp, zseq>> => J_ZxIdle' BY DEF J_ZxIdle
LEMMA ZZ_FSeqLe == J_SeqLe /\ UNCHANGED <<stamp, nseq, sole, zseq>> => J_SeqLe' BY DEF J_SeqLe
LEMMA ZZ_FSoleRel == J_SoleRel /\ UNCHANGED <<sole, nseq, rmemA, asize>> => J_SoleRel' BY DEF J_SoleRel
LEMMA ZZ_FGenTop == J_GenTop /\ UNCHANGED <<attached, dState, stamp, sole, agen, due, members>> => J_GenTop'
BY DEF J_GenTop, View, Valid, Majority, SolePairs, InSyncR
LEMMA ZZ_FZLive ==
  J_ZLive /\ UNCHANGED <<zx, dState, attached, rmemA, zseq, nseq, zsize, asize, zgen, agen, zrgen, rgenA, zrmem>>
  => J_ZLive'
BY DEF J_ZLive
LEMMA ZZ_FRelLe == J_RelLe /\ UNCHANGED <<rgenA, agen>> => J_RelLe' BY DEF J_RelLe
LEMMA ZZ_FWHiC == I_WHiC /\ UNCHANGED <<acked, cutAck, sPres, sCon>> => I_WHiC' BY DEF I_WHiC, AckW
LEMMA ZZ_FHeadLoC == I_HeadLoC /\ UNCHANGED <<acked, cutAck, sPres, sCon, dState, reverted, mark, head>> => I_HeadLoC'
BY DEF I_HeadLoC, AckW, CatchingUp, HiOf
LEMMA ZZ_FHeadLoA == I_HeadLoA /\ UNCHANGED <<acked, sPres, sCon, dState, reverted, mark, head>> => I_HeadLoA'
BY DEF I_HeadLoA, CatchingUp, HiOf
LEMMA ZZ_FStandbyLegal == I_StandbyLegal /\ UNCHANGED <<dState, head, ackedEver, pend>> => I_StandbyLegal'
BY DEF I_StandbyLegal, PendVal
LEMMA ZZ_FHeadHiC == I_HeadHiC /\ UNCHANGED <<acked, cutAck, sPres, dState, reverted, mark, head>> => I_HeadHiC'
BY DEF I_HeadHiC, AckW, CatchingUp, HiOf
LEMMA ZZ_FSnapLegal == I_SnapLegal /\ UNCHANGED <<sPres, sCon, ackedEver, pend>> => I_SnapLegal'
BY DEF I_SnapLegal, PendVal
LEMMA ZZ_FPendTop == I_PendTop /\ UNCHANGED <<pend, head, sPres, sCon>> => I_PendTop' BY DEF I_PendTop
LEMMA ZZ_FPendNext == I_PendNext /\ UNCHANGED <<pend, nextSeq, sPres>> => I_PendNext' BY DEF I_PendNext
LEMMA ZZ_FValidLegal == I_ValidLegal /\ UNCHANGED <<dState, stamp, sole, head, ackedEver, pend>> => I_ValidLegal'
BY DEF I_ValidLegal, InSyncR, Valid, Majority, SolePairs, PendVal
LEMMA ZZ_FZNoValid == J_ZNoValid /\ UNCHANGED <<zx, zst, dState, stamp, sole>> => J_ZNoValid'
BY DEF J_ZNoValid, Valid, Majority, SolePairs
LEMMA ZZ_FZM0 == J_ZM0 /\ UNCHANGED <<zx, zm0, zsize>> => J_ZM0' BY DEF J_ZM0
LEMMA ZZ_FSoleGen == J_SoleGen /\ UNCHANGED <<sole, nseq, agen>> => J_SoleGen' BY DEF J_SoleGen
LEMMA ZZ_FCutLegal == I_CutLegal /\ UNCHANGED <<cutK, cutTgt, head, ackedEver, pend>> => I_CutLegal'
BY DEF I_CutLegal, PendVal
LEMMA ZZ_FInSyncLegal == I_InSyncLegal /\ UNCHANGED <<attached, dState, head, ackedEver, pend>> => I_InSyncLegal'
BY DEF I_InSyncLegal, InSyncR, PendVal
LEMMA ZZ_FZRel == J_ZRel /\ UNCHANGED <<zx, zm0, zseq, zgen, zsize, zrgen, zrmem, sole, dState>> => J_ZRel'
BY Full DEF J_ZRel, ZombieReleases, Majority, InSyncR
\* the old conjuncts v7 replaces follow from their replacements
LEMMA ZZ_RelHoldOld == J_RelHoldS => J_RelHold BY DEF J_RelHoldS, J_RelHold
LEMMA ZZ_LegalOld == I_LegalS2 => I_LegalS BY DEF I_LegalS2, I_LegalS, LegalV2, LegalV
