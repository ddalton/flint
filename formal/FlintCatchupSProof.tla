  <2>3. I_Chain'
    <3>1. ChainReads(sPres'[r], sPar'[r], sAl'[r], sCon'[r]) BY <2>LE
    <3>2. \A x \in Blocks : x \notin hAl'[r] => head'[r][x] = Up(sPar'[r], sCon'[r], hPar'[r], x)
