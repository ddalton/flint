  <2>2. CatchingUp(q) => nextSeq' \notin sPres[q] BY <1>0, <1>T, <1>k, <1>p DEF I_RangesS
  <2>3. dState[q] = "standby" => mark'[q] = mark[q] BY <1>p
  <2>4. mark[q] \in Nat /\ sb[q] \in Int BY <1>0, <1>T, Groups DEF TyLeg
