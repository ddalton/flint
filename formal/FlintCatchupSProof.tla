    <3>4. f >= nextSeq \/ ~conf[f] BY <3>3, <3>1
    <3>. QED BY <3>3, <3>4, <1>u DEF ZC_V7, I_FreshS2
  <2>5. I_SnapLegal' /\ I_PendTop' BY <1>u, ZC_FSnapLegal, ZC_FPendTop DEF ZC_V7
