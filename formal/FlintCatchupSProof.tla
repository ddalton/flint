------------------------- MODULE FlintCatchupSProof -------------------------
(***************************************************************************)
(* TLAPS proof of the membership stamp (FlintCatchupS rev 17, design doc  *)
(* rev 8 section 12) for every bound, in c27's setting with the consumer  *)
(* crash and the zombie move ON (gate item 2; plan:                       *)
(* FlintCatchupSProof-PLAN.md).  Generated by gen-FlintCatchupSProof.py: *)
(* FlintCatchupT's preamble and type layer (FlintCatchupTProof.tla        *)
(* cf71b06a) with TypeOK -> TypeOKT, Clean -> Full; the stamp's parts     *)
(* after it.  WORK IN PROGRESS: nothing here is cited until a record run. *)
(***************************************************************************)
EXTENDS FlintCatchupSInd, TLAPS, NaturalsInduction, FiniteSetTheorems

\* (the model's own unnamed ASSUMEs, restated so a proof can cite them)
ASSUME Const ==
  /\ MaxVer \in Nat /\ MaxEpoch \in Nat /\ MaxFails \in Nat /\ MaxAsm \in Nat /\ MaxAsm >= 1
  /\ Retain \in Nat /\ Retain >= 1
  /\ Reps \subseteq Nat /\ 0 \notin Reps /\ IsFiniteSet(Reps) /\ Reps # {}

\* c27's setting (the gate's arms): every knob as FlintCatchupX*.cfg sets it
ASSUME Full ==
  /\ Policy = "trust" /\ Capture = FALSE /\ Crash = TRUE /\ ZombieMoves = TRUE
  /\ ZombieWhere = "colocated" /\ RaidFailsAtDrop = TRUE /\ StageOracle = FALSE
  /\ WriteQuorum = 1 /\ AssemblyQuorum = 1 /\ BaseInclusive = TRUE
  /\ CutStampsAll = FALSE /\ PinRetention = TRUE
  /\ Backoff = TRUE /\ CoverageWalk = TRUE /\ MarkGate = TRUE /\ ReadFails = FALSE /\ LocalLegGuard = TRUE
  /\ FenceMark = FALSE /\ CatchupWaitsCut = FALSE /\ AssemblyMark = TRUE /\ StageDefer = TRUE /\ AckAfterMark = FALSE
  /\ Stamp = TRUE /\ RecordUp = TRUE /\ MajorityRead = "count" /\ Decree = TRUE /\ DeferExpires = FALSE
  /\ MonitorSkipsHold = FALSE /\ DecreeGated = TRUE /\ DecreeSparesLast = TRUE /\ RelView = TRUE
  /\ EvenVouch = "decree" /\ TornExcluded = TRUE /\ TornNeverSole = TRUE /\ ZombiePreStampLegal = TRUE
  \* the in-write rule (the user, 10-31: "adopt the in-write rule and the whole mark"), in place of the premise that
  \* the last healthy member never fails; the drain with its stamp (the user, 10-31: "adopt the planned-removal stamp")
  /\ LastFails = TRUE /\ WholeMark = TRUE /\ InWriteGuard = TRUE /\ MonitorGuard = TRUE
  /\ OperatorMark = TRUE /\ DrainStamps = TRUE
  \* the zombie acks only on the continuation confirmed for it alone (rev 17; c33b pz1's four-replica trace)
  /\ ZombieTriple = TRUE

\* S's TypeOK = FlintCatchupT's TypeOK (the T variables) /\ the stamp's
TypeOKT ==
  /\ ver \in Vers
  /\ head \in [R -> [Blocks -> Vers]]
  /\ hAl \in [R -> SUBSET Blocks]
  /\ hPar \in [R -> 0..MaxEpoch]
  /\ sPres \in [R -> SUBSET Epochs]
  /\ sCon \in [R -> [Epochs -> [Blocks -> Vers]]]
  /\ sAl \in [R -> [Epochs -> SUBSET Blocks]]
  /\ sPar \in [R -> [Epochs -> 0..MaxEpoch]]
  /\ anc \in [R -> [Epochs -> SUBSET Epochs]]
  /\ recorded \in SUBSET Epochs
  /\ nextSeq \in 1..(MaxEpoch + 1)
  /\ cutK \in 0..MaxEpoch
  /\ cutTgt \in SUBSET R /\ cutDone \in SUBSET R /\ cutGone \in SUBSET R
  /\ members \in SUBSET R
  /\ attached \in BOOLEAN
  /\ path \in [R -> {"ok", "failing", "out", "back"}]
  /\ dState \in [R -> {"insync", "stale", "standby"}]
  /\ mark \in [R -> 0..MaxEpoch]
  /\ reverted \in [R -> -1..MaxEpoch]
  /\ sb \in [R -> -1..MaxEpoch]
  /\ pin \in [R -> 0..MaxEpoch]
  /\ riskRec \in [R -> 0..NoRisk]
  /\ pend \subseteq Write
  /\ acked \in [Blocks -> Vers]
  /\ fails \in 0..MaxFails
  /\ badAdmit \in BOOLEAN
  /\ used \in [R -> SUBSET R]
  /\ tainted \in [R -> BOOLEAN]
  /\ floor \in [R -> -1..MaxEpoch]
  /\ mustRev \in [R -> BOOLEAN]
  /\ restamp \in [R -> BOOLEAN]
  /\ cfgAt \in [Epochs -> SUBSET R]
  /\ conf \in [Epochs -> BOOLEAN]
  /\ tr \in [R -> SUBSET Epochs]
  /\ htr \in [R -> BOOLEAN]
  /\ zx \in R \cup {0}
  /\ cutAck \in [R -> [Epochs -> [Blocks -> Vers]]]
  /\ badLoss \in BOOLEAN
  /\ ackedEver \in [Blocks -> SUBSET Vers]
TyStampS ==
  /\ stamp \in [R -> StampRec]
  /\ nseq \in 1..MaxAsm /\ aseq \in 1..MaxAsm /\ agen \in 0..(NR + 1) /\ asize \in 0..NR
  /\ rgenA \in 0..(NR + 1) /\ rmemA \in SUBSET R /\ zrgen \in 0..(NR + 1) /\ zrmem \in SUBSET R
  /\ hold \in BOOLEAN /\ due \in BOOLEAN
  /\ sole \subseteq (1..MaxAsm) \X (0..(NR + 1)) \X SUBSET R
  /\ zseq \in 0..MaxAsm /\ zgen \in 0..(NR + 1) /\ zsize \in 0..NR /\ zm0 \in SUBSET R /\ zst \in BOOLEAN
  /\ badAck \in BOOLEAN /\ zAcked \in BOOLEAN /\ zfreed \in R \cup {0}
  /\ zLeg \in R \cup {0} /\ zjv \subseteq Vers /\ zexcl \in BOOLEAN
  /\ postMove \in BOOLEAN /\ legalJ \in [Blocks -> SUBSET Vers] /\ riskTail \in BOOLEAN /\ vouched \in BOOLEAN
  /\ tornMarked \in BOOLEAN /\ tornServed \in BOOLEAN /\ tornBare \in BOOLEAN /\ zpost \subseteq 1..MaxVer

LEMMA TypeOKParts == TypeOK <=> TypeOKT /\ TyStampS
BY DEF TypeOK, TypeOKT, TyStampS

-----------------------------------------------------------------------------
(* FlintCatchupT's preamble and type layer, for the T variables (copied).  *)


\* (S) the stage's assembly lies in the attachable legs, its marks in R
LEMMA AsmSetSub == AsmSet \subseteq Attachable /\ Attachable \subseteq R /\ AsmMarks(AsmSet) \subseteq R
BY Full DEF AsmSet, CleanMem, StampMem, Attachable, InSyncR, AsmMarks, AsmExcl, DecreeSet

\* (S) TyStampS in two groups, as T's: the stamp variables, the ghosts
TyStA ==
  /\ stamp \in [R -> StampRec]
  /\ nseq \in 1..MaxAsm /\ aseq \in 1..MaxAsm /\ agen \in 0..(NR + 1) /\ asize \in 0..NR
  /\ rgenA \in 0..(NR + 1) /\ rmemA \in SUBSET R /\ zrgen \in 0..(NR + 1) /\ zrmem \in SUBSET R
  /\ hold \in BOOLEAN /\ due \in BOOLEAN
  /\ sole \subseteq (1..MaxAsm) \X (0..(NR + 1)) \X SUBSET R
  /\ zseq \in 0..MaxAsm /\ zgen \in 0..(NR + 1) /\ zsize \in 0..NR /\ zm0 \in SUBSET R /\ zst \in BOOLEAN
TyGh ==
  /\ badAck \in BOOLEAN /\ zAcked \in BOOLEAN /\ zfreed \in R \cup {0}
  /\ zLeg \in R \cup {0} /\ zjv \subseteq Vers /\ zexcl \in BOOLEAN
  /\ postMove \in BOOLEAN /\ legalJ \in [Blocks -> SUBSET Vers] /\ riskTail \in BOOLEAN /\ vouched \in BOOLEAN
  /\ tornMarked \in BOOLEAN /\ tornServed \in BOOLEAN /\ tornBare \in BOOLEAN /\ zpost \subseteq 1..MaxVer
LEMMA TyStampSplit == TyStampS <=> TyStA /\ TyGh BY DEF TyStampS, TyStA, TyGh
LEMMA TyStampSplitP == TyStampS' <=> TyStA' /\ TyGh' BY DEF TyStampS, TyStA, TyGh
LEMMA TypeOKPartsP == TypeOK' <=> TypeOKT' /\ TyStampS' BY DEF TypeOK, TypeOKT, TyStampS
\* the stamp groups an action leaves alone carry over
LEMMA C_StA == TyStA /\ UNCHANGED stampVars => TyStA' BY DEF TyStA, stampVars
LEMMA C_Gh == TyGh /\ UNCHANGED sGhost => TyGh' BY DEF TyGh, sGhost
LEMMA C_NoStamp == TyStampS /\ NoStamp => TyStampS' BY TyStampSplit, TyStampSplitP, C_StA, C_Gh DEF NoStamp

LEMMA MinProp ==
  ASSUME NEW T \in SUBSET Nat, T # {}
  PROVE  Min(T) \in T /\ \A u \in T : Min(T) <= u
<1>1. PICK t \in T : TRUE OBVIOUS
<1>2. \E m \in Nat : m \in T /\ \A k \in 0 .. m-1 : k \notin T
  <2>. DEFINE P(n) == n \in T
  <2>. HIDE DEF P
  <2>0. t \in Nat /\ P(t) BY <1>1 DEF P
  <2>1. \E m \in Nat : P(m) /\ \A k \in 0 .. m-1 : ~P(k)
    BY <2>0, SmallestNatural, IsaT(300)
  <2>. QED BY <2>1 DEF P
<1>3. PICK m \in Nat : m \in T /\ \A k \in 0 .. m-1 : k \notin T BY <1>2
<1>4. \A u \in T : m <= u
  <2>. TAKE u \in T
  <2>1. u \in Nat OBVIOUS
  <2>2. ~(u < m) BY <1>3, <2>1
  <2>. QED BY <2>1, <2>2
<1>. QED BY <1>3, <1>4 DEF Min

LEMMA MaxProp ==
  ASSUME NEW N \in Nat, NEW T \in SUBSET (0..N), T # {}
  PROVE  Max(T) \in T /\ \A u \in T : u <= Max(T)
<1>1. \E m \in T : \A u \in T : u <= m
  <2>. DEFINE U == {N - t : t \in T}
  <2>1. U \in SUBSET Nat /\ U # {} OBVIOUS
  <2>2. Min(U) \in U /\ \A u \in U : Min(U) <= u BY <2>1, MinProp
  <2>3. PICK t0 \in T : Min(U) = N - t0 BY <2>2
  <2>. QED BY <2>2, <2>3
<1>. QED BY <1>1 DEF Max

LEMMA Min2 ==
  ASSUME NEW a \in Nat, NEW b \in Nat
  PROVE  Min({a, b}) \in {a, b} /\ Min({a, b}) <= a /\ Min({a, b}) <= b
BY MinProp

LEMMA NoRiskNat == NoRisk \in Nat /\ NoRisk = MaxEpoch + 1
BY Const DEF NoRisk

LEMMA RNat == R \subseteq Nat /\ 0 \notin R /\ IsFiniteSet(R)
BY Const DEF R

\* With one landing enough to ack and one leg enough to stage, the quorum
\* never binds.
LEMMA QuorumTrue == QuorumOK
BY Full DEF QuorumOK

LEMMA OneLanding ==
  ASSUME NEW S \in SUBSET R
  PROVE  (Cardinality(S) >= WriteQuorum) <=> S # {}
<1>1. IsFiniteSet(S) BY RNat, FS_Subset
<1>2. Cardinality(S) \in Nat BY <1>1, FS_CardinalityType
<1>3. Cardinality(S) = 0 <=> S = {} BY <1>1, FS_EmptySet
<1>. QED BY <1>2, <1>3, Full

-----------------------------------------------------------------------------
(* TypeOKT, in groups: one obligation over all of TypeOKT times z3 out.      *)

TyScalar ==
  /\ ver \in Vers /\ nextSeq \in 1..(MaxEpoch + 1) /\ cutK \in 0..MaxEpoch
  /\ attached \in BOOLEAN /\ fails \in 0..MaxFails
  /\ badAdmit \in BOOLEAN /\ badLoss \in BOOLEAN /\ zx \in R \cup {0}
TySets ==
  /\ recorded \in SUBSET Epochs /\ cutTgt \in SUBSET R /\ cutDone \in SUBSET R
  /\ cutGone \in SUBSET R /\ members \in SUBSET R
TyLeg ==
  /\ path \in [R -> {"ok", "failing", "out", "back"}]
  /\ dState \in [R -> {"insync", "stale", "standby"}]
  /\ mark \in [R -> 0..MaxEpoch] /\ reverted \in [R -> -1..MaxEpoch]
  /\ sb \in [R -> -1..MaxEpoch] /\ pin \in [R -> 0..MaxEpoch]
  /\ riskRec \in [R -> 0..NoRisk] /\ restamp \in [R -> BOOLEAN]
TyHead ==
  /\ head \in [R -> [Blocks -> Vers]] /\ hAl \in [R -> SUBSET Blocks]
  /\ hPar \in [R -> 0..MaxEpoch]
TySnap ==
  /\ sPres \in [R -> SUBSET Epochs]
  /\ sCon \in [R -> [Epochs -> [Blocks -> Vers]]]
  /\ sAl \in [R -> [Epochs -> SUBSET Blocks]]
  /\ sPar \in [R -> [Epochs -> 0..MaxEpoch]]
  /\ anc \in [R -> [Epochs -> SUBSET Epochs]]
TyPend ==
  /\ pend \subseteq Write /\ acked \in [Blocks -> Vers]
  /\ ackedEver \in [Blocks -> SUBSET Vers]
TyTie ==
  /\ used \in [R -> SUBSET R] /\ tainted \in [R -> BOOLEAN]
  /\ floor \in [R -> -1..MaxEpoch] /\ mustRev \in [R -> BOOLEAN]
TyTrust ==
  /\ cfgAt \in [Epochs -> SUBSET R] /\ conf \in [Epochs -> BOOLEAN]
  /\ tr \in [R -> SUBSET Epochs] /\ htr \in [R -> BOOLEAN]
  /\ cutAck \in [R -> [Epochs -> [Blocks -> Vers]]]

Ty == TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust

LEMMA TypeOKSplit == TypeOKT <=> Ty
BY DEF TypeOKT, Ty, TyScalar, TySets, TyLeg, TyHead, TySnap, TyPend, TyTie, TyTrust
LEMMA TypeOKSplitP == TypeOKT' <=> Ty'
BY DEF TypeOKT, Ty, TyScalar, TySets, TyLeg, TyHead, TySnap, TyPend, TyTie, TyTrust
LEMMA Groups == TypeOKT => TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust
BY TypeOKSplit DEF Ty
LEMMA GroupsP ==
  TyScalar' /\ TySets' /\ TyLeg' /\ TyHead' /\ TySnap' /\ TyPend' /\ TyTie' /\ TyTrust' => TypeOKT'
BY TypeOKSplitP DEF Ty

\* A group an action leaves alone carries over.
LEMMA C_Scalar == TyScalar /\ UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>> => TyScalar'
BY DEF TyScalar
LEMMA C_Sets == TySets /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>> => TySets'
BY DEF TySets
LEMMA C_Leg == TyLeg /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>> => TyLeg'
BY DEF TyLeg
LEMMA C_Head == TyHead /\ UNCHANGED <<head, hAl, hPar>> => TyHead'
BY DEF TyHead
LEMMA C_Snap == TySnap /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>> => TySnap'
BY DEF TySnap
LEMMA C_Pend == TyPend /\ UNCHANGED <<pend, acked, ackedEver>> => TyPend'
BY DEF TyPend
LEMMA C_Tie == TyTie /\ UNCHANGED tieVars => TyTie'
BY DEF TyTie, tieVars
LEMMA C_Trust == TyTrust /\ UNCHANGED trustVars => TyTrust'
BY DEF TyTrust, trustVars

LEMMA T_Init == Init => TypeOKT
<1>. SUFFICES ASSUME Init PROVE Ty BY TypeOKSplit
<1>1. TyScalar BY Const DEF Init, TyScalar, Vers
<1>2. TySets BY DEF Init, TySets
<1>3. TyLeg BY Const, NoRiskNat DEF Init, TyLeg
<1>4. TyHead BY Const DEF Init, TyHead, Zero, Vers
<1>5. TySnap BY Const DEF Init, TySnap, Zero, Vers, Epochs
<1>6. TyPend BY Const DEF Init, TyPend, Zero, Vers
<1>7. TyTie BY Const DEF Init, TyTie
<1>8. TyTrust BY Const DEF Init, TyTrust, Zero, Vers
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>7, <1>8 DEF Ty

\* The record's view of legs going stale keeps the leg and tie groups.
LEMMA T_StaleMarks ==
  ASSUME TyLeg, TyTie, NEW M, StaleMarks(M),
         UNCHANGED <<path, mark, reverted, sb, pin, riskRec, used, mustRev>>
  PROVE  TyLeg' /\ TyTie'
<1>1. UNCHANGED <<tainted, floor>> BY Full DEF StaleMarks
<1>2. dState' \in [R -> {"insync", "stale", "standby"}] /\ restamp' \in [R -> BOOLEAN]
  BY DEF StaleMarks, TyLeg
<1>3. TyLeg' BY <1>2 DEF TyLeg
<1>4. TyTie' BY <1>1 DEF TyTie
<1>. QED BY <1>3, <1>4

LEMMA LatestType == ASSUME TyScalar PROVE Latest \in 0..MaxEpoch
BY Const DEF TyScalar, Latest

\* The memberships and number types a step leans on.
LEMMA Basics ==
  ASSUME TypeOKT
  PROVE  /\ members \subseteq R /\ InSyncR \subseteq R /\ Healthy \subseteq R /\ Bases \subseteq R
         /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
         /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
         /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
         /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                         /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                         /\ sb[q] \in Int /\ reverted[q] \in Int
<1>1. members \subseteq R /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs
  BY DEF TypeOKT
<1>2. InSyncR \subseteq R /\ Healthy \subseteq R BY <1>1 DEF InSyncR, Healthy
<1>3. Bases \subseteq R BY <1>1, <1>2 DEF Bases
<1>4. Epochs \subseteq Nat /\ R \subseteq Nat /\ MaxEpoch \in Nat BY Const, RNat DEF Epochs
<1>5. nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat BY Const DEF TypeOKT, Vers
<1>6. \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                   /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                   /\ sb[q] \in Int /\ reverted[q] \in Int
  <2>. SUFFICES ASSUME NEW q \in R
               PROVE  /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
    OBVIOUS
  <2>1. sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs BY DEF TypeOKT
  <2>2. hPar[q] \in 0..MaxEpoch /\ mark[q] \in 0..MaxEpoch /\ pin[q] \in 0..MaxEpoch BY DEF TypeOKT
  <2>3. sb[q] \in -1..MaxEpoch /\ reverted[q] \in -1..MaxEpoch BY DEF TypeOKT
  <2>. QED BY <2>1, <2>2, <2>3, Const
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6

\* The numbers a step compares.
LEMMA Nats ==
  ASSUME TypeOKT
  PROVE  /\ ver \in Nat /\ nextSeq \in Nat /\ cutK \in Nat
         /\ \A x \in Blocks : acked[x] \in Nat /\ ackedEver[x] \subseteq Nat
         /\ \A q \in R : \A x \in Blocks : head[q][x] \in Nat
         /\ \A q \in R : \A e \in Epochs : \A x \in Blocks : sCon[q][e][x] \in Nat /\ cutAck[q][e][x] \in Nat
         /\ \A w \in pend : /\ w.b \in Blocks /\ w.v \in Nat /\ w.v >= 1 /\ w.cutAt \in Nat
                            /\ w.to \subseteq R /\ w.landed \subseteq R /\ w.dropped \subseteq R
BY Const DEF TypeOKT, TyScalar, TyHead, TySnap, TyPend, TyTrust, Vers, Write

LEMMA T_Submit ==
  ASSUME TypeOKT, NEW x \in Blocks, Submit(x) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. Latest \in 0..MaxEpoch BY <1>0, LatestType
<1>u. UNCHANGED <<nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<acked, ackedEver>> /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF Submit
<1>1. TyScalar' BY <1>0, <1>u, Const DEF Submit, TyScalar, Vers
<1>2. TyLeg'
  <2>1. riskRec' \in [R -> 0..NoRisk]
    <3>. SUFFICES ASSUME NEW r \in R PROVE riskRec'[r] \in 0..NoRisk BY DEF Submit
    <3>1. riskRec[r] \in 0..NoRisk BY <1>0 DEF TyLeg
    <3>2. riskRec[r] \in Nat /\ Latest \in Nat BY <3>1, <1>a, NoRiskNat
    <3>3. Min({riskRec[r], Latest}) \in {riskRec[r], Latest} BY <3>2, Min2
    <3>4. Latest \in 0..NoRisk BY <1>a, NoRiskNat, Const
    <3>5. Min({riskRec[r], Latest}) \in 0..NoRisk BY <3>1, <3>3, <3>4
    <3>6. riskRec'[r] = IF r \in members THEN riskRec[r] ELSE Min({riskRec[r], Latest}) BY DEF Submit
    <3>. QED BY <3>1, <3>5, <3>6
  <2>. QED BY <1>0, <1>u, <2>1 DEF TyLeg
<1>3. TyPend'
  <2>1. ver + 1 \in 1..MaxVer BY <1>0, Const DEF Submit, TyScalar, Vers
  <2>2. nextSeq \in 1..(MaxEpoch + 1) BY <1>0 DEF TyScalar
  <2>3. members \in SUBSET R BY <1>0 DEF TySets
  <2>4. [b |-> x, v |-> ver + 1, to |-> members, landed |-> {}, dropped |-> {},
         recAt |-> Latest, cutAt |-> nextSeq] \in Write
    BY <1>a, <2>1, <2>2, <2>3 DEF Write
  <2>. QED BY <1>0, <1>u, <2>4 DEF Submit, TyPend
<1>. QED BY <1>0, <1>u, <1>1, <1>2, <1>3, C_Sets, C_Head, C_Snap, C_Tie, C_Trust, GroupsP

LEMMA T_Land ==
  ASSUME TypeOKT, NEW w \in pend, NEW r \in R, Land(w, r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. w \in Write BY <1>0 DEF TyPend
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF Land
<1>1. TyHead' BY <1>0, <1>a DEF Land, TyHead, Write, Vers
<1>2. TyPend' BY <1>0, <1>a DEF Land, TyPend, Write
<1>. QED BY <1>0, <1>u, <1>1, <1>2, C_Scalar, C_Sets, C_Leg, C_Snap, C_Tie, C_Trust, GroupsP

LEMMA T_Drop ==
  ASSUME TypeOKT, NEW w \in pend, NEW r \in R, Drop(w, r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. w \in Write BY <1>0 DEF TyPend
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<acked, ackedEver>>
      /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF Drop
<1>1. TyLeg'
  <2>1. riskRec[r] \in 0..NoRisk BY <1>0 DEF TyLeg
  <2>2. riskRec[r] \in Nat /\ w.recAt \in Nat /\ w.recAt <= MaxEpoch
    BY <2>1, <1>a, Const, NoRiskNat DEF Write
  <2>3. Min({riskRec[r], w.recAt}) \in {riskRec[r], w.recAt} BY <2>2, Min2
  <2>5. Min({riskRec[r], w.recAt}) \in 0..NoRisk BY <2>1, <2>2, <2>3, NoRiskNat, Const
  <2>6. riskRec' = [riskRec EXCEPT ![r] = Min({riskRec[r], w.recAt})] BY DEF Drop
  <2>4. riskRec' \in [R -> 0..NoRisk] BY <1>0, <2>5, <2>6 DEF TyLeg
  <2>. QED BY <1>0, <1>u, <2>4 DEF TyLeg
<1>2. TySets' BY <1>0, Full DEF Drop, TySets
<1>3. TyPend' BY <1>0, <1>a DEF Drop, TyPend, Write
<1>. QED BY <1>0, <1>u, <1>1, <1>2, <1>3, C_Scalar, C_Head, C_Snap, C_Tie, C_Trust, GroupsP

LEMMA T_Complete ==
  ASSUME TypeOKT, NEW w \in pend, Complete(w) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. w \in Write BY <1>0 DEF TyPend
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF Complete
<1>1. TyPend' BY <1>0, <1>a DEF Complete, TyPend, Write, Vers
<1>. QED BY <1>0, <1>u, <1>1, C_Scalar, C_Sets, C_Leg, C_Head, C_Snap, C_Tie, C_Trust, GroupsP

\* Path and the monitor: FailBegin, FaultOut, MarkStale, Return.
LEMMA T_Path ==
  ASSUME TypeOKT, NEW r \in R, FailBegin(r) \/ FaultOut(r) \/ MarkStale(r) \/ Return(r)
  PROVE  TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>u. /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED trustVars
  BY DEF FailBegin, FaultOut, MarkStale, Return, trustVars
<1>s. TyScalar' /\ TySets' /\ TyLeg' /\ TyTie'
  <2>1. CASE FailBegin(r)
    <3>1. UNCHANGED <<ver, nextSeq, cutK, attached, badAdmit, badLoss, zx>>
          /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
          /\ UNCHANGED <<dState, mark, reverted, sb, pin, riskRec, restamp>> /\ UNCHANGED tieVars
      BY <2>1 DEF FailBegin
    <3>2. fails' \in 0..MaxFails BY <1>0, <2>1, Const DEF FailBegin, TyScalar
    <3>3. path' \in [R -> {"ok", "failing", "out", "back"}] BY <1>0, <2>1 DEF FailBegin, TyLeg
    <3>. QED BY <1>0, <3>1, <3>2, <3>3, C_Sets, C_Tie DEF TyScalar, TyLeg
  <2>2. CASE FaultOut(r)
    <3>1. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
          /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone>>
          /\ UNCHANGED <<dState, mark, reverted, sb, pin, riskRec, restamp>> /\ UNCHANGED tieVars
      BY <2>2 DEF FaultOut
    <3>2. members' \in SUBSET R BY <1>0, <2>2 DEF FaultOut, TySets
    <3>3. path' \in [R -> {"ok", "failing", "out", "back"}] BY <1>0, <2>2 DEF FaultOut, TyLeg
    <3>. QED BY <1>0, <3>1, <3>2, <3>3, C_Scalar, C_Tie DEF TySets, TyLeg
  <2>3. CASE MarkStale(r)
    <3>1. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
          /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
          /\ UNCHANGED <<path, mark, reverted, sb, pin, riskRec, used, mustRev>>
          /\ StaleMarks(IF WholeMark THEN {q \in InSyncR : q \notin members} ELSE {r})
      BY <2>3 DEF MarkStale
    <3>2. TyLeg' /\ TyTie' BY <1>0, <3>1, T_StaleMarks
    <3>. QED BY <1>0, <3>1, <3>2, C_Scalar, C_Sets
  <2>4. CASE Return(r)
    <3>1. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
          /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
          /\ UNCHANGED <<dState, mark, reverted, sb, pin, riskRec, restamp>> /\ UNCHANGED tieVars
      BY <2>4 DEF Return
    <3>3. path' \in [R -> {"ok", "failing", "out", "back"}] BY <1>0, <2>4 DEF Return, TyLeg
    <3>. QED BY <1>0, <3>1, <3>3, C_Scalar, C_Sets, C_Tie DEF TyLeg
  <2>. QED BY <2>1, <2>2, <2>3, <2>4
<1>. QED BY <1>0, <1>u, <1>s, C_Head, C_Snap, C_Pend, C_Trust, GroupsP

LEMMA T_Observe ==
  ASSUME TypeOKT, NEW e \in Epochs, Observe(e) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars
      /\ UNCHANGED <<cfgAt, htr, cutAck>>
  BY DEF Observe
<1>1. TyTrust' BY <1>0, <1>u DEF Observe, TyTrust
<1>. QED BY <1>0, <1>u, <1>1, C_Scalar, C_Sets, C_Leg, C_Head, C_Snap, C_Pend, C_Tie, GroupsP

\* The scheduler's small steps.
LEMMA T_CutSmall ==
  ASSUME TypeOKT, cutK # 0 => cutK = nextSeq,
         CutBegin \/ CutRecord \/ CutAbort \/ CutAbortRead \/ Retire
  PROVE  TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>u. /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars
  BY DEF CutBegin, CutRecord, CutAbort, CutAbortRead, Retire
<1>s. TyScalar' /\ TySets' /\ TyLeg' /\ TyTrust'
  <2>1. CASE CutBegin
    <3>1. UNCHANGED <<ver, nextSeq, attached, fails, badAdmit, badLoss, zx>>
          /\ UNCHANGED <<recorded, members>>
          /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
          /\ UNCHANGED trustVars
      BY <2>1 DEF CutBegin
    <3>2. cutK' \in 0..MaxEpoch BY <1>0, <2>1 DEF CutBegin, TyScalar
    <3>3. cutTgt' \in SUBSET R /\ cutDone' \in SUBSET R /\ cutGone' \in SUBSET R
      BY <2>1 DEF CutBegin, InSyncR
    <3>. QED BY <1>0, <3>1, <3>2, <3>3, C_Leg, C_Trust DEF TyScalar, TySets
  <2>2. CASE CutRecord
    <3>1. cutK \in Epochs /\ nextSeq = cutK BY <1>0, <2>2, Const DEF CutRecord, TyScalar, Epochs
    <3>2. UNCHANGED <<ver, attached, fails, badAdmit, badLoss, zx>> /\ UNCHANGED members
          /\ UNCHANGED <<path, dState, reverted, sb, pin, riskRec, restamp>>
          /\ UNCHANGED <<tr, htr, cutAck>>
      BY <2>2 DEF CutRecord
    <3>a. /\ recorded' = recorded \cup {cutK} /\ nextSeq' = nextSeq + 1
          /\ cutK' = 0 /\ cutTgt' = {} /\ cutDone' = {} /\ cutGone' = {}
          /\ mark' = [q \in R |-> IF q \in cutTgt /\ (CutStampsAll \/ dState[q] = "insync")
                                  THEN cutK ELSE mark[q]]
          /\ cfgAt' = [cfgAt EXCEPT ![cutK] = cutTgt \cap members]
          /\ conf' = [conf EXCEPT ![cutK] = FALSE]
      BY <2>2, Full DEF CutRecord
    <3>3. TyScalar'
      <4>1. nextSeq' \in 1..(MaxEpoch + 1) /\ cutK' \in 0..MaxEpoch BY <3>1, <3>a, Const DEF Epochs
      <4>. QED BY <1>0, <3>2, <4>1 DEF TyScalar
    <3>4. TySets' BY <1>0, <3>1, <3>2, <3>a DEF TySets
    <3>5. mark' \in [R -> 0..MaxEpoch] BY <1>0, <3>1, <3>a DEF TyLeg, Epochs
    <3>6. TyLeg' BY <1>0, <3>2, <3>5 DEF TyLeg
    <3>7. TyTrust'
      <4>1. cfgAt' \in [Epochs -> SUBSET R] BY <1>0, <3>1, <3>a DEF TyTrust, TySets
      <4>2. conf' \in [Epochs -> BOOLEAN] BY <1>0, <3>1, <3>a DEF TyTrust
      <4>. QED BY <1>0, <3>2, <4>1, <4>2 DEF TyTrust
    <3>. QED BY <3>3, <3>4, <3>6, <3>7
  <2>3. CASE CutAbort \/ CutAbortRead
    <3>1. UNCHANGED <<ver, nextSeq, attached, fails, badAdmit, badLoss, zx>>
          /\ UNCHANGED <<recorded, members>>
          /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
          /\ UNCHANGED trustVars
          /\ cutK' = 0 /\ cutTgt' = {} /\ cutDone' = {} /\ cutGone' = {}
      BY <2>3 DEF CutAbort, CutAbortRead
    <3>2. TyScalar' /\ TySets' BY <1>0, <3>1, Const DEF TyScalar, TySets
    <3>. QED BY <1>0, <3>1, <3>2, C_Leg, C_Trust
  <2>4. CASE Retire
    <3>1. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
          /\ UNCHANGED <<cutTgt, cutDone, cutGone, members>>
          /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
          /\ UNCHANGED trustVars
      BY <2>4 DEF Retire
    <3>2. recorded' \in SUBSET Epochs BY <1>0, <2>4 DEF Retire, TySets
    <3>. QED BY <1>0, <3>1, <3>2, C_Scalar, C_Leg, C_Trust DEF TySets
  <2>. QED BY <2>1, <2>2, <2>3, <2>4
<1>. QED BY <1>0, <1>u, <1>s, C_Head, C_Snap, C_Pend, C_Tie, GroupsP

\* A snapshot cut from r's head: its ancestor set is epochs.
LEMMA NewAncType ==
  ASSUME TyHead, TySnap, NEW r \in R, NEW e \in Epochs
  PROVE  NewAnc(r, e) \in SUBSET Epochs
<1>1. hPar[r] \in 0..MaxEpoch BY DEF TyHead
<1>2. hPar[r] # 0 => hPar[r] \in Epochs BY <1>1, Const DEF Epochs
<1>3. AncOf(r, hPar[r]) \in SUBSET Epochs BY <1>2 DEF AncOf, TySnap
<1>. QED BY <1>3 DEF NewAnc

LEMMA T_CutOne ==
  ASSUME TypeOKT, NEW r \in R, CutOne(r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. cutK \in Epochs BY <1>0, Const DEF CutOne, TyScalar, Epochs
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED head /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars
      /\ UNCHANGED <<cfgAt, conf, htr>>
  BY DEF CutOne
<1>1. TySets' BY <1>0, <1>u DEF CutOne, TySets
<1>2. TyTrust' BY <1>0, <1>a, <1>u DEF CutOne, TyTrust, TyPend
<1>3. TyHead' /\ TySnap'
  <2>1. CASE cutK \in sPres[r]
    <3>1. UNCHANGED <<hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>> BY <2>1 DEF CutOne
    <3>. QED BY <1>0, <1>u, <3>1, C_Head, C_Snap
  <2>2. CASE cutK \notin sPres[r]
    <3>1. NewAnc(r, cutK) \in SUBSET Epochs BY <1>0, <1>a, NewAncType
    <3>a. /\ sPres' = [sPres EXCEPT ![r] = @ \cup {cutK}]
          /\ sCon' = [sCon EXCEPT ![r][cutK] = head[r]]
          /\ sAl' = [sAl EXCEPT ![r][cutK] = hAl[r]]
          /\ sPar' = [sPar EXCEPT ![r][cutK] = hPar[r]]
          /\ anc' = [anc EXCEPT ![r][cutK] = NewAnc(r, cutK)]
          /\ hPar' = [hPar EXCEPT ![r] = cutK]
          /\ hAl' = [hAl EXCEPT ![r] = {}]
      BY <2>2 DEF CutOne
    <3>2. TyHead' BY <1>0, <1>a, <1>u, <3>a DEF TyHead, Epochs
    <3>3. sPres' \in [R -> SUBSET Epochs] BY <1>0, <1>a, <3>a DEF TySnap
    <3>4. sCon' \in [R -> [Epochs -> [Blocks -> Vers]]] BY <1>0, <1>a, <3>a DEF TySnap, TyHead
    <3>5. sAl' \in [R -> [Epochs -> SUBSET Blocks]] BY <1>0, <1>a, <3>a DEF TySnap, TyHead
    <3>6. sPar' \in [R -> [Epochs -> 0..MaxEpoch]] BY <1>0, <1>a, <3>a DEF TySnap, TyHead
    <3>7. anc' \in [R -> [Epochs -> SUBSET Epochs]] BY <1>0, <1>a, <3>1, <3>a DEF TySnap
    <3>. QED BY <3>2, <3>3, <3>4, <3>5, <3>6, <3>7 DEF TySnap
  <2>. QED BY <2>1, <2>2
<1>. QED BY <1>0, <1>u, <1>1, <1>2, <1>3, C_Scalar, C_Leg, C_Pend, C_Tie, GroupsP

LEMMA T_GC ==
  ASSUME TypeOKT, NEW r \in R, NEW e \in Epochs, GC(r, e) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, sCon>> /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars
      /\ UNCHANGED <<cfgAt, conf, htr>>
  BY DEF GC
<1>g. /\ sPres' = [sPres EXCEPT ![r] = @ \ {e}]
      /\ anc' = [anc EXCEPT ![r] = [c \in Epochs |-> IF c = e THEN {} ELSE anc[r][c] \ {e}]]
      /\ \/ /\ hAl' = [hAl EXCEPT ![r] = @ \cup sAl[r][e]]
            /\ hPar' = [hPar EXCEPT ![r] = sPar[r][e]]
            /\ UNCHANGED <<sAl, sPar>>
         \/ /\ sAl' = [sAl EXCEPT ![r] = [c \in Epochs |->
                         IF c \in Children(r, e) THEN sAl[r][c] \cup sAl[r][e] ELSE sAl[r][c]]]
            /\ sPar' = [sPar EXCEPT ![r] = [c \in Epochs |->
                         IF c \in Children(r, e) THEN sPar[r][e] ELSE sPar[r][c]]]
            /\ UNCHANGED <<hAl, hPar>>
  BY DEF GC
<1>1. TyHead' BY <1>0, <1>u, <1>g DEF TyHead, TySnap, Epochs
<1>2. TySnap'
  <2>1. sPres' \in [R -> SUBSET Epochs] BY <1>0, <1>g DEF TySnap
  <2>2. anc' \in [R -> [Epochs -> SUBSET Epochs]] BY <1>0, <1>g DEF TySnap
  <2>3. sAl' \in [R -> [Epochs -> SUBSET Blocks]] /\ sPar' \in [R -> [Epochs -> 0..MaxEpoch]]
    BY <1>0, <1>g DEF TySnap
  <2>. QED BY <1>0, <1>u, <2>1, <2>2, <2>3 DEF TySnap
<1>3. TyTrust' BY <1>0, <1>u, Const DEF GC, TyTrust, Zero, Vers
<1>. QED BY <1>0, <1>u, <1>1, <1>2, <1>3, C_Scalar, C_Sets, C_Leg, C_Pend, C_Tie, GroupsP

LEMMA T_SelectBase ==
  ASSUME TypeOKT, NEW r \in R, SelectBase(r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. recorded # {} => Min(recorded) \in recorded
  BY <1>0, MinProp DEF TySets, Epochs
<1>b. BaseCandidates(r) \subseteq Epochs BY <1>0 DEF BaseCandidates, TySets
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF SelectBase
<1>1. TyLeg'
  <2>1. sb'[r] \in 0..MaxEpoch /\ sb' = [sb EXCEPT ![r] = sb'[r]]
    BY <1>0, <1>b, Const DEF SelectBase, TyLeg, Epochs
  <2>2. sb' \in [R -> -1..MaxEpoch] BY <1>0, <2>1 DEF TyLeg
  <2>3. reverted' \in [R -> -1..MaxEpoch] BY <1>0 DEF SelectBase, TyLeg
  <2>4. pin' \in [R -> 0..MaxEpoch] BY <1>0, <1>a, <2>1 DEF SelectBase, TyLeg, TySets, Epochs
  <2>. QED BY <1>0, <1>u, <2>2, <2>3, <2>4 DEF TyLeg
<1>. QED BY <1>0, <1>u, <1>1, C_Scalar, C_Sets, C_Head, C_Snap, C_Pend, C_Tie, C_Trust, GroupsP

LEMMA T_SessionFail ==
  ASSUME TypeOKT, NEW r \in R, SessionFail(r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF SessionFail
<1>1. TyLeg' BY <1>0, <1>u, Const DEF SessionFail, TyLeg
<1>. QED BY <1>0, <1>u, <1>1, C_Scalar, C_Sets, C_Head, C_Snap, C_Pend, C_Tie, C_Trust, GroupsP

LEMMA T_RevertD ==
  ASSUME TypeOKT, NEW r \in R, RevertD(r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. sb[r] \in 0..MaxEpoch BY <1>0 DEF RevertD, TyLeg
<1>b. (IF sb[r] = 0 THEN Zero ELSE sCon[r][sb[r]]) \in [Blocks -> Vers]
  <2>1. CASE sb[r] = 0 BY <2>1, Const DEF Zero, Vers
  <2>2. CASE sb[r] # 0 BY <1>0, <1>a, <2>2, Const DEF TySnap, Epochs
  <2>. QED BY <2>1, <2>2
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, members>>
      /\ UNCHANGED <<path, dState, mark, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<sCon, sAl, sPar>> /\ UNCHANGED <<pend, acked, ackedEver>>
      /\ UNCHANGED tieVars /\ UNCHANGED <<cfgAt, conf, htr>>
  BY Full DEF RevertD
<1>1. TySets' BY <1>0, <1>u DEF RevertD, TySets
<1>2. TyLeg' BY <1>0, <1>a, <1>u DEF RevertD, TyLeg
<1>3. TyHead' BY <1>0, <1>a, <1>b DEF RevertD, TyHead
<1>4. TySnap' BY <1>0, <1>u DEF RevertD, TySnap, Epochs
<1>5. TyTrust' BY <1>0, <1>u, Const DEF RevertD, TyTrust, Zero, Vers
<1>. QED BY <1>0, <1>u, <1>1, <1>2, <1>3, <1>4, <1>5, C_Scalar, C_Pend, C_Tie, GroupsP

\* A copy's result is a head.
LEMMA AfterCopyType ==
  ASSUME TySnap, NEW start \in [Blocks -> Vers], NEW s \in R, NEW lo \in Int,
         NEW target \in Int, Lin(s) \subseteq Epochs
  PROVE  AfterCopy(start, s, lo, target) \in [Blocks -> Vers]
<1>. SUFFICES ASSUME NEW x \in Blocks,
                    {e \in CopyElems(s, lo, target) : x \in sAl[s][e]} # {}
             PROVE  sCon[s][Max({e \in CopyElems(s, lo, target) : x \in sAl[s][e]})][x] \in Vers
  BY DEF AfterCopy
<1>. DEFINE H == {e \in CopyElems(s, lo, target) : x \in sAl[s][e]}
<1>1. H \in SUBSET (0..MaxEpoch) BY Const DEF CopyElems, Epochs
<1>2. Max(H) \in H BY <1>1, Const, MaxProp
<1>3. Max(H) \in Epochs BY <1>2 DEF CopyElems
<1>. QED BY <1>3 DEF TySnap

LEMMA LinType == ASSUME TyHead, TySnap, NEW s \in R PROVE Lin(s) \subseteq Epochs
<1>1. hPar[s] \in 0..MaxEpoch BY DEF TyHead
<1>2. hPar[s] # 0 => hPar[s] \in Epochs BY <1>1, Const DEF Epochs
<1>. QED BY <1>2 DEF Lin, AncOf, TySnap

LEMMA T_CopyAlign ==
  ASSUME TyHead, TySnap, TyTrust, NEW r \in R, NEW s \in R,
         NEW from \in 0..MaxEpoch, NEW target \in Epochs, CopyAlign(r, s, from, target),
         UNCHANGED <<cfgAt, conf, htr>>
  PROVE  TyHead' /\ TySnap' /\ TyTrust'
<1>. DEFINE lo == IF BaseInclusive \/ from = 0 THEN from ELSE from + 1
<1>0. head[r] \in [Blocks -> Vers] /\ lo \in Int /\ target \in Int BY Const DEF TyHead, Epochs
<1>1. AfterCopy(head[r], s, lo, target) \in [Blocks -> Vers]
  BY <1>0, AfterCopyType, LinType
<1>2. hAl[r] \cup Copied(s, lo, target) \subseteq Blocks BY DEF Copied, TyHead
<1>3. TyHead' BY <1>1, <1>2 DEF CopyAlign, TyHead, Epochs
<1>4. CASE from = target \/ target \in sPres[r]
  <2>. QED BY <1>3, <1>4 DEF CopyAlign, TySnap, TyTrust
<1>5. CASE ~(from = target \/ target \in sPres[r])
  <2>1. NewAnc(r, target) \in SUBSET Epochs BY NewAncType
  <2>a. /\ sPres' = [sPres EXCEPT ![r] = @ \cup {target}]
        /\ sCon' = [sCon EXCEPT ![r][target] = AfterCopy(head[r], s, lo, target)]
        /\ sAl' = [sAl EXCEPT ![r][target] = hAl[r] \cup Copied(s, lo, target)]
        /\ sPar' = [sPar EXCEPT ![r][target] = hPar[r]]
        /\ anc' = [anc EXCEPT ![r][target] = NewAnc(r, target)]
        /\ tr' = [tr EXCEPT ![r] = @ \cup {target}]
        /\ cutAck' = [cutAck EXCEPT ![r][target] = cutAck[s][target]]
    BY <1>5, Full DEF CopyAlign
  <2>2. TySnap'
    <3>1. sPres' \in [R -> SUBSET Epochs] BY <2>a DEF TySnap
    <3>2. sCon' \in [R -> [Epochs -> [Blocks -> Vers]]] BY <1>1, <2>a DEF TySnap
    <3>3. sAl' \in [R -> [Epochs -> SUBSET Blocks]] BY <1>2, <2>a DEF TySnap
    <3>4. sPar' \in [R -> [Epochs -> 0..MaxEpoch]] BY <2>a DEF TySnap, TyHead
    <3>5. anc' \in [R -> [Epochs -> SUBSET Epochs]] BY <2>1, <2>a DEF TySnap
    <3>. QED BY <3>1, <3>2, <3>3, <3>4, <3>5 DEF TySnap
  <2>3. TyTrust' BY <2>a DEF TyTrust
  <2>. QED BY <1>3, <2>2, <2>3
<1>. QED BY <1>4, <1>5

\* A copy's source is a replica.
LEMMA CoverSetSub ==
  ASSUME NEW r \in R, NEW t, NEW b PROVE CoverSet(r, t, b) \subseteq R
<1>1. Sources(r) \subseteq R BY DEF Sources
<1>2. Sources(r) # {} => First(Sources(r)) \in Sources(r) BY <1>1, RNat, MinProp DEF First
<1>. QED BY <1>1, <1>2 DEF CoverSet

\* The trust target is a recorded epoch, or 0.
LEMMA TgtType ==
  ASSUME TySets PROVE Tgt \in {0} \cup recorded /\ (Tgt # 0 => Tgt \in Epochs)
<1>1. TrustedRec \subseteq recorded BY DEF TrustedRec
<1>2. TrustedRec # {} => Max(TrustedRec) \in TrustedRec
  BY <1>1, Const, MaxProp DEF TySets, Epochs
<1>. QED BY <1>1, <1>2, Full DEF Tgt, TySets, Epochs

LEMMA T_BulkCopy ==
  ASSUME TypeOKT, NEW r \in R, BulkCopy(r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. Tgt \in Epochs BY <1>0, TgtType DEF BulkCopy
<1>b. sb[r] \in 0..MaxEpoch BY <1>0 DEF BulkCopy, TyLeg
<1>c. PICK s \in CoverSet(r, Tgt, sb[r]) :
        /\ CopyAlign(r, s, sb[r], Tgt)
        /\ used' = used
        /\ mark' = [mark EXCEPT ![r] = Tgt]
        /\ pin' = [pin EXCEPT ![r] = IF PinRetention THEN Tgt ELSE pin[r]]
  BY Full DEF BulkCopy
<1>d. s \in R BY CoverSetSub
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, reverted, riskRec, restamp>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED <<tainted, floor, mustRev>>
      /\ UNCHANGED <<cfgAt, conf, htr>>
  BY DEF BulkCopy
<1>1. TyHead' /\ TySnap' /\ TyTrust' BY <1>0, <1>a, <1>b, <1>c, <1>d, <1>u, T_CopyAlign
<1>e. dState' = [dState EXCEPT ![r] = "standby"] /\ sb' = [sb EXCEPT ![r] = -1] BY DEF BulkCopy
<1>2. TyLeg' BY <1>0, <1>a, <1>c, <1>e, <1>u, Full, Const DEF TyLeg, Epochs
<1>3. TyTie' BY <1>0, <1>c, <1>u DEF TyTie
<1>. QED BY <1>0, <1>u, <1>1, <1>2, <1>3, C_Scalar, C_Sets, C_Pend, GroupsP

LEMMA T_Chase ==
  ASSUME TypeOKT, NEW r \in R, Chase(r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>a. Tgt \in Epochs BY <1>0, TgtType DEF Chase
<1>b. mark[r] \in 0..MaxEpoch BY <1>0 DEF TyLeg
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, sb, riskRec>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED <<tainted, floor>>
      /\ UNCHANGED <<cfgAt, conf, htr>>
  BY DEF Chase
<1>1. CASE CoverSet(r, Tgt, mark[r]) # {}
  <2>1. PICK s \in CoverSet(r, Tgt, mark[r]) :
          /\ CopyAlign(r, s, mark[r], Tgt)
          /\ used' = used
          /\ mark' = [mark EXCEPT ![r] = Tgt]
          /\ pin' = [pin EXCEPT ![r] = IF PinRetention THEN Tgt ELSE pin[r]]
    BY <1>1, Full DEF Chase
  <2>2. s \in R BY CoverSetSub
  <2>3. TyHead' /\ TySnap' /\ TyTrust' BY <1>0, <1>a, <1>b, <1>u, <2>1, <2>2, T_CopyAlign
  <2>4. UNCHANGED <<dState, reverted, restamp, mustRev>> BY <1>1 DEF Chase
  <2>5. TyLeg' BY <1>0, <1>a, <1>u, <2>1, <2>4 DEF TyLeg, Epochs
  <2>6. TyTie' BY <1>0, <1>u, <2>1, <2>4 DEF TyTie
  <2>. QED BY <1>0, <1>u, <2>3, <2>5, <2>6, C_Scalar, C_Sets, C_Pend, GroupsP
<1>2. CASE CoverSet(r, Tgt, mark[r]) = {}
  <2>1. /\ dState' = [dState EXCEPT ![r] = "stale"] /\ Demote(r)
        /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
        /\ UNCHANGED <<mark, pin, used>> /\ UNCHANGED trustVars
    BY <1>2 DEF Chase, trustVars
  <2>2. reverted' = [reverted EXCEPT ![r] = -1] /\ UNCHANGED <<restamp, mustRev>> BY <2>1, Full DEF Demote
  <2>3. TyLeg' BY <1>0, <1>u, <2>1, <2>2, Const DEF TyLeg
  <2>4. TyTie' BY <1>0, <1>u, <2>1, <2>2 DEF TyTie
  <2>. QED BY <1>0, <1>u, <2>1, <2>3, <2>4, C_Scalar, C_Sets, C_Head, C_Snap, C_Pend, C_Trust, GroupsP
<1>. QED BY <1>1, <1>2

LEMMA T_Unstage ==
  ASSUME TypeOKT, Unstage PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>1. /\ UNCHANGED <<dState, tainted, floor, restamp>>
      /\ conf' = [e \in Epochs |-> TRUE] /\ tr' = tr /\ htr' = [q \in R |-> FALSE]
  BY Full DEF Unstage
<1>u. UNCHANGED <<ver, nextSeq, cutK, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone>>
      /\ UNCHANGED <<path, mark, reverted, sb, pin, riskRec, used, mustRev>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED <<cfgAt, cutAck>>
  BY DEF Unstage
<1>2. TyLeg' /\ TyTie' BY <1>0, <1>1, <1>u DEF TyLeg, TyTie
<1>3. TyScalar' BY <1>0, <1>u DEF Unstage, TyScalar
<1>4. TySets' BY <1>0, <1>u DEF Unstage, TySets
<1>5. TyTrust' BY <1>0, <1>1, <1>u DEF TyTrust
<1>. QED BY <1>0, <1>u, <1>2, <1>3, <1>4, <1>5, C_Head, C_Snap, C_Pend, GroupsP
LEMMA T_Stage ==
  ASSUME TypeOKT, Stage PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>1. StaleMarks(AsmMarks(AsmSet)) BY DEF Stage
<1>u. UNCHANGED <<ver, nextSeq, cutK, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone>>
      /\ UNCHANGED <<mark, reverted, sb, pin, riskRec, used, mustRev>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED <<cfgAt, conf, tr, cutAck>>
  BY DEF Stage
<1>2. TyLeg' /\ TyTie'
  <2>1. path' \in [R -> {"ok", "failing", "out", "back"}] BY <1>0 DEF Stage, TyLeg
  <2>2. dState' \in [R -> {"insync", "stale", "standby"}] /\ restamp' \in [R -> BOOLEAN]
        /\ UNCHANGED <<tainted, floor>>
    BY <1>0, <1>1, Full DEF StaleMarks, TyLeg
  <2>. QED BY <1>0, <1>u, <2>1, <2>2 DEF TyLeg, TyTie
<1>3. TyScalar' BY <1>0, <1>u DEF Stage, TyScalar
<1>4. TySets' BY <1>0, <1>u, AsmSetSub DEF Stage, TySets
<1>5. TyTrust' BY <1>0, <1>u, Full DEF Stage, TyTrust
<1>. QED BY <1>0, <1>u, <1>2, <1>3, <1>4, <1>5, C_Head, C_Snap, C_Pend, GroupsP

-----------------------------------------------------------------------------
(* StageAdmit's LET, named (trust: the final delta's source is any member  *)
(* of the assembly whose lineage covers the standby's mark).               *)

AdmK == nextSeq
AdmT == AsmSet
AdmM == AsmMarks(AsmSet)
AdmElems(r, s) == {e \in Lin(s) \cup {AdmK} : mark[r] <= e /\ e <= AdmK}
AdmAl(s, e) == IF e = AdmK THEN hAl[s] ELSE sAl[s][e]
AdmCon(s, e) == IF e = AdmK THEN head[s] ELSE sCon[s][e]
AdmHits(r, s, x) == {e \in AdmElems(r, s) : x \in AdmAl(s, e)}
AdmHead(r, s) == [x \in Blocks |-> IF AdmHits(r, s, x) = {} THEN head[r][x]
                                   ELSE AdmCon(s, Max(AdmHits(r, s, x)))[x]]
AdmAlD(r, s) == hAl[r] \cup {x \in Blocks : \E e \in AdmElems(r, s) : x \in AdmAl(s, e)}

\* The guard and the snapshot effects of StageAdmit(r) with source s.
AdmGuard(r, s) ==
  /\ ~attached /\ cutK = 0 /\ dState[r] = "standby" /\ path[r] = "back"
  /\ nextSeq <= MaxEpoch /\ recorded # {} /\ AdmT # {}
  /\ mark[r] \in tr[r]
  /\ \A t \in AdmT : AdmK \notin sPres[t]
  /\ AdmK \notin sPres[r]
  /\ s \in AdmT /\ LinCovers(s, mark[r])
AdmSnap(r, s) ==
  /\ sPres' = [q \in R |-> IF q \in AdmT \cup {r} THEN sPres[q] \cup {AdmK} ELSE sPres[q]]
  /\ sCon' = [q \in R |-> IF q \in AdmT THEN [sCon[q] EXCEPT ![AdmK] = head[q]]
                          ELSE IF q = r THEN [sCon[q] EXCEPT ![AdmK] = AdmHead(r, s)]
                          ELSE sCon[q]]
  /\ sAl' = [q \in R |-> IF q \in AdmT THEN [sAl[q] EXCEPT ![AdmK] = hAl[q]]
                         ELSE IF q = r THEN [sAl[q] EXCEPT ![AdmK] = AdmAlD(r, s)]
                         ELSE sAl[q]]
  /\ sPar' = [q \in R |-> IF q \in AdmT \cup {r} THEN [sPar[q] EXCEPT ![AdmK] = hPar[q]]
                          ELSE sPar[q]]
  /\ anc' = [q \in R |-> IF q \in AdmT \cup {r} THEN [anc[q] EXCEPT ![AdmK] = NewAnc(q, AdmK)]
                         ELSE anc[q]]
  /\ hPar' = [q \in R |-> IF q \in AdmT \cup {r} THEN AdmK ELSE hPar[q]]
  /\ hAl' = [q \in R |-> IF q \in AdmT \cup {r} THEN {} ELSE hAl[q]]
  /\ head' = [head EXCEPT ![r] = AdmHead(r, s)]
AdmRest(r, s) ==
  /\ badAdmit' = (badAdmit \/ AdmHead(r, s) # head[s])
  /\ badLoss' = (badLoss \/ \E x \in Blocks :
                    \/ head[s][x] >= acked[x] /\ AdmHead(r, s)[x] < acked[x]
                    \/ AdmHead(r, s)[x] \notin ackedEver[x] \cup {head[q][x] : q \in AdmT})
  /\ tr' = [q \in R |-> IF (q \in AdmT /\ htr[q]) \/ (q = r /\ htr[s])
                        THEN tr[q] \cup {AdmK} ELSE tr[q] \ {AdmK}]
  /\ cutAck' = [q \in R |-> IF q \in AdmT \cup {r} THEN [cutAck[q] EXCEPT ![AdmK] = acked]
                            ELSE cutAck[q]]
  /\ htr' = [q \in R |-> FALSE]
  /\ recorded' = recorded \cup {AdmK}
  /\ nextSeq' = nextSeq + 1
  /\ mark' = [q \in R |-> IF q \in AdmT \cup {r} THEN AdmK ELSE mark[q]]
  /\ members' = AdmT \cup {r}
  /\ path' = [q \in R |-> IF q \in AdmT \cup {r} THEN "ok" ELSE path[q]]
  /\ dState' = [q \in R |-> IF q = r THEN "insync"
                            ELSE IF q \in AdmM THEN "stale" ELSE dState[q]]
  /\ restamp' = [q \in R |-> IF q = r \/ q \in AdmM THEN FALSE ELSE restamp[q]]
  /\ reverted' = [reverted EXCEPT ![r] = -1]
  /\ pin' = [pin EXCEPT ![r] = 0]
  /\ attached' = TRUE
  /\ riskRec' = [riskRec EXCEPT ![r] = NoRisk]
  /\ UNCHANGED tieVars
  /\ UNCHANGED <<ver, cutK, cutTgt, cutDone, cutGone, sb, pend, acked, fails, cfgAt, conf, zx, ackedEver>>

\* (S) StageAdmit's existential body for source s, with the elems' lower bound a parameter (opaque: the PICK
\* matches it with the model's bound, and BaseInclusive then rewrites the argument, not the binders under it)
ZK_AdmBody(r, s, lo) ==
  LET lineS == Lin(s) \cup {nextSeq}
      elems == {e \in lineS : lo <= e /\ e <= nextSeq}
      alOf(e) == IF e = nextSeq THEN hAl[s] ELSE sAl[s][e]
      conOf(e) == IF e = nextSeq THEN head[s] ELSE sCon[s][e]
      dHead == [x \in Blocks |->
                 LET hits == {e \in elems : x \in alOf(e)}
                 IN IF hits = {} THEN head[r][x] ELSE conOf(Max(hits))[x]]
      dAl == hAl[r] \cup {x \in Blocks : \E e \in elems : x \in alOf(e)}
  IN /\ sPres' = [q \in R |-> IF q \in AsmSet \cup {r} THEN sPres[q] \cup {nextSeq} ELSE sPres[q]]
     /\ sCon' = [q \in R |-> IF q \in AsmSet THEN [sCon[q] EXCEPT ![nextSeq] = head[q]]
                             ELSE IF q = r THEN [sCon[q] EXCEPT ![nextSeq] = dHead]
                             ELSE sCon[q]]
     /\ sAl' = [q \in R |-> IF q \in AsmSet THEN [sAl[q] EXCEPT ![nextSeq] = hAl[q]]
                            ELSE IF q = r THEN [sAl[q] EXCEPT ![nextSeq] = dAl]
                            ELSE sAl[q]]
     /\ sPar' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [sPar[q] EXCEPT ![nextSeq] = hPar[q]]
                             ELSE sPar[q]]
     /\ anc' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [anc[q] EXCEPT ![nextSeq] = NewAnc(q, nextSeq)]
                            ELSE anc[q]]
     /\ hPar' = [q \in R |-> IF q \in AsmSet \cup {r} THEN nextSeq ELSE hPar[q]]
     /\ hAl' = [q \in R |-> IF q \in AsmSet \cup {r} THEN {} ELSE hAl[q]]
     /\ head' = [head EXCEPT ![r] = dHead]
     /\ badAdmit' = (badAdmit \/ dHead # head[s])
     /\ badLoss' = (badLoss \/ \E x \in Blocks :
                       \/ head[s][x] >= acked[x] /\ dHead[x] < acked[x]
                       \/ dHead[x] \notin ackedEver[x] \cup {head[q][x] : q \in AsmSet})
     /\ IF Policy = "trust"
          THEN /\ tr' = [q \in R |-> IF (q \in AsmSet /\ htr[q]) \/ (q = r /\ htr[s])
                                     THEN tr[q] \cup {nextSeq} ELSE tr[q] \ {nextSeq}]
               /\ cutAck' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [cutAck[q] EXCEPT ![nextSeq] = acked]
                                         ELSE cutAck[q]]
               /\ htr' = [q \in R |-> FALSE]
          ELSE UNCHANGED <<tr, htr, cutAck>>

LEMMA StageAdmitFacts ==
  ASSUME NEW r \in R, StageAdmit(r)
  PROVE  \E s \in R : AdmGuard(r, s) /\ AdmSnap(r, s) /\ AdmRest(r, s)
<1>1. AssemblyQuorum = 1 /\ Policy = "trust" /\ BaseInclusive = TRUE BY Full
<1>2a. PICK s \in (IF Policy = "trust"
                      THEN {q \in AsmSet : LinCovers(q, mark[r])}
                      ELSE CoverSet(r, Max(recorded), mark[r]) \cap AsmSet) :
             LET lineS == Lin(s) \cup {nextSeq}
                 elems == {e \in lineS : (IF BaseInclusive THEN mark[r] ELSE mark[r] + 1) <= e /\ e <= nextSeq}
                 alOf(e) == IF e = nextSeq THEN hAl[s] ELSE sAl[s][e]
                 conOf(e) == IF e = nextSeq THEN head[s] ELSE sCon[s][e]
                 dHead == [x \in Blocks |->
                            LET hits == {e \in elems : x \in alOf(e)}
                            IN IF hits = {} THEN head[r][x] ELSE conOf(Max(hits))[x]]
                 dAl == hAl[r] \cup {x \in Blocks : \E e \in elems : x \in alOf(e)}
             IN /\ sPres' = [q \in R |-> IF q \in AsmSet \cup {r} THEN sPres[q] \cup {nextSeq} ELSE sPres[q]]
                /\ sCon' = [q \in R |-> IF q \in AsmSet THEN [sCon[q] EXCEPT ![nextSeq] = head[q]]
                                        ELSE IF q = r THEN [sCon[q] EXCEPT ![nextSeq] = dHead]
                                        ELSE sCon[q]]
                /\ sAl' = [q \in R |-> IF q \in AsmSet THEN [sAl[q] EXCEPT ![nextSeq] = hAl[q]]
                                       ELSE IF q = r THEN [sAl[q] EXCEPT ![nextSeq] = dAl]
                                       ELSE sAl[q]]
                /\ sPar' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [sPar[q] EXCEPT ![nextSeq] = hPar[q]]
                                        ELSE sPar[q]]
                /\ anc' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [anc[q] EXCEPT ![nextSeq] = NewAnc(q, nextSeq)]
                                       ELSE anc[q]]
                /\ hPar' = [q \in R |-> IF q \in AsmSet \cup {r} THEN nextSeq ELSE hPar[q]]
                /\ hAl' = [q \in R |-> IF q \in AsmSet \cup {r} THEN {} ELSE hAl[q]]
                /\ head' = [head EXCEPT ![r] = dHead]
                /\ badAdmit' = (badAdmit \/ dHead # head[s])
                /\ badLoss' = (badLoss \/ \E x \in Blocks :
                                  \/ head[s][x] >= acked[x] /\ dHead[x] < acked[x]
                                  \/ dHead[x] \notin ackedEver[x] \cup {head[q][x] : q \in AsmSet})
                /\ IF Policy = "trust"
                     THEN /\ tr' = [q \in R |-> IF (q \in AsmSet /\ htr[q]) \/ (q = r /\ htr[s])
                                                THEN tr[q] \cup {nextSeq} ELSE tr[q] \ {nextSeq}]
                          /\ cutAck' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [cutAck[q] EXCEPT ![nextSeq] = acked]
                                                    ELSE cutAck[q]]
                          /\ htr' = [q \in R |-> FALSE]
                     ELSE UNCHANGED <<tr, htr, cutAck>>
  BY DEF StageAdmit
<1>2. s \in {q \in AsmSet : LinCovers(q, mark[r])} /\
        LET lineS == Lin(s) \cup {nextSeq}
            elems == {e \in lineS : mark[r] <= e /\ e <= nextSeq}
            alOf(e) == IF e = nextSeq THEN hAl[s] ELSE sAl[s][e]
            conOf(e) == IF e = nextSeq THEN head[s] ELSE sCon[s][e]
            dHead == [x \in Blocks |->
                       LET hits == {e \in elems : x \in alOf(e)}
                       IN IF hits = {} THEN head[r][x] ELSE conOf(Max(hits))[x]]
            dAl == hAl[r] \cup {x \in Blocks : \E e \in elems : x \in alOf(e)}
        IN /\ sPres' = [q \in R |-> IF q \in AsmSet \cup {r} THEN sPres[q] \cup {nextSeq} ELSE sPres[q]]
           /\ sCon' = [q \in R |-> IF q \in AsmSet THEN [sCon[q] EXCEPT ![nextSeq] = head[q]]
                                   ELSE IF q = r THEN [sCon[q] EXCEPT ![nextSeq] = dHead]
                                   ELSE sCon[q]]
           /\ sAl' = [q \in R |-> IF q \in AsmSet THEN [sAl[q] EXCEPT ![nextSeq] = hAl[q]]
                                  ELSE IF q = r THEN [sAl[q] EXCEPT ![nextSeq] = dAl]
                                  ELSE sAl[q]]
           /\ sPar' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [sPar[q] EXCEPT ![nextSeq] = hPar[q]]
                                   ELSE sPar[q]]
           /\ anc' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [anc[q] EXCEPT ![nextSeq] = NewAnc(q, nextSeq)]
                                  ELSE anc[q]]
           /\ hPar' = [q \in R |-> IF q \in AsmSet \cup {r} THEN nextSeq ELSE hPar[q]]
           /\ hAl' = [q \in R |-> IF q \in AsmSet \cup {r} THEN {} ELSE hAl[q]]
           /\ head' = [head EXCEPT ![r] = dHead]
           /\ badAdmit' = (badAdmit \/ dHead # head[s])
           /\ badLoss' = (badLoss \/ \E x \in Blocks :
                             \/ head[s][x] >= acked[x] /\ dHead[x] < acked[x]
                             \/ dHead[x] \notin ackedEver[x] \cup {head[q][x] : q \in AsmSet})
           /\ tr' = [q \in R |-> IF (q \in AsmSet /\ htr[q]) \/ (q = r /\ htr[s])
                                 THEN tr[q] \cup {nextSeq} ELSE tr[q] \ {nextSeq}]
           /\ cutAck' = [q \in R |-> IF q \in AsmSet \cup {r} THEN [cutAck[q] EXCEPT ![nextSeq] = acked]
                                     ELSE cutAck[q]]
           /\ htr' = [q \in R |-> FALSE]
  <2>1. ZK_AdmBody(r, s, IF BaseInclusive THEN mark[r] ELSE mark[r] + 1) BY <1>2a DEF ZK_AdmBody
  <2>2. (IF BaseInclusive THEN mark[r] ELSE mark[r] + 1) = mark[r] BY <1>1
  <2>3. ZK_AdmBody(r, s, mark[r]) BY <2>1, <2>2
  <2>4. s \in {q \in AsmSet : LinCovers(q, mark[r])} BY <1>1, <1>2a
  <2>. QED BY <1>1, <2>3, <2>4 DEF ZK_AdmBody
<1>3. s \in R BY <1>2, AsmSetSub
<1>4. AdmGuard(r, s) BY <1>1, <1>2, Full DEF StageAdmit, AdmGuard, AdmT, AdmK
<1>5. AdmHead(r, s) = [x \in Blocks |->
                         LET hits == {e \in {e \in Lin(s) \cup {nextSeq} : mark[r] <= e /\ e <= nextSeq} :
                                        x \in (IF e = nextSeq THEN hAl[s] ELSE sAl[s][e])}
                         IN IF hits = {} THEN head[r][x]
                            ELSE (IF Max(hits) = nextSeq THEN head[s] ELSE sCon[s][Max(hits)])[x]]
  BY DEF AdmHead, AdmHits, AdmElems, AdmAl, AdmCon, AdmK
<1>6. AdmAlD(r, s) = hAl[r] \cup {x \in Blocks : \E e \in {e \in Lin(s) \cup {nextSeq} : mark[r] <= e /\ e <= nextSeq} :
                                     x \in (IF e = nextSeq THEN hAl[s] ELSE sAl[s][e])}
  BY DEF AdmAlD, AdmElems, AdmAl, AdmK
<1>7. AdmSnap(r, s) BY <1>2, <1>5, <1>6 DEF AdmSnap, AdmT, AdmK
<1>8. AdmRest(r, s) BY <1>1, <1>2, <1>5, Full DEF StageAdmit, AdmRest, AdmT, AdmM, AdmK, tieVars
<1>. QED BY <1>3, <1>4, <1>7, <1>8

LEMMA AdmHeadType ==
  ASSUME TyScalar, TyHead, TySnap, NEW r \in R, NEW s \in R, nextSeq <= MaxEpoch
  PROVE  AdmHead(r, s) \in [Blocks -> Vers] /\ AdmAlD(r, s) \subseteq Blocks
<1>1. AdmK \in Epochs BY DEF TyScalar, AdmK, Epochs
<1>2. Lin(s) \subseteq Epochs BY LinType
<1>3. \A x \in Blocks : AdmHits(r, s, x) \in SUBSET (0..MaxEpoch)
  BY <1>1, <1>2 DEF AdmHits, AdmElems, Epochs
<1>4. \A x \in Blocks : AdmHits(r, s, x) # {} => AdmCon(s, Max(AdmHits(r, s, x)))[x] \in Vers
  <2>. SUFFICES ASSUME NEW x \in Blocks, AdmHits(r, s, x) # {}
               PROVE  AdmCon(s, Max(AdmHits(r, s, x)))[x] \in Vers
    OBVIOUS
  <2>1. Max(AdmHits(r, s, x)) \in AdmHits(r, s, x) BY <1>3, MaxProp, Const
  <2>2. Max(AdmHits(r, s, x)) \in Epochs BY <1>1, <1>2, <2>1 DEF AdmHits, AdmElems
  <2>3. \A e \in Epochs : AdmCon(s, e) \in [Blocks -> Vers] BY DEF AdmCon, TySnap, TyHead
  <2>. QED BY <2>2, <2>3
<1>5. AdmHead(r, s) \in [Blocks -> Vers] BY <1>4 DEF AdmHead, TyHead
<1>6. \A e \in AdmElems(r, s) : AdmAl(s, e) \subseteq Blocks
  BY <1>1, <1>2 DEF AdmElems, AdmAl, TyHead, TySnap
<1>. QED BY <1>5, <1>6 DEF AdmAlD, TyHead

LEMMA T_StageAdmit ==
  ASSUME TypeOKT, NEW r \in R, StageAdmit(r) PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>1. PICK s \in R : AdmGuard(r, s) /\ AdmSnap(r, s) /\ AdmRest(r, s) BY StageAdmitFacts
<1>2. AdmK \in Epochs /\ nextSeq <= MaxEpoch BY <1>0, <1>1 DEF AdmGuard, TyScalar, AdmK, Epochs
<1>3. AdmHead(r, s) \in [Blocks -> Vers] /\ AdmAlD(r, s) \subseteq Blocks BY <1>0, <1>2, AdmHeadType
<1>4. AdmT \subseteq R BY AsmSetSub DEF AdmT
<1>5. \A q \in R : NewAnc(q, AdmK) \in SUBSET Epochs BY <1>0, <1>2, NewAncType
<1>r. /\ nextSeq' = nextSeq + 1 /\ attached' = TRUE /\ badAdmit' \in BOOLEAN /\ badLoss' \in BOOLEAN
      /\ UNCHANGED <<ver, cutK, fails, zx>>
      /\ mark' = [q \in R |-> IF q \in AdmT \cup {r} THEN AdmK ELSE mark[q]]
      /\ path' = [q \in R |-> IF q \in AdmT \cup {r} THEN "ok" ELSE path[q]]
      /\ dState' = [q \in R |-> IF q = r THEN "insync"
                                ELSE IF q \in AdmM THEN "stale" ELSE dState[q]]
      /\ restamp' = [q \in R |-> IF q = r \/ q \in AdmM THEN FALSE ELSE restamp[q]]
      /\ reverted' = [reverted EXCEPT ![r] = -1] /\ pin' = [pin EXCEPT ![r] = 0]
      /\ riskRec' = [riskRec EXCEPT ![r] = NoRisk] /\ UNCHANGED sb
  BY <1>1 DEF AdmRest
<1>s1. TyScalar' BY <1>0, <1>2, <1>r, Const DEF TyScalar, AdmK
<1>s2. TySets' BY <1>0, <1>1, <1>2, <1>4 DEF AdmRest, TySets
<1>s3. TyLeg'
  <2>1. mark' \in [R -> 0..MaxEpoch] BY <1>0, <1>2, <1>r DEF TyLeg, Epochs, AdmK
  <2>2. path' \in [R -> {"ok", "failing", "out", "back"}] /\ dState' \in [R -> {"insync", "stale", "standby"}]
        /\ restamp' \in [R -> BOOLEAN]
    BY <1>0, <1>r DEF TyLeg
  <2>3. reverted' \in [R -> -1..MaxEpoch] /\ pin' \in [R -> 0..MaxEpoch] /\ sb' \in [R -> -1..MaxEpoch]
    BY <1>0, <1>r, Const DEF TyLeg
  <2>4. riskRec' \in [R -> 0..NoRisk] BY <1>0, <1>r, NoRiskNat DEF TyLeg
  <2>. QED BY <2>1, <2>2, <2>3, <2>4 DEF TyLeg
<1>s4. TyHead' BY <1>0, <1>1, <1>2, <1>3 DEF AdmSnap, TyHead, Epochs
<1>s5. TySnap'
  <2>1. sPres' \in [R -> SUBSET Epochs] BY <1>0, <1>1, <1>2 DEF AdmSnap, TySnap
  <2>2. sCon' \in [R -> [Epochs -> [Blocks -> Vers]]] BY <1>0, <1>1, <1>2, <1>3 DEF AdmSnap, TySnap, TyHead
  <2>3. sAl' \in [R -> [Epochs -> SUBSET Blocks]] BY <1>0, <1>1, <1>2, <1>3 DEF AdmSnap, TySnap, TyHead
  <2>4. sPar' \in [R -> [Epochs -> 0..MaxEpoch]] BY <1>0, <1>1, <1>2 DEF AdmSnap, TySnap, TyHead
  <2>5. anc' \in [R -> [Epochs -> SUBSET Epochs]] BY <1>0, <1>1, <1>2, <1>5 DEF AdmSnap, TySnap
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5 DEF TySnap
<1>s6. TyPend' BY <1>0, <1>1 DEF AdmRest, TyPend
<1>s7. TyTie' BY <1>0, <1>1, C_Tie DEF AdmRest
<1>s8. TyTrust' BY <1>0, <1>1, <1>2 DEF AdmRest, TyTrust, TyPend
<1>. QED BY <1>s1, <1>s2, <1>s3, <1>s4, <1>s5, <1>s6, <1>s7, <1>s8, GroupsP

-----------------------------------------------------------------------------
(* A snapshot chain, in general: present set P, parents Par, ghost         *)
(* ancestors An, allocations Al, contents Con.  Everything the catch-up    *)
(* reads off a lineage follows from three facts: parents are older and     *)
(* present, An is the parent walk, and an unallocated block reads through. *)

\* (Up, ChainShape and ChainReads are FlintCatchupTInd's.)

LEMMA AncBound ==
  ASSUME NEW P, NEW Par, NEW An, ChainShape(P, Par, An)
  PROVE  \A e \in P : e \in An[e] /\ An[e] \subseteq P /\ \A f \in An[e] : f <= e
<1>. DEFINE Q(n) == n \in P => (n \in An[n] /\ An[n] \subseteq P /\ \A f \in An[n] : f <= n)
<1>1. \A n \in Nat : (\A m \in 0..(n-1) : Q(m)) => Q(n)
  <2>. SUFFICES ASSUME NEW n \in Nat, \A m \in 0..(n-1) : Q(m), n \in P
               PROVE  n \in An[n] /\ An[n] \subseteq P /\ \A f \in An[n] : f <= n
    OBVIOUS
  <2>1. Par[n] \in 0..MaxEpoch /\ Par[n] < n /\ (Par[n] # 0 => Par[n] \in P)
    BY DEF ChainShape
  <2>2. An[n] = {n} \cup (IF Par[n] = 0 THEN {} ELSE An[Par[n]]) BY DEF ChainShape
  <2>3. CASE Par[n] = 0 BY <2>2, <2>3 DEF ChainShape
  <2>4. CASE Par[n] # 0
    <3>1. Par[n] \in 0..(n-1) /\ Par[n] \in P BY <2>1, <2>4, Const
    <3>2. An[Par[n]] \subseteq P /\ \A f \in An[Par[n]] : f <= Par[n] BY <3>1
    <3>. QED BY <2>1, <2>2, <2>4, <3>1, <3>2 DEF ChainShape, Epochs
  <2>. QED BY <2>3, <2>4
<1>2. \A n \in Nat : Q(n)
  <2>. HIDE DEF Q
  <2>. SUFFICES ASSUME NEW n0 \in Nat, ~Q(n0) PROVE FALSE OBVIOUS
  <2>. DEFINE S == {n \in Nat : ~Q(n)}
  <2>1. S \in SUBSET Nat /\ S # {} OBVIOUS
  <2>2. Min(S) \in S /\ \A u \in S : Min(S) <= u BY <2>1, MinProp
  <2>3. \A m \in 0..(Min(S) - 1) : Q(m) BY <2>2
  <2>. QED BY <2>2, <2>3, <1>1
<1>. QED BY <1>2 DEF ChainShape, Epochs

\* A lineage's ancestors are its own prefix.
LEMMA AncPrefix ==
  ASSUME NEW P, NEW Par, NEW An, ChainShape(P, Par, An)
  PROVE  \A e \in P : \A f \in An[e] : An[f] = {g \in An[e] : g <= f}
<1>0. \A e \in P : e \in An[e] /\ An[e] \subseteq P /\ \A f \in An[e] : f <= e BY AncBound
<1>. DEFINE Q(n) == n \in P => \A f \in An[n] : An[f] = {g \in An[n] : g <= f}
<1>1. \A n \in Nat : (\A m \in 0..(n-1) : Q(m)) => Q(n)
  <2>. SUFFICES ASSUME NEW n \in Nat, \A m \in 0..(n-1) : Q(m), n \in P, NEW f \in An[n]
               PROVE  An[f] = {g \in An[n] : g <= f}
    OBVIOUS
  <2>1. Par[n] < n /\ (Par[n] # 0 => Par[n] \in P) /\ Par[n] \in 0..MaxEpoch BY DEF ChainShape
  <2>2. An[n] = {n} \cup (IF Par[n] = 0 THEN {} ELSE An[Par[n]]) BY DEF ChainShape
  <2>3. CASE f = n
    <3>1. \A g \in An[n] : g <= n BY <1>0
    <3>. QED BY <2>3, <3>1
  <2>4. CASE f # n
    <3>1. Par[n] # 0 /\ f \in An[Par[n]] BY <2>2, <2>4
    <3>2. Par[n] \in 0..(n-1) /\ Par[n] \in P BY <2>1, <3>1, Const
    <3>3. An[f] = {g \in An[Par[n]] : g <= f} BY <3>1, <3>2
    <3>4. f <= Par[n] /\ Par[n] < n BY <1>0, <2>1, <3>1, <3>2
    <3>5. f \in Nat /\ n \in Nat BY <1>0, <3>1, <3>2 DEF ChainShape, Epochs
    <3>6. ~(n <= f) BY <3>4, <3>5, <3>2
    <3>7. {g \in An[n] : g <= f} = {g \in An[Par[n]] : g <= f} BY <2>2, <3>1, <3>6
    <3>. QED BY <3>3, <3>7
  <2>. QED BY <2>3, <2>4
<1>2. \A n \in Nat : Q(n)
  <2>. HIDE DEF Q
  <2>. SUFFICES ASSUME NEW n0 \in Nat, ~Q(n0) PROVE FALSE OBVIOUS
  <2>. DEFINE S == {n \in Nat : ~Q(n)}
  <2>1. S \in SUBSET Nat /\ S # {} OBVIOUS
  <2>2. Min(S) \in S /\ \A u \in S : Min(S) <= u BY <2>1, MinProp
  <2>3. \A m \in 0..(Min(S) - 1) : Q(m) BY <2>2
  <2>. QED BY <2>2, <2>3, <1>1
<1>. QED BY <1>2 DEF ChainShape, Epochs

\* Reading block x at e: the newest ancestor at or above lo that allocated x,
\* or, with none, what lo's parent holds (0 when the walk ends).
LEMMA ReadThrough ==
  ASSUME NEW P, NEW Par, NEW An, NEW Al, NEW Con,
         ChainShape(P, Par, An), ChainReads(P, Par, Al, Con),
         NEW x \in Blocks
  PROVE  \A e \in P : \A lo \in An[e] :
           LET H == {f \in An[e] : lo <= f /\ x \in Al[f]}
           IN  /\ H = {} => Con[e][x] = Up(Par, Con, Par[lo], x)
               /\ H # {} => Con[e][x] = Con[Max(H)][x] /\ Max(H) \in H
<1>0. \A e \in P : e \in An[e] /\ An[e] \subseteq P /\ \A f \in An[e] : f <= e BY AncBound
<1>. DEFINE Q(n) == n \in P => \A lo \in An[n] :
                      LET H == {f \in An[n] : lo <= f /\ x \in Al[f]}
                      IN  /\ H = {} => Con[n][x] = Up(Par, Con, Par[lo], x)
                          /\ H # {} => Con[n][x] = Con[Max(H)][x] /\ Max(H) \in H
<1>1. \A n \in Nat : (\A m \in 0..(n-1) : Q(m)) => Q(n)
  <2>. SUFFICES ASSUME NEW n \in Nat, \A m \in 0..(n-1) : Q(m), n \in P, NEW lo \in An[n]
               PROVE  LET H == {f \in An[n] : lo <= f /\ x \in Al[f]}
                      IN  /\ H = {} => Con[n][x] = Up(Par, Con, Par[lo], x)
                          /\ H # {} => Con[n][x] = Con[Max(H)][x] /\ Max(H) \in H
    OBVIOUS
  <2>. DEFINE H == {f \in An[n] : lo <= f /\ x \in Al[f]}
  <2>0. An[n] \subseteq P /\ \A f \in An[n] : f <= n /\ n \in An[n] BY <1>0
  <2>a. P \subseteq 0..MaxEpoch BY Const DEF ChainShape, Epochs
  <2>b. H \subseteq 0..MaxEpoch /\ \A f \in H : f <= n BY <2>0, <2>a
  <2>1. Par[n] < n /\ (Par[n] # 0 => Par[n] \in P) /\ Par[n] \in 0..MaxEpoch BY DEF ChainShape
  <2>2. An[n] = {n} \cup (IF Par[n] = 0 THEN {} ELSE An[Par[n]]) BY DEF ChainShape
  <2>3. CASE x \in Al[n] /\ lo <= n
    <3>1. n \in H BY <2>0, <2>3
    <3>2. Max(H) = n
      <4>1. Max(H) \in H /\ \A u \in H : u <= Max(H) BY <2>b, <3>1, MaxProp, Const
      <4>. QED BY <4>1, <2>b, <3>1, <2>a
    <3>. QED BY <3>1, <3>2
  <2>4. CASE ~(x \in Al[n] /\ lo <= n)
    <3>0. lo <= n BY <2>0
    <3>1. x \notin Al[n] BY <2>4, <3>0
    <3>2. Con[n][x] = Up(Par, Con, Par[n], x) BY <3>1 DEF ChainReads
    <3>3. CASE lo = n
      <4>1. H = {} BY <3>1, <3>3, <2>0, <2>a
      <4>. QED BY <3>2, <3>3, <4>1
    <3>4. CASE lo # n
      <4>1. Par[n] # 0 /\ lo \in An[Par[n]] BY <2>2, <3>4
      <4>2. Par[n] \in 0..(n-1) /\ Par[n] \in P BY <2>1, <4>1, Const
      <4>3. H = {f \in An[Par[n]] : lo <= f /\ x \in Al[f]} BY <2>2, <3>1, <4>1
      <4>4. Con[n][x] = Con[Par[n]][x] BY <3>2, <4>1 DEF Up
      <4>. QED BY <4>1, <4>2, <4>3, <4>4
    <3>. QED BY <3>3, <3>4
  <2>. QED BY <2>3, <2>4
<1>2. \A n \in Nat : Q(n)
  <2>. HIDE DEF Q
  <2>. SUFFICES ASSUME NEW n0 \in Nat, ~Q(n0) PROVE FALSE OBVIOUS
  <2>. DEFINE S == {n \in Nat : ~Q(n)}
  <2>1. S \in SUBSET Nat /\ S # {} OBVIOUS
  <2>2. Min(S) \in S /\ \A u \in S : Min(S) <= u BY <2>1, MinProp
  <2>3. \A m \in 0..(Min(S) - 1) : Q(m) BY <2>2
  <2>. QED BY <2>2, <2>3, <1>1
<1>. QED BY <1>2 DEF ChainShape, Epochs

\* No ancestor allocated x: the walk ends at 0.
LEMMA ReadBottom ==
  ASSUME NEW P, NEW Par, NEW An, NEW Al, NEW Con,
         ChainShape(P, Par, An), ChainReads(P, Par, Al, Con),
         NEW x \in Blocks
  PROVE  \A e \in P : (\A f \in An[e] : x \notin Al[f]) => Con[e][x] = 0
<1>. DEFINE Q(n) == n \in P => ((\A f \in An[n] : x \notin Al[f]) => Con[n][x] = 0)
<1>1. \A n \in Nat : (\A m \in 0..(n-1) : Q(m)) => Q(n)
  <2>. SUFFICES ASSUME NEW n \in Nat, \A m \in 0..(n-1) : Q(m), n \in P,
                      \A f \in An[n] : x \notin Al[f]
               PROVE  Con[n][x] = 0
    OBVIOUS
  <2>1. Par[n] < n /\ (Par[n] # 0 => Par[n] \in P) /\ Par[n] \in 0..MaxEpoch BY DEF ChainShape
  <2>2. An[n] = {n} \cup (IF Par[n] = 0 THEN {} ELSE An[Par[n]]) BY DEF ChainShape
  <2>3. Con[n][x] = Up(Par, Con, Par[n], x) BY <2>2 DEF ChainReads
  <2>4. CASE Par[n] = 0 BY <2>3, <2>4 DEF Up
  <2>5. CASE Par[n] # 0
    <3>1. Par[n] \in 0..(n-1) /\ Par[n] \in P BY <2>1, <2>5, Const
    <3>2. \A f \in An[Par[n]] : x \notin Al[f] BY <2>2, <2>5
    <3>. QED BY <2>3, <2>5, <3>1, <3>2 DEF Up
  <2>. QED BY <2>4, <2>5
<1>2. \A n \in Nat : Q(n)
  <2>. HIDE DEF Q
  <2>. SUFFICES ASSUME NEW n0 \in Nat, ~Q(n0) PROVE FALSE OBVIOUS
  <2>. DEFINE S == {n \in Nat : ~Q(n)}
  <2>1. S \in SUBSET Nat /\ S # {} OBVIOUS
  <2>2. Min(S) \in S /\ \A u \in S : Min(S) <= u BY <2>1, MinProp
  <2>3. \A m \in 0..(Min(S) - 1) : Q(m) BY <2>2
  <2>. QED BY <2>2, <2>3, <1>1
<1>. QED BY <1>2 DEF ChainShape, Epochs

\* The ancestors at or above lo that allocated x; all of them.
RT(An, Al, e, lo, x) == {f \in An[e] : lo <= f /\ x \in Al[f]}
RTall(An, Al, e, x) == {f \in An[e] : x \in Al[f]}

\* A snapshot k cut on top of a chain (its parent h, the head's).
LEMMA ChainExtend ==
  ASSUME NEW P, NEW Par, NEW An, ChainShape(P, Par, An),
         NEW P2, NEW Par2, NEW An2, NEW k \in Epochs, NEW h \in 0..MaxEpoch,
         k \notin P, h < k, h # 0 => h \in P,
         P2 = P \cup {k}, Par2[k] = h, An2[k] = {k} \cup (IF h = 0 THEN {} ELSE An[h]),
         \A e \in P : Par2[e] = Par[e] /\ An2[e] = An[e]
  PROVE  ChainShape(P2, Par2, An2)
<1>1. \A e \in P : Par[e] # 0 => Par[e] \in P /\ Par[e] # k BY DEF ChainShape
<1>. QED BY <1>1 DEF ChainShape

LEMMA ChainReadsExtend ==
  ASSUME NEW P, NEW Par, NEW Al, NEW Con, NEW An, ChainShape(P, Par, An), ChainReads(P, Par, Al, Con),
         NEW P2, NEW Par2, NEW Al2, NEW Con2, NEW k \in Epochs, NEW h \in 0..MaxEpoch,
         k \notin P, h # 0 => h \in P,
         P2 = P \cup {k}, Par2[k] = h,
         \A x \in Blocks : x \notin Al2[k] => Con2[k][x] = Up(Par, Con, h, x),
         \A e \in P : Par2[e] = Par[e] /\ Al2[e] = Al[e] /\ Con2[e] = Con[e]
  PROVE  ChainReads(P2, Par2, Al2, Con2)
<1>1. \A e \in P : Par[e] # 0 => Par[e] \in P /\ Par[e] # k BY DEF ChainShape
<1>2. h # 0 => Con2[h] = Con[h] BY DEF ChainShape
<1>. QED BY <1>1, <1>2 DEF ChainReads, Up

\* ReadThrough at one e and lo, the set named (what callers apply).
LEMMA ReadAt ==
  ASSUME NEW P, NEW Par, NEW An, NEW Al, NEW Con,
         ChainShape(P, Par, An), ChainReads(P, Par, Al, Con),
         NEW x \in Blocks, NEW e \in P, NEW lo \in An[e]
  PROVE  /\ RT(An, Al, e, lo, x) = {} => Con[e][x] = Up(Par, Con, Par[lo], x)
         /\ RT(An, Al, e, lo, x) # {} =>
              /\ Max(RT(An, Al, e, lo, x)) \in RT(An, Al, e, lo, x)
              /\ Con[e][x] = Con[Max(RT(An, Al, e, lo, x))][x]
<1>1. \A ee \in P : \A ll \in An[ee] :
        LET H == {f \in An[ee] : ll <= f /\ x \in Al[f]}
        IN  /\ H = {} => Con[ee][x] = Up(Par, Con, Par[ll], x)
            /\ H # {} => Con[ee][x] = Con[Max(H)][x] /\ Max(H) \in H
  BY ReadThrough, IsaT(300)
<1>. QED BY <1>1 DEF RT

\* Reading through the whole walk: the newest ancestor that allocated x.
LEMMA ReadMax ==
  ASSUME NEW P, NEW Par, NEW An, NEW Al, NEW Con,
         ChainShape(P, Par, An), ChainReads(P, Par, Al, Con),
         NEW x \in Blocks, NEW e \in P, RTall(An, Al, e, x) # {}
  PROVE  Max(RTall(An, Al, e, x)) \in RTall(An, Al, e, x) /\ Con[e][x] = Con[Max(RTall(An, Al, e, x))][x]
<1>0. e \in An[e] /\ An[e] \subseteq P /\ \A f \in An[e] : f <= e BY AncBound
<1>1. An[e] \subseteq Nat /\ An[e] # {} BY <1>0, Const DEF ChainShape, Epochs
<1>2. Min(An[e]) \in An[e] /\ \A f \in An[e] : Min(An[e]) <= f BY <1>1, MinProp
<1>3. RT(An, Al, e, Min(An[e]), x) = RTall(An, Al, e, x) BY <1>2 DEF RT, RTall
<1>4. RT(An, Al, e, Min(An[e]), x) # {} =>
        /\ Max(RT(An, Al, e, Min(An[e]), x)) \in RT(An, Al, e, Min(An[e]), x)
        /\ Con[e][x] = Con[Max(RT(An, Al, e, Min(An[e]), x))][x]
  BY <1>2, ReadAt
<1>. QED BY <1>3, <1>4

\* Under the invariant, leg s's lineage is a snapshot chain, and the copy's
\* elements from lo through t are t's own ancestors from lo up.
LEMMA LegChain ==
  ASSUME I_Lineage, I_Chain, TypeOKT, NEW s \in R
  PROVE  /\ ChainShape(sPres[s], sPar[s], anc[s])
         /\ ChainReads(sPres[s], sPar[s], sAl[s], sCon[s])
BY DEF I_Lineage, I_Chain

LEMMA LinPrefix ==
  ASSUME I_Lineage, I_Ranges, TypeOKT, NEW s \in R, NEW t \in Lin(s)
  PROVE  /\ t \in sPres[s] /\ hPar[s] \in sPres[s]
         /\ anc[s][t] = {g \in Lin(s) : g <= t}
<1>1. hPar[s] # 0 /\ Lin(s) = anc[s][hPar[s]] BY DEF Lin, AncOf
<1>2. hPar[s] \in sPres[s] BY <1>1 DEF I_Ranges
<1>3. ChainShape(sPres[s], sPar[s], anc[s]) BY DEF I_Lineage
<1>4. anc[s][hPar[s]] \subseteq sPres[s] BY <1>2, <1>3, AncBound
<1>5. anc[s][t] = {g \in anc[s][hPar[s]] : g <= t} BY <1>1, <1>2, <1>3, AncPrefix
<1>. QED BY <1>1, <1>2, <1>4, <1>5

LEMMA LinSub ==
  ASSUME I_Lineage, I_Ranges, TypeOKT, NEW s \in R PROVE Lin(s) \subseteq sPres[s]
<1>1. CASE hPar[s] = 0 BY <1>1 DEF Lin, AncOf
<1>2. CASE hPar[s] # 0
  <2>1. hPar[s] \in sPres[s] BY <1>2 DEF I_Ranges
  <2>2. ChainShape(sPres[s], sPar[s], anc[s]) BY DEF I_Lineage
  <2>. QED BY <1>2, <2>1, <2>2, AncBound DEF Lin, AncOf
<1>. QED BY <1>1, <1>2

\* A new snapshot k on leg q, its parent the head's parent: the chain stays
\* a chain (specialized to a leg, so a step instantiates only q and k).
LEMMA LegExtend ==
  ASSUME I_Lineage, I_Chain, I_Ranges, TypeOKT, NEW q \in R, NEW k \in Epochs,
         k \notin sPres[q], hPar[q] < k,
         sPres'[q] = sPres[q] \cup {k}, sPar'[q][k] = hPar[q],
         anc'[q][k] = {k} \cup (IF hPar[q] = 0 THEN {} ELSE anc[q][hPar[q]]),
         \A e \in sPres[q] : /\ sPar'[q][e] = sPar[q][e] /\ anc'[q][e] = anc[q][e]
                            /\ sAl'[q][e] = sAl[q][e] /\ sCon'[q][e] = sCon[q][e],
         \A x \in Blocks : x \notin sAl'[q][k] => sCon'[q][k][x] = Up(sPar[q], sCon[q], hPar[q], x)
  PROVE  ChainShape(sPres'[q], sPar'[q], anc'[q]) /\ ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q])
<1>1. ChainShape(sPres[q], sPar[q], anc[q]) /\ ChainReads(sPres[q], sPar[q], sAl[q], sCon[q])
  BY DEF I_Lineage, I_Chain
<1>2. hPar[q] \in sPres[q] \cup {0} /\ hPar[q] \in 0..MaxEpoch BY DEF I_Ranges, TypeOKT, TyHead
<1>3. \A e \in sPres[q] : /\ sPar[q][e] \in 0..MaxEpoch /\ sPar[q][e] < e
                         /\ (sPar[q][e] # 0 => sPar[q][e] \in sPres[q] /\ sPar[q][e] # k)
                         /\ anc[q][e] = {e} \cup (IF sPar[q][e] = 0 THEN {} ELSE anc[q][sPar[q][e]])
  BY <1>1 DEF ChainShape
<1>4. sPres[q] \subseteq Epochs BY DEF TypeOKT, TySnap
<1>5. ChainShape(sPres'[q], sPar'[q], anc'[q])
  <2>1. sPres'[q] \subseteq Epochs BY <1>4
  <2>2. ASSUME NEW e \in sPres'[q]
        PROVE  /\ sPar'[q][e] \in 0..MaxEpoch /\ sPar'[q][e] < e
               /\ (sPar'[q][e] # 0 => sPar'[q][e] \in sPres'[q])
               /\ anc'[q][e] = {e} \cup (IF sPar'[q][e] = 0 THEN {} ELSE anc'[q][sPar'[q][e]])
    <3>1. CASE e = k
      <4>1. hPar[q] # 0 => anc'[q][hPar[q]] = anc[q][hPar[q]] BY <1>2
      <4>. QED BY <3>1, <1>2, <4>1
    <3>2. CASE e # k
      <4>1. e \in sPres[q] BY <3>2
      <4>2. sPar[q][e] # 0 => anc'[q][sPar[q][e]] = anc[q][sPar[q][e]] BY <4>1, <1>3
      <4>. QED BY <4>1, <4>2, <1>3
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <2>1, <2>2 DEF ChainShape
<1>6. ChainReads(sPres'[q], sPar'[q], sAl'[q], sCon'[q])
  <2>. SUFFICES ASSUME NEW e \in sPres'[q], NEW x \in Blocks, x \notin sAl'[q][e]
               PROVE  sCon'[q][e][x] = Up(sPar'[q], sCon'[q], sPar'[q][e], x)
    BY DEF ChainReads
  <2>1. CASE e = k
    <3>1. hPar[q] # 0 => sCon'[q][hPar[q]] = sCon[q][hPar[q]] BY <1>2
    <3>. QED BY <2>1, <3>1 DEF Up
  <2>2. CASE e # k
    <3>1. e \in sPres[q] /\ x \notin sAl[q][e] BY <2>2
    <3>2. sCon[q][e][x] = Up(sPar[q], sCon[q], sPar[q][e], x) BY <3>1, <1>1 DEF ChainReads
    <3>3. sPar[q][e] # 0 => sCon'[q][sPar[q][e]] = sCon[q][sPar[q][e]] BY <3>1, <1>3
    <3>. QED BY <3>1, <3>2, <3>3 DEF Up
  <2>. QED BY <2>1, <2>2
<1>. QED BY <1>5, <1>6

LEMMA CopyRead ==
  ASSUME I_Lineage, I_Chain, I_Ranges, TypeOKT, NEW s \in R, NEW t \in Lin(s),
         NEW lo \in Nat, lo = 0 \/ (lo \in Lin(s) /\ lo <= t), NEW x \in Blocks
  PROVE  LET H == {e \in CopyElems(s, lo, t) : x \in sAl[s][e]}
         IN  /\ H # {} => Max(H) \in H /\ sCon[s][Max(H)][x] = sCon[s][t][x]
             /\ H = {} /\ lo # 0 => sCon[s][t][x] = Up(sPar[s], sCon[s], sPar[s][lo], x)
             /\ H = {} /\ lo = 0 => sCon[s][t][x] = 0
<1>. DEFINE H == {e \in CopyElems(s, lo, t) : x \in sAl[s][e]}
<1>0. ChainShape(sPres[s], sPar[s], anc[s]) /\ ChainReads(sPres[s], sPar[s], sAl[s], sCon[s])
  BY LegChain
<1>1. t \in sPres[s] /\ anc[s][t] = {g \in Lin(s) : g <= t} BY LinPrefix
<1>2. Lin(s) \subseteq Nat BY LinType DEF TypeOKT, TyHead, TySnap, Epochs
<1>3. H = {f \in anc[s][t] : lo <= f /\ x \in sAl[s][f]} BY <1>1, <1>2 DEF CopyElems
<1>4. CASE lo # 0
  <2>1. lo \in anc[s][t] BY <1>1, <1>4
  <2>2. /\ RT(anc[s], sAl[s], t, lo, x) = {} => sCon[s][t][x] = Up(sPar[s], sCon[s], sPar[s][lo], x)
        /\ RT(anc[s], sAl[s], t, lo, x) # {} =>
              /\ Max(RT(anc[s], sAl[s], t, lo, x)) \in RT(anc[s], sAl[s], t, lo, x)
              /\ sCon[s][t][x] = sCon[s][Max(RT(anc[s], sAl[s], t, lo, x))][x]
    <3>1. ChainShape(sPres[s], sPar[s], anc[s]) /\ ChainReads(sPres[s], sPar[s], sAl[s], sCon[s]) BY <1>0
    <3>2. t \in sPres[s] /\ lo \in anc[s][t] BY <1>1, <2>1
    <3>. QED BY <3>1, <3>2, ReadAt
  <2>3. H = RT(anc[s], sAl[s], t, lo, x) BY <1>3 DEF RT
  <2>. QED BY <1>4, <2>2, <2>3
<1>5. CASE lo = 0
  <2>1. \A f \in anc[s][t] : 0 <= f BY <1>1, <1>2
  <2>2. H = {f \in anc[s][t] : x \in sAl[s][f]} BY <1>3, <1>5, <2>1
  <2>a. H = RTall(anc[s], sAl[s], t, x) BY <2>2 DEF RTall
  <2>b. ChainShape(sPres[s], sPar[s], anc[s]) /\ ChainReads(sPres[s], sPar[s], sAl[s], sCon[s]) /\ t \in sPres[s]
    BY <1>0, <1>1
  <2>3. H # {} => Max(H) \in H /\ sCon[s][t][x] = sCon[s][Max(H)][x]
    <3>1. RTall(anc[s], sAl[s], t, x) # {} =>
            Max(RTall(anc[s], sAl[s], t, x)) \in RTall(anc[s], sAl[s], t, x)
            /\ sCon[s][t][x] = sCon[s][Max(RTall(anc[s], sAl[s], t, x))][x]
      BY <2>b, ReadMax
    <3>. QED BY <3>1, <2>a
  <2>4. H = {} => sCon[s][t][x] = 0
    <3>1. \A e \in sPres[s] : (\A f \in anc[s][e] : x \notin sAl[s][f]) => sCon[s][e][x] = 0
      BY <2>b, ReadBottom
    <3>. QED BY <3>1, <2>b, <2>2
  <2>. QED BY <1>5, <2>3, <2>4
<1>. QED BY <1>4, <1>5

------------------------------------------------------------------------
-----------------------------------------------------------------------------
(* (S) The type layer, part 1: Init, and every old action that leaves the   *)
(* stamp alone (NoStamp) or holds it (LossS).  The shared-variable half is  *)
(* the copied T_* lemma; the stamp half carries over or is two booleans.    *)

LEMMA S_NR == NR \in Nat /\ NR >= 1
<1>1. IsFiniteSet(R) /\ R # {} BY Const DEF R
<1>2. Cardinality(R) \in Nat BY <1>1, FS_CardinalityType
<1>3. Cardinality(R) # 0 BY <1>1, FS_EmptySet
<1>. QED BY <1>2, <1>3 DEF NR, R

LEMMA S_TyInit == Init => TypeOK
<1>. SUFFICES ASSUME Init PROVE TypeOKT /\ TyStampS BY TypeOKParts
<1>1. TypeOKT BY T_Init
<1>2. TyStA
  <2>1. NR \in Nat /\ NR >= 1 /\ MaxAsm \in Nat /\ MaxAsm >= 1 BY S_NR, Const
  <2>2. stamp \in [R -> StampRec] BY <2>1 DEF Init, StampRec, R
  <2>3. /\ nseq \in 1..MaxAsm /\ aseq \in 1..MaxAsm /\ agen \in 0..(NR + 1) /\ asize \in 0..NR
        /\ rgenA \in 0..(NR + 1) /\ rmemA \in SUBSET R /\ zrgen \in 0..(NR + 1) /\ zrmem \in SUBSET R
    BY <2>1 DEF Init
  <2>4. /\ hold \in BOOLEAN /\ due \in BOOLEAN
        /\ sole \subseteq (1..MaxAsm) \X (0..(NR + 1)) \X SUBSET R
        /\ zseq \in 0..MaxAsm /\ zgen \in 0..(NR + 1) /\ zsize \in 0..NR /\ zm0 \in SUBSET R /\ zst \in BOOLEAN
    BY <2>1 DEF Init
  <2>. QED BY <2>2, <2>3, <2>4 DEF TyStA
<1>3. TyGh BY DEF Init, TyGh
<1>. QED BY <1>1, <1>2, <1>3, TyStampSplit

\* the stamp half of an action that leaves the stamp alone, or holds it
LEMMA S_TyKeep == ASSUME TypeOK, TypeOKT', NoStamp PROVE TypeOK'
BY TypeOKParts, TypeOKPartsP, C_NoStamp

LEMMA C_LossS == ASSUME TyStampS, NEW r \in R, LossS(r) PROVE TyStampS'
<1>1. CASE Stamp /\ attached /\ r \in members
  <2>1. /\ hold' = TRUE /\ due' = TRUE
        /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zm0,
                       zrgen, zrmem, zst, sGhost>>
    BY <1>1 DEF LossS
  <2>2. TyStA' BY <2>1, TyStampSplit DEF TyStA
  <2>3. TyGh' BY <2>1, TyStampSplit DEF TyGh, sGhost
  <2>. QED BY <2>2, <2>3, TyStampSplitP
<1>2. CASE ~(Stamp /\ attached /\ r \in members) BY <1>2, C_NoStamp DEF LossS
<1>. QED BY <1>1, <1>2

LEMMA S_TyLossKeep == ASSUME TypeOK, TypeOKT', NEW r \in R, LossS(r) PROVE TypeOK'
BY TypeOKParts, TypeOKPartsP, C_LossS

LEMMA S_TySubmit == ASSUME TypeOK, NEW x \in Blocks, Submit(x) /\ NoStamp PROVE TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_Submit
<1>. QED BY <1>1, S_TyKeep

LEMMA S_TyComplete ==
  ASSUME TypeOK, NEW w \in pend,
         Complete(w) /\ badAck' = (badAck \/ (Stamp /\ \E q \in members : Core(stamp[q]) # Core(CurStamp)))
                     /\ UNCHANGED <<stampVars, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  PROVE  TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_Complete
<1>2. TyStA' BY TypeOKParts, TyStampSplit, C_StA
<1>3. TyGh' BY TypeOKParts, TyStampSplit DEF TyGh
<1>. QED BY <1>1, <1>2, <1>3, TyStampSplitP, TypeOKPartsP

LEMMA S_TyLand == ASSUME TypeOK, NEW w \in pend, NEW r \in R, Land(w, r) /\ NoStamp PROVE TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_Land
<1>. QED BY <1>1, S_TyKeep

LEMMA S_TyDrop == ASSUME TypeOK, NEW w \in pend, NEW r \in R, Drop(w, r) /\ LossS(r) PROVE TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_Drop
<1>. QED BY <1>1, S_TyLossKeep

LEMMA S_TyPath ==
  ASSUME TypeOK, NEW r \in R,
         \/ FailBegin(r) /\ NoStamp
         \/ FaultOut(r) /\ LossS(r)
         \/ MarkStale(r) /\ ~(Stamp /\ MonitorSkipsHold /\ hold) /\ NoStamp
         \/ Return(r) /\ NoStamp
  PROVE  TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_Path
<1>. QED BY <1>1, S_TyKeep, S_TyLossKeep

LEMMA S_TyObserve == ASSUME TypeOK, NEW e \in Epochs, Observe(e) /\ NoStamp PROVE TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_Observe
<1>. QED BY <1>1, S_TyKeep

\* (the cut's own range, cutK # 0 => cutK = nextSeq, is a conjunct of the invariant: I_RangesS)
LEMMA S_TyCutSmall ==
  ASSUME TypeOK, cutK # 0 => cutK = nextSeq,
         (CutBegin \/ CutRecord \/ CutAbort \/ CutAbortRead \/ Retire) /\ NoStamp
  PROVE  TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_CutSmall
<1>. QED BY <1>1, S_TyKeep

LEMMA S_TyCutGC == ASSUME TypeOK, NEW r \in R, (CutOne(r) \/ \E e \in Epochs : GC(r, e)) /\ NoStamp PROVE TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_CutOne, T_GC
<1>. QED BY <1>1, S_TyKeep

LEMMA S_TyCatchup ==
  ASSUME TypeOK, NEW r \in R,
         (SelectBase(r) \/ RevertD(r) \/ BulkCopy(r) \/ SessionFail(r) \/ Chase(r)) /\ NoStamp
  PROVE  TypeOK'
<1>1. TypeOKT' BY TypeOKParts, T_SelectBase, T_RevertD, T_BulkCopy, T_SessionFail, T_Chase
<1>. QED BY <1>1, S_TyKeep

\* the drain (the user, 10-31: "adopt the planned-removal stamp"): r marked stale and removed, held as a loss
LEMMA S_TyDrain ==
  ASSUME TypeOK, NEW r \in R, Drain(r) /\ (IF DrainStamps THEN LossS(r) ELSE NoStamp) PROVE TypeOK'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY TypeOKParts, Groups
<1>1. /\ StaleMarks({r}) /\ members' = members \ {r}
      /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq, cutK, cutTgt, cutDone,
                     cutGone, attached, path, mark, reverted, sb, pin, pend, acked, fails, riskRec, badAdmit, badLoss,
                     ackedEver, zx>>
      /\ UNCHANGED <<used, mustRev, trustVars>>
  BY DEF Drain
<1>2. TyLeg' /\ TyTie' BY <1>0, <1>1, T_StaleMarks
<1>3. TySets' BY <1>0, <1>1 DEF TySets
<1>4. TypeOKT' BY <1>0, <1>1, <1>2, <1>3, C_Scalar, C_Head, C_Snap, C_Pend, C_Trust, GroupsP
<1>5. TyStampS'
  <2>1. CASE DrainStamps BY <2>1, TypeOKParts, C_LossS
  <2>2. CASE ~DrainStamps BY <2>2, TypeOKParts, C_NoStamp
  <2>. QED BY <2>1, <2>2
<1>. QED BY <1>4, <1>5, TypeOKPartsP

-----------------------------------------------------------------------------
(* The type layer, S: the zombie's disjuncts of Next, the raid's end, the  *)
(* expiry stage.  Each keeps TypeOK = TypeOKT /\ TyStA /\ TyGh.            *)

LEMMA ZA_NRNat == NR \in Nat
BY Const, FS_CardinalityType DEF NR, R

\* CrashUnstage's half over the T variables (T's Clean had Crash = FALSE).
LEMMA ZA_T_CrashUnstage ==
  ASSUME TypeOKT, CrashUnstage PROVE TypeOKT'
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY Groups
<1>u. UNCHANGED <<ver, nextSeq, fails, badAdmit, badLoss, zx>> /\ UNCHANGED recorded
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED acked /\ UNCHANGED tieVars /\ UNCHANGED <<cfgAt, tr, cutAck>>
  BY DEF CrashUnstage
<1>1. /\ attached' = FALSE /\ members' = {} /\ pend' = {}
      /\ cutK' = 0 /\ cutTgt' = {} /\ cutDone' = {} /\ cutGone' = {}
      /\ conf' = [e \in Epochs |-> TRUE] /\ htr' = [q \in R |-> FALSE]
  BY Full DEF CrashUnstage
<1>2. ackedEver' = [x \in Blocks |-> ackedEver[x] \cup
                     {w.v : w \in {u \in pend : u.b = x /\ u.landed # {}}}]
  BY DEF CrashUnstage
<1>3. TyScalar' BY <1>0, <1>u, <1>1, Const DEF TyScalar
<1>4. TySets' BY <1>0, <1>u, <1>1 DEF TySets
<1>5. TyPend'
  <2>1. \A w \in pend : w.v \in Vers BY <1>0 DEF TyPend, Write, Vers
  <2>2. ackedEver' \in [Blocks -> SUBSET Vers] BY <1>0, <1>2, <2>1 DEF TyPend
  <2>. QED BY <1>0, <1>u, <1>1, <2>2 DEF TyPend
<1>6. TyTrust' BY <1>0, <1>u, <1>1 DEF TyTrust
<1>. QED BY <1>0, <1>u, <1>3, <1>4, <1>5, <1>6, C_Leg, C_Head, C_Snap, C_Tie, GroupsP

\* the zombie's write (not a released raid's): ver, z's head, its riskRec,
\* the write hole; the ghosts zjv and zpost
LEMMA S_TyZombie ==
  ASSUME TypeOK, NEW r \in R, NEW x \in Blocks,
         Zombie(r, x) /\ ~ZombieReleases /\ zjv' = zjv \cup {ver + 1}
                                  /\ zpost' = (IF Stamp /\ zst THEN zpost \cup {ver + 1} ELSE zpost)
                                  /\ UNCHANGED <<stampVars, badAck, zAcked, zfreed, zLeg, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare>>
  PROVE  TypeOK'
<1>t. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>t, Groups
<1>z. Zombie(r, x) OBVIOUS
<1>u. UNCHANGED <<nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, restamp>>
      /\ UNCHANGED hPar /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked>> /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY <1>z DEF Zombie
<1>v. ver + 1 \in 1..MaxVer /\ ver' = ver + 1 BY <1>0, <1>z, Const DEF Zombie, TyScalar, Vers
<1>1. TyScalar' BY <1>0, <1>u, <1>v DEF TyScalar, Vers
<1>2. TyLeg'
  <2>1. riskRec[r] \in 0..NoRisk BY <1>0 DEF TyLeg
  <2>2. Latest \in 0..MaxEpoch BY <1>0, LatestType
  <2>3. riskRec[r] \in Nat /\ Latest \in Nat BY <2>1, <2>2, NoRiskNat
  <2>4. Min({riskRec[r], Latest}) \in {riskRec[r], Latest} BY <2>3, Min2
  <2>5. Min({riskRec[r], Latest}) \in 0..NoRisk BY <2>1, <2>2, <2>4, NoRiskNat, Const
  <2>6. riskRec' = [riskRec EXCEPT ![r] = Min({riskRec[r], Latest})] BY <1>z DEF Zombie
  <2>7. riskRec' \in [R -> 0..NoRisk] BY <1>0, <2>5, <2>6 DEF TyLeg
  <2>. QED BY <1>0, <1>u, <2>7 DEF TyLeg
<1>3. TyHead'
  <2>1. head' = [head EXCEPT ![r][x] = ver + 1] /\ hAl' = [hAl EXCEPT ![r] = @ \cup {x}] BY <1>z DEF Zombie
  <2>. QED BY <1>0, <1>u, <1>v, <2>1 DEF TyHead, Vers
<1>4. TyPend'
  <2>1. ackedEver' = IF Stamp /\ ZombiePreStampLegal /\ ~zst THEN [ackedEver EXCEPT ![x] = @ \cup {ver + 1}]
                                                              ELSE ackedEver
    BY <1>z DEF Zombie
  <2>. QED BY <1>0, <1>u, <1>v, <2>1 DEF TyPend, Vers
<1>T. TypeOKT' BY <1>0, <1>u, <1>1, <1>2, <1>3, <1>4, C_Sets, C_Snap, C_Tie, C_Trust, GroupsP
<1>s. /\ UNCHANGED stampVars
      /\ UNCHANGED <<badAck, zAcked, zfreed, zLeg, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare>>
      /\ zjv' = zjv \cup {ver + 1}
      /\ zpost' = (IF Stamp /\ zst THEN zpost \cup {ver + 1} ELSE zpost)
  OBVIOUS
<1>5. TyStA' BY <1>t, <1>s, C_StA
<1>6. TyGh' BY <1>t, <1>s, <1>v DEF TyGh, Vers
<1>. QED BY <1>T, <1>5, <1>6, TyStampSplitP, TypeOKPartsP

\* a zombie whose raid was a confirmed sole continuation acks on z
LEMMA S_TyZombieAck ==
  ASSUME TypeOK, NEW x \in Blocks, ZombieAck(x) PROVE TypeOK'
<1>t. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>t, Groups
<1>z. zx \in R BY <1>0 DEF ZombieAck, ZombieReleases, TyScalar
<1>v. ver + 1 \in 1..MaxVer /\ ver' = ver + 1 BY <1>0, Const DEF ZombieAck, TyScalar, Vers
<1>u. UNCHANGED <<nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED hPar /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED pend /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF ZombieAck
<1>1. TyScalar' BY <1>0, <1>u, <1>v DEF TyScalar, Vers
<1>2. TyHead'
  <2>1. head' = [head EXCEPT ![zx][x] = ver + 1] /\ hAl' = [hAl EXCEPT ![zx] = @ \cup {x}] BY DEF ZombieAck
  <2>. QED BY <1>0, <1>u, <1>v, <1>z, <2>1 DEF TyHead, Vers
<1>3. TyPend'
  <2>1. acked' = [acked EXCEPT ![x] = ver + 1] /\ ackedEver' = [ackedEver EXCEPT ![x] = @ \cup {ver + 1}]
    BY DEF ZombieAck
  <2>. QED BY <1>0, <1>u, <1>v, <2>1 DEF TyPend, Vers
<1>T. TypeOKT' BY <1>0, <1>u, <1>1, <1>2, <1>3, C_Sets, C_Leg, C_Snap, C_Tie, C_Trust, GroupsP
<1>s. /\ UNCHANGED stampVars /\ zAcked' = TRUE
      /\ UNCHANGED <<badAck, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  BY DEF ZombieAck
<1>4. TyStA' BY <1>t, <1>s, C_StA
<1>5. TyGh' BY <1>t, <1>s DEF TyGh
<1>. QED BY <1>T, <1>4, <1>5, TyStampSplitP, TypeOKPartsP

\* the raid goes away (unstage, crash): no barrier survives it
LEMMA S_TyEndRaid ==
  ASSUME TypeOK, (Unstage \/ CrashUnstage) /\ EndRaidS PROVE TypeOK'
<1>t. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>1. TypeOKT'
  <2>1. CASE Unstage BY <1>t, <2>1, T_Unstage
  <2>2. CASE CrashUnstage BY <1>t, <2>2, ZA_T_CrashUnstage
  <2>. QED BY <2>1, <2>2
<1>e. /\ hold' = FALSE /\ due' = FALSE
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
      /\ UNCHANGED sGhost
  BY DEF EndRaidS
<1>2. TyStA' BY <1>t, <1>e DEF TyStA
<1>3. TyGh' BY <1>t, <1>e, C_Gh
<1>. QED BY <1>1, <1>2, <1>3, TyStampSplitP, TypeOKPartsP

\* the zombie move (Full: StageDefer, no FenceMark): the raid detaches, the
\* zombie raid keeps the old assembly
LEMMA S_TyZombieMove ==
  ASSUME TypeOK, ZombieMove /\ MoveS PROVE TypeOK'
<1>t. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>t, Groups
<1>1. PICK z \in members : /\ zx' = z /\ attached' = FALSE /\ members' = {}
                           /\ path' = [path EXCEPT ![z] = "back"]
                           /\ dState' = [q \in R |-> IF q \in {} THEN "stale" ELSE dState[q]]
                           /\ restamp' = [q \in R |-> IF q \in {} THEN FALSE ELSE restamp[q]]
                           /\ UNCHANGED <<tainted, floor>>
  BY Full DEF ZombieMove, StaleMarks
<1>u. UNCHANGED <<ver, nextSeq, cutK, fails, badAdmit, badLoss>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone>>
      /\ UNCHANGED <<mark, reverted, sb, pin, riskRec, used, mustRev>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED <<cfgAt, tr, cutAck>>
  BY DEF ZombieMove
<1>2. conf' = [e \in Epochs |-> TRUE] /\ htr' = [q \in R |-> FALSE] BY Full DEF ZombieMove
<1>3. z \in R BY <1>0, <1>1 DEF TySets
<1>4. TyScalar' BY <1>0, <1>u, <1>1, <1>3 DEF TyScalar
<1>5. TySets' BY <1>0, <1>u, <1>1 DEF TySets
<1>6. TyLeg' /\ TyTie'
  <2>1. path' \in [R -> {"ok", "failing", "out", "back"}] BY <1>0, <1>1 DEF TyLeg
  <2>2. dState' \in [R -> {"insync", "stale", "standby"}] /\ restamp' \in [R -> BOOLEAN]
    BY <1>0, <1>1 DEF TyLeg
  <2>. QED BY <1>0, <1>u, <1>1, <2>1, <2>2 DEF TyLeg, TyTie
<1>7. TyTrust' BY <1>0, <1>u, <1>2 DEF TyTrust
<1>T. TypeOKT' BY <1>0, <1>u, <1>4, <1>5, <1>6, <1>7, C_Head, C_Snap, C_Pend, GroupsP
<1>m. /\ zseq' = aseq /\ zgen' = agen /\ zsize' = asize /\ zm0' = members /\ zst' = FALSE
      /\ zrgen' = rgenA /\ zrmem' = rmemA /\ hold' = FALSE /\ due' = FALSE
      /\ zLeg' = zx' /\ zjv' = {} /\ zexcl' = FALSE /\ postMove' = FALSE /\ legalJ' = [x \in Blocks |-> {}]
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, rgenA, rmemA, sole>>
      /\ UNCHANGED <<badAck, zAcked, zfreed, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  BY Full DEF MoveS
<1>8. TyStA' BY <1>t, <1>0, <1>m DEF TyStA, TySets
<1>9. TyGh' BY <1>t, <1>1, <1>3, <1>m DEF TyGh
<1>. QED BY <1>T, <1>8, <1>9, TyStampSplitP, TypeOKPartsP

\* the zombie's late monitor (Full: MarkGate, so never; proved for any knob)
LEMMA S_TyZombieMark ==
  ASSUME TypeOK, ZombieMark /\ NoStamp PROVE TypeOK'
<1>t. TypeOKT /\ TyStampS BY TypeOKParts
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>t, Groups
<1>1. /\ StaleMarks({q \in InSyncR : q # zx})
      /\ UNCHANGED <<path, mark, reverted, sb, pin, riskRec, used, mustRev>>
  BY DEF ZombieMark
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED trustVars
  BY DEF ZombieMark
<1>2. TyLeg' /\ TyTie' BY <1>0, <1>1, T_StaleMarks
<1>T. TypeOKT' BY <1>0, <1>u, <1>2, C_Scalar, C_Sets, C_Head, C_Snap, C_Pend, C_Trust, GroupsP
<1>S. TyStampS' BY <1>t, C_NoStamp
<1>. QED BY <1>T, <1>S, TypeOKPartsP

\* hygiene: the zombie's raid goes away; zfreed records the leg
LEMMA S_TyZombieHygiene ==
  ASSUME TypeOK,
         ZombieHygiene /\ zfreed' = zx /\ UNCHANGED <<stampVars, badAck, zAcked, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  PROVE  TypeOK'
<1>t. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>t, Groups
<1>h. ZombieHygiene OBVIOUS
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss>> /\ zx' = 0
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY <1>h DEF ZombieHygiene
<1>1. TyScalar' BY <1>0, <1>u DEF TyScalar
<1>T. TypeOKT' BY <1>0, <1>u, <1>1, C_Sets, C_Leg, C_Head, C_Snap, C_Pend, C_Tie, C_Trust, GroupsP
<1>s. /\ UNCHANGED stampVars /\ zfreed' = zx
      /\ UNCHANGED <<badAck, zAcked, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  OBVIOUS
<1>2. TyStA' BY <1>t, <1>s, C_StA
<1>3. TyGh' BY <1>t, <1>0, <1>s DEF TyGh, TyScalar
<1>. QED BY <1>T, <1>2, <1>3, TyStampSplitP, TypeOKPartsP

\* the zombie stamps its own leg (zseq, zgen + 1, zsize, {z})
LEMMA S_TyZombieStamp ==
  ASSUME TypeOK, ZombieStamp,
         zgen <= NR   \* NEEDS-INV: zgen <= NR (zgen is agen at the move; agen <= asize <= NR)
  PROVE  TypeOK'
<1>t. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>0. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>t, Groups
<1>u. /\ UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF ZombieStamp
<1>T. TypeOKT' BY <1>0, <1>u, C_Scalar, C_Sets, C_Leg, C_Head, C_Snap, C_Pend, C_Tie, C_Trust, GroupsP
<1>z. zx \in R BY <1>0 DEF ZombieStamp, TyScalar
<1>r. [seq |-> zseq, gen |-> zgen + 1, size |-> zsize, mem |-> {zx}, rgen |-> zrgen, rmem |-> zrmem] \in StampRec
  <2>1. /\ zseq \in 0..MaxAsm /\ zgen \in 0..(NR + 1) /\ zsize \in 0..NR
        /\ zrgen \in 0..(NR + 1) /\ zrmem \in SUBSET R
    BY <1>t DEF TyStA
  <2>2. zgen + 1 \in 0..(NR + 1) BY <2>1, ZA_NRNat
  <2>. QED BY <1>z, <2>1, <2>2 DEF StampRec, R
<1>s. /\ stamp' = [stamp EXCEPT ![zx] = [seq |-> zseq, gen |-> zgen + 1, size |-> zsize, mem |-> {zx},
                                         rgen |-> zrgen, rmem |-> zrmem]]
      /\ zst' = TRUE
      /\ UNCHANGED <<nseq, aseq, agen, asize, rgenA, rmemA, hold, due, sole, zseq, zgen, zsize, zm0, zrgen, zrmem>>
      /\ UNCHANGED sGhost
  BY DEF ZombieStamp
<1>1. stamp' \in [R -> StampRec] BY <1>t, <1>z, <1>r, <1>s DEF TyStA
<1>2. TyStA' BY <1>t, <1>s, <1>1 DEF TyStA
<1>3. TyGh' BY <1>t, <1>s, C_Gh
<1>. QED BY <1>T, <1>2, <1>3, TyStampSplitP, TypeOKPartsP

\* the defer's expiry: Full sets DeferExpires = FALSE, so StageRisk never fires
LEMMA S_TyStageRisk ==
  ASSUME TypeOK, StageRisk PROVE TypeOK'
BY Full DEF StageRisk

-----------------------------------------------------------------------------
(* (S) The type layer, part 3: the stamp's own actions (Stage, StageAdmit,  *)
(* AdmitRefuse, StampLand, Release, RecordConfirm, HeldFail, StageDecree).  *)
(* Each: the shared-variable half (the copied T_* lemma where the action is *)
(* the old model's), then the stamp half in its two groups.                 *)

\* a set of legs has at most NR members
LEMMA ZB_CardSub == ASSUME NEW S \in SUBSET R PROVE NR \in Nat /\ Cardinality(S) \in 0..NR
<1>1. IsFiniteSet(R) BY RNat
<1>2. IsFiniteSet(S) /\ Cardinality(S) <= Cardinality(R) BY <1>1, FS_Subset
<1>3. Cardinality(S) \in Nat /\ Cardinality(R) \in Nat BY <1>1, <1>2, FS_CardinalityType
<1>. QED BY <1>2, <1>3 DEF NR, R

\* the held writes completing as failed leave every landed version legal: a version
LEMMA ZB_AckedEverFail ==
  ASSUME TyPend,
         ackedEver' = [x \in Blocks |-> ackedEver[x] \cup {w.v : w \in {u \in pend : u.b = x /\ u.landed # {}}}]
  PROVE  ackedEver' \in [Blocks -> SUBSET Vers]
<1>1. \A w \in pend : w.v \in Vers BY Const DEF TyPend, Write, Vers
<1>2. \A x \in Blocks : ackedEver[x] \subseteq Vers BY DEF TyPend
<1>. QED BY <1>1, <1>2

\* an assembly of M (a fresh seq below MaxAsm) and a stamped stage's ghosts
LEMMA ZB_TyNewAsm ==
  ASSUME TyStA, TyGh, NEW M \in SUBSET R, nseq < MaxAsm, NewAsm(M), StageGhosts
  PROVE  TyStA' /\ TyGh'
<1>0. NR \in Nat /\ Cardinality(M) \in 0..NR BY ZB_CardSub
<1>n. MaxAsm \in Nat /\ nseq \in 1..MaxAsm BY Const DEF TyStA
<1>1. /\ nseq' = nseq + 1 /\ aseq' = nseq + 1 /\ agen' = 0 /\ asize' = Cardinality(M)
      /\ stamp' = [q \in R |-> IF q \in M THEN [seq |-> nseq + 1, gen |-> 0, size |-> Cardinality(M), mem |-> M,
                                                 rgen |-> 0, rmem |-> M]
                                           ELSE stamp[q]]
      /\ rgenA' = 0 /\ rmemA' = M
      /\ hold' = FALSE /\ due' = FALSE /\ zfreed' = 0
      /\ zexcl' = (zexcl \/ (zLeg # 0 /\ zLeg \notin M))
      /\ postMove' = (postMove \/ zLeg # 0)
      /\ legalJ' = IF zLeg # 0 /\ ~postMove
                     THEN [x \in Blocks |-> legalJ[x] \cup ({head'[q][x] : q \in M} \cap zjv)]
                     ELSE legalJ
      /\ UNCHANGED <<sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst, badAck, zAcked, zLeg, zjv>>
  BY Full DEF NewAsm
<1>2. [seq |-> nseq + 1, gen |-> 0, size |-> Cardinality(M), mem |-> M, rgen |-> 0, rmem |-> M] \in StampRec
  BY <1>0, <1>n DEF StampRec, R
<1>3. stamp' \in [R -> StampRec] BY <1>1, <1>2 DEF TyStA
<1>4. /\ nseq' \in 1..MaxAsm /\ aseq' \in 1..MaxAsm /\ agen' \in 0..(NR + 1) /\ asize' \in 0..NR
      /\ rgenA' \in 0..(NR + 1) /\ rmemA' \in SUBSET R
  BY <1>0, <1>n, <1>1
<1>5. TyStA' BY <1>1, <1>3, <1>4 DEF TyStA
<1>6. legalJ' \in [Blocks -> SUBSET Vers] BY <1>1 DEF TyGh
<1>7. /\ UNCHANGED <<riskTail, zpost>>
      /\ vouched' \in BOOLEAN /\ tornMarked' \in BOOLEAN /\ tornServed' \in BOOLEAN /\ tornBare' \in BOOLEAN
  BY DEF StageGhosts
<1>8. zfreed' \in R \cup {0} /\ zexcl' \in BOOLEAN /\ postMove' \in BOOLEAN BY <1>1
<1>9. TyGh' BY <1>1, <1>6, <1>7, <1>8 DEF TyGh
<1>. QED BY <1>5, <1>9

LEMMA S_TyStage ==
  ASSUME TypeOK, Stage PROVE TypeOK'
<1>0. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>1. TypeOKT' BY <1>0, T_Stage
<1>2. AsmSet \in SUBSET R BY AsmSetSub
<1>3. nseq < MaxAsm BY Full DEF Stage, CanStampStage
<1>4. NewAsm(AsmSet) /\ StageGhosts BY Full DEF Stage
<1>5. TyStA' /\ TyGh' BY <1>0, <1>2, <1>3, <1>4, ZB_TyNewAsm
<1>. QED BY <1>1, <1>5, TyStampSplitP, TypeOKPartsP

LEMMA S_TyStageAdmit ==
  ASSUME TypeOK, NEW r \in R,
         StageAdmit(r) /\ NewAsm(members') /\ (IF Stamp THEN StageGhosts ELSE TRUE)
  PROVE  TypeOK'
<1>0. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>1. TypeOKT' BY <1>0, T_StageAdmit
<1>2. members' = AsmSet \cup {r}
  <2>1. PICK s \in R : AdmGuard(r, s) /\ AdmSnap(r, s) /\ AdmRest(r, s) BY StageAdmitFacts
  <2>. QED BY <2>1 DEF AdmRest, AdmT
<1>3. members' \in SUBSET R BY <1>2, AsmSetSub
<1>4. nseq < MaxAsm BY Full DEF StageAdmit, CanStampStage
<1>5. NewAsm(members') /\ StageGhosts BY Full
<1>6. TyStA' /\ TyGh' BY <1>0, <1>3, <1>4, <1>5, ZB_TyNewAsm
<1>. QED BY <1>1, <1>6, TyStampSplitP, TypeOKPartsP

\* (Under Full, Policy = "trust": AdmitRefuse is disabled.  The proof below
\* does not lean on that.)
LEMMA S_TyAdmitRefuse ==
  ASSUME TypeOK, NEW r \in R, AdmitRefuse(r) /\ NoStamp PROVE TypeOK'
<1>0. TypeOKT /\ TyStampS BY TypeOKParts
<1>g. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>0, Groups
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED floor /\ UNCHANGED trustVars
  BY DEF AdmitRefuse
<1>a. /\ dState' = [dState EXCEPT ![r] = "stale"]
      /\ mustRev' = [mustRev EXCEPT ![r] = TRUE]
      /\ used' = [used EXCEPT ![r] = {}]
      /\ tainted' = [tainted EXCEPT ![r] = FALSE]
  BY DEF AdmitRefuse
<1>1. TyLeg' BY <1>g, <1>u, <1>a DEF TyLeg
<1>2. TyTie' BY <1>g, <1>u, <1>a DEF TyTie
<1>3. TypeOKT' BY <1>g, <1>u, <1>1, <1>2, C_Scalar, C_Sets, C_Head, C_Snap, C_Pend, C_Trust, GroupsP
<1>4. TyStampS' BY <1>0, C_NoStamp
<1>. QED BY <1>3, <1>4, TypeOKPartsP

\* StampLand's choice: the failing survivors G that fail the stamp write too
ZB_Must == {q \in members : path[q] \in {"out", "back"}}
ZB_May == {q \in members : path[q] = "failing"}
ZB_LS(G) == members \ (ZB_Must \cup G)
ZB_Pick(G) ==
  /\ members' = ZB_LS(G)
  /\ IF ZB_LS(G) = {}
       THEN /\ pend' = {}
            /\ ackedEver' = [x \in Blocks |-> ackedEver[x] \cup
                               {w.v : w \in {u \in pend : u.b = x /\ u.landed # {}}}]
            /\ UNCHANGED stamp
       ELSE /\ stamp' = [q \in R |-> IF q \in ZB_LS(G) THEN [seq |-> aseq, gen |-> agen + 1,
                                                             size |-> asize, mem |-> ZB_LS(G),
                                                             rgen |-> rgenA, rmem |-> rmemA]
                                                        ELSE stamp[q]]
            /\ UNCHANGED <<pend, ackedEver>>

LEMMA S_TyStampLand ==
  ASSUME TypeOK, StampLand,
         \* NEEDS-INV: agen <= NR (the landing's generation agen + 1 stays in 0..NR + 1)
         agen <= NR
  PROVE  TypeOK'
<1>0. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>g. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>0, Groups
<1>1. PICK G \in SUBSET ZB_May : ZB_Pick(G) BY DEF StampLand, ZB_Pick, ZB_LS, ZB_Must, ZB_May
<1>2. ZB_LS(G) \subseteq members /\ members \subseteq R BY <1>g DEF ZB_LS, TySets
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED acked /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF StampLand
<1>v. /\ agen' = agen + 1 /\ due' = FALSE
      /\ UNCHANGED <<nseq, aseq, asize, rgenA, rmemA, hold, sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
      /\ UNCHANGED sGhost
  BY DEF StampLand
<1>3. TySets' BY <1>g, <1>u, <1>1, <1>2 DEF ZB_Pick, TySets
<1>4. TyPend'
  <2>1. CASE ZB_LS(G) = {}
    <3>1. pend' = {} /\ ackedEver' = [x \in Blocks |-> ackedEver[x] \cup
                                        {w.v : w \in {u \in pend : u.b = x /\ u.landed # {}}}]
      BY <1>1, <2>1 DEF ZB_Pick
    <3>2. ackedEver' \in [Blocks -> SUBSET Vers] BY <1>g, <3>1, ZB_AckedEverFail
    <3>. QED BY <1>g, <1>u, <3>1, <3>2 DEF TyPend
  <2>2. CASE ZB_LS(G) # {}
    <3>1. UNCHANGED <<pend, ackedEver>> BY <1>1, <2>2 DEF ZB_Pick
    <3>. QED BY <1>g, <1>u, <3>1, C_Pend
  <2>. QED BY <2>1, <2>2
<1>5. TypeOKT' BY <1>g, <1>u, <1>3, <1>4, C_Scalar, C_Leg, C_Head, C_Snap, C_Tie, C_Trust, GroupsP
<1>6. NR \in Nat /\ Cardinality(members) \in 0..NR BY <1>2, ZB_CardSub
<1>7. agen + 1 \in 0..(NR + 1) BY <1>0, <1>6 DEF TyStA
<1>8. stamp' \in [R -> StampRec]
  <2>1. CASE ZB_LS(G) = {}
    <3>1. UNCHANGED stamp BY <1>1, <2>1 DEF ZB_Pick
    <3>. QED BY <1>0, <3>1 DEF TyStA
  <2>2. CASE ZB_LS(G) # {}
    <3>1. stamp' = [q \in R |-> IF q \in ZB_LS(G) THEN [seq |-> aseq, gen |-> agen + 1,
                                                       size |-> asize, mem |-> ZB_LS(G),
                                                       rgen |-> rgenA, rmem |-> rmemA]
                                                  ELSE stamp[q]]
      BY <1>1, <2>2 DEF ZB_Pick
    <3>2. aseq \in 0..MaxAsm /\ asize \in 0..NR /\ rgenA \in 0..(NR + 1) /\ rmemA \in SUBSET Reps
      BY <1>0 DEF TyStA, R
    <3>3. ZB_LS(G) \in SUBSET Reps BY <1>2 DEF R
    <3>4. [seq |-> aseq, gen |-> agen + 1, size |-> asize, mem |-> ZB_LS(G),
           rgen |-> rgenA, rmem |-> rmemA] \in StampRec
      BY <1>7, <3>2, <3>3 DEF StampRec
    <3>. QED BY <1>0, <3>1, <3>4 DEF TyStA
  <2>. QED BY <2>1, <2>2
<1>9. TyStA' BY <1>0, <1>v, <1>7, <1>8 DEF TyStA
<1>10. TyGh' BY <1>0, <1>v, C_Gh
<1>. QED BY <1>5, <1>9, <1>10, TyStampSplitP, TypeOKPartsP

LEMMA S_TyRelease ==
  ASSUME TypeOK, Release PROVE TypeOK'
<1>0. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>g. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>0, Groups
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED tieVars /\ UNCHANGED trustVars
  BY DEF Release
<1>1. TypeOKT' BY <1>g, <1>u, C_Scalar, C_Sets, C_Leg, C_Head, C_Snap, C_Pend, C_Tie, C_Trust, GroupsP
<1>v. /\ hold' = FALSE /\ rgenA' = agen /\ rmemA' = members
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, due, sole, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
      /\ UNCHANGED sGhost
  BY DEF Release
<1>2. members \in SUBSET R BY <1>g DEF TySets
<1>3. TyStA' BY <1>0, <1>v, <1>2 DEF TyStA
<1>4. TyGh' BY <1>0, <1>v, C_Gh
<1>. QED BY <1>1, <1>3, <1>4, TyStampSplitP, TypeOKPartsP

LEMMA S_TyRecordConfirm ==
  ASSUME TypeOK, RecordConfirm PROVE TypeOK'
<1>0. TypeOKT /\ TyStA /\ TyGh BY TypeOKParts, TyStampSplit
<1>g. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>0, Groups
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, mark, reverted, sb, pin, riskRec, used, mustRev>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED trustVars
      /\ StaleMarks(InSyncR \ members)
  BY DEF RecordConfirm
<1>1. TyLeg' /\ TyTie' BY <1>g, <1>u, T_StaleMarks
<1>2. TypeOKT' BY <1>g, <1>u, <1>1, C_Scalar, C_Sets, C_Head, C_Snap, C_Pend, C_Trust, GroupsP
<1>v. /\ sole' = sole \cup {<<aseq, agen, members>>}
      /\ hold' = FALSE /\ rgenA' = agen /\ rmemA' = members
      /\ UNCHANGED <<stamp, nseq, aseq, agen, asize, due, zseq, zgen, zsize, zm0, zrgen, zrmem, zst>>
      /\ UNCHANGED sGhost
  BY DEF RecordConfirm
<1>3. members \in SUBSET R BY <1>g DEF TySets
<1>4. <<aseq, agen, members>> \in (1..MaxAsm) \X (0..(NR + 1)) \X SUBSET R BY <1>0, <1>3 DEF TyStA
<1>5. sole' \subseteq (1..MaxAsm) \X (0..(NR + 1)) \X SUBSET R BY <1>0, <1>v, <1>4 DEF TyStA
<1>6. TyStA' BY <1>0, <1>v, <1>3, <1>5 DEF TyStA
<1>7. TyGh' BY <1>0, <1>v, C_Gh
<1>. QED BY <1>2, <1>6, <1>7, TyStampSplitP, TypeOKPartsP

LEMMA S_TyHeldFail ==
  ASSUME TypeOK, HeldFail PROVE TypeOK'
<1>0. TypeOKT /\ TyStampS BY TypeOKParts
<1>g. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>0, Groups
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, dState, mark, reverted, sb, pin, riskRec, restamp>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED acked /\ UNCHANGED tieVars /\ UNCHANGED trustVars
      /\ NoStamp
  BY DEF HeldFail, NoStamp
<1>a. pend' = {} /\ ackedEver' = [x \in Blocks |-> ackedEver[x] \cup
                                    {w.v : w \in {u \in pend : u.b = x /\ u.landed # {}}}]
  BY DEF HeldFail
<1>1. ackedEver' \in [Blocks -> SUBSET Vers] BY <1>g, <1>a, ZB_AckedEverFail
<1>2. TyPend' BY <1>g, <1>u, <1>a, <1>1 DEF TyPend
<1>3. TypeOKT' BY <1>g, <1>u, <1>2, C_Scalar, C_Sets, C_Leg, C_Head, C_Snap, C_Tie, C_Trust, GroupsP
<1>4. TyStampS' BY <1>0, <1>u, C_NoStamp
<1>. QED BY <1>3, <1>4, TypeOKPartsP

LEMMA S_TyStageDecree ==
  ASSUME TypeOK, StageDecree PROVE TypeOK'
<1>0. TypeOKT /\ TyStampS BY TypeOKParts
<1>g. TyScalar /\ TySets /\ TyLeg /\ TyHead /\ TySnap /\ TyPend /\ TyTie /\ TyTrust BY <1>0, Groups
<1>u. UNCHANGED <<ver, nextSeq, cutK, attached, fails, badAdmit, badLoss, zx>>
      /\ UNCHANGED <<recorded, cutTgt, cutDone, cutGone, members>>
      /\ UNCHANGED <<path, mark, reverted, sb, pin, riskRec, used, mustRev>>
      /\ UNCHANGED <<head, hAl, hPar>> /\ UNCHANGED <<sPres, sCon, sAl, sPar, anc>>
      /\ UNCHANGED <<pend, acked, ackedEver>> /\ UNCHANGED trustVars
      /\ StaleMarks(DecreeSet) /\ NoStamp
  BY DEF StageDecree, NoStamp
<1>1. TyLeg' /\ TyTie' BY <1>g, <1>u, T_StaleMarks
<1>2. TypeOKT' BY <1>g, <1>u, <1>1, C_Scalar, C_Sets, C_Head, C_Snap, C_Pend, C_Trust, GroupsP
<1>3. TyStampS' BY <1>0, <1>u, C_NoStamp
<1>. QED BY <1>2, <1>3, TypeOKPartsP

-----------------------------------------------------------------------------
(* (S) The inductive invariant on rev 16 (FlintCatchupSInd v6, SIndAll6:  *)
(* the stamp layer, the generation bounds, the surviving FlintCatchupT     *)
(* conjuncts with I_MembersS, the restatements) and Inv_AckedHeld, split   *)
(* in three groups; a frame per conjunct; Init; what it gives.             *)

IndJ ==
  /\ J_DueHold /\ J_HoldAtt /\ J_Rel /\ J_Cur /\ J_ZxOut /\ J_Aseq /\ J_SeqSync /\ J_MemRel /\ J_RelHold
  /\ J_NoAckBad /\ J_M0 /\ J_RelValid /\ J_MinorRel /\ J_RelInSync /\ J_ViewIn /\ J_ViewOut /\ J_SoleSeq
  /\ J_GenBound /\ J_ZGen
IndT ==
  /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
  /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
IndS == I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
IndInv == TypeOK /\ IndJ /\ IndT /\ IndS

LEMMA IndIsSIndAll == IndInv <=> SIndAll6 /\ Inv_AckedHeld
BY DEF IndInv, IndJ, IndT, IndS, SIndAll6, SInd1, SInd0
LEMMA IndSplit == IndInv <=> TypeOK /\ IndJ /\ IndT /\ IndS
BY DEF IndInv
LEMMA IndSplitP == IndInv' <=> TypeOK' /\ IndJ' /\ IndT' /\ IndS'
BY DEF IndInv

Goal == Inv_NoNewLoss /\ Inv_MembersHold /\ Inv_RaidHolds /\ Inv_AckStamped

\* --- frames: a conjunct carries over when what it reads does --------------------------------
LEMMA F_DueHold == J_DueHold /\ UNCHANGED <<due, hold>> => J_DueHold' BY DEF J_DueHold
LEMMA F_JHoldAtt == J_HoldAtt /\ UNCHANGED <<hold, attached>> => J_HoldAtt' BY DEF J_HoldAtt
LEMMA F_Rel == J_Rel /\ UNCHANGED <<attached, hold, rgenA, agen, rmemA, members>> => J_Rel' BY DEF J_Rel
LEMMA F_Cur == J_Cur /\ UNCHANGED <<attached, due, members, stamp, aseq, agen, asize, rgenA, rmemA>> => J_Cur'
BY DEF J_Cur, CurStamp, Core
LEMMA F_ZxOut == J_ZxOut /\ UNCHANGED <<zx, members>> => J_ZxOut' BY DEF J_ZxOut
LEMMA F_Aseq == J_Aseq /\ UNCHANGED <<aseq, nseq>> => J_Aseq' BY DEF J_Aseq
LEMMA F_SeqSync == J_SeqSync /\ UNCHANGED <<dState, stamp, nseq, asize>> => J_SeqSync' BY DEF J_SeqSync, InSyncR
LEMMA F_MemRel == J_MemRel /\ UNCHANGED <<attached, members, rmemA>> => J_MemRel' BY DEF J_MemRel
LEMMA F_RelHold == J_RelHold /\ UNCHANGED <<rmemA, dState, head, acked, pend>> => J_RelHold'
BY DEF J_RelHold, InSyncR, Pending
LEMMA F_NoAckBad == J_NoAckBad /\ UNCHANGED badAck => J_NoAckBad' BY DEF J_NoAckBad
LEMMA F_M0 == J_M0 /\ UNCHANGED <<stamp, nseq, asize, rmemA, dState>> => J_M0' BY DEF J_M0, SeqLegs, InSyncR
LEMMA F_RelValid == J_RelValid /\ UNCHANGED <<nseq, rgenA, asize, rmemA, sole>> => J_RelValid'
BY DEF J_RelValid, RelStamp, Valid, Majority, SolePairs
LEMMA F_MinorRel == J_MinorRel /\ UNCHANGED <<nseq, rgenA, asize, rmemA, dState>> => J_MinorRel'
BY DEF J_MinorRel, RelStamp, Majority, InSyncR
LEMMA F_RelInSync == J_RelInSync /\ UNCHANGED <<rmemA, dState>> => J_RelInSync' BY DEF J_RelInSync, InSyncR
LEMMA F_ViewIn == J_ViewIn /\ UNCHANGED <<dState, rmemA, stamp, sole, nseq, rgenA>> => J_ViewIn'
BY DEF J_ViewIn, InSyncR, View, Valid, Majority, SolePairs
LEMMA F_ViewOut == J_ViewOut /\ UNCHANGED <<dState, rmemA, stamp, sole, nseq, rgenA>> => J_ViewOut'
BY DEF J_ViewOut, InSyncR, View, Valid, Majority, SolePairs
LEMMA F_SoleSeq == J_SoleSeq /\ UNCHANGED <<sole, nseq, dState>> => J_SoleSeq' BY DEF J_SoleSeq, InSyncR
LEMMA F_GenBound == J_GenBound /\ UNCHANGED <<attached, agen, members, due, asize>> => J_GenBound' BY DEF J_GenBound
LEMMA F_ZGen == J_ZGen /\ UNCHANGED zgen => J_ZGen' BY DEF J_ZGen
\* every J conjunct at once, for a step that leaves the stamp and what the J layer reads alone
LEMMA F_IndJ ==
  IndJ /\ UNCHANGED <<stampVars, sGhost>>
       /\ UNCHANGED <<attached, members, zx, dState, head, acked, pend>> => IndJ'
BY F_DueHold, F_JHoldAtt, F_Rel, F_Cur, F_ZxOut, F_Aseq, F_SeqSync, F_MemRel, F_RelHold, F_NoAckBad, F_M0,
   F_RelValid, F_MinorRel, F_RelInSync, F_ViewIn, F_ViewOut, F_SoleSeq, F_GenBound, F_ZGen DEF IndJ, stampVars, sGhost

LEMMA F_RangesS ==
  I_RangesS /\ UNCHANGED <<cutK, nextSeq, attached, pend, members, recorded, conf, sPres, tr, hPar>> => I_RangesS'
BY DEF I_RangesS
LEMMA F_Lineage == I_Lineage /\ UNCHANGED <<sPres, sPar, anc>> => I_Lineage' BY DEF I_Lineage
LEMMA F_Chain == I_Chain /\ UNCHANGED <<sPres, sPar, sAl, sCon, hAl, head, hPar>> => I_Chain' BY DEF I_Chain
LEMMA F_Pend == I_Pend /\ UNCHANGED <<pend, acked, ver, members, head, nextSeq, cutK>> => I_Pend' BY DEF I_Pend
LEMMA F_MembersS == I_MembersS /\ UNCHANGED <<attached, members, dState>> => I_MembersS'
BY DEF I_MembersS, InSyncR
LEMMA F_AckedHeld == Inv_AckedHeld /\ UNCHANGED <<dState, head, acked>> => Inv_AckedHeld' BY DEF Inv_AckedHeld
LEMMA F_HoldAtt == I_HoldAtt /\ UNCHANGED <<attached, members, head, acked>> => I_HoldAtt' BY DEF I_HoldAtt
LEMMA F_PendSeen == I_PendSeen /\ UNCHANGED <<pend, head, sPres, sCon>> => I_PendSeen' BY DEF I_PendSeen
LEMMA F_Vers == I_Vers /\ UNCHANGED <<acked, ver, head, sPres, sCon>> => I_Vers' BY DEF I_Vers
LEMMA F_Reverted ==
  I_Reverted /\ UNCHANGED <<dState, reverted, sb, hAl, hPar, head, sCon, sPres, recorded>> => I_Reverted'
BY DEF I_Reverted, RevOK
LEMMA F_HeadPend == I_HeadPend /\ UNCHANGED <<dState, reverted, mark, head, pend>> => I_HeadPend'
BY DEF I_HeadPend, CatchingUp, HiOf
LEMMA F_Session ==
  I_Session /\ UNCHANGED <<dState, reverted, sb, mark, members, hPar, nextSeq, sPres, tr, pin,
                           recorded, path, cutK, cutTgt, cutDone, cutGone>>
  => I_Session'
BY DEF I_Session, SessionOK, CatchingUp
LEMMA F_TC == Inv_TrustComplete /\ UNCHANGED <<tr, sCon, cutAck>> => Inv_TrustComplete' BY DEF Inv_TrustComplete
LEMMA F_NoBadLoss == I_NoBadLoss /\ UNCHANGED badLoss => I_NoBadLoss' BY DEF I_NoBadLoss
LEMMA F_AckedEverS == I_AckedEverS /\ UNCHANGED <<acked, ackedEver>> => I_AckedEverS' BY DEF I_AckedEverS
LEMMA F_LegalS == I_LegalS /\ UNCHANGED <<head, sPres, sCon, ackedEver, pend, zjv, zpost>> => I_LegalS'
BY DEF I_LegalS, LegalV, PendVal
LEMMA F_WHiS == I_WHiS /\ UNCHANGED <<sPres, cutAck>> => I_WHiS' BY DEF I_WHiS
LEMMA F_AckMono == I_AckMono /\ UNCHANGED <<sPres, cutAck, acked>> => I_AckMono' BY DEF I_AckMono
LEMMA F_HeadLoS == I_HeadLoS /\ UNCHANGED <<dState, reverted, mark, sPres, cutAck, head>> => I_HeadLoS'
BY DEF I_HeadLoS, CatchingUp, HiOf
LEMMA F_FreshS ==
  I_FreshS /\ UNCHANGED <<attached, members, dState, rmemA, sPres, nextSeq, conf, sCon, cutAck>> => I_FreshS'
BY DEF I_FreshS, BasesS, InSyncR

\* A leg the step leaves alone keeps its per-leg facts (FlintCatchupTProof's, verbatim).
LEMMA SessionOther ==
  ASSUME NEW q \in R, SessionOK(q),
         UNCHANGED <<members, nextSeq, recorded, cutK, cutTgt, cutDone, cutGone>>,
         dState'[q] = dState[q], reverted'[q] = reverted[q], sb'[q] = sb[q], mark'[q] = mark[q],
         hPar'[q] = hPar[q], sPres'[q] = sPres[q], tr'[q] = tr[q], pin'[q] = pin[q], path'[q] = path[q]
  PROVE  SessionOK(q)'
BY DEF SessionOK, CatchingUp
LEMMA SessionOtherG ==
  ASSUME NEW q \in R, SessionOK(q),
         UNCHANGED <<members, nextSeq, recorded, cutK, cutTgt, cutDone>>, cutGone \subseteq cutGone',
         dState'[q] = dState[q], reverted'[q] = reverted[q], sb'[q] = sb[q], mark'[q] = mark[q],
         hPar'[q] = hPar[q], sPres'[q] = sPres[q], tr'[q] = tr[q], pin'[q] = pin[q], path'[q] = path[q]
  PROVE  SessionOK(q)'
BY DEF SessionOK, CatchingUp
LEMMA RevOther ==
  ASSUME NEW q \in R, RevOK(q), UNCHANGED recorded,
         dState'[q] = dState[q], reverted'[q] = reverted[q], sb'[q] = sb[q], hAl'[q] = hAl[q],
         hPar'[q] = hPar[q], head'[q] = head[q], sCon'[q] = sCon[q], sPres'[q] = sPres[q]
  PROVE  RevOK(q)'
BY DEF RevOK

\* --- Init ---------------------------------------------------------------------------------
LEMMA I_Init == Init => IndInv
<1>. SUFFICES ASSUME Init PROVE IndInv OBVIOUS
<1>0. TypeOK BY S_TyInit
<1>a. R # {} /\ MaxEpoch \in Nat /\ NR \in Nat /\ NR >= 1 BY Const, S_NR DEF R
<1>b. InSyncR = R /\ members = R /\ Healthy = R /\ rmemA = R BY DEF Init, InSyncR, Healthy
<1>c. \A q \in R : stamp[q] = [seq |-> 1, gen |-> 0, size |-> NR, mem |-> R, rgen |-> 0, rmem |-> R] BY DEF Init
<1>d. Cardinality(R) = NR BY DEF NR, R
<1>e. 2 * NR > NR BY <1>a
<1>1. J_DueHold /\ J_HoldAtt /\ J_Rel /\ J_ZxOut /\ J_Aseq /\ J_MemRel /\ J_NoAckBad /\ J_SoleSeq
  BY DEF Init, J_DueHold, J_HoldAtt, J_Rel, J_ZxOut, J_Aseq, J_MemRel, J_NoAckBad, J_SoleSeq
<1>2. J_Cur BY <1>c DEF Init, J_Cur, Core, CurStamp
<1>3. J_SeqSync BY <1>b, <1>c DEF Init, J_SeqSync
<1>4. J_RelHold BY <1>b DEF Init, J_RelHold, Zero
<1>5. J_M0
  <2>1. SeqLegs = R BY <1>c DEF Init, SeqLegs
  <2>. QED BY <1>b, <1>d, <2>1 DEF Init, J_M0
<1>6. Majority(RelStamp) /\ Valid(RelStamp) BY <1>d, <1>e DEF Init, RelStamp, Majority, Valid
<1>7. J_RelValid /\ J_MinorRel /\ J_RelInSync BY <1>a, <1>b, <1>6 DEF J_RelValid, J_MinorRel, J_RelInSync
<1>9. J_GenBound /\ J_ZGen BY <1>a, <1>b, <1>d DEF Init, J_GenBound, J_ZGen
<1>8. J_ViewIn /\ J_ViewOut
  <2>1. \A q \in R : Valid(stamp[q]) /\ View(stamp[q]) = stamp[q] BY <1>c, <1>d, <1>e DEF Valid, Majority, View
  <2>. QED BY <1>b, <1>c, <2>1 DEF Init, J_ViewIn, J_ViewOut
<1>j. IndJ BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>7, <1>8, <1>9 DEF IndJ
<1>t1. I_RangesS BY Const DEF Init, I_RangesS, Epochs
<1>t2. I_Lineage /\ I_Chain BY DEF Init, I_Lineage, ChainShape, Epochs, I_Chain, ChainReads, Up, Zero
<1>t3. I_Pend /\ I_PendSeen /\ I_Vers BY Const DEF Init, I_Pend, I_PendSeen, I_Vers, Zero
<1>t4. I_MembersS /\ Inv_AckedHeld BY <1>a, <1>b DEF Init, I_MembersS, Inv_AckedHeld, Zero
<1>t5. I_HoldAtt BY DEF Init, I_HoldAtt, Zero
<1>t6. I_Reverted /\ I_HeadPend /\ I_Session
  BY DEF Init, I_Reverted, RevOK, I_Session, SessionOK, I_HeadPend, CatchingUp
<1>t7. Inv_TrustComplete /\ I_NoBadLoss BY DEF Init, Inv_TrustComplete, I_NoBadLoss
<1>t. IndT BY <1>t1, <1>t2, <1>t3, <1>t4, <1>t5, <1>t6, <1>t7 DEF IndT
<1>s1. I_AckedEverS /\ I_LegalS BY DEF Init, I_AckedEverS, I_LegalS, LegalV, Zero
<1>s2. I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY DEF Init, I_WHiS, I_AckMono, I_HeadLoS, CatchingUp, I_FreshS, BasesS
<1>s. IndS BY <1>s1, <1>s2 DEF IndS
<1>. QED BY <1>0, <1>j, <1>t, <1>s, IndSplit

\* --- what the invariant gives the theorem ------------------------------------------------
LEMMA I_Goal == IndInv => Goal
<1>. SUFFICES ASSUME IndInv PROVE Goal OBVIOUS
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>1. Inv_AckedHeld BY <1>0 DEF IndT
<1>2. Inv_MembersHold
  <2>1. CASE attached BY <2>1, <1>0 DEF IndT, I_HoldAtt, Inv_MembersHold
  <2>2. CASE ~attached BY <2>2, <1>0 DEF IndT, I_RangesS, Inv_MembersHold
  <2>. QED BY <2>1, <2>2
<1>3. Inv_RaidHolds
  <2>. SUFFICES ASSUME attached, members # {}, QuorumOK, NEW x \in Blocks, ~Pending(x)
                PROVE \E r \in members : head[r][x] >= acked[x]
    BY DEF Inv_RaidHolds
  <2>. QED BY <1>0 DEF IndT, I_HoldAtt
<1>. QED BY <1>0, <1>1, <1>2, <1>3 DEF IndT, IndJ, I_NoBadLoss, J_NoAckBad, Goal, Inv_NoNewLoss, Inv_AdmitNoLoss, Inv_AckStamped

-----------------------------------------------------------------------------
(* (S) IndNew: the 26 conjuncts the invariant agents' counterexamples to  *)
(* induction added (v7; peeled on rev 17 with the drain in, c31 q1/q3).    *)
(* The final invariant is IndAll == IndInv /\ IndNew; each agent's lemma   *)
(* is ASSUME IndInv, IndNew, <disjunct> PROVE IndInv' /\ IndNew'.           *)

IndNew ==
  /\ J_RelHoldS
  /\ I_FreshS2
  /\ I_LegalS2
  /\ I_SnapPend
  /\ J_ZxIdle
  /\ J_SeqLe
  /\ J_SoleRel
  /\ J_GenTop
  /\ J_ZLive
  /\ J_RelLe
  /\ I_WHiC
  /\ I_HeadLoC
  /\ I_HeadLoA
  /\ I_StandbyLegal
  /\ I_HeadHiC
  /\ I_SnapLegal
  /\ I_PendTop
  /\ I_PendNext
  /\ J_ZRel
  /\ I_CutLegal
  /\ I_InSyncLegal
  /\ I_ValidLegal
  /\ J_ZNoValid
  /\ J_ZM0
  /\ J_SoleGen
  /\ J_ZCut
IndAll == IndInv /\ IndNew

\* a frame per new conjunct
LEMMA F_RelHoldSN == J_RelHoldS /\ UNCHANGED <<rmemA, dState, head, acked>> => J_RelHoldS' BY DEF J_RelHoldS, InSyncR
LEMMA F_FreshS2N == I_FreshS2 /\ UNCHANGED <<dState, rmemA, sPres, nextSeq, conf, sCon, cutAck>> => I_FreshS2' BY DEF I_FreshS2, InSyncR
LEMMA F_LegalS2N == I_LegalS2 /\ UNCHANGED <<head, sPres, sCon, ackedEver, pend, zpost>> => I_LegalS2' BY DEF I_LegalS2, LegalV2, PendVal
LEMMA F_SnapPend == I_SnapPend /\ UNCHANGED <<sPres, sCon, pend>> => I_SnapPend' BY DEF I_SnapPend
LEMMA F_ZxIdle == J_ZxIdle /\ UNCHANGED <<zx, dState, sb, reverted, stamp, zseq>> => J_ZxIdle' BY DEF J_ZxIdle
LEMMA F_SeqLe == J_SeqLe /\ UNCHANGED <<stamp, nseq, sole, zseq>> => J_SeqLe' BY DEF J_SeqLe
LEMMA F_SoleRel == J_SoleRel /\ UNCHANGED <<sole, nseq, rmemA, asize>> => J_SoleRel' BY DEF J_SoleRel
LEMMA F_GenTop == J_GenTop /\ UNCHANGED <<attached, dState, stamp, sole, agen, due, members>> => J_GenTop' BY DEF J_GenTop, InSyncR, View, Valid, Majority, SolePairs
LEMMA F_ZLive == J_ZLive /\ UNCHANGED <<zx, dState, attached, rmemA, zseq, nseq, zsize, asize, zgen, agen, zrgen, rgenA, zrmem>> => J_ZLive' BY DEF J_ZLive
LEMMA F_RelLe == J_RelLe /\ UNCHANGED <<rgenA, agen>> => J_RelLe' BY DEF J_RelLe
LEMMA F_WHiC == I_WHiC /\ UNCHANGED <<acked, cutAck, sPres, sCon>> => I_WHiC' BY DEF I_WHiC, AckW
LEMMA F_HeadLoC == I_HeadLoC /\ UNCHANGED <<dState, reverted, mark, sPres, sCon, head, acked, cutAck>> => I_HeadLoC' BY DEF I_HeadLoC, AckW, CatchingUp, HiOf
LEMMA F_HeadLoA == I_HeadLoA /\ UNCHANGED <<dState, reverted, mark, sPres, sCon, acked, head>> => I_HeadLoA' BY DEF I_HeadLoA, CatchingUp, HiOf
LEMMA F_StandbyLegal == I_StandbyLegal /\ UNCHANGED <<dState, head, ackedEver, pend>> => I_StandbyLegal' BY DEF I_StandbyLegal, PendVal
LEMMA F_HeadHiC == I_HeadHiC /\ UNCHANGED <<dState, reverted, mark, sPres, cutAck, head, acked>> => I_HeadHiC' BY DEF I_HeadHiC, AckW, CatchingUp, HiOf
LEMMA F_SnapLegal == I_SnapLegal /\ UNCHANGED <<sPres, sCon, ackedEver, pend>> => I_SnapLegal' BY DEF I_SnapLegal, PendVal
LEMMA F_PendTop == I_PendTop /\ UNCHANGED <<pend, head, sPres, sCon>> => I_PendTop' BY DEF I_PendTop
LEMMA F_PendNext == I_PendNext /\ UNCHANGED <<pend, nextSeq, sPres>> => I_PendNext' BY DEF I_PendNext
LEMMA F_ZRel == J_ZRel /\ UNCHANGED <<zx, zm0, zseq, zgen, zsize, zrgen, zrmem, sole, dState>> => J_ZRel' BY DEF J_ZRel, ZombieReleases, InSyncR, Majority, Valid, SolePairs
LEMMA F_CutLegal == I_CutLegal /\ UNCHANGED <<cutK, cutTgt, head, ackedEver, pend>> => I_CutLegal' BY DEF I_CutLegal, PendVal
LEMMA F_InSyncLegal == I_InSyncLegal /\ UNCHANGED <<attached, dState, head, ackedEver, pend>> => I_InSyncLegal' BY DEF I_InSyncLegal, InSyncR, PendVal
LEMMA F_ZNoValid == J_ZNoValid /\ UNCHANGED <<zx, zst, dState, stamp, sole>> => J_ZNoValid' BY DEF J_ZNoValid, Valid, Majority, SolePairs
LEMMA F_ZM0 == J_ZM0 /\ UNCHANGED <<zx, zm0, zsize>> => J_ZM0' BY DEF J_ZM0
LEMMA F_SoleGen == J_SoleGen /\ UNCHANGED <<sole, nseq, agen>> => J_SoleGen' BY DEF J_SoleGen
LEMMA F_ZCut == J_ZCut /\ UNCHANGED <<cutK, zx, cutTgt>> => J_ZCut' BY DEF J_ZCut
LEMMA F_ValidLegal == I_ValidLegal /\ UNCHANGED <<dState, stamp, sole, head, ackedEver, pend>> => I_ValidLegal' BY DEF I_ValidLegal, InSyncR, Valid, Majority, SolePairs, PendVal

LEMMA IndNewSplit == IndNew <=> J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0 /\ J_SoleGen /\ J_ZCut BY DEF IndNew
LEMMA IndNewSplitP == IndNew' <=> J_RelHoldS' /\ I_FreshS2' /\ I_LegalS2' /\ I_SnapPend' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe' /\ I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_StandbyLegal' /\ I_HeadHiC' /\ I_SnapLegal' /\ I_PendTop' /\ I_PendNext' /\ J_ZRel' /\ I_CutLegal' /\ I_InSyncLegal' /\ I_ValidLegal' /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen' /\ J_ZCut' BY DEF IndNew

LEMMA I_InitNew == Init => IndNew
<1>. SUFFICES ASSUME Init PROVE IndNew OBVIOUS
<1>a1. NR \in Nat /\ NR >= 1 /\ Cardinality(R) = NR BY S_NR DEF NR, R
<1>a2. InSyncR = R /\ members = R BY DEF Init, InSyncR
<1>a. NR \in Nat /\ NR >= 1 /\ Cardinality(R) = NR /\ InSyncR = R /\ members = R BY <1>a1, <1>a2
<1>b. \A q \in R : stamp[q] = [seq |-> 1, gen |-> 0, size |-> NR, mem |-> R, rgen |-> 0, rmem |-> R] BY DEF Init
<1>c. \A q \in R : View(stamp[q]) = stamp[q] BY <1>a, <1>b DEF View, Valid, Majority
<1>3. J_RelHoldS BY <1>a, Const DEF Init, J_RelHoldS, InSyncR, Zero, CatchingUp
<1>4. I_FreshS2 BY <1>a, Const DEF Init, I_FreshS2, InSyncR, Zero, CatchingUp
<1>5. I_LegalS2 BY <1>a, Const DEF Init, I_LegalS2, LegalV2, PendVal, Zero, CatchingUp
<1>6. I_SnapPend BY <1>a, Const DEF Init, I_SnapPend, Zero, CatchingUp
<1>7. J_ZxIdle BY Const DEF Init, J_ZxIdle, Zero, CatchingUp
<1>8. J_SeqLe BY <1>b, Const DEF Init, J_SeqLe, Zero, CatchingUp
<1>9. J_SoleRel BY <1>a, Const DEF Init, J_SoleRel, Zero, CatchingUp
<1>10. J_GenTop BY <1>a, <1>b, <1>c, Const DEF Init, J_GenTop, InSyncR, View, Valid, Majority, SolePairs, Zero, CatchingUp
<1>11. J_ZLive BY Const DEF Init, J_ZLive, Zero, CatchingUp
<1>12. J_RelLe BY <1>a, Const DEF Init, J_RelLe, Zero, CatchingUp
<1>13. I_WHiC BY <1>a, Const DEF Init, I_WHiC, AckW, Zero, CatchingUp
<1>14. I_HeadLoC BY <1>a, Const DEF Init, I_HeadLoC, AckW, CatchingUp, HiOf, Zero, CatchingUp
<1>15. I_HeadLoA BY <1>a, Const DEF Init, I_HeadLoA, CatchingUp, HiOf, Zero, CatchingUp
<1>16. I_StandbyLegal BY <1>a, Const DEF Init, I_StandbyLegal, PendVal, Zero, CatchingUp
<1>17. I_HeadHiC BY <1>a, Const DEF Init, I_HeadHiC, AckW, CatchingUp, HiOf, Zero, CatchingUp
<1>18. I_SnapLegal BY <1>a, Const DEF Init, I_SnapLegal, PendVal, Zero, CatchingUp
<1>19. I_PendTop BY <1>a, Const DEF Init, I_PendTop, Zero, CatchingUp
<1>20. I_PendNext BY <1>a, Const DEF Init, I_PendNext, Zero, CatchingUp
<1>21. J_ZRel BY <1>a, Const DEF Init, J_ZRel, ZombieReleases, InSyncR, Majority, Zero, CatchingUp
<1>22. I_CutLegal BY <1>a, Const DEF Init, I_CutLegal, PendVal, Zero, CatchingUp
<1>23. I_InSyncLegal BY <1>a, Const DEF Init, I_InSyncLegal, InSyncR, PendVal, Zero, CatchingUp
<1>24. I_ValidLegal BY <1>a, Const DEF Init, I_ValidLegal, InSyncR, Valid, Majority, SolePairs, PendVal, Zero, CatchingUp
<1>25. J_ZNoValid /\ J_ZM0 /\ J_SoleGen BY Const DEF Init, J_ZNoValid, J_ZM0, J_SoleGen
<1>z. J_ZCut BY DEF Init, J_ZCut
<1>. QED BY <1>3, <1>4, <1>5, <1>6, <1>7, <1>8, <1>9, <1>10, <1>11, <1>12, <1>13, <1>14, <1>15, <1>16, <1>17, <1>18, <1>19, <1>20, <1>21, <1>22, <1>23, <1>24, <1>25, <1>z, IndNewSplit

-----------------------------------------------------------------------------
(* (S) The stage's read (Stage, StageAdmit: inv-stage owns it, inv-admit    *)
(* cites it).  On a detached volume every in_sync leg reads the live seq;   *)
(* the newest valid view among the attachable legs comes from a leg of the  *)
(* last released generation (rmemA), because a conclusive read with every   *)
(* attachable leg outside it would need more legs than the assembly has     *)
(* (count, vouch), an in_sync leg of the release left unattached (the       *)
(* decree's read), or a record confirmation of the live seq alongside a     *)
(* majority release (J_SoleRel rules that out).  So the stage assembles     *)
(* legs of rmemA that are in_sync, and they hold every acked write.         *)

\* every in_sync leg reads the live seq; a view keeps the stamp's size
LEMMA ZU_ViewSeq ==
  ASSUME TypeOK, J_ViewIn, J_ViewOut, NEW l \in InSyncR
  PROVE  /\ View(stamp[l]).seq = nseq
         /\ View(stamp[l]).gen \in 0..(NR + 1)
         /\ View(stamp[l]).size = stamp[l].size
<1>1. l \in R BY DEF InSyncR
<1>2. View(stamp[l]).seq = nseq
  <2>1. CASE l \in rmemA BY <2>1 DEF J_ViewIn
  <2>2. CASE l \notin rmemA BY <2>2 DEF J_ViewOut
  <2>. QED BY <2>1, <2>2
<1>3. stamp[l] \in StampRec BY <1>1 DEF TypeOK
<1>4. View(stamp[l]).gen \in 0..(NR + 1) /\ View(stamp[l]).size = stamp[l].size BY <1>3 DEF View, StampRec
<1>. QED BY <1>2, <1>4

\* the newest valid view exists (all of them read the live seq; take the largest generation)
LEMMA ZU_Newest ==
  ASSUME TypeOK, J_ViewIn, J_ViewOut, VAtt # {}
  PROVE  /\ \E q \in VAtt : NewestS = View(stamp[q])
         /\ \A q \in VAtt : ~Newer(View(stamp[q]), NewestS)
         /\ NewestS.seq = nseq
<1>0. VAtt \subseteq InSyncR BY Full DEF VAtt, Attachable
<1>1. \A q \in VAtt : View(stamp[q]).seq = nseq /\ View(stamp[q]).gen \in 0..(NR + 1)
  BY <1>0, ZU_ViewSeq
<1>. DEFINE G == {View(stamp[q]).gen : q \in VAtt}
<1>2. G \subseteq 0..(NR + 1) /\ G # {} BY <1>1
<1>3. NR + 1 \in Nat BY S_NR
<1>4. Max(G) \in G /\ \A u \in G : u <= Max(G) BY <1>2, <1>3, MaxProp
<1>5. PICK qs \in VAtt : View(stamp[qs]).gen = Max(G) BY <1>4
<1>6. \A q \in VAtt : ~Newer(View(stamp[q]), View(stamp[qs]))
  <2>. SUFFICES ASSUME NEW q \in VAtt PROVE ~Newer(View(stamp[q]), View(stamp[qs])) OBVIOUS
  <2>1. View(stamp[q]).gen \in G OBVIOUS
  <2>2. View(stamp[q]).gen <= View(stamp[qs]).gen BY <2>1, <1>4, <1>5
  <2>3. View(stamp[q]).seq = View(stamp[qs]).seq BY <1>1
  <2>4. View(stamp[q]).gen \in Nat /\ View(stamp[qs]).gen \in Nat BY <1>1, <1>3
  <2>. QED BY <2>2, <2>3, <2>4 DEF Newer
<1>. DEFINE P(st) == \A q \in VAtt : ~Newer(View(stamp[q]), st)
<1>. DEFINE SS == {View(stamp[q]) : q \in VAtt}
<1>7. \E st \in SS : P(st) BY <1>6
<1>8. NewestS \in SS /\ P(NewestS)
  <2>1. NewestS = CHOOSE st \in SS : P(st) BY DEF NewestS
  <2>. HIDE DEF P, SS
  <2>. QED BY <1>7, <2>1
<1>9. PICK q1 \in VAtt : NewestS = View(stamp[q1]) BY <1>8
<1>. QED BY <1>8, <1>9, <1>1

\* two disjoint sets of legs inside a third
LEMMA ZU_Disj ==
  ASSUME NEW A \in SUBSET R, NEW B \in SUBSET R, NEW S \in SUBSET R, A \cap B = {}, A \subseteq S, B \subseteq S
  PROVE  /\ Cardinality(A) \in Nat /\ Cardinality(B) \in Nat /\ Cardinality(S) \in Nat
         /\ Cardinality(A) + Cardinality(B) <= Cardinality(S)
<1>1. IsFiniteSet(R) BY RNat
<1>2. IsFiniteSet(A) /\ IsFiniteSet(B) /\ IsFiniteSet(S) BY <1>1, FS_Subset
<1>3. Cardinality(A) \in Nat /\ Cardinality(B) \in Nat /\ Cardinality(S) \in Nat BY <1>2, FS_CardinalityType
<1>4. Cardinality(A \cap B) = 0 BY FS_EmptySet
<1>5. Cardinality(A \cup B) = Cardinality(A) + Cardinality(B) - Cardinality(A \cap B) BY <1>2, FS_Union
<1>6. A \cup B \in SUBSET S OBVIOUS
<1>7. Cardinality(A \cup B) <= Cardinality(S) BY <1>2, <1>6, FS_Subset
<1>. QED BY <1>3, <1>4, <1>5, <1>7

\* a set of legs inside another is no larger
LEMMA ZU_SubCard ==
  ASSUME NEW A \in SUBSET R, NEW B \in SUBSET R, A \subseteq B
  PROVE  Cardinality(A) \in Nat /\ Cardinality(B) \in Nat /\ Cardinality(A) <= Cardinality(B)
<1>1. IsFiniteSet(R) BY RNat
<1>2. IsFiniteSet(B) BY <1>1, FS_Subset
<1>3. IsFiniteSet(A) /\ Cardinality(A) <= Cardinality(B) BY <1>2, FS_Subset
<1>. QED BY <1>2, <1>3, FS_CardinalityType

\* a majority of n is at least MajSize(n)
LEMMA ZU_MajSize ==
  ASSUME NEW k \in Nat, NEW n \in Nat, 2 * k > n PROVE k >= MajSize(n)
BY DEF MajSize

\* the read: StampMem (and the assembly) lie in rmemA, in_sync; the members hold every acked write
LEMMA S_StageRead ==
  ASSUME IndInv, J_SoleRel, ~attached, CanStampStage
  PROVE  /\ AsmSet # {} /\ AsmSet \subseteq StampMem /\ StampMem \subseteq Attachable
         /\ StampMem \subseteq rmemA \cap InSyncR
         /\ AsmSet \subseteq rmemA \cap InSyncR
         /\ \A q \in AsmSet : \A x \in Blocks : head[q][x] >= acked[x]
         /\ NewestS.seq = nseq /\ NewestS.mem \subseteq rmemA
<1>0. TypeOK /\ IndJ /\ IndT BY IndSplit
<1>j. /\ J_SeqSync /\ J_RelHold /\ J_M0 /\ J_RelValid /\ J_MinorRel /\ J_RelInSync /\ J_ViewIn /\ J_ViewOut
  BY <1>0 DEF IndJ
<1>g. VAtt # {} /\ Conclusive /\ StampMem # {} /\ CleanMem # {} BY Full DEF CanStampStage
<1>a. Attachable \subseteq InSyncR /\ InSyncR \subseteq R BY Full DEF Attachable, InSyncR
<1>s. StampMem \subseteq Attachable /\ StampMem = NewestS.mem \cap Attachable BY DEF StampMem
<1>m. AsmSet = CleanMem /\ CleanMem \subseteq StampMem BY <1>g, Full DEF AsmSet, CleanMem
<1>n. /\ \E q \in VAtt : NewestS = View(stamp[q])
      /\ \A q \in VAtt : ~Newer(View(stamp[q]), NewestS)
      /\ NewestS.seq = nseq
  BY <1>0, <1>j, <1>g, ZU_Newest
<1>1. PICK q1 \in VAtt : NewestS = View(stamp[q1]) BY <1>n
<1>2. q1 \in InSyncR BY <1>a DEF VAtt
<1>v1. View(stamp[q1]).gen \in 0..(NR + 1) /\ View(stamp[q1]).size = stamp[q1].size BY <1>0, <1>j, <1>2, ZU_ViewSeq
<1>3. q1 \in rmemA
  <2>. SUFFICES ASSUME q1 \notin rmemA PROVE FALSE OBVIOUS
  <2>1. View(stamp[q1]).gen < rgenA BY <1>2, <1>j DEF J_ViewOut
  <2>2. CASE Attachable \cap rmemA # {}
    <3>1. PICK q0 \in Attachable \cap rmemA : TRUE BY <2>2
    <3>2. q0 \in InSyncR \cap rmemA BY <3>1, <1>a
    <3>3. /\ Valid(View(stamp[q0])) /\ View(stamp[q0]).seq = nseq /\ View(stamp[q0]).gen >= rgenA
      BY <3>2, <1>j DEF J_ViewIn
    <3>4. q0 \in VAtt BY <3>1, <3>3 DEF VAtt
    <3>5. View(stamp[q0]).gen \in 0..(NR + 1) /\ rgenA \in 0..(NR + 1) /\ NR \in Nat
      BY <1>0, <1>j, <3>2, ZU_ViewSeq, S_NR DEF TypeOK
    <3>6. Newer(View(stamp[q0]), NewestS) BY <3>3, <3>5, <2>1, <1>1, <1>n, <1>v1 DEF Newer
    <3>. QED BY <3>4, <3>6, <1>n
  <2>3. CASE Attachable \cap rmemA = {}
    <3>1. Majority(RelStamp)
      <4>. SUFFICES ASSUME ~Majority(RelStamp) PROVE FALSE OBVIOUS
      <4>1. InSyncR \subseteq rmemA BY <1>j DEF J_MinorRel
      <4>2. Attachable # {} BY <1>g, <1>s
      <4>. QED BY <4>1, <4>2, <1>a, <2>3
    <3>2. 2 * Cardinality(rmemA) > asize BY <3>1 DEF Majority, RelStamp
    <3>3. /\ Cardinality(Attachable) \in Nat /\ Cardinality(rmemA) \in Nat
          /\ Cardinality(Attachable) + Cardinality(rmemA) <= asize
      <4>1. Attachable \subseteq SeqLegs /\ rmemA \subseteq SeqLegs /\ Cardinality(SeqLegs) = asize
        BY <1>a, <1>j DEF J_M0
      <4>2. SeqLegs \subseteq R /\ rmemA \subseteq R /\ Attachable \subseteq R BY <1>0, <1>a DEF SeqLegs, TypeOK
      <4>. QED BY <4>1, <4>2, <2>3, ZU_Disj
    <3>4. NewestS.size = asize BY <1>1, <1>2, <1>v1, <1>j DEF J_SeqSync
    <3>a. asize \in Nat BY <1>0 DEF TypeOK
    <3>5. ~CountOK BY <3>2, <3>3, <3>4, <3>a, Full DEF CountOK
    <3>6. ~SoleOK
      <4>. SUFFICES ASSUME SoleOK PROVE FALSE OBVIOUS
      <4>1. PICK c \in sole : <<c[1], c[2]>> = <<NewestS.seq, NewestS.gen>> BY DEF SoleOK, SolePairs
      <4>2. c[1] = nseq BY <4>1, <1>n
      <4>3. rmemA \subseteq c[3] /\ 2 * Cardinality(c[3]) <= asize BY <4>2 DEF J_SoleRel
      <4>4. c[3] \subseteq R /\ rmemA \subseteq R BY <1>0 DEF TypeOK
      <4>5. Cardinality(rmemA) <= Cardinality(c[3]) /\ Cardinality(c[3]) \in Nat BY <4>3, <4>4, ZU_SubCard
      <4>. QED BY <4>3, <4>5, <3>2, <3>3, <3>a
    <3>7. ~(InSyncR \subseteq Attachable) BY <2>3, <1>j DEF J_RelInSync
    <3>8. ~VouchOK
      <4>. SUFFICES ASSUME VouchOK PROVE FALSE OBVIOUS
      <4>1. Cardinality(Attachable) > asize - MajSize(asize) BY <3>4 DEF VouchOK, VouchCond
      <4>2. Cardinality(rmemA) >= MajSize(asize) BY <3>2, <3>3, <3>a, ZU_MajSize
      <4>3. MajSize(asize) \in Int BY <3>a DEF MajSize
      <4>. QED BY <4>1, <4>2, <4>3, <3>3, <3>a
    <3>. QED BY <3>5, <3>6, <3>7, <3>8, <1>g, Full DEF Conclusive, PlainConclusive
  <2>. QED BY <2>2, <2>3
<1>4. NewestS.mem \subseteq rmemA BY <1>1, <1>2, <1>3, <1>j DEF J_ViewIn
<1>5. StampMem \subseteq rmemA \cap InSyncR BY <1>4, <1>s, <1>a
<1>6. AsmSet \subseteq rmemA \cap InSyncR /\ AsmSet # {} BY <1>5, <1>m, <1>g
<1>7. pend = {} BY <1>0 DEF IndT, I_RangesS
<1>8. \A q \in AsmSet : \A x \in Blocks : head[q][x] >= acked[x] BY <1>6, <1>7, <1>j DEF J_RelHold, Pending
<1>. QED BY <1>n, <1>m, <1>s, <1>4, <1>5, <1>6, <1>8

-----------------------------------------------------------------------------
(* (S) The invariant layer, the data plane: Submit, Complete, Land, Drop.   *)
(* FlintCatchupTProof's I_Submit / I_Land / I_Drop / I_Complete ported:    *)
(* the stamp is left alone (NoStamp) except Drop's LossS (the barrier and  *)
(* a stamp due when the dropped leg is a member) and Complete's badAck.    *)
(* A completion runs with the barrier down: the release is the members     *)
(* (J_Rel), every member carries the raid's stamp core (J_Cur, so badAck   *)
(* stays FALSE), and the release keeps an in_sync member (J_RelInSync), so *)
(* the completed write landed and an in_sync member holds it.              *)

\* every J conjunct but J_RelHold and J_NoAckBad reads only the stamp, the raid and the record
LEMMA ZD_FJ ==
  ASSUME IndJ, UNCHANGED stampVars, UNCHANGED <<attached, members, zx, dState>>, J_RelHold', J_NoAckBad'
  PROVE  IndJ'
BY F_DueHold, F_JHoldAtt, F_Rel, F_Cur, F_ZxOut, F_Aseq, F_SeqSync, F_MemRel, F_M0, F_RelValid, F_MinorRel,
   F_RelInSync, F_ViewIn, F_ViewOut, F_SoleSeq, F_GenBound, F_ZGen DEF IndJ, stampVars

\* the J conjuncts that read neither the barrier nor the members (Drop's LossS moves those)
LEMMA ZD_FJcore ==
  ASSUME IndJ, UNCHANGED <<stamp, nseq, aseq, asize, rgenA, rmemA, sole, zgen, dState, badAck>>
  PROVE  /\ J_Aseq' /\ J_SeqSync' /\ J_M0' /\ J_RelValid' /\ J_MinorRel' /\ J_RelInSync' /\ J_ViewIn'
         /\ J_ViewOut' /\ J_SoleSeq' /\ J_ZGen' /\ J_NoAckBad'
BY F_Aseq, F_SeqSync, F_M0, F_RelValid, F_MinorRel, F_RelInSync, F_ViewIn, F_ViewOut, F_SoleSeq, F_ZGen,
   F_NoAckBad DEF IndJ

\* --- v7 (FlintCatchupSInd's v7 candidates, NEEDS-INV until 40-ind-base takes them) ----------------
ZD_V7 ==
  /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
  /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
  /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
  /\ J_SoleGen

\* the v7 conjuncts that read only the stamp registers and the record (no data-plane step moves them)
LEMMA ZD_FV7 ==
  ASSUME I_FreshS2, J_ZxIdle, J_SeqLe, J_SoleRel, J_ZLive, J_RelLe, J_ZRel, J_ZNoValid, J_ZM0, J_SoleGen,
         UNCHANGED <<stamp, nseq, agen, asize, rgenA, rmemA, sole, zseq, zgen, zsize, zrgen, zrmem, zm0, zst>>,
         UNCHANGED <<dState, sb, reverted, zx, attached, sPres, nextSeq, conf, sCon, cutAck>>
  PROVE  /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_ZLive' /\ J_RelLe' /\ J_ZRel'
         /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen'
<1>1. I_FreshS2' BY DEF I_FreshS2, InSyncR
<1>2. J_ZxIdle' BY DEF J_ZxIdle
<1>3. J_SeqLe' BY DEF J_SeqLe
<1>4. J_SoleRel' BY DEF J_SoleRel
<1>5. J_ZLive' BY DEF J_ZLive
<1>6. J_RelLe' BY DEF J_RelLe
<1>7. ZombieReleases' <=> ZombieReleases BY DEF ZombieReleases, Majority, Valid, SolePairs
<1>8. J_ZRel' BY <1>7 DEF J_ZRel, InSyncR
<1>9. J_ZNoValid' BY DEF J_ZNoValid, Valid, Majority, SolePairs
<1>10. J_ZM0' BY DEF J_ZM0
<1>11. J_SoleGen' BY DEF J_SoleGen
<1>. QED BY <1>1, <1>2, <1>3, <1>4, <1>5, <1>6, <1>8, <1>9, <1>10, <1>11

\* a leg's stamp keeps its validity while the stamps and the record's confirmations stay
LEMMA ZD_ValidSame ==
  ASSUME UNCHANGED <<stamp, sole>> PROVE \A q \in R : Valid(stamp[q])' <=> Valid(stamp[q])
BY DEF Valid, Majority, SolePairs

LEMMA ZD_FGenTop ==
  ASSUME J_GenTop, UNCHANGED <<attached, dState, stamp, agen, due, members, sole>> PROVE J_GenTop'
BY DEF J_GenTop, InSyncR, View, Valid, Majority, SolePairs

\* the acked-value orderings, when the acked maps, the snapshots and every catching-up head stay
LEMMA ZD_FHL ==
  ASSUME I_WHiC, I_HeadLoC, I_HeadLoA, I_HeadHiC,
         UNCHANGED <<acked, cutAck, sPres, sCon, dState, reverted, mark>>,
         \A q \in R : CatchingUp(q) => head'[q] = head[q]
  PROVE  I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC'
<1>1. \A x \in Blocks : AckW(x)' = AckW(x) BY DEF AckW
<1>2. \A q \in R : CatchingUp(q)' = CatchingUp(q) /\ HiOf(q)' = HiOf(q) BY DEF CatchingUp, HiOf
<1>3. I_WHiC' BY <1>1 DEF I_WHiC
<1>4. I_HeadLoC' BY <1>1, <1>2 DEF I_HeadLoC
<1>5. I_HeadLoA' BY <1>2 DEF I_HeadLoA
<1>6. I_HeadHiC' BY <1>1, <1>2 DEF I_HeadHiC
<1>. QED BY <1>3, <1>4, <1>5, <1>6

\* a leg catching up has its epoch below nextSeq (a standby's mark, a stale leg's revert = its base)
LEMMA ZD_HiLt ==
  ASSUME TypeOKT, I_Session, I_Reverted, NEW r \in R, CatchingUp(r)
  PROVE  HiOf(r) \in Int /\ HiOf(r) < nextSeq
<1>0. nextSeq \in Nat /\ mark[r] \in Nat /\ reverted[r] \in Int /\ sb[r] \in Int BY Basics
<1>1. SessionOK(r) /\ RevOK(r) BY DEF I_Session, I_Reverted
<1>2. CASE dState[r] = "standby" BY <1>0, <1>1, <1>2 DEF SessionOK, HiOf
<1>3. CASE dState[r] # "standby"
  <2>1. dState[r] = "stale" /\ reverted[r] # -1 BY <1>3 DEF CatchingUp
  <2>2. sb[r] = reverted[r] BY <1>1, <2>1 DEF RevOK
  <2>3. sb[r] < nextSeq BY <1>1, <2>1, <2>2 DEF SessionOK
  <2>. QED BY <1>0, <1>3, <2>2, <2>3 DEF HiOf
<1>. QED BY <1>2, <1>3

\* a snapshot holding a write in flight's version (or more) is at that write's epoch or later, so at nextSeq - 1 or later
LEMMA ZD_SnapHi ==
  ASSUME TypeOKT, I_PendTop, I_SnapPend, I_Pend, NEW w \in pend, NEW q \in R, NEW p \in sPres[q],
         w.v <= sCon[q][p][w.b]
  PROVE  w.cutAt <= p /\ w.cutAt >= nextSeq - 1 /\ w.cutAt \in Nat /\ p \in Nat
<1>0. p \in Epochs /\ Epochs \subseteq Nat BY Basics
<1>1. w.b \in Blocks /\ w.v \in Nat /\ w.cutAt \in Nat /\ sCon[q][p][w.b] \in Nat /\ nextSeq \in Nat BY <1>0, Nats
<1>2. sCon[q][p][w.b] <= w.v BY DEF I_PendTop
<1>3. sCon[q][p][w.b] = w.v BY <1>1, <1>2
<1>4. w.cutAt <= p BY <1>3 DEF I_SnapPend
<1>5. w.cutAt >= nextSeq - 1 BY DEF I_Pend
<1>. QED BY <1>0, <1>1, <1>4, <1>5

-----------------------------------------------------------------------------
LEMMA I_Submit ==
  ASSUME IndInv, ZD_V7, NEW x \in Blocks, Submit(x) /\ NoStamp PROVE IndInv' /\ ZD_V7'
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>K. TypeOKT BY <1>0, TypeOKParts
<1>V. /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
      /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
      /\ J_SoleGen
  BY DEF ZD_V7
<1>a. /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY <1>0 DEF IndT, IndS
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R /\ Healthy \subseteq R /\ Bases \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>K, Basics
<1>u. /\ UNCHANGED <<head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, members, attached, path, dState, mark, reverted, sb, pin>>
      /\ UNCHANGED <<acked, fails, badAdmit, badLoss, ackedEver, restamp, zx>>
      /\ UNCHANGED <<cfgAt, conf, tr, htr, cutAck>>
  BY DEF Submit, trustVars
<1>s. UNCHANGED stampVars /\ UNCHANGED sGhost BY DEF NoStamp
<1>s2. UNCHANGED <<rmemA, badAck, zjv, zpost>> BY <1>s DEF stampVars, sGhost
<1>. DEFINE nw == [b |-> x, v |-> ver + 1, to |-> members, landed |-> {},
                   dropped |-> {}, recAt |-> Latest, cutAt |-> nextSeq]
<1>p. /\ attached /\ ~Pending(x) /\ ver < MaxVer
      /\ ver' = ver + 1 /\ pend' = pend \cup {nw}
  BY DEF Submit
<1>v. ver \in Nat /\ nextSeq \in Nat BY <1>K, Groups DEF TyScalar, Vers
<1>n. \A q \in R : head[q][x] # ver + 1 /\ \A e \in sPres[q] : sCon[q][e][x] # ver + 1
  BY <1>a, <1>K, <1>T, <1>v, Groups DEF I_Vers, TyHead, TySnap, Vers
<1>1. TypeOK' BY <1>0, S_TySubmit
<1>j. IndJ'
  <2>0. \A y \in Blocks : ~Pending(y)' => ~Pending(y) BY <1>p DEF Pending
  <2>1. J_RelHold' BY <1>0, <1>u, <1>s2, <2>0 DEF IndJ, J_RelHold, InSyncR
  <2>2. J_NoAckBad' BY <1>0, <1>s2 DEF IndJ, J_NoAckBad
  <2>. QED BY <1>0, <1>s, <1>u, <2>1, <2>2, ZD_FJ
<1>t. IndT'
  <2>1. I_RangesS' BY <1>a, <1>u, <1>p DEF I_RangesS
  <2>2. /\ I_Lineage' /\ I_Chain' /\ I_MembersS' /\ I_HoldAtt' /\ I_Reverted' /\ I_Session'
        /\ Inv_TrustComplete' /\ I_NoBadLoss' /\ Inv_AckedHeld'
    BY <1>a, <1>u, F_Lineage, F_Chain, F_MembersS, F_HoldAtt, F_Reverted, F_Session, F_TC, F_NoBadLoss,
       F_AckedHeld
  <2>3. I_Pend'
    <3>0. TypeOKT /\ I_Pend /\ I_Vers /\ I_RangesS BY <1>a, <1>K
    <3>N. /\ ver \in Nat /\ nextSeq \in Nat /\ acked[x] \in Nat
          /\ \A w \in pend : w.v \in Nat /\ w.cutAt \in Nat
      BY <3>0, Nats
    <3>1. ver + 1 > acked[x] BY <3>0, <3>N DEF I_Vers
    <3>2. \A w \in pend : w.b # x BY <1>p DEF Pending
    <3>3. cutK # 0 => nextSeq >= cutK BY <3>0, <3>N DEF I_RangesS
    <3>4. \A w1, w2 \in pend' : w1.b = w2.b => w1 = w2 BY <3>0, <3>2, <1>p DEF I_Pend
    <3>5. ASSUME NEW w \in pend'
          PROVE  /\ w.v > acked'[w.b] /\ w.v <= ver'
                 /\ w.landed \cap w.dropped = {}
                 /\ w.landed \cup w.dropped \subseteq w.to
                 /\ members' \subseteq w.to \ w.dropped
                 /\ \A q \in w.landed \cap members' : head'[q][w.b] = w.v
                 /\ w.cutAt <= nextSeq' /\ w.cutAt >= nextSeq' - 1
                 /\ cutK' # 0 => w.cutAt >= cutK'
      <4>1. CASE w = nw BY <4>1, <3>1, <3>3, <3>N, <1>p, <1>u
      <4>2. CASE w \in pend BY <4>2, <3>0, <3>N, <1>p, <1>u DEF I_Pend
      <4>. QED BY <4>1, <4>2, <1>p
    <3>. QED BY <3>4, <3>5 DEF I_Pend
  <2>4. I_PendSeen' BY <1>a, <1>T, <1>u, <1>p, <1>n DEF I_PendSeen
  <2>5. I_Vers'
    <3>1. ver \in Nat /\ (\A y \in Blocks : acked[y] \in Nat)
          /\ (\A q \in R : \A y \in Blocks : head[q][y] \in Nat)
          /\ (\A q \in R : \A e \in Epochs : \A y \in Blocks : sCon[q][e][y] \in Nat)
      BY <1>K, Nats
    <3>2. \A q \in R : sPres[q] \subseteq Epochs BY <1>K, Groups DEF TySnap
    <3>. QED BY <1>a, <1>T, <1>u, <1>p, <3>1, <3>2 DEF I_Vers
  <2>6. I_HeadPend' BY <1>a, <1>T, <1>u, <1>p, <1>n DEF I_HeadPend, CatchingUp, HiOf
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6 DEF IndT
<1>S. IndS'
  <2>1. I_AckedEverS' /\ I_WHiS' /\ I_AckMono' /\ I_HeadLoS' /\ I_FreshS'
    BY <1>a, <1>u, <1>s2, F_AckedEverS, F_WHiS, F_AckMono, F_HeadLoS, F_FreshS
  <2>2. I_LegalS'
    <3>1. \A y \in Blocks : PendVal(y) \subseteq PendVal(y)' BY <1>p DEF PendVal
    <3>. QED BY <1>a, <1>u, <1>s2, <3>1 DEF I_LegalS, LegalV
  <2>. QED BY <2>1, <2>2 DEF IndS
<1>vd. \A q \in R : Valid(stamp[q])' <=> Valid(stamp[q])
  <2>1. UNCHANGED <<stamp, sole>> BY <1>s DEF stampVars
  <2>. QED BY <2>1, ZD_ValidSame
<1>N. ZD_V7'
  <2>1. /\ I_FreshS2' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_ZLive' /\ J_RelLe' /\ J_ZRel'
        /\ J_ZNoValid' /\ J_ZM0' /\ J_SoleGen'
    BY <1>V, <1>u, <1>s, ZD_FV7 DEF stampVars
  <2>2. J_GenTop' BY <1>V, <1>u, <1>s, ZD_FGenTop DEF stampVars
  <2>3. I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC' BY <1>V, <1>u, ZD_FHL
  <2>4. J_RelHoldS' BY <1>V, <1>u, <1>s2 DEF J_RelHoldS, InSyncR
  <2>5. I_SnapPend' BY <1>V, <1>u, <1>p, <1>n DEF I_SnapPend
  <2>6. I_LegalS2' /\ I_StandbyLegal' /\ I_SnapLegal' /\ I_CutLegal' /\ I_InSyncLegal' /\ I_ValidLegal'
    <3>1. \A y \in Blocks : PendVal(y) \subseteq PendVal(y)' BY <1>p DEF PendVal
    <3>2. I_LegalS2' BY <1>V, <1>u, <1>s2, <3>1 DEF I_LegalS2, LegalV2
    <3>3. I_StandbyLegal' BY <1>V, <1>u, <3>1 DEF I_StandbyLegal
    <3>4. I_SnapLegal' BY <1>V, <1>u, <3>1 DEF I_SnapLegal
    <3>5. I_CutLegal' /\ I_InSyncLegal' BY <1>V, <1>u, <3>1 DEF I_CutLegal, I_InSyncLegal, InSyncR
    <3>6. I_ValidLegal' BY <1>V, <1>u, <3>1, <1>vd DEF I_ValidLegal, InSyncR
    <3>. QED BY <3>2, <3>3, <3>4, <3>5, <3>6
  <2>7. I_PendTop'
    <3>1. \A q \in R : head[q][x] <= ver /\ \A e \in sPres[q] : sCon[q][e][x] <= ver BY <1>a DEF I_Vers
    <3>2. \A q \in R : head[q][x] \in Nat /\ \A e \in sPres[q] : sCon[q][e][x] \in Nat BY <1>K, <1>T, Nats
    <3>3. \A q \in R : head[q][x] <= ver + 1 /\ \A e \in sPres[q] : sCon[q][e][x] <= ver + 1
      BY <3>1, <3>2, <1>v
    <3>. QED BY <3>3, <1>V, <1>u, <1>p DEF I_PendTop
  <2>8. I_PendNext' BY <1>V, <1>u, <1>p DEF I_PendNext
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>8 DEF ZD_V7
<1>. QED BY <1>1, <1>j, <1>t, <1>S, <1>N, IndSplitP

-----------------------------------------------------------------------------
LEMMA I_Complete ==
  ASSUME IndInv, ZD_V7, NEW w \in pend,
         Complete(w) /\ badAck' = (badAck \/ (Stamp /\ \E q \in members : Core(stamp[q]) # Core(CurStamp)))
                     /\ UNCHANGED <<stampVars, zAcked, zfreed, zLeg, zjv, zexcl, postMove, legalJ, riskTail, vouched, tornMarked, tornServed, tornBare, zpost>>
  PROVE  IndInv' /\ ZD_V7'
<1>0. TypeOK /\ IndJ /\ IndT /\ IndS BY IndSplit
<1>K. TypeOKT BY <1>0, TypeOKParts
<1>V. /\ J_RelHoldS /\ I_FreshS2 /\ I_LegalS2 /\ I_SnapPend /\ J_ZxIdle /\ J_SeqLe /\ J_SoleRel /\ J_GenTop
      /\ J_ZLive /\ J_RelLe /\ I_WHiC /\ I_HeadLoC /\ I_HeadLoA /\ I_StandbyLegal /\ I_HeadHiC /\ I_SnapLegal
      /\ I_PendTop /\ I_PendNext /\ J_ZRel /\ I_CutLegal /\ I_InSyncLegal /\ I_ValidLegal /\ J_ZNoValid /\ J_ZM0
      /\ J_SoleGen
  BY DEF ZD_V7
<1>a. /\ I_RangesS /\ I_Lineage /\ I_Chain /\ I_Pend /\ I_MembersS /\ I_HoldAtt /\ I_PendSeen /\ I_Vers
      /\ I_Reverted /\ I_HeadPend /\ I_Session /\ Inv_TrustComplete /\ I_NoBadLoss /\ Inv_AckedHeld
      /\ I_AckedEverS /\ I_LegalS /\ I_WHiS /\ I_AckMono /\ I_HeadLoS /\ I_FreshS
  BY <1>0 DEF IndT, IndS
<1>J. J_DueHold /\ J_Rel /\ J_Cur /\ J_RelInSync /\ J_RelHold /\ J_NoAckBad BY <1>0 DEF IndJ
<1>T. /\ members \subseteq R /\ InSyncR \subseteq R /\ Healthy \subseteq R /\ Bases \subseteq R
      /\ cutTgt \subseteq R /\ cutDone \subseteq R /\ cutGone \subseteq R
      /\ recorded \subseteq Epochs /\ Epochs \subseteq Nat /\ R \subseteq Nat
      /\ nextSeq \in Nat /\ cutK \in Nat /\ ver \in Nat /\ MaxEpoch \in Nat
      /\ \A q \in R : /\ sPres[q] \subseteq Epochs /\ tr[q] \subseteq Epochs
                      /\ hPar[q] \in Nat /\ mark[q] \in Nat /\ pin[q] \in Nat
                      /\ sb[q] \in Int /\ reverted[q] \in Int
  BY <1>K, Basics
<1>u. /\ UNCHANGED <<ver, head, hAl, hPar, sPres, sCon, sAl, sPar, anc, recorded, nextSeq>>
      /\ UNCHANGED <<cutK, cutTgt, cutDone, cutGone, members, attached, path, dState, mark, reverted, sb, pin>>
      /\ UNCHANGED <<fails, riskRec, badAdmit, badLoss, restamp, zx>>
      /\ UNCHANGED <<cfgAt, conf, tr, htr, cutAck>>
  BY DEF Complete, trustVars
<1>s. UNCHANGED stampVars /\ zjv' = zjv /\ zpost' = zpost OBVIOUS
<1>s2. UNCHANGED <<rmemA, hold, due, stamp, aseq, agen, asize, rgenA>> BY <1>s DEF stampVars
<1>w. w \in Write BY <1>K, Groups DEF TyPend
<1>L. (Cardinality(w.landed) >= WriteQuorum) <=> w.landed # {} BY <1>w, OneLanding DEF Write
<1>p. /\ w.landed \cup w.dropped = w.to /\ pend' = pend \ {w}
      /\ acked' = IF w.landed # {} THEN [acked EXCEPT ![w.b] = w.v] ELSE acked
      /\ ackedEver' = IF w.landed # {} THEN [ackedEver EXCEPT ![w.b] = @ \cup {w.v}] ELSE ackedEver
  BY <1>L DEF Complete
<1>at. attached BY <1>a DEF I_RangesS
<1>nh. ~hold /\ ~due BY <1>J, Full DEF Complete, J_DueHold
<1>rm. rmemA = members BY <1>J, <1>at, <1>nh DEF J_Rel
<1>o. \A u \in pend : u # w => u.b # w.b BY <1>a DEF I_Pend
<1>g. w.v > acked[w.b] /\ w.v \in Nat /\ acked[w.b] \in Nat /\ w.v <= ver /\ w.b \in Blocks
  BY <1>a, <1>K, Nats DEF I_Pend
<1>m. members \subseteq w.landed BY <1>a, <1>p DEF I_Pend
<1>hm. \A q \in members : head[q][w.b] = w.v BY <1>a, <1>m DEF I_Pend
<1>ne. members \cap InSyncR # {} BY <1>J, <1>rm DEF J_RelInSync
<1>ld. w.landed # {} BY <1>ne, <1>m
<1>ak. /\ \A y \in Blocks : y # w.b => acked'[y] = acked[y] /\ ackedEver'[y] = ackedEver[y]
       /\ acked'[w.b] = w.v /\ ackedEver'[w.b] = ackedEver[w.b] \cup {w.v}
  <2>1. /\ acked' = [acked EXCEPT ![w.b] = w.v]
        /\ ackedEver' = [ackedEver EXCEPT ![w.b] = @ \cup {w.v}]
    BY <1>p, <1>ld
  <2>. QED BY <2>1, <1>g, <1>K, Groups DEF TyPend
<1>P. \A y \in Blocks : Pending(y)' <=> (Pending(y) /\ y # w.b) BY <1>p, <1>o DEF Pending
<1>1. TypeOK' BY <1>0, S_TyComplete
<1>j. IndJ'
  <2>1. J_NoAckBad'
    <3>1. \A q \in members : Core(stamp[q]) = Core(CurStamp) BY <1>J, <1>at, <1>nh DEF J_Cur
    <3>2. ~badAck BY <1>J DEF J_NoAckBad
    <3>. QED BY <3>1, <3>2 DEF J_NoAckBad
  <2>2. J_RelHold'
    <3>. SUFFICES ASSUME NEW q \in rmemA \cap InSyncR, NEW y \in Blocks, ~Pending(y)'
                  PROVE  head[q][y] >= acked'[y]
      BY <1>u, <1>s2 DEF J_RelHold, InSyncR
    <3>1. CASE y = w.b BY <3>1, <1>ak, <1>hm, <1>rm, <1>g
    <3>2. CASE y # w.b
      <4>1. ~Pending(y) BY <3>2, <1>P
      <4>. QED BY <4>1, <3>2, <1>ak, <1>J DEF J_RelHold
    <3>. QED BY <3>1, <3>2
  <2>. QED BY <1>0, <1>s, <1>u, <2>1, <2>2, ZD_FJ
<1>t. IndT'
  <2>1. I_RangesS' BY <1>a, <1>u, <1>p, <1>at DEF I_RangesS
  <2>2. /\ I_Lineage' /\ I_Chain' /\ I_MembersS' /\ I_Reverted' /\ I_Session' /\ Inv_TrustComplete'
        /\ I_NoBadLoss'
    BY <1>a, <1>u, F_Lineage, F_Chain, F_MembersS, F_Reverted, F_Session, F_TC, F_NoBadLoss
  <2>3. I_Pend'
    <3>1. \A u \in pend' : acked'[u.b] = acked[u.b] BY <1>p, <1>o, <1>ak, <1>K, Groups DEF TyPend, Write
    <3>. QED BY <1>a, <1>T, <1>u, <1>p, <3>1 DEF I_Pend
  <2>4. I_HoldAtt'
    <3>. SUFFICES ASSUME attached, NEW q \in members, NEW y \in Blocks PROVE head[q][y] >= acked'[y]
      BY <1>u DEF I_HoldAtt
    <3>1. CASE y = w.b BY <3>1, <1>ak, <1>hm, <1>g
    <3>2. CASE y # w.b BY <3>2, <1>ak, <1>a DEF I_HoldAtt
    <3>. QED BY <3>1, <3>2
  <2>5. Inv_AckedHeld'
    <3>. SUFFICES ASSUME NEW y \in Blocks PROVE \E q \in R : dState[q] = "insync" /\ head[q][y] >= acked'[y]
      BY <1>u DEF Inv_AckedHeld
    <3>1. CASE y = w.b
      <4>1. PICK q \in members \cap InSyncR : TRUE BY <1>ne
      <4>2. q \in R /\ dState[q] = "insync" BY <4>1 DEF InSyncR
      <4>. QED BY <3>1, <4>1, <4>2, <1>ak, <1>hm, <1>g
    <3>2. CASE y # w.b BY <3>2, <1>ak, <1>a DEF Inv_AckedHeld
    <3>. QED BY <3>1, <3>2
  <2>6. I_PendSeen' /\ I_HeadPend' BY <1>a, <1>u, <1>p DEF I_PendSeen, I_HeadPend, CatchingUp, HiOf
  <2>7. I_Vers'
    <3>1. \A y \in Blocks : acked'[y] <= ver BY <1>ak, <1>g, <1>a DEF I_Vers
    <3>. QED BY <3>1, <1>a, <1>u DEF I_Vers
  <2>. QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7 DEF IndT
<1>S. IndS'
  <2>1. I_WHiS' /\ I_HeadLoS' /\ I_FreshS'
    BY <1>a, <1>u, <1>s2, F_WHiS, F_HeadLoS, F_FreshS
  <2>2. I_AckedEverS'
    <3>. SUFFICES ASSUME NEW y \in Blocks PROVE acked'[y] \in ackedEver'[y] /\ 0 \in ackedEver'[y]
      BY DEF I_AckedEverS
    <3>1. CASE y = w.b BY <3>1, <1>ak, <1>a DEF I_AckedEverS
    <3>2. CASE y # w.b BY <3>2, <1>ak, <1>a DEF I_AckedEverS
    <3>. QED BY <3>1, <3>2
  <2>3. I_AckMono'
    <3>. SUFFICES ASSUME NEW q \in R, NEW e \in sPres[q], NEW y \in Blocks PROVE cutAck[q][e][y] <= acked'[y]
      BY <1>u DEF I_AckMono
    <3>0. e \in Epochs BY <1>T
    <3>N. cutAck[q][e][y] \in Nat /\ acked[y] \in Nat BY <3>0, <1>K, Nats
    <3>1. cutAck[q][e][y] <= acked[y] BY <1>a DEF I_AckMono
    <3>2. CASE y = w.b BY <3>2, <3>1, <3>N, <1>ak, <1>g
    <3>3. CASE y # w.b BY <3>3, <3>1, <1>ak
    <3>. QED BY <3>2, <3>3
  <2>4. I_LegalS'
    <3>1. \A y \in Blocks : y # w.b => PendVal(y)' = PendVal(y) BY <1>p DEF PendVal
    <3>2. PendVal(w.b) = {w.v} /\ PendVal(w.b)' = {} BY <1>p, <1>o DEF PendVal
    <3>3. \A y \in Blocks : LegalV(y)' = LegalV(y) BY <3>1, <3>2, <1>ak, <1>s DEF LegalV
    <3>. QED BY <1>a, <1>u, <3>3 DEF I_LegalS
  <2>. QED BY <2>1, <2>2, <2>3, <2>4 DEF IndS
<1>vd. \A q \in R : Valid(stamp[q])' <=> Valid(stamp[q])
