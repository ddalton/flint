<1>p. /\ cutK # 0 /\ cutDone = cutTgt
      /\ recorded' = recorded \cup {cutK} /\ nextSeq' = nextSeq + 1
      /\ mark' = [q \in R |-> IF q \in cutTgt /\ dState[q] = "insync" THEN cutK ELSE mark[q]]
      /\ cutK' = 0 /\ cutTgt' = {} /\ cutDone' = {} /\ cutGone' = {}
