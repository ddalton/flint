    <3>2. I_LegalS2' /\ I_SnapPend' /\ I_WHiC' /\ I_HeadLoC' /\ I_HeadLoA' /\ I_HeadHiC' /\ I_SnapLegal' /\ I_PendTop' /\ I_PendNext'
