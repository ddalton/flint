      BY <1>u, <3>0 DEF I_FreshS
    <3>1. CASE q = r /\ f = cutK
      <4>1. head[r][x] >= acked[x] BY <3>1, <1>0, <1>k DEF I_HoldAtt
      <4>. QED BY <4>1, <2>n, <3>1
    <3>2. CASE ~(q = r /\ f = cutK)
      <4>1. f \in sPres[q] /\ sCon'[q][f] = sCon[q][f] /\ cutAck'[q][f] = cutAck[q][f] BY <3>2, <3>0, <2>old
      <4>2. q \in BasesS BY <1>k DEF BasesS
      <4>. QED BY <4>1, <4>2, <1>0 DEF I_FreshS
    <3>. QED BY <3>1, <3>2
  <2>v. ZC_V7'
    <3>1. J_RelHoldS' /\ J_ZxIdle' /\ J_SeqLe' /\ J_SoleRel' /\ J_GenTop' /\ J_ZLive' /\ J_RelLe' /\ I_StandbyLegal' /\ J_ZRel'
      BY <1>u, ZC_KeepV7
    <3>2. I_SnapPend'
      <4>. SUFFICES ASSUME NEW q \in R, NEW f \in sPres'[q], NEW w \in pend, sCon'[q][f][w.b] = w.v
